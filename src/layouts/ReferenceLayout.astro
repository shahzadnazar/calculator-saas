---
/**
 * ReferenceLayout — shared skeleton for a reference table/chart page.
 *
 * A page supplies its registry entry and editorial slots (intro, how-to, notes);
 * this layout derives SEO metadata, breadcrumbs and Article + Breadcrumb schema,
 * renders the shared DataTable from getReferenceTable(), and appends the embed
 * box so every reference table is embeddable (each embed = an attribution
 * backlink). New reference assets get all of this for free.
 *
 * Slots: "intro" (lead sentence), "howto" (how to use, prose), "notes"
 * (worked example + methodology, prose).
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Icon from '@components/Icon.astro';
import DataTable from '@components/DataTable.astro';
import EmbedBox from '@components/EmbedBox.astro';
import { type ReferenceAsset, referencePath, REFERENCE_DATA_LICENSE } from '@data/reference';
import { getReferenceTable } from '@lib/referenceTables';
import { breadcrumbSchema, articleSchema, datasetSchema } from '@lib/schema';
import { SITE } from '@config/site';

interface Props {
  reference: ReferenceAsset;
  /**
   * Override the registry's review date. Rarely needed — the date belongs to
   * the table, not to the page that renders it, so it lives in the registry
   * where the sitemap's lastmod can read it too.
   */
  reviewed?: string;
}
const { reference, reviewed = reference.reviewed } = Astro.props;
const path = referencePath(reference);
const table = getReferenceTable(reference.slug);
const csvPath = `${path}.csv`;

// "18 July 2026" — spelled out, because this line exists to be read by an editor
// deciding whether to cite the figure, not parsed.
const reviewedDisplay = new Date(`${reviewed}T00:00:00Z`).toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});

// The sentence we would like someone to write, written for them. Handing over
// the exact wording is the cheapest way to raise both the chance a citation
// happens at all and the chance it carries the link.
const citation = `${SITE.name}. "${reference.title}." ${SITE.url}${path} (reviewed ${reviewedDisplay}).`;

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Reference', path: '/reference' },
  { name: reference.shortName, path },
];
const jsonLd = [
  breadcrumbSchema(crumbs),
  articleSchema({
    title: reference.title,
    description: reference.description,
    path,
    authorName: `${SITE.name} Editorial`,
    datePublished: `${reviewed}T00:00:00Z`,
  }),
  ...(table
    ? [
        datasetSchema({
          name: reference.title,
          description: reference.description,
          path,
          dateModified: `${reviewed}T00:00:00Z`,
          csvPath,
          variables: table.headers,
          license: REFERENCE_DATA_LICENSE.url,
        }),
      ]
    : []),
];
---

<BaseLayout title={reference.title} description={reference.description} path={path} ogImage={`/og/ref-${reference.slug}.png`} jsonLd={jsonLd}>
  <div class="wrap py-4">
    <Breadcrumbs crumbs={crumbs} />

    <header class="mt-5 max-w-3xl">
      <span class="icon-chip h-14 w-14"><Icon name={reference.icon} size={28} /></span>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight sm:text-4xl">{reference.title}</h1>
      <p class="mt-3 text-lg" style="color: var(--muted)"><slot name="intro" /></p>
      <p class="mt-3 text-sm" style="color: var(--muted)">
        Figures reviewed <time datetime={reviewed}>{reviewedDisplay}</time>{table && <> · <a href={csvPath} class="hover:underline" style="color: var(--color-brand-600)" download>Download CSV</a></>}
      </p>
    </header>

    <div class="prose mt-8"><slot name="howto" /></div>

    {table && <div class="mt-4"><DataTable headers={table.headers} rows={table.rows} maxWidth={table.maxWidth} /></div>}

    <div class="prose mt-8"><slot name="notes" /></div>

    <section class="mt-8 max-w-3xl" aria-labelledby="cite-heading">
      <h2 id="cite-heading" class="text-2xl font-bold">Cite this table</h2>
      <p class="mt-3 text-sm" style="color: var(--muted)">
        These figures are published under
        <a href={REFERENCE_DATA_LICENSE.url} rel="license noopener" target="_blank" class="hover:underline" style="color: var(--color-brand-600)">{REFERENCE_DATA_LICENSE.name}</a>:
        reuse them anywhere, including commercially, as long as you say where they came from.
        Every value is computed from this site's unit-tested functions, and the method is set
        out above.
      </p>
      <p class="card mt-3 p-4 text-sm" data-citation>{citation}</p>
      <button type="button" class="btn btn-secondary mt-3" data-copy-citation>Copy citation</button>
    </section>

    <EmbedBox
      title={reference.shortName}
      slug={reference.slug}
      embedPath={`/embed/reference/${reference.slug}`}
      canonicalPath={path}
      noun="table"
    />
  </div>
</BaseLayout>

<script>
  // Same shape as EmbedBox's copy button: clipboard where it exists, selection
  // where it does not, so the citation is always obtainable.
  document.querySelectorAll<HTMLButtonElement>('[data-copy-citation]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.closest('section')?.querySelector<HTMLElement>('[data-citation]');
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text.textContent?.trim() ?? '');
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = 'Copy citation'), 1500);
      } catch {
        const range = document.createRange();
        range.selectNodeContents(text);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      }
    });
  });
</script>
