---
/**
 * BaseLayout — the HTML shell shared by every page.
 *
 * Responsibilities: document skeleton, <head> via BaseHead, pre-paint theme
 * application (no flash of the wrong theme), global styles, skip link, header
 * and footer. Page-specific structured data flows through to BaseHead.
 */
import '@styles/global.css';
import BaseHead from '@components/BaseHead.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { organizationSchema, webSiteSchema } from '@lib/schema';
import { SITE } from '@config/site';

interface Props {
  title: string;
  description?: string;
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** Include the site-wide Organization + WebSite schema (default: true). */
  siteSchema?: boolean;
}

const {
  title,
  description,
  path,
  ogImage,
  ogType,
  noindex,
  jsonLd = [],
  siteSchema = true,
} = Astro.props;

const schemas = siteSchema
  ? [organizationSchema(), webSiteSchema(), ...jsonLd]
  : jsonLd;

const langAttr = SITE.locale.split('_')[0];
---

<!doctype html>
<html lang={langAttr}>
  <head>
    <BaseHead
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      jsonLd={schemas}
    />
    <script is:inline>
      // Set the theme before first paint, so there is no flash.
      //
      // LIGHT is the product default, not the visitor's OS setting. Every dark rule in the
      // stylesheets is written as `:root:not([data-theme='light'])` inside a
      // prefers-color-scheme query, so stamping `light` here switches all 83 of them off in
      // one move; `dark` still comes through for anyone who picks it with the toggle.
      //
      // Written before the try, so a browser that refuses localStorage (private mode, blocked
      // site data) still lands on light rather than falling through to the OS.
      (function () {
        var el = document.documentElement;
        el.setAttribute('data-theme', 'light');
        try {
          if (localStorage.getItem('theme') === 'dark') el.setAttribute('data-theme', 'dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:px-4 focus:py-2"
      style="background: var(--color-brand-600); color: #fff"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
