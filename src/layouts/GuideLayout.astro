---
/**
 * GuideLayout — renders a long-form guide from the content collection with
 * Article structured data, author attribution (EEAT), and interlinking to the
 * calculators it references.
 */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { getAuthor } from '@config/authors';
import { getCalculator, getCategory, calculatorPath } from '@data/calculators';
import { articleSchema, breadcrumbSchema } from '@lib/schema';

interface Props {
  guide: CollectionEntry<'guides'>;
}
const { guide } = Astro.props;
const { data } = guide;
const path = `/guides/${guide.id}`;
const author = getAuthor(data.author);
const category = getCategory(data.category);

const related = data.relatedCalculators
  .map((ref) => {
    const [cat, slug] = ref.split('/');
    return getCalculator(cat, slug);
  })
  .filter((c) => c && c.status === 'live');

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Guides', path: '/guides' },
  { name: data.title, path },
];

const jsonLd = [
  articleSchema({
    title: data.title,
    description: data.description,
    path,
    authorName: author.name,
    datePublished: data.publishDate.toISOString(),
    dateModified: (data.updatedDate ?? data.publishDate).toISOString(),
  }),
  breadcrumbSchema(crumbs),
];
---

<BaseLayout title={data.title} description={data.description} path={path} ogType="article" jsonLd={jsonLd}>
  <div class="wrap py-8">
    <Breadcrumbs crumbs={crumbs} />

    <article class="mx-auto mt-6 max-w-3xl">
      <header>
        {
          category && (
            <a href={`/${category.slug}`} class="text-sm font-semibold" style="color: var(--color-brand-600)">
              {category.icon} {category.name}
            </a>
          )
        }
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">{data.title}</h1>
        <p class="mt-3 text-lg" style="color: var(--muted)">{data.description}</p>
        <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm" style="color: var(--muted)">
          <span>{author.role}</span>
          <span aria-hidden="true">·</span>
          <span>Updated {fmtDate(data.updatedDate ?? data.publishDate)}</span>
        </div>
      </header>

      <div class="prose guide-prose mt-8">
        <slot />
      </div>

      {
        related.length > 0 && (
          <section class="mt-12 rounded-2xl border p-6" style="border-color: var(--line); background: var(--card)">
            <h2 class="text-lg font-bold">Calculators used in this guide</h2>
            <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
              {related.map((c) => (
                <li>
                  <a href={calculatorPath(c!)} class="flex items-center justify-between gap-2 rounded-lg border p-3 transition-colors hover:border-[var(--color-brand-400)]" style="border-color: var(--line)">
                    <span class="font-semibold" style="color: var(--heading)">{c!.title}</span>
                    <span aria-hidden="true" style="color: var(--color-brand-600)">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <!-- Author / EEAT -->
      <aside class="mt-10 flex items-start gap-4 border-t pt-8" style="border-color: var(--line)">
        <div class="grid h-12 w-12 shrink-0 place-items-center rounded-full text-xl" style="background: var(--color-brand-100); color: var(--color-brand-700)">✍️</div>
        <div>
          <p class="font-bold" style="color: var(--heading)">{author.name}</p>
          <p class="mt-1 text-sm" style="color: var(--muted)">{author.bio}</p>
        </div>
      </aside>
    </article>
  </div>
</BaseLayout>

<style>
  /* Guides use the full article column (so embedded calculators have room),
     while keeping paragraphs comfortable via generous line spacing. */
  .guide-prose {
    max-width: none;
  }
  /* Give embedded interactive calculators breathing room from the text. */
  .guide-prose :global([data-scientific-calculator]),
  .guide-prose :global([data-mortgage]),
  .guide-prose :global([data-compound]),
  .guide-prose :global([data-bmi]),
  .guide-prose :global([data-calorie]) {
    margin-block: 1.5rem;
  }
</style>
