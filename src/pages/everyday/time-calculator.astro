---
import CalculatorLayout from '@layouts/CalculatorLayout.astro';
import TimeCalculator from '@components/islands/TimeCalculator.astro';
import { getCalculator } from '@data/calculators';
const calc = getCalculator('everyday', 'time-calculator')!;
const faqs = [
  { question: 'How do I add two durations?', answer: 'Enter each duration in days, hours, minutes and seconds, choose Add, and the calculator combines them and normalises the result — so 2h 30m plus 1h 45m becomes 4h 15m.' },
  { question: 'Can it subtract time?', answer: 'Yes. Choose Subtract to find the difference between two durations. If the result is negative, the calculator shows it with a minus sign.' },
  { question: 'How do I convert between hours, minutes and seconds?', answer: 'There are 60 seconds in a minute, 60 minutes in an hour and 24 hours in a day. So one hour is 3,600 seconds, and one day is 86,400 seconds. The calculator also shows the total duration in seconds.' },
  { question: 'Why is adding time different from adding ordinary numbers?', answer: 'Time is in base 60, not base 10 — 60 minutes roll over into an hour, not 100. That is why 45 minutes plus 30 minutes is 1h 15m, and why doing it by hand is easy to get wrong.' },
  { question: 'What is the difference from the hours calculator?', answer: 'This tool adds and subtracts durations (spans of time). The hours calculator works out time worked between two clock times, with breaks — better for timesheets.' },
];
---
<CalculatorLayout
  calculator={calc}
  presentation="task-first"
  reviewMetadata={{ reviewedDate: '2026-08-09' }}
  intro="Add or subtract two durations in days, hours, minutes and seconds, then press Calculate Time to see the normalised result and the total in seconds."
  faqs={faqs}
>
  <TimeCalculator />
  <Fragment slot="content">
    <h2>How to use the time calculator</h2>
    <ol>
      <li>Enter the first duration in <strong>days, hours, minutes and seconds</strong> (leave any field blank for zero).</li>
      <li>Choose <strong>add</strong> or <strong>subtract</strong>, then enter the second duration.</li>
      <li>Press <strong>Calculate Time</strong> to see the normalised result and the total in seconds.</li>
    </ol>

    <h2>How duration arithmetic works</h2>
    <p>
      Time is awkward to add by hand because it runs in base 60, not base 10 — 60 minutes roll
      over into an hour, not 100. The calculator sidesteps that by converting each duration to a
      single number of seconds, adding or subtracting those, and then breaking the total back
      into days, hours, minutes and seconds so the carrying is always right.
    </p>

    <h2>A worked example</h2>
    <p>
      Add <strong>2h 30m</strong> and <strong>1h 45m</strong>. As seconds that is 9,000 + 6,300 =
      <strong>15,300 seconds</strong>; broken back down, the answer is <strong>4h 15m</strong> —
      not 3h 75m. The minutes past 60 correctly carry into an extra hour, which is the step that
      trips up mental arithmetic.
    </p>

    <h2>Subtracting durations</h2>
    <p>
      Subtraction works the same way. <strong>5h 15m</strong> minus <strong>2h 50m</strong> is
      18,900 − 10,200 = 8,700 seconds, or <strong>2h 25m</strong>. If the second duration is
      larger than the first, the result is negative and shown with a minus sign rather than
      wrapping around.
    </p>

    <h2>Time unit conversions</h2>
    <table>
      <thead>
        <tr><th>Unit</th><th>Equivalent</th></tr>
      </thead>
      <tbody>
        <tr><td>1 minute</td><td>60 seconds</td></tr>
        <tr><td>1 hour</td><td>60 minutes = 3,600 seconds</td></tr>
        <tr><td>1 day</td><td>24 hours = 1,440 minutes = 86,400 seconds</td></tr>
      </tbody>
    </table>

    <h2>How this differs from the hours calculator</h2>
    <p>
      This tool adds and subtracts <strong>durations</strong> — spans of time with no particular
      start or end. To work out time elapsed between two <strong>clock times</strong>, such as a
      shift from 9:00 to 17:30 with a break, use the
      <a href="/everyday/hours-calculator">hours calculator</a> instead. To count days between
      calendar dates, use the <a href="/everyday/date-calculator">date calculator</a>.
    </p>
  </Fragment>
</CalculatorLayout>
