---
import CalculatorLayout from '@layouts/CalculatorLayout.astro';
import PasswordGeneratorCalculator from '@components/islands/PasswordGeneratorCalculator.astro';
import { getCalculator } from '@data/calculators';

const calc = getCalculator('everyday', 'password-generator')!;

const faqs = [
  {
    question: 'Are these passwords safe to use?',
    answer:
      'Yes. Passwords are generated in your browser using the Web Cryptography API, which provides cryptographically strong randomness. Nothing you generate is transmitted to or stored on any server.',
  },
  {
    question: 'What makes a strong password?',
    answer:
      'Length and variety. A longer password with a mix of uppercase, lowercase, digits and symbols has far more possible combinations, making it exponentially harder to guess. Aim for at least 16 characters where allowed.',
  },
  {
    question: 'What does the strength meter measure?',
    answer:
      'It estimates entropy in bits — a measure of unpredictability based on the character set and length. More bits means a stronger password. Above about 90 bits is considered very strong.',
  },
  {
    question: 'Should I reuse passwords?',
    answer:
      'No. Use a unique password for every account and store them in a reputable password manager, so a breach of one service cannot compromise the others.',
  },
  {
    question: 'How long should a password be?',
    answer:
      'Aim for at least 16 characters wherever a site allows it. Length matters more than complexity: a long password has exponentially more combinations, so adding characters strengthens it faster than swapping in the odd symbol.',
  },
  {
    question: 'How often should I change my password?',
    answer:
      'Current guidance (including from NIST) is to change a password only when there is a reason to — a breach, a phishing scare, or a shared password — rather than on a fixed schedule. Forced routine changes tend to push people toward weaker, predictable variations.',
  },
];
---

<CalculatorLayout
  calculator={calc}
  presentation="task-first"
  intro="Generate strong, random passwords right in your browser. Choose the length and character types — nothing is ever sent to a server."
  faqs={faqs}
  reviewMetadata={{ reviewedDate: '2026-07-17' }}
>
  <PasswordGeneratorCalculator />

  <Fragment slot="content">
    <h2>How to use the password generator</h2>
    <p>
      Set the <strong>length</strong> with the slider and choose which character types to
      include — <strong>uppercase</strong>, <strong>lowercase</strong>,
      <strong>digits</strong> and <strong>symbols</strong>. A new password generates
      automatically; use the ↻ button for another, and Copy to place it on your clipboard.
    </p>

    <h2>Why longer is stronger</h2>
    <p>
      Each extra character multiplies the number of possible passwords. A 16-character
      password drawing from all four character types is astronomically harder to crack
      than an 8-character one — which is why the strength meter rewards length.
    </p>

    <h2>Your privacy</h2>
    <p>
      This tool runs entirely on your device using secure browser randomness. Passwords
      are never sent over the network, logged, or stored. For maximum security, pair
      strong unique passwords with a password manager and two-factor authentication.
    </p>
  </Fragment>
</CalculatorLayout>
