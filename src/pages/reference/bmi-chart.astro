---
import ReferenceLayout from '@layouts/ReferenceLayout.astro';
import { getReference } from '@data/reference';
import { BMI_THRESHOLDS_CONSISTENT } from '@lib/referenceTables';

const ref = getReference('bmi-chart')!;
---

<ReferenceLayout reference={ref}>
  <Fragment slot="intro">
    The weight ranges for each height under the WHO's BMI categories. Find your height, then see the healthy,
    overweight and obese weight bands — in pounds.
  </Fragment>

  <Fragment slot="howto">
    <h2>How to read the chart</h2>
    <p>
      Find your height, then read across. The <strong>healthy</strong> column is the weight range for a BMI of
      18.5–24.9; below it is underweight, and the <strong>overweight</strong> (BMI 25–29.9) and
      <strong>obese</strong> (BMI 30+) columns follow. BMI is a screening tool, not a diagnosis — very muscular
      people can read high despite low body fat.
    </p>
  </Fragment>

  <Fragment slot="notes">
    <h2>Methodology</h2>
    <p>
      BMI is weight in kilograms divided by height in metres squared. Each weight boundary here is that formula
      inverted — the weight at a BMI of 18.5, 25 and 30 for the given height — using the same thresholds this
      site's <a href={`/${ref.relatedCalculator}`}>BMI calculator</a> classifies by{BMI_THRESHOLDS_CONSISTENT ? '' : ' (thresholds under review)'}.
      Weights are rounded to the nearest pound; to convert to kilograms, divide by 2.205. This is general
      information for adults aged 20+, not medical advice.
    </p>
  </Fragment>
</ReferenceLayout>
