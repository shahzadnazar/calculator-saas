---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Icon from '@components/Icon.astro';
import { REFERENCES_ORDERED, referencePath } from '@data/reference';
import { breadcrumbSchema, collectionPageSchema } from '@lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Reference', path: '/reference' },
];
const jsonLd = [
  breadcrumbSchema(crumbs),
  collectionPageSchema({
    name: 'Reference Tables & Charts',
    description: 'Computed reference tables and charts — payment tables, growth tables and a BMI chart.',
    path: '/reference',
    items: REFERENCES_ORDERED.map((r) => ({ name: r.title, path: referencePath(r) })),
  }),
];
---

<BaseLayout
  title="Reference Tables & Charts"
  description="Accurate reference tables and charts — mortgage and loan payment tables, a compound-interest growth table and a BMI chart — computed from tested formulas."
  path="/reference"
  jsonLd={jsonLd}
>
  <div class="wrap py-4">
    <Breadcrumbs crumbs={crumbs} />

    <header class="mt-5 max-w-3xl">
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">Reference tables &amp; charts</h1>
      <p class="mt-3 text-lg" style="color: var(--muted)">
        At-a-glance reference tables you can cite, print or bookmark — each computed from the same tested formulas
        that power our calculators, so the numbers are accurate to the cent.
      </p>
    </header>

    <section class="mt-10">
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
          REFERENCES_ORDERED.map((r) => (
            <li>
              <a href={referencePath(r)} class="card flex h-full flex-col gap-2 p-6 transition-shadow hover:shadow-lg">
                <span class="icon-chip h-11 w-11"><Icon name={r.icon} size={22} /></span>
                <span class="mt-1 text-lg font-bold" style="color: var(--heading)">{r.shortName}</span>
                <span class="text-sm" style="color: var(--muted)">{r.description}</span>
                <span class="mt-auto pt-2 text-sm font-semibold" style="color: var(--color-brand-600)">View the table →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
