---
import CalculatorLayout from '@layouts/CalculatorLayout.astro';
import FractionCalculator from '@components/islands/FractionCalculator.astro';
import { getCalculator } from '@data/calculators';

const calc = getCalculator('math', 'fraction-calculator')!;

const faqs = [
  {
    question: 'How do I add or subtract fractions?',
    answer:
      'Give the fractions a common denominator, then add or subtract the numerators. For example, 1/2 + 1/3 becomes 3/6 + 2/6 = 5/6. This calculator finds the common denominator and simplifies the result automatically.',
  },
  {
    question: 'How do I multiply fractions?',
    answer:
      'Multiply the numerators together and the denominators together, then simplify. For example, 2/3 × 3/4 = 6/12 = 1/2. No common denominator is needed for multiplication.',
  },
  {
    question: 'How do I divide fractions?',
    answer:
      'Flip the second fraction (its reciprocal) and multiply. For example, 3/4 ÷ 2/3 = 3/4 × 3/2 = 9/8, which is 1 1/8 as a mixed number. The calculator reduces the answer to lowest terms.',
  },
  {
    question: 'How do I simplify a fraction?',
    answer:
      'Divide the numerator and denominator by their greatest common divisor (GCD). For 8/12 the GCD is 4, so it simplifies to 2/3. The calculator simplifies every result for you.',
  },
  {
    question: 'How do I convert between fractions and decimals?',
    answer:
      'To turn a fraction into a decimal, divide the numerator by the denominator (3/4 = 0.75). To turn a decimal into a fraction, write it over its place value and simplify (0.75 = 75/100 = 3/4).',
  },
  {
    question: 'What is a mixed number?',
    answer:
      'A mixed number combines a whole number and a fraction, like 3 1/2. When a result is an improper fraction (numerator larger than denominator), the calculator also shows it as a mixed number.',
  },
];
---

<CalculatorLayout
  calculator={calc}
  reviewedOn="2026-07-18"
  intro="Add, subtract, multiply and divide fractions and get the answer as a simplified fraction, a mixed number and a decimal."
  faqs={faqs}
>
  <FractionCalculator />

  <Fragment slot="content">
    <h2>How to use the fraction calculator</h2>
    <p>
      Enter the numerator and denominator of each fraction, choose an operation, and read
      the simplified result along with its mixed-number and decimal forms. Negative
      numerators are supported.
    </p>

    <h2>The rules, briefly</h2>
    <ul>
      <li><strong>Add / subtract:</strong> convert to a common denominator, then combine the numerators.</li>
      <li><strong>Multiply:</strong> numerator × numerator over denominator × denominator.</li>
      <li><strong>Divide:</strong> multiply by the reciprocal (flip the second fraction).</li>
      <li><strong>Simplify:</strong> divide the numerator and denominator by their greatest common divisor.</li>
    </ul>

    <h2>Worked examples</h2>
    <ul>
      <li><strong>Add:</strong> 1/2 + 1/3 → 3/6 + 2/6 = <strong>5/6</strong></li>
      <li><strong>Multiply:</strong> 2/3 × 3/4 = 6/12 = <strong>1/2</strong></li>
      <li><strong>Divide:</strong> 3/4 ÷ 2/3 = 3/4 × 3/2 = 9/8 = <strong>1 1/8</strong></li>
    </ul>

    <h2>Fractions, decimals and percentages</h2>
    <p>
      Every fraction is also a decimal and a percentage: 3/4 = 0.75 = 75%. Divide the top
      by the bottom to get the decimal, then multiply by 100 for the percentage. Working
      the other way or with percentages? Try the
      <a href="/math/percent-calculator">percentage calculator</a>.
    </p>
  </Fragment>
</CalculatorLayout>
