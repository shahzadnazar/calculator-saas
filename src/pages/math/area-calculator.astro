---
import CalculatorLayout from '@layouts/CalculatorLayout.astro';
import AreaCalculator from '@components/islands/AreaCalculator.astro';
import { getCalculator } from '@data/calculators';
const calc = getCalculator('math', 'area-calculator')!;
const faqs = [
  { question: 'How do I calculate the area of a shape?', answer: 'It depends on the shape. A rectangle is length × width; a triangle is ½ × base × height; a circle is π × radius². Choose your shape above and enter its dimensions — the calculator applies the right formula automatically.' },
  { question: 'How do I find the area of a circle?', answer: 'Area = π × r², where r is the radius (half the diameter). For a circle with radius 5, the area is π × 25 ≈ 78.54 square units. If you only know the diameter, halve it first to get the radius.' },
  { question: 'How do I find the area of a triangle?', answer: 'The standard formula is ½ × base × height, where the height is measured perpendicular to the base. A triangle with a base of 6 and height of 4 has an area of ½ × 6 × 4 = 12. If you know the three sides instead, the triangle calculator uses Heron\'s formula.' },
  { question: 'What is the area of a rectangle?', answer: 'Length × width. A room 8 units long and 5 wide is 8 × 5 = 40 square units. A square is the special case where length and width are equal, so its area is side².' },
  { question: 'What units does the area come out in?', answer: 'Enter all measurements in the same unit; the area is in that unit squared. Select a unit label (cm, m, in, ft, yd) to match your measurements.' },
];
---
<CalculatorLayout calculator={calc} presentation="task-first" intro="Calculate the area of a rectangle, square, triangle, circle, trapezoid, parallelogram or ellipse — just pick the shape and enter its dimensions." faqs={faqs} reviewMetadata={{ reviewedDate: '2026-07-25' }}>
  <AreaCalculator />
  <Fragment slot="content">
    <h2>Area formulas, with worked examples</h2>
    <p>Every shape has its own formula, but they all give a result in square units. Here are the ones this calculator handles:</p>
    <table>
      <thead>
        <tr><th>Shape</th><th>Formula</th><th>Example</th></tr>
      </thead>
      <tbody>
        <tr><td>Rectangle</td><td>length × width</td><td>8 × 5 = 40</td></tr>
        <tr><td>Square</td><td>side²</td><td>4² = 16</td></tr>
        <tr><td>Triangle</td><td>½ × base × height</td><td>½ × 6 × 4 = 12</td></tr>
        <tr><td>Circle</td><td>π × radius²</td><td>π × 5² ≈ 78.54</td></tr>
        <tr><td>Trapezoid</td><td>½ × (a + b) × height</td><td>½ × (6 + 4) × 3 = 15</td></tr>
        <tr><td>Parallelogram</td><td>base × height</td><td>6 × 4 = 24</td></tr>
        <tr><td>Ellipse</td><td>π × a × b</td><td>π × 5 × 3 ≈ 47.12</td></tr>
      </tbody>
    </table>

    <h2>Keep your units consistent</h2>
    <p>Area is always in squared units. If you measure in metres, the area is in square metres; in feet, square feet. For a floor or room specifically, the <a href="/everyday/square-footage-calculator">square footage calculator</a> also estimates material cost. For 3D shapes, use the <a href="/math/volume-calculator">volume calculator</a>, and for a triangle from its three sides, the <a href="/math/triangle-calculator">triangle calculator</a> finds the area and every angle.</p>
  </Fragment>
</CalculatorLayout>
