---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Icon from '@components/Icon.astro';
import CalculatorCard from '@components/CalculatorCard.astro';
import CalculatorSearch from '@components/search/CalculatorSearch.astro';
import { SEARCH_INDEX_URL } from '@lib/search';
import {
  CATEGORIES,
  type Category,
  getCalculatorsByCategory,
  calculatorPath,
  categoryPath,
} from '@data/calculators';
import { breadcrumbSchema } from '@lib/schema';

export const getStaticPaths = (() => {
  return CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}) satisfies GetStaticPaths;

interface Props {
  category: Category;
}
const { category } = Astro.props;
const all = getCalculatorsByCategory(category.slug);
const live = all.filter((c) => c.status === 'live');
const planned = all.filter((c) => c.status === 'planned');

const crumbs = [
  { name: 'Home', path: '/' },
  { name: category.shortName, path: categoryPath(category) },
];
---

<BaseLayout
  title={`${category.name} — Free Online Tools`}
  description={category.description}
  path={categoryPath(category)}
  ogImage={`/og/cat-${category.slug}.png`}
  jsonLd={[breadcrumbSchema(crumbs)]}
>
  <div class="wrap py-4">
    <!-- The count rides on the breadcrumb's line: it labels the page rather than
         the calculators, so it belongs with the trail, not in the heading block. -->
    <div class="browse-crumbs">
      <Breadcrumbs crumbs={crumbs} />
      {
        live.length > 0 && (
          <p class="browse-crumbs__count" style="color: var(--muted)">
            <span class="h-2 w-2 rounded-full" style="background: var(--color-accent-500)" />
            {live.length} {live.length === 1 ? 'calculator' : 'calculators'} · free, no sign-up
          </p>
        )
      }
    </div>

    <header class="mt-5">
      <!-- A category page lists a whole set, so the way to a named calculator is a
           search, not a scroll. Same combobox as the header, home page and task
           hubs, over the one index. -->
      <div class="browse-head">
        <div class="browse-head__label">
          <span class="icon-chip h-14 w-14"><Icon name={category.icon} size={28} /></span>
        </div>

        <div class="browse-head__search">
          <CalculatorSearch
            id={`category-search-${category.slug}`}
            indexUrl={SEARCH_INDEX_URL}
            loadStrategy="interaction"
            placeholder="Search all calculators…"
          />
        </div>
      </div>

      <div class="max-w-3xl">
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight sm:text-4xl">{category.name}</h1>
      <p class="mt-3 text-lg" style="color: var(--muted)">{category.description}</p>
      </div>
    </header>

    {
      live.length > 0 && (
        <section class="mt-10">
          <h2 class="sr-only">Available {category.shortName} calculators</h2>
          <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            {live.map((c) => (
              <li>
                <CalculatorCard href={calculatorPath(c)} title={c.title} blurb={c.description} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      planned.length > 0 && (
        <section class="mt-12">
          <h2 class="text-xl font-bold">Coming soon</h2>
          <p class="mt-1 text-sm" style="color: var(--muted)">
            On our roadmap — building each to the same quality bar as the tools above.
          </p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {planned.map((c) => (
              <li
                class="rounded-full border px-3 py-1.5 text-sm"
                style="border-color: var(--line); color: var(--muted); background: var(--card)"
              >
                {c.title}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
