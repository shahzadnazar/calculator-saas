---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { getCategory } from '@data/calculators';
import { SITE } from '@config/site';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.publishDate.getTime() - a.data.publishDate.getTime();
});

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Guides', path: '/guides' },
];
---

<BaseLayout
  title="Guides — Make Sense of the Numbers"
  description={`In-depth, plain-English guides from ${SITE.name} on money, health and math — each paired with the calculators you need to put them into practice.`}
  path="/guides"
>
  <div class="wrap py-8">
    <Breadcrumbs crumbs={crumbs} />

    <header class="mt-5 max-w-3xl">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Guides</h1>
      <p class="mt-3 text-lg" style="color: var(--muted)">
        Clear, practical explainers that go beyond the numbers — each one paired with the
        calculators to put it into practice.
      </p>
    </header>

    {
      guides.length === 0 ? (
        <p class="mt-10" style="color: var(--muted)">New guides are on the way.</p>
      ) : (
        <ul class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
          {guides.map((g) => {
            const cat = getCategory(g.data.category);
            return (
              <li>
                <a href={`/guides/${g.id}`} class="card flex h-full flex-col gap-2 p-6 transition-shadow hover:shadow-lg">
                  <span class="text-sm font-semibold" style="color: var(--color-brand-600)">
                    {cat?.icon} {cat?.shortName}
                  </span>
                  <span class="text-lg font-bold" style="color: var(--heading)">{g.data.title}</span>
                  <span class="text-sm" style="color: var(--muted)">{g.data.description}</span>
                  <span class="mt-auto pt-2 text-xs" style="color: var(--muted)">{fmtDate(g.data.updatedDate ?? g.data.publishDate)}</span>
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</BaseLayout>
