---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import PhysicalCalculator from '@components/calc/PhysicalCalculator.astro';
import { SITE } from '@config/site';
import {
  getCalculator,
  getCategory,
  calculatorPath,
  STATS,
} from '@data/calculators';
import { getPopularCalculatorIds } from '@data/popular-calculators';
import { TASK_GROUPS_ORDERED, taskPath } from '@data/tasks';

// A curated set of flagship tools — a teaser, not the full 49 (that's /calculators).
const popularRefs = [
  'finance/mortgage-calculator',
  'health/bmi-calculator',
  'math/percent-calculator',
  'math/scientific-calculator',
  'finance/loan-calculator',
  'health/calorie-calculator',
  'finance/compound-interest-calculator',
  'everyday/age-calculator',
  'finance/tip-calculator',
];
const featured = popularRefs
  .map((ref) => {
    const [cat, slug] = ref.split('/');
    return getCalculator(cat, slug);
  })
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

// Hero quick-links — the curated popular set (the same list the search empty-state uses).
const popular = getPopularCalculatorIds()
  .map((ref) => {
    const [cat, slug] = ref.split('/');
    return getCalculator(cat, slug);
  })
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

// Surface the flagship pillar guides on the home page (fall back to featured).
const allGuides = await getCollection('guides', ({ data }) => !data.draft);
const featuredGuides = [
  ...allGuides.filter((g) => g.data.pillar),
  ...allGuides.filter((g) => !g.data.pillar && g.data.featured),
]
  .sort((a, b) => Number(b.data.pillar) - Number(a.data.pillar))
  .slice(0, 3);

const valueProps = [
  { icon: 'zap', title: 'Instant & accurate', body: 'Results update as you type, using formulas that are unit-tested for correctness.' },
  { icon: 'shield-check', title: 'Private by design', body: 'Every calculation runs in your browser. Nothing you enter is sent to a server.' },
  { icon: 'badge-check', title: 'Free, no sign-up', body: 'No accounts, no paywalls, no clutter — just the tool you came for.' },
  { icon: 'smartphone', title: 'Works everywhere', body: 'Fast and responsive on phones, tablets and desktops, online or offline once loaded.' },
];
---

<BaseLayout
  title={`${SITE.name} — Free Online Calculators for Finance, Health & Math`}
  description={SITE.description}
  path="/"
>
  <!-- Hero — product-forward (SaaS): a live Basic/Scientific calculator sits beside the headline,
       search and popular links. Mobile order (per the §5 contract): headline → search → popular →
       calculator, so the search comes before the calculator on small screens. -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10 opacity-70"
      style="background: radial-gradient(60rem 30rem at 50% -10%, var(--color-brand-100), transparent 70%)"
      aria-hidden="true"
    >
    </div>
    <div class="wrap py-12 sm:py-16 lg:py-20">
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
        <!-- Left: headline + search + popular quick-links -->
        <div class="text-center lg:text-left">
          <p class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-sm font-medium" style="border-color: var(--line); color: var(--muted); background: var(--card)">
            <span class="h-2 w-2 rounded-full" style="background: var(--color-accent-500)"></span>
            {STATS.live} tools, organised by what you want to do
          </p>
          <h1 class="mt-6 text-4xl font-extrabold tracking-tight sm:text-5xl">
            What do you want to <span style="color: var(--color-brand-600)">work out?</span>
          </h1>
          <p class="mx-auto mt-4 max-w-xl text-lg lg:mx-0" style="color: var(--muted)">
            {SITE.description}
          </p>

          <form action="/calculators" method="get" class="mx-auto mt-7 flex max-w-xl gap-2 lg:mx-0">
            <label class="sr-only" for="hero-search">Search calculators</label>
            <input
              id="hero-search"
              name="q"
              type="search"
              class="field"
              placeholder="Search: mortgage, BMI, scientific, percentage…"
              autocomplete="off"
            />
            <button type="submit" class="btn btn-primary shrink-0">Search</button>
          </form>

          <div class="mt-5 flex flex-wrap items-center justify-center gap-2 lg:justify-start">
            <span class="text-sm font-semibold" style="color: var(--muted)">Popular:</span>
            {
              popular.map((c) => (
                <a
                  href={calculatorPath(c)}
                  class="rounded-full border px-3 py-1 text-sm font-medium transition-shadow hover:shadow-sm"
                  style="border-color: var(--line); color: var(--heading); background: var(--card)"
                >
                  {c.title.replace(/ Calculator$/, '')}
                </a>
              ))
            }
          </div>
        </div>

        <!-- Right: the live calculator — Basic by default, one-tap switch to Scientific -->
        <div class="mx-auto w-full max-w-sm lg:mx-0 lg:ml-auto lg:max-w-md">
          <PhysicalCalculator id="home-calculator" defaultMode="basic" showModeSwitch={true} size="compact" />
          <p class="mt-3 text-center text-xs lg:text-left" style="color: var(--muted)">
            A real calculator, right here — switch to <strong>Scientific</strong> for functions, powers and trig.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tasks — the primary, task-first way in -->
  <section class="wrap pb-4 pt-2">
    <h2 class="sr-only">Browse calculators by task</h2>
    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        TASK_GROUPS_ORDERED.map((group) => (
          <li>
            <a href={taskPath(group)} class="card flex h-full flex-col p-6 transition-shadow hover:shadow-lg">
              <div class="flex items-center gap-3">
                <span class="icon-chip h-11 w-11 shrink-0"><Icon name={group.icon} size={22} /></span>
                <span class="text-lg font-bold" style="color: var(--heading)">{group.title}</span>
              </div>
              <span class="mt-3 font-semibold" style="color: var(--color-brand-600)">{group.question}</span>
              <span class="mt-1 text-sm" style="color: var(--muted)">{group.description}</span>
              <span class="mt-auto pt-3 text-xs font-semibold uppercase tracking-wide" style="color: var(--muted)">{group.members.length} calculators</span>
            </a>
          </li>
        ))
      }
      <li>
        <a href="/calculators" class="card flex h-full flex-col items-start justify-center p-6 transition-shadow hover:shadow-lg" style="border-style: dashed">
          <span class="text-lg font-bold" style="color: var(--heading)">Prefer to browse?</span>
          <span class="mt-1 text-sm" style="color: var(--muted)">See every calculator in one searchable list.</span>
          <span class="mt-3 text-sm font-semibold" style="color: var(--color-brand-600)">All {STATS.live} calculators →</span>
        </a>
      </li>
    </ul>
  </section>

  <!-- Featured -->
  <section class="wrap py-14">
    <div class="flex items-end justify-between">
      <h2 class="text-2xl font-bold">Popular calculators</h2>
      <a href="/calculators" class="text-sm font-semibold hover:underline" style="color: var(--color-brand-600)">View all →</a>
    </div>
    <ul class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        featured.map((c) => (
          <li>
            <a href={calculatorPath(c)} class="card flex h-full flex-col gap-2 p-6 transition-shadow hover:shadow-lg">
              <span class="text-lg font-bold" style="color: var(--heading)">{c.title}</span>
              <span class="text-sm" style="color: var(--muted)">{c.description}</span>
              <span class="mt-auto pt-2 text-sm font-semibold" style="color: var(--color-brand-600)">Open →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Guides -->
  {
    featuredGuides.length > 0 && (
      <section class="wrap pb-4">
        <div class="flex items-end justify-between">
          <h2 class="text-2xl font-bold">From our guides</h2>
          <a href="/guides" class="text-sm font-semibold hover:underline" style="color: var(--color-brand-600)">All guides →</a>
        </div>
        <ul class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {featuredGuides.map((g) => {
            const cat = getCategory(g.data.category);
            return (
              <li>
                <a href={`/guides/${g.id}`} class="card flex h-full flex-col gap-2 p-6 transition-shadow hover:shadow-lg">
                  <span class="inline-flex items-center gap-1.5 text-sm font-semibold" style="color: var(--color-brand-600)">
                    {cat && <Icon name={cat.icon} size={16} />}
                    {cat?.shortName}
                  </span>
                  <span class="text-lg font-bold" style="color: var(--heading)">{g.data.title}</span>
                  <span class="text-sm" style="color: var(--muted)">{g.data.description}</span>
                  <span class="mt-auto pt-2 text-sm font-semibold" style="color: var(--color-brand-600)">Read guide →</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  <!-- Value props -->
  <section class="border-y" style="border-color: var(--line); background: var(--card)">
    <div class="wrap py-14">
      <h2 class="text-center text-2xl font-bold">Why AllCalculators</h2>
      <ul class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          valueProps.map((v) => (
            <li class="text-center sm:text-left">
              <span class="icon-chip mx-auto h-11 w-11 sm:mx-0"><Icon name={v.icon} size={22} /></span>
              <h3 class="mt-3 font-bold" style="color: var(--heading)">{v.title}</h3>
              <p class="mt-1 text-sm" style="color: var(--muted)">{v.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Trust -->
  <section class="wrap py-16">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-2xl font-bold">Tools you can trust</h2>
      <p class="mt-4" style="color: var(--muted)">
        Accuracy is the whole point of a calculator. Every formula on {SITE.name} is
        implemented transparently and backed by an automated test suite, and each tool
        is reviewed against authoritative sources before it goes live. We show our
        working in every calculator's explainer so you can understand — not just trust —
        the result.
      </p>
      <a href="/methodology" class="btn btn-secondary mt-6">How we build our calculators</a>
    </div>
  </section>
</BaseLayout>
