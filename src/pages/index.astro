---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { SITE } from '@config/site';
import {
  CATEGORIES_ORDERED,
  getLiveCalculators,
  getCalculatorsByCategory,
  getCategory,
  calculatorPath,
  categoryPath,
  STATS,
} from '@data/calculators';

const featured = getLiveCalculators();

// Surface the flagship pillar guides on the home page (fall back to featured).
const allGuides = await getCollection('guides', ({ data }) => !data.draft);
const featuredGuides = [
  ...allGuides.filter((g) => g.data.pillar),
  ...allGuides.filter((g) => !g.data.pillar && g.data.featured),
]
  .sort((a, b) => Number(b.data.pillar) - Number(a.data.pillar))
  .slice(0, 3);

const valueProps = [
  { icon: '⚡', title: 'Instant & accurate', body: 'Results update as you type, using formulas that are unit-tested for correctness.' },
  { icon: '🔒', title: 'Private by design', body: 'Every calculation runs in your browser. Nothing you enter is sent to a server.' },
  { icon: '🆓', title: 'Free, no sign-up', body: 'No accounts, no paywalls, no clutter — just the tool you came for.' },
  { icon: '📱', title: 'Works everywhere', body: 'Fast and responsive on phones, tablets and desktops, online or offline once loaded.' },
];
---

<BaseLayout
  title={`${SITE.name} — Free Online Calculators for Finance, Health & Math`}
  description={SITE.description}
  path="/"
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10 opacity-70"
      style="background: radial-gradient(60rem 30rem at 50% -10%, var(--color-brand-100), transparent 70%)"
      aria-hidden="true"
    >
    </div>
    <div class="wrap py-16 text-center sm:py-24">
      <p class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-sm font-medium" style="border-color: var(--line); color: var(--muted); background: var(--card)">
        <span class="h-2 w-2 rounded-full" style="background: var(--color-accent-500)"></span>
        {STATS.live} live tools · {STATS.categories} categories · growing weekly
      </p>
      <h1 class="mx-auto mt-6 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-6xl">
        Every calculator you need, <span style="color: var(--color-brand-600)">in one place.</span>
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg" style="color: var(--muted)">
        {SITE.description}
      </p>

      <form action="/calculators" method="get" class="mx-auto mt-8 flex max-w-xl gap-2">
        <label class="sr-only" for="hero-search">Search calculators</label>
        <input
          id="hero-search"
          name="q"
          type="search"
          class="field"
          placeholder="Search: mortgage, BMI, scientific, percentage…"
          autocomplete="off"
        />
        <button type="submit" class="btn btn-primary shrink-0">Search</button>
      </form>
    </div>
  </section>

  <!-- Featured -->
  <section class="wrap pb-4">
    <div class="flex items-end justify-between">
      <h2 class="text-2xl font-bold">Popular calculators</h2>
      <a href="/calculators" class="text-sm font-semibold hover:underline" style="color: var(--color-brand-600)">View all →</a>
    </div>
    <ul class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        featured.map((c) => (
          <li>
            <a href={calculatorPath(c)} class="card flex h-full flex-col gap-2 p-6 transition-shadow hover:shadow-lg">
              <span class="text-lg font-bold" style="color: var(--heading)">{c.title}</span>
              <span class="text-sm" style="color: var(--muted)">{c.description}</span>
              <span class="mt-auto pt-2 text-sm font-semibold" style="color: var(--color-brand-600)">Open →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Categories -->
  <section class="wrap py-14">
    <h2 class="text-2xl font-bold">Browse by category</h2>
    <ul class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        CATEGORIES_ORDERED.map((cat) => {
          const count = getCalculatorsByCategory(cat.slug).length;
          return (
            <li>
              <a href={categoryPath(cat)} class="card flex h-full flex-col gap-2 p-6 transition-shadow hover:shadow-lg">
                <span class="text-3xl" aria-hidden="true">{cat.icon}</span>
                <span class="text-lg font-bold" style="color: var(--heading)">{cat.name}</span>
                <span class="text-sm" style="color: var(--muted)">{cat.description}</span>
                <span class="mt-auto pt-2 text-xs font-semibold uppercase tracking-wide" style="color: var(--color-brand-600)">{count} tools</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <!-- Guides -->
  {
    featuredGuides.length > 0 && (
      <section class="wrap pb-4">
        <div class="flex items-end justify-between">
          <h2 class="text-2xl font-bold">From our guides</h2>
          <a href="/guides" class="text-sm font-semibold hover:underline" style="color: var(--color-brand-600)">All guides →</a>
        </div>
        <ul class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {featuredGuides.map((g) => {
            const cat = getCategory(g.data.category);
            return (
              <li>
                <a href={`/guides/${g.id}`} class="card flex h-full flex-col gap-2 p-6 transition-shadow hover:shadow-lg">
                  <span class="text-sm font-semibold" style="color: var(--color-brand-600)">
                    {cat?.icon} {cat?.shortName}
                  </span>
                  <span class="text-lg font-bold" style="color: var(--heading)">{g.data.title}</span>
                  <span class="text-sm" style="color: var(--muted)">{g.data.description}</span>
                  <span class="mt-auto pt-2 text-sm font-semibold" style="color: var(--color-brand-600)">Read guide →</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  <!-- Value props -->
  <section class="border-y" style="border-color: var(--line); background: var(--card)">
    <div class="wrap py-14">
      <h2 class="text-center text-2xl font-bold">Why AllCalculators</h2>
      <ul class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          valueProps.map((v) => (
            <li class="text-center sm:text-left">
              <div class="text-3xl" aria-hidden="true">{v.icon}</div>
              <h3 class="mt-3 font-bold" style="color: var(--heading)">{v.title}</h3>
              <p class="mt-1 text-sm" style="color: var(--muted)">{v.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Trust -->
  <section class="wrap py-16">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-2xl font-bold">Tools you can trust</h2>
      <p class="mt-4" style="color: var(--muted)">
        Accuracy is the whole point of a calculator. Every formula on {SITE.name} is
        implemented transparently and backed by an automated test suite, and each tool
        is reviewed against authoritative sources before it goes live. We show our
        working in every calculator's explainer so you can understand — not just trust —
        the result.
      </p>
      <a href="/methodology" class="btn btn-secondary mt-6">How we build our calculators</a>
    </div>
  </section>
</BaseLayout>
