---
/**
 * INTERNAL DEV DEMO — monetization-region architecture (R5) validation.
 * noindex + nofollow, excluded from the sitemap, no public links to it.
 * MUST be deleted before production launch (CI prelaunch-no-dev guard enforces).
 *
 * This page exercises the MonetizationRegion orchestrator + policy resolvers
 * with PLACEHOLDERS ONLY. No live page, no real ad/affiliate/analytics/consent
 * provider, no network request. It uses its OWN demo config to showcase states;
 * the production `MONETIZATION_CONFIG` keeps every placement off.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import MonetizationRegion from '@components/monetization/MonetizationRegion.astro';
import { MONETIZATION_CSS } from '@lib/monetization/styles';
import type { MonetizationConfig, ConsentState } from '@lib/monetization/policy';

// Demo-only config: enabled, with each placement mapped to a module kind so all
// seven modules can be shown. Production config (src/config/monetization.ts)
// stays fully disabled.
const DEMO_CONFIG: MonetizationConfig = {
  enabled: true,
  placements: {
    'calculator-post-result': { enabled: true, module: 'affiliate', reserveSpace: false, requiresConsent: 'none' },
    'calculator-sidebar': { enabled: true, module: 'ad', reserveSpace: true, retainReservationOnNoFill: true, lazy: true, requiresConsent: 'advertising' },
    'calculator-in-content': { enabled: true, module: 'ad', reserveSpace: true, retainReservationOnNoFill: true, lazy: true, requiresConsent: 'advertising' },
    'related-tools': { enabled: true, module: 'embed', reserveSpace: false, requiresConsent: 'none' },
    'home-after-dashboard': { enabled: true, module: 'sponsored', reserveSpace: false, requiresConsent: 'none' },
    'category-between-groups': { enabled: true, module: 'lead', reserveSpace: false, requiresConsent: 'leadGeneration' },
    'guide-in-content': { enabled: true, module: 'api', reserveSpace: false, requiresConsent: 'none' },
    footer: { enabled: true, module: 'premium', reserveSpace: false, requiresConsent: 'none' },
  },
};

const ADS_OK: ConsentState = { advertising: true, analytics: false, personalization: false, leadGeneration: false };
const LEADS_OK: ConsentState = { advertising: false, analytics: false, personalization: false, leadGeneration: true };
const DENIED: ConsentState = { advertising: false, analytics: false, personalization: false, leadGeneration: false };
---

<BaseLayout
  title="Monetization Regions — Dev Demo"
  description="Internal component demo (noindex)."
  path="/dev/monetization"
  noindex={true}
>
  {/* Region + module + workspace styles, normally emitted by CalculatorLayout only
      when a placement is active. This demo renders regions directly, so it emits
      the same shared CSS itself. */}
  <style is:inline set:html={MONETIZATION_CSS} />
  <div class="wrap py-4">
    <p class="text-sm" style="color: var(--muted)">
      Internal demo route — noindex, excluded from sitemap, removed before launch.
      Placeholders only: no live page, no real ad / affiliate / analytics / consent
      provider, and no network request. Production placements are all disabled.
    </p>
    <h1 class="mt-2 text-2xl font-bold">Monetization regions — architecture demo</h1>

    <!-- ============================================================ -->
    <!-- SLOT STATES                                                  -->
    <!-- ============================================================ -->
    <h2 class="mon-h2">Slot states (ad placement)</h2>
    <div class="mon-grid">
      <div class="mon-cell" data-demo="state-disabled">
        <p class="mon-cap">disabled → renders nothing</p>
        <MonetizationRegion placement="calculator-in-content" config={DEMO_CONFIG} consent={ADS_OK} demonstrationState="disabled" />
        <p class="mon-empty">(no region in the DOM)</p>
      </div>
      <div class="mon-cell" data-demo="state-reserved">
        <p class="mon-cap">reserved (dimensions held)</p>
        <MonetizationRegion placement="calculator-in-content" config={DEMO_CONFIG} consent={ADS_OK} demonstrationState="reserved" />
      </div>
      <div class="mon-cell" data-demo="state-loading">
        <p class="mon-cap">loading (stable, restrained)</p>
        <MonetizationRegion placement="calculator-in-content" config={DEMO_CONFIG} consent={ADS_OK} demonstrationState="loading" />
      </div>
      <div class="mon-cell" data-demo="state-filled">
        <p class="mon-cap">filled (+ disclosure)</p>
        <MonetizationRegion placement="calculator-in-content" config={DEMO_CONFIG} consent={ADS_OK} demonstrationState="filled" />
      </div>
      <div class="mon-cell" data-demo="state-nofill-seen">
        <p class="mon-cap">no-fill, visible → reservation retained</p>
        <MonetizationRegion placement="calculator-in-content" config={DEMO_CONFIG} consent={ADS_OK} demonstrationState="no-fill" seen={true} />
      </div>
      <div class="mon-cell" data-demo="state-nofill-unseen">
        <p class="mon-cap">no-fill, not yet seen → collapses</p>
        <MonetizationRegion placement="calculator-in-content" config={DEMO_CONFIG} consent={ADS_OK} demonstrationState="no-fill" seen={false} />
        <p class="mon-empty">(collapsed — no region in the DOM)</p>
      </div>
      <div class="mon-cell" data-demo="state-failed">
        <p class="mon-cap">failed → reservation retained (visible)</p>
        <MonetizationRegion placement="calculator-in-content" config={DEMO_CONFIG} consent={ADS_OK} demonstrationState="failed" seen={true} />
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- MODULE KINDS (filled placeholders)                           -->
    <!-- ============================================================ -->
    <h2 class="mon-h2">Revenue modules (distinct per kind)</h2>
    <div class="mon-grid">
      <div class="mon-cell" data-demo="module-ad">
        <p class="mon-cap">ad</p>
        <MonetizationRegion placement="calculator-in-content" config={DEMO_CONFIG} consent={ADS_OK} demonstrationState="filled" />
      </div>
      <div class="mon-cell" data-demo="module-affiliate">
        <p class="mon-cap">affiliate</p>
        <MonetizationRegion placement="calculator-post-result" config={DEMO_CONFIG} resultState="valid" demonstrationState="filled" />
      </div>
      <div class="mon-cell" data-demo="module-sponsored">
        <p class="mon-cap">sponsored</p>
        <MonetizationRegion placement="home-after-dashboard" config={DEMO_CONFIG} demonstrationState="filled" />
      </div>
      <div class="mon-cell" data-demo="module-premium">
        <p class="mon-cap">premium</p>
        <MonetizationRegion placement="footer" config={DEMO_CONFIG} demonstrationState="filled" />
      </div>
      <div class="mon-cell" data-demo="module-embed">
        <p class="mon-cap">embed</p>
        <MonetizationRegion placement="related-tools" config={DEMO_CONFIG} demonstrationState="filled" />
      </div>
      <div class="mon-cell" data-demo="module-api">
        <p class="mon-cap">api</p>
        <MonetizationRegion placement="guide-in-content" config={DEMO_CONFIG} demonstrationState="filled" />
      </div>
      <div class="mon-cell" data-demo="module-lead">
        <p class="mon-cap">lead (needs leadGeneration consent)</p>
        <MonetizationRegion placement="category-between-groups" config={DEMO_CONFIG} consent={LEADS_OK} demonstrationState="filled" />
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- RESULT-STATE GATING (post-result, resolver-driven)           -->
    <!-- ============================================================ -->
    <h2 class="mon-h2">Result-state gating (calculator-post-result)</h2>
    <p class="mon-sub">Renders only for a fresh valid result; blocked for empty / example / invalid / stale.</p>
    <div class="mon-grid">
      <div class="mon-cell" data-demo="gate-valid">
        <p class="mon-cap">valid → eligible</p>
        <MonetizationRegion placement="calculator-post-result" config={DEMO_CONFIG} resultState="valid" />
      </div>
      <div class="mon-cell" data-demo="gate-stale">
        <p class="mon-cap">valid but stale → blocked</p>
        <MonetizationRegion placement="calculator-post-result" config={DEMO_CONFIG} resultState="valid" resultIsStale={true} />
        <p class="mon-empty">(no region)</p>
      </div>
      <div class="mon-cell" data-demo="gate-invalid">
        <p class="mon-cap">invalid → blocked</p>
        <MonetizationRegion placement="calculator-post-result" config={DEMO_CONFIG} resultState="invalid" />
        <p class="mon-empty">(no region)</p>
      </div>
      <div class="mon-cell" data-demo="gate-empty">
        <p class="mon-cap">empty → blocked</p>
        <MonetizationRegion placement="calculator-post-result" config={DEMO_CONFIG} resultState="empty" />
        <p class="mon-empty">(no region)</p>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- CONSENT SIMULATION                                           -->
    <!-- ============================================================ -->
    <h2 class="mon-h2">Consent (default denied; placeholders only)</h2>
    <div class="mon-grid">
      <div class="mon-cell" data-demo="consent-denied">
        <p class="mon-cap">lead + consent denied → blocked</p>
        <MonetizationRegion placement="category-between-groups" config={DEMO_CONFIG} consent={DENIED} demonstrationState="filled" />
        <p class="mon-empty">(no region)</p>
      </div>
      <div class="mon-cell" data-demo="consent-granted">
        <p class="mon-cap">lead + leadGeneration consent → placeholder</p>
        <MonetizationRegion placement="category-between-groups" config={DEMO_CONFIG} consent={LEADS_OK} demonstrationState="filled" />
      </div>
      <div class="mon-cell" data-demo="consent-ad-denied">
        <p class="mon-cap">ad + no advertising consent → blocked</p>
        <MonetizationRegion placement="calculator-in-content" config={DEMO_CONFIG} consent={DENIED} />
        <p class="mon-empty">(no region)</p>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- SIDEBAR ELIGIBILITY (container-query)                         -->
    <!-- ============================================================ -->
    <h2 class="mon-h2">Sidebar eligibility (container-based, opt-in)</h2>
    <p class="mon-sub">
      The sidebar appears only when the workspace container is wide enough to keep the
      full core calculator (~1040px workspace, ~600px core). Resize to see it activate.
    </p>
    <div class="mon-cell" data-demo="sidebar-eligible">
      <p class="mon-cap">Wide workspace → sidebar eligible</p>
      <div class="mon-elig mon-elig--wide">
        <div class="mon-elig-core">Core calculator workspace (placeholder)</div>
        <div class="mon-elig-side">
          <MonetizationRegion placement="calculator-sidebar" config={DEMO_CONFIG} consent={ADS_OK} allowSidebar={true} demonstrationState="reserved" />
        </div>
      </div>
    </div>
    <div class="mon-cell mt-4" data-demo="sidebar-ineligible">
      <p class="mon-cap">Narrow workspace → sidebar hidden (core never compressed)</p>
      <div class="mon-elig mon-elig--narrow">
        <div class="mon-elig-core">Core calculator workspace (placeholder)</div>
        <div class="mon-elig-side">
          <MonetizationRegion placement="calculator-sidebar" config={DEMO_CONFIG} consent={ADS_OK} allowSidebar={true} demonstrationState="reserved" />
        </div>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- LAYOUT INTEGRATION — RESULT-STATE BRIDGE (R6)                -->
    <!-- ============================================================ -->
    <h2 class="mon-h2">Layout integration — result-state bridge (R6)</h2>
    <p class="mon-sub">
      In CalculatorLayout the post-result region is a hidden sibling of the result (never
      inside it). The client bridge observes the shared result shells and reveals it ONLY
      for a fresh valid result — hiding it again on empty / invalid / stale / calculating.
      These are mock result shells (no calculator logic runs); the region is a placeholder.
    </p>

    <p class="mon-sub">
      The bridge is rooted at this calculator's <code>[data-calculator-workspace]</code>
      and queries result shells ONLY inside it — an unrelated result shell elsewhere on
      the page can never make this region eligible.
    </p>

    <div class="mon-cell" data-demo="bridge-single" data-bridge-demo>
      <p class="mon-cap">Single result (BMI / password style) + an unrelated external result</p>
      <div class="mon-bridge-controls">
        <button type="button" class="btn btn-secondary" data-act="valid" data-target="0">Valid result</button>
        <button type="button" class="btn btn-secondary" data-act="stale" data-target="0">Mark stale</button>
        <button type="button" class="btn btn-secondary" data-act="calc" data-target="0">Recalculating</button>
        <button type="button" class="btn btn-secondary" data-act="invalid" data-target="0">Invalid</button>
        <button type="button" class="btn btn-secondary" data-act="empty" data-target="0">Reset</button>
      </div>
      <div class="mon-bridge-controls" data-demo="bridge-external-controls">
        <button type="button" class="btn btn-secondary" data-scope="ext" data-act="valid" data-target="0">External → valid</button>
        <button type="button" class="btn btn-secondary" data-scope="ext" data-act="empty" data-target="0">External → reset</button>
      </div>
      <div data-calculator-workspace>
        <section data-result-shell data-result-state="empty" data-result-activity="idle" class="mon-mock-shell" aria-label="Mock result shell">
          Workspace result — state: <strong data-mock-state>empty</strong>
        </section>
      </div>
      <section data-result-shell data-external-shell data-result-state="empty" data-result-activity="idle" class="mon-mock-shell mon-mock-shell--external" aria-label="Unrelated external result">
        Unrelated external result (outside the workspace) — <strong data-mock-state>empty</strong>
      </section>
      <MonetizationRegion placement="calculator-post-result" resultGate="client" config={DEMO_CONFIG} />
    </div>

    <div class="mon-cell mt-4" data-demo="bridge-percent" data-bridge-demo>
      <p class="mon-cap">Three independent equations (percentage) → ONE region; any single fresh valid result qualifies</p>
      <div class="mon-bridge-controls">
        <button type="button" class="btn btn-secondary" data-act="valid" data-target="0">Eq 1 valid</button>
        <button type="button" class="btn btn-secondary" data-act="empty" data-target="0">Eq 1 reset</button>
        <button type="button" class="btn btn-secondary" data-act="valid" data-target="1">Eq 2 valid</button>
        <button type="button" class="btn btn-secondary" data-act="empty" data-target="1">Eq 2 reset</button>
        <button type="button" class="btn btn-secondary" data-act="valid" data-target="2">Eq 3 valid</button>
        <button type="button" class="btn btn-secondary" data-act="empty" data-target="2">Eq 3 reset</button>
      </div>
      <div data-calculator-workspace>
        <section data-result-shell data-result-state="empty" data-result-activity="idle" class="mon-mock-shell" aria-label="Mock equation 1">Equation 1 — <strong data-mock-state>empty</strong></section>
        <section data-result-shell data-result-state="empty" data-result-activity="idle" class="mon-mock-shell" aria-label="Mock equation 2">Equation 2 — <strong data-mock-state>empty</strong></section>
        <section data-result-shell data-result-state="empty" data-result-activity="idle" class="mon-mock-shell" aria-label="Mock equation 3">Equation 3 — <strong data-mock-state>empty</strong></section>
      </div>
      <MonetizationRegion placement="calculator-post-result" resultGate="client" config={DEMO_CONFIG} />
    </div>

    <p class="mt-10 text-sm" style="color: var(--muted)">
      Toggle the header theme switch for light / dark. Narrow the viewport to confirm the
      demo never overflows and the sidebar column drops below the core. Every module is a
      placeholder — no provider, script, tracker or network request is present.
    </p>
  </div>
</BaseLayout>

<script>
  // Bridge demo: the SAME eligibility predicate CalculatorLayout's inline bridge
  // uses (imported from @lib/monetization/result-bridge), wired to mock shells so
  // the reveal/hide behaviour is exercised in a real browser. No calculator logic.
  import { shellEligible } from '@lib/monetization/result-bridge';

  document.querySelectorAll<HTMLElement>('[data-bridge-demo]').forEach((root) => {
    // Scope EXACTLY like CalculatorLayout's inline bridge: query result shells only
    // inside this instance's [data-calculator-workspace] root, never document-wide.
    const workspace = root.querySelector<HTMLElement>('[data-calculator-workspace]');
    if (!workspace) return;
    const shells = Array.from(workspace.querySelectorAll<HTMLElement>('[data-result-shell]'));
    const externalShells = Array.from(root.querySelectorAll<HTMLElement>('[data-external-shell]'));
    const gates = Array.from(root.querySelectorAll<HTMLElement>('[data-mon-client-gated]'));
    if (!shells.length || !gates.length) return;

    const reflect = (shell: HTMLElement) => {
      const label = shell.querySelector<HTMLElement>('[data-mock-state]');
      if (label) label.textContent = shell.dataset.stale === 'true' ? 'valid (stale)' : (shell.dataset.resultState ?? '');
    };

    // Eligibility considers ONLY the workspace shells — external shells are ignored.
    const sync = () => {
      const eligible = shells.some((el) =>
        shellEligible({
          state: el.getAttribute('data-result-state'),
          activity: el.getAttribute('data-result-activity'),
          stale: el.getAttribute('data-stale') === 'true',
        }),
      );
      gates.forEach((g) => {
        g.hidden = !eligible;
        g.setAttribute('data-mon-eligible', String(eligible));
      });
    };

    // Observe both workspace AND external shells so a mutation to EITHER re-runs
    // sync — proving that an external change still leaves eligibility unaffected.
    const obs = new MutationObserver(() => {
      [...shells, ...externalShells].forEach(reflect);
      sync();
    });
    [...shells, ...externalShells].forEach((s) =>
      obs.observe(s, { attributes: true, attributeFilter: ['data-result-state', 'data-result-activity', 'data-stale'] }),
    );

    root.querySelectorAll<HTMLButtonElement>('[data-act]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const list = btn.dataset.scope === 'ext' ? externalShells : shells;
        const shell = list[Number(btn.dataset.target ?? '0')];
        if (!shell) return;
        switch (btn.dataset.act) {
          case 'valid':
            shell.dataset.resultState = 'valid';
            shell.dataset.resultActivity = 'just-updated';
            shell.dataset.stale = 'false';
            break;
          case 'empty':
            shell.dataset.resultState = 'empty';
            shell.dataset.resultActivity = 'idle';
            shell.dataset.stale = 'false';
            break;
          case 'invalid':
            shell.dataset.resultState = 'invalid';
            shell.dataset.resultActivity = 'idle';
            shell.dataset.stale = 'false';
            break;
          case 'stale':
            shell.dataset.resultState = 'valid';
            shell.dataset.resultActivity = 'idle';
            shell.dataset.stale = 'true';
            break;
          case 'calc':
            shell.dataset.resultState = 'valid';
            shell.dataset.resultActivity = 'calculating';
            shell.dataset.stale = 'false';
            break;
        }
      });
    });

    [...shells, ...externalShells].forEach(reflect);
    sync();
  });
</script>

<style>
  .mon-h2 {
    margin-top: 2.25rem;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .mon-sub {
    margin-top: 0.25rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .mon-grid {
    margin-top: 0.75rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  }
  .mon-cell {
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    padding: 0.8rem;
    background: var(--card);
  }
  .mon-cap {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--muted);
    margin: 0 0 0.6rem;
  }
  .mon-empty {
    margin: 0.5rem 0 0;
    font-size: 0.7rem;
    font-style: italic;
    color: var(--muted);
  }
  /* Sidebar eligibility demo: a container query decides whether the side column
     shows. Named `.mon-elig*` to stay distinct from the real layout's
     `.mon-workspace` (shipped via MONETIZATION_CSS). */
  .mon-elig {
    margin-top: 0.5rem;
    container-type: inline-size;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  /* Constrain the narrow workspace's CONTAINER width so its container query
     never reaches the sidebar threshold. */
  .mon-elig--narrow {
    max-width: 720px;
  }
  .mon-elig-core {
    min-height: 120px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .mon-elig-side {
    display: none;
  }
  /* Only when the container is wide enough do we add the ~300px sidebar and keep
     the core ≥ 600px — mirrors sidebarFitsContainer() in the policy. */
  @container (min-width: 1040px) {
    .mon-elig {
      grid-template-columns: minmax(600px, 1fr) 300px;
    }
    .mon-elig-side {
      display: block;
    }
  }
  /* Result-state bridge demo */
  .mon-bridge-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }
  .mon-bridge-controls .btn {
    padding: 0.3rem 0.6rem;
    font-size: 0.8rem;
  }
  .mon-mock-shell {
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    padding: 0.7rem 0.85rem;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.6rem;
  }
  .mon-mock-shell[data-result-state='valid'] {
    border-color: var(--color-brand-500);
    color: var(--heading);
  }
  .mon-mock-shell[data-result-state='invalid'] {
    border-color: #e11d48;
  }
  .mon-mock-shell--external {
    border-style: dashed;
    opacity: 0.85;
  }
</style>
