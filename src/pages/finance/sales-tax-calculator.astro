---
import CalculatorLayout from '@layouts/CalculatorLayout.astro';
import SalesTaxCalculator from '@components/islands/SalesTaxCalculator.astro';
import { getCalculator } from '@data/calculators';

const calc = getCalculator('finance', 'sales-tax-calculator')!;

const faqs = [
  {
    question: 'How do I calculate sales tax?',
    answer:
      'Multiply the pre-tax price by the tax rate (as a decimal) to get the tax amount, then add it to the price for the total. For example, $100 at 7.25% is $7.25 tax and $107.25 total.',
  },
  {
    question: 'What is sales tax?',
    answer:
      'Sales tax is a percentage added at the point of sale, collected by the seller and passed to the government. In the US it is set by state and local jurisdictions (there is no national sales tax), so the combined rate depends on where the sale happens.',
  },
  {
    question: 'How do I find the price before tax from a total?',
    answer:
      'Divide the tax-inclusive total by (1 + rate). For a $107.25 total at 7.25%, the pre-tax price is 107.25 ÷ 1.0725 = $100. Use the "Remove tax" mode above to do this automatically.',
  },
  {
    question: 'Which states have no sales tax?',
    answer:
      'Five states have no statewide sales tax — New Hampshire, Oregon, Montana, Alaska and Delaware (the "NOMAD" states). Alaska has no state sales tax but allows local ones, so some Alaskan cities still charge it.',
  },
  {
    question: 'Are all purchases taxed?',
    answer:
      'No. Many states exempt or reduce tax on necessities such as groceries and prescription medicine, and rules vary widely by jurisdiction. Enter the rate that actually applies to your item and location.',
  },
  {
    question: 'What sales tax rate should I use?',
    answer:
      'Use the combined state-plus-local rate that applies where the purchase is made. Rates range from 0% to over 10% once local taxes are included, so the correct figure depends on the exact city or county.',
  },
];
---

<CalculatorLayout
  calculator={calc}
  presentation="task-first"
  intro="Add sales tax to a price, or work backwards to find the pre-tax amount and tax included in a total. Enter any tax rate."
  faqs={faqs}
  reviewMetadata={{ reviewedDate: '2026-07-18' }}
>
  <SalesTaxCalculator />

  <Fragment slot="content">
    <h2>How to use this calculator</h2>
    <ol>
      <li>Choose a mode: <strong>Add tax</strong> to go from a pre-tax price to a total, or <strong>Remove tax</strong> to pull the pre-tax price out of a tax-inclusive total.</li>
      <li>Enter the <strong>amount</strong> — the pre-tax price when adding, or the receipt total when removing.</li>
      <li>Enter the <strong>sales-tax rate</strong> as a percentage (the combined state-plus-local rate where the sale happens).</li>
      <li>Press <strong>Calculate</strong> to see the tax, the pre-tax amount and the total — all three, whichever mode you are in.</li>
    </ol>

    <h2>Adding vs. removing tax</h2>
    <p>
      The two modes run the calculation in opposite directions. Use <strong>Add tax</strong> when
      you know the shelf price and want the checkout total. Use <strong>Remove tax</strong> when a
      receipt shows a single tax-inclusive figure and you need to split out how much of it was tax
      — the everyday case for expense reports, VAT-style bookkeeping and reclaiming tax on
      business purchases.
    </p>

    <h2>The formulas</h2>
    <p>Adding tax is a straight markup on the pre-tax price:</p>
    <ul>
      <li><strong>Tax</strong> = price × (rate ÷ 100)</li>
      <li><strong>Total</strong> = price + tax</li>
    </ul>
    <p>Removing tax is the reverse — you cannot just subtract the rate, because the tax was charged on the smaller pre-tax figure, not the total:</p>
    <ul>
      <li><strong>Pre-tax price</strong> = total ÷ (1 + rate ÷ 100)</li>
      <li><strong>Tax included</strong> = total − pre-tax price</li>
    </ul>

    <h2>A worked example</h2>
    <p>
      A $100 item at a 7.25% rate has $100 × 0.0725 = <strong>$7.25</strong> in tax, for a
      <strong>$107.25</strong> total. Working backwards from a $107.25 receipt: $107.25 ÷ 1.0725 =
      <strong>$100</strong> before tax, so $7.25 was tax. Note why subtracting 7.25% of $107.25
      gives the wrong answer — that would be $7.78, because the rate applies to the $100 base, not
      the tax-inclusive total.
    </p>

    <h2>States with no sales tax</h2>
    <p>
      Five states levy no statewide sales tax — <strong>New Hampshire, Oregon, Montana, Alaska and
      Delaware</strong> (remembered as "NOMAD"). Alaska is the asterisk: it has no state rate but
      lets cities and boroughs add their own, so a purchase there may still be taxed locally.
      Everywhere else, the combined state-and-local rate applies.
    </p>

    <h2>Choosing the right rate</h2>
    <p>
      There is no national U.S. sales tax; the rate is set by state, county and city, so the figure
      that applies is the <strong>combined</strong> rate at the point of sale. Once local taxes are
      added, rates range from 0% to over 10%, and many states exempt or reduce tax on necessities
      such as groceries and prescription medicine. Enter the rate that actually applies to your item
      and location rather than a statewide headline number.
    </p>

    <h2>What this tool does not do</h2>
    <ul>
      <li><strong>It does not know your local rate.</strong> You supply the percentage; look up the correct combined rate for the exact address.</li>
      <li><strong>It does not handle item-level exemptions.</strong> If part of a cart is taxable and part is exempt, calculate each portion separately.</li>
      <li><strong>It assumes a single flat rate</strong> — not tiered or category-specific rates that a few jurisdictions apply.</li>
    </ul>
    <p>
      Rates and exemptions differ by jurisdiction; confirm the correct combined rate for your
      location. To split a tip on a taxed restaurant bill, see the
      <a href="/finance/tip-calculator">tip calculator</a>. This tool is for estimation only and is
      not tax advice.
    </p>
  </Fragment>
</CalculatorLayout>
