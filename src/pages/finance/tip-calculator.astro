---
import CalculatorLayout from '@layouts/CalculatorLayout.astro';
import TipCalculator from '@components/islands/TipCalculator.astro';
import { getCalculator } from '@data/calculators';
const calc = getCalculator('finance', 'tip-calculator')!;
const faqs = [
  { question: 'How do I calculate a tip?', answer: 'Multiply the bill by the tip percentage as a decimal. For a $50 bill at 20%, that is 50 × 0.20 = $10, for a $60 total. A quick mental shortcut for 20% is to take 10% (move the decimal one place: $5) and double it.' },
  { question: 'How much should I tip?', answer: 'In the United States, 15–20% of the pre-tax bill is standard for sit-down restaurant service, with 18–20% for good service. Tip 10% or less for minimal service, and more for exceptional service. Norms differ by country and service type.' },
  { question: 'How much should I tip movers, a hairdresser or an Uber driver?', answer: 'Common US guidance: movers about $20–40 per person for a day\'s work (or 5–10% of the bill split among the crew), hairdressers and barbers 15–20%, massage therapists 15–20%, and rideshare or taxi drivers 10–20% with a small minimum. See the table below for more.' },
  { question: 'Do I tip on the total with tax, or before tax?', answer: 'Etiquette says to tip on the pre-tax amount, though many people tip on the total for simplicity. Enter whichever figure you prefer as the bill.' },
  { question: 'How do I split a bill with a tip?', answer: 'Enter the number of people and the calculator divides the total (bill plus tip) evenly, showing the amount and the tip each person owes. A $60 total split four ways is $15 each.' },
];
---
<CalculatorLayout calculator={calc} presentation="task-first" intro="Calculate the tip and total on any bill and split it evenly between friends. Tap a preset percentage or enter your own." faqs={faqs} reviewMetadata={{ reviewedDate: '2026-07-23' }}>
  <TipCalculator />
  <Fragment slot="content">
    <h2>How to calculate a tip</h2>
    <p>Multiply the bill by the tip rate: a <strong>$50</strong> bill at <strong>20%</strong> is 50 × 0.20 = <strong>$10</strong>, for a $60 total. Splitting four ways, that is $15 each. The fastest mental trick for 20% is to find 10% (just move the decimal one place — $5) and double it; for 15%, take that 10% and add half of it again.</p>

    <h2>How much to tip, by service</h2>
    <table>
      <thead>
        <tr><th>Service</th><th>Typical US tip</th></tr>
      </thead>
      <tbody>
        <tr><td>Restaurant (table service)</td><td>15–20% pre-tax</td></tr>
        <tr><td>Food delivery</td><td>15–20% (min. $3–5)</td></tr>
        <tr><td>Rideshare / taxi</td><td>10–20%</td></tr>
        <tr><td>Hairdresser / barber</td><td>15–20%</td></tr>
        <tr><td>Massage therapist</td><td>15–20%</td></tr>
        <tr><td>Movers</td><td>$20–40 per mover / day</td></tr>
        <tr><td>Bartender</td><td>$1–2 per drink</td></tr>
        <tr><td>Hotel housekeeping</td><td>$2–5 per night</td></tr>
      </tbody>
    </table>

    <h2>Tipping around the world</h2>
    <p>Customs vary widely by country — in much of Europe and Asia a service charge is often already included and tipping is minimal or rounded up rather than a set percentage. When travelling, check local norms so you neither under- nor over-tip. To add or remove sales tax from a price, see the <a href="/finance/sales-tax-calculator">sales tax calculator</a>.</p>
  </Fragment>
</CalculatorLayout>
