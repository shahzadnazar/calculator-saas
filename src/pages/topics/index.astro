---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Icon from '@components/Icon.astro';
import { CLUSTERS_ORDERED, clusterPath } from '@data/clusters';
import { breadcrumbSchema, collectionPageSchema } from '@lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Topics', path: '/topics' },
];

const jsonLd = [
  breadcrumbSchema(crumbs),
  collectionPageSchema({
    name: 'Calculator Topics',
    description: 'Curated collections of related calculators, each with a guide to choosing the right tool.',
    path: '/topics',
    items: CLUSTERS_ORDERED.map((c) => ({ name: c.title, path: clusterPath(c) })),
  }),
];
---

<BaseLayout
  title="Calculator Topics — Curated Collections"
  description="Browse calculators by topic — loans, saving and investing, body and diet, time and date, and geometry — each with a guide to choosing the right tool."
  path="/topics"
  jsonLd={jsonLd}
>
  <div class="wrap py-4">
    <Breadcrumbs crumbs={crumbs} />

    <header class="mt-5 max-w-3xl">
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">Browse by topic</h1>
      <p class="mt-3 text-lg" style="color: var(--muted)">
        Related calculators, grouped into topic collections. Each hub explains how the tools fit together
        and which one to reach for.
      </p>
    </header>

    <section class="mt-10">
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
          CLUSTERS_ORDERED.map((cluster) => (
            <li>
              <a href={clusterPath(cluster)} class="card flex h-full flex-col gap-2 p-6 transition-shadow hover:shadow-lg">
                <span class="icon-chip h-11 w-11"><Icon name={cluster.icon} size={22} /></span>
                <span class="mt-1 text-lg font-bold" style="color: var(--heading)">{cluster.title}</span>
                <span class="text-sm" style="color: var(--muted)">{cluster.description}</span>
                <span class="mt-auto pt-2 text-sm font-semibold" style="color: var(--color-brand-600)">
                  {cluster.members.length} calculators →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
