---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Icon from '@components/Icon.astro';
import CalculatorCard from '@components/CalculatorCard.astro';
import { TASK_GROUPS, type TaskGroup, taskPath } from '@data/tasks';
import { getCalculator, calculatorPath } from '@data/calculators';
import { getCluster, clusterPath } from '@data/clusters';
import { getReferencesForCalculatorRefs, referencePath } from '@data/reference';
import { breadcrumbSchema, collectionPageSchema } from '@lib/schema';

export const getStaticPaths = (() => {
  return TASK_GROUPS.map((group) => ({
    params: { slug: group.slug },
    props: { group },
  }));
}) satisfies GetStaticPaths;

interface Props {
  group: TaskGroup;
}
const { group } = Astro.props;
const path = taskPath(group);

// Resolve a "category/slug" ref to a live calculator + its task-framed note.
const resolve = (ref: string, use: string) => {
  const [cat, slug] = ref.split('/');
  const calc = getCalculator(cat, slug);
  return calc && calc.status === 'live' ? { calc, use } : null;
};
type Resolved = NonNullable<ReturnType<typeof resolve>>;

const useByRef = new Map(group.members.map((m) => [m.ref, m.use]));
const members = group.members
  .map((m) => resolve(m.ref, m.use))
  .filter((x): x is Resolved => x !== null);

// When the hub defines sections, render grouped; otherwise a single flat grid.
const sections = group.sections
  ? group.sections.map((s) => ({
      title: s.title,
      items: s.refs
        .map((ref) => resolve(ref, useByRef.get(ref) ?? ''))
        .filter((x): x is Resolved => x !== null),
    }))
  : null;

// Guides + reference tables + topic pillars related to this task.
const allGuides = await getCollection('guides', ({ data }) => !data.draft);
const guides = group.guides
  .map((id) => allGuides.find((g) => g.id === id))
  .filter((g): g is NonNullable<typeof g> => Boolean(g));
const references = getReferencesForCalculatorRefs(group.members.map((m) => m.ref));
const pillars = (group.pillars ?? []).map((s) => getCluster(s)).filter((c): c is NonNullable<typeof c> => Boolean(c));

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Tasks', path: '/tasks' },
  { name: group.shortName, path },
];

const jsonLd = [
  breadcrumbSchema(crumbs),
  collectionPageSchema({
    name: group.title,
    description: group.description,
    path,
    items: [
      ...members.map((m) => ({ name: m.calc.title, path: calculatorPath(m.calc) })),
      ...references.map((r) => ({ name: r.title, path: referencePath(r) })),
    ],
  }),
];
---

<BaseLayout title={`${group.title} Calculators`} description={group.description} path={path} ogImage={`/og/task-${group.slug}.png`} jsonLd={jsonLd}>
  <div class="wrap py-4">
    <Breadcrumbs crumbs={crumbs} />

    <header class="mt-2 max-w-3xl">
   <div class="flex w-fit flex-row gap-3 items-center">
  <span class="icon-chip h-10 w-10">
    <Icon name={group.icon} size={24} />
  </span>

  <p
    class="mt-0 text-sm font-semibold uppercase tracking-wide"
    style="color: var(--color-brand-600)"
  >
    {group.title}
  </p>
</div>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight sm:text-4xl">{group.question}</h1>
      <p class="mt-3 text-lg" style="color: var(--muted)">{group.intro}</p>
    </header>

    {
      sections ? (
        <div class="mt-4 space-y-5">
          {sections.map((section) => (
            <section aria-label={section.title}>
              <h2 class="text-sm font-bold uppercase tracking-wide" style="color: var(--muted)">{section.title}</h2>
              <ul class="mt-4 grid grid-cols-1 gap-5 sm:grid-cols-2">
                {section.items.map((m) => (
                  <li>
                    <CalculatorCard href={calculatorPath(m.calc)} title={m.calc.title} blurb={m.use} />
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      ) : (
        <section class="mt-10" aria-label={`${group.title} calculators`}>
          <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            {members.map((m) => (
              <li>
                <CalculatorCard href={calculatorPath(m.calc)} title={m.calc.title} blurb={m.use} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      references.length > 0 && (
        <section class="mt-7" aria-labelledby="reference-heading">
          <h2 id="reference-heading" class="text-2xl font-bold">Reference tables</h2>
          <p class="mt-1 text-sm" style="color: var(--muted)">
            At-a-glance tables you can cite, print or embed — computed from the same formulas as the calculators.
          </p>
          <ul class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {references.map((r) => (
              <li>
                <a href={referencePath(r)} class="card flex h-full flex-col gap-1 p-5 transition-shadow hover:shadow-lg">
                  <span class="flex items-center gap-2 text-lg font-bold" style="color: var(--heading)">
                    <span class="icon-chip h-8 w-8"><Icon name={r.icon} size={18} /></span>
                    {r.shortName}
                  </span>
                  <span class="text-sm" style="color: var(--muted)">{r.description}</span>
                  <span class="mt-auto pt-2 text-sm font-semibold" style="color: var(--color-brand-600)">View the table →</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      guides.length > 0 && (
        <section class="mt-7 max-w-3xl" aria-labelledby="guides-heading">
          <h2 id="guides-heading" class="text-2xl font-bold">Guides on this topic</h2>
          <ul class="mt-3 space-y-3">
            {guides.map((g) => (
              <li>
                <a href={`/guides/${g.id}`} class="card flex items-center justify-between gap-4 p-3 transition-shadow hover:shadow-lg">
                  <span>
                    <span class="font-semibold" style="color: var(--heading)">{g.data.title}</span>
                    <span class="mt-0.5 block text-sm" style="color: var(--muted)">{g.data.description}</span>
                  </span>
                  <span aria-hidden="true" style="color: var(--color-brand-600)">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      pillars.length > 0 && (
        <section class="mt-14 max-w-3xl" aria-labelledby="pillar-heading">
          <h2 id="pillar-heading" class="text-2xl font-bold">Go deeper</h2>
          <ul class="mt-5 space-y-3">
            {pillars.map((c) => (
              <li>
                <a href={clusterPath(c)} class="card flex items-center justify-between gap-4 p-4 transition-shadow hover:shadow-lg">
                  <span>
                    <span class="font-semibold" style="color: var(--heading)">{c.title}</span>
                    <span class="mt-0.5 block text-sm" style="color: var(--muted)">{c.description}</span>
                  </span>
                  <span aria-hidden="true" style="color: var(--color-brand-600)">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
