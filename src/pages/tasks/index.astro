---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Icon from '@components/Icon.astro';
import { TASK_GROUPS_ORDERED, taskPath } from '@data/tasks';
import { breadcrumbSchema, collectionPageSchema } from '@lib/schema';
import { SITE } from '@config/site';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Tasks', path: '/tasks' },
];

const jsonLd = [
  breadcrumbSchema(crumbs),
  collectionPageSchema({
    name: 'Calculators by task',
    description: 'Every calculator organised by what you want to work out.',
    path: '/tasks',
    items: TASK_GROUPS_ORDERED.map((t) => ({ name: t.title, path: taskPath(t) })),
  }),
];
---

<BaseLayout
  title="What do you want to work out? — Calculators by Task"
  description={`Find the right calculator by what you're trying to do — borrow and repay, save and invest, income and tax, health and fitness, dates and time, measuring, and everyday math. ${SITE.name}.`}
  path="/tasks"
  jsonLd={jsonLd}
>
  <div class="wrap py-8">
    <Breadcrumbs crumbs={crumbs} />

    <header class="mt-5 max-w-3xl">
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">What do you want to work out?</h1>
      <p class="mt-3 text-lg" style="color: var(--muted)">
        Start from the job you're trying to get done. Every calculator on the site lives under one of
        these seven tasks — pick the one that matches your question.
      </p>
    </header>

    <section class="mt-10">
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          TASK_GROUPS_ORDERED.map((group) => (
            <li>
              <a href={taskPath(group)} class="card flex h-full flex-col p-6 transition-shadow hover:shadow-lg">
                <span class="icon-chip h-11 w-11"><Icon name={group.icon} size={22} /></span>
                <span class="mt-3 text-lg font-bold" style="color: var(--heading)">{group.title}</span>
                <span class="mt-1 text-sm font-medium" style="color: var(--color-brand-600)">{group.question}</span>
                <span class="mt-2 text-sm" style="color: var(--muted)">{group.description}</span>
                <span class="mt-auto pt-3 text-sm font-semibold" style="color: var(--color-brand-600)">
                  {group.members.length} calculators →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
