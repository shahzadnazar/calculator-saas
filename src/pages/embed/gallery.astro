---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { EMBEDDABLE } from '@config/monetization';
import { CATEGORIES_ORDERED, getCalculatorsByCategory, calculatorPath } from '@data/calculators';
import { REFERENCES_ORDERED, referencePath } from '@data/reference';
import { buildEmbedSnippet, type EmbedTarget } from '@lib/embed';
import { breadcrumbSchema, collectionPageSchema } from '@lib/schema';

interface GalleryItem extends EmbedTarget {
  description: string;
}
interface GalleryGroup {
  title: string;
  items: GalleryItem[];
}

const calcGroups: GalleryGroup[] = CATEGORIES_ORDERED.map((cat) => ({
  title: `${cat.icon} ${cat.name}`,
  items: getCalculatorsByCategory(cat.slug)
    .filter((c) => c.status === 'live')
    .map((c) => ({
      title: c.title,
      description: c.description,
      slug: c.slug,
      embedPath: `/embed/${c.category}/${c.slug}`,
      canonicalPath: calculatorPath(c),
    })),
}));

const refGroup: GalleryGroup = {
  title: '📊 Reference tables',
  items: REFERENCES_ORDERED.map((r) => ({
    title: r.shortName,
    description: r.description,
    slug: r.slug,
    embedPath: `/embed/reference/${r.slug}`,
    canonicalPath: referencePath(r),
  })),
};

const groups: GalleryGroup[] = [...calcGroups, refGroup];
const total = groups.reduce((n, g) => n + g.items.length, 0);
const allItems = groups.flatMap((g) => g.items);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Embed calculators', path: '/embed' },
  { name: 'Gallery', path: '/embed/gallery' },
];
const jsonLd = [
  breadcrumbSchema(crumbs),
  collectionPageSchema({
    name: 'Embed Gallery',
    description: 'Every calculator and reference table you can embed for free.',
    path: '/embed/gallery',
    items: allItems.map((i) => ({ name: i.title, path: i.canonicalPath })),
  }),
];
---

<BaseLayout
  title="Embed Gallery — Every Free Calculator & Table to Embed"
  description="Browse all of our free, embeddable calculators and reference tables. Copy the code for any of them in one click, or preview the embed first."
  path="/embed/gallery"
  jsonLd={jsonLd}
>
  <div class="wrap py-8">
    <Breadcrumbs crumbs={crumbs} />

    <header class="mt-5 max-w-3xl">
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">Embed gallery</h1>
      <p class="mt-3 text-lg" style="color: var(--muted)">
        All {total} calculators and reference tables you can add to your site — free. Copy the code for any one in
        a click, or preview the embed first. Just keep the attribution link.
      </p>
      <p class="mt-3 text-sm">
        <a href="/embed" class="font-semibold hover:underline" style="color: var(--color-brand-600)">← How embedding works</a>
      </p>
    </header>

    {
      !EMBEDDABLE.enabled && (
        <p class="mt-8 max-w-3xl rounded-lg border p-4 text-sm" style="border-color: var(--line); color: var(--muted)">
          Embedding is being finalised and will be available shortly.
        </p>
      )
    }

    {
      groups.map((group) => (
        <section class="mt-12">
          <h2 class="text-xl font-bold" style="color: var(--heading)">{group.title}</h2>
          <ul class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {group.items.map((item) => (
              <li class="card flex h-full flex-col p-5" data-embed-card>
                <span class="font-bold" style="color: var(--heading)">{item.title}</span>
                <span class="mt-1 text-sm" style="color: var(--muted)">{item.description}</span>
                <div class="mt-4 flex flex-wrap items-center gap-2">
                  <button type="button" class="btn btn-primary text-sm" data-gallery-copy>Copy embed code</button>
                  <a href={item.embedPath} target="_blank" rel="noopener" class="text-sm font-semibold hover:underline" style="color: var(--color-brand-600)">
                    Preview ↗
                  </a>
                </div>
                <textarea class="sr-only" tabindex="-1" aria-hidden="true" readonly data-gallery-code>{buildEmbedSnippet(item)}</textarea>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-gallery-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const card = btn.closest('[data-embed-card]');
      const ta = card?.querySelector<HTMLTextAreaElement>('[data-gallery-code]');
      if (!ta) return;
      const reset = () => setTimeout(() => (btn.textContent = 'Copy embed code'), 1500);
      try {
        await navigator.clipboard.writeText(ta.value);
        btn.textContent = 'Copied!';
        reset();
      } catch {
        ta.classList.remove('sr-only');
        ta.select();
        btn.textContent = 'Press Ctrl+C';
        reset();
      }
    });
  });
</script>
