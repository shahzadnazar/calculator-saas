---
import type { GetStaticPaths } from 'astro';
import EmbedLayout from '@layouts/EmbedLayout.astro';
import IslandBySlug from '@components/IslandBySlug.astro';
import { getLiveCalculators, calculatorPath } from '@data/calculators';

export const getStaticPaths = (() => {
  return getLiveCalculators().map((calc) => ({
    params: { category: calc.category, slug: calc.slug },
    props: { calc },
  }));
}) satisfies GetStaticPaths;

interface Props {
  calc: ReturnType<typeof getLiveCalculators>[number];
}
const { calc } = Astro.props;
---

<EmbedLayout title={calc.title} canonicalPath={calculatorPath(calc)} slug={calc.slug}>
  <IslandBySlug slug={calc.slug} />
</EmbedLayout>
