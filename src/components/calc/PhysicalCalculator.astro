---
/**
 * PhysicalCalculator — composes the control row, display, an optional Scientific
 * function panel, and the SHARED Basic keypad over one engine.
 *
 * The Basic keypad renders in BOTH modes and never moves; Scientific mode only
 * reveals the function panel above it. One stable control row: mode switch left,
 * Deg/Rad right (reserved space in Basic so nothing shifts). `size` trims the
 * compact (homepage) variant without shrinking tap targets.
 */
import CalculatorDisplay from './CalculatorDisplay.astro';
import BasicKeypad from './BasicKeypad.astro';
import ScientificFunctions from './ScientificFunctions.astro';
import ModeSwitch from './ModeSwitch.astro';
import '@styles/calc.css';

interface Props {
  id?: string;
  defaultMode?: 'basic' | 'scientific';
  showModeSwitch?: boolean;
  size?: 'compact' | 'full';
}
const { id = 'calc', defaultMode = 'basic', showModeSwitch = true, size = 'full' } = Astro.props;
const sci = defaultMode === 'scientific';
---

<section class="calc-shell" data-physical-calculator data-default-mode={defaultMode} data-size={size} id={id} aria-label="Calculator">
  <div class="calc-top">
    {showModeSwitch ? <ModeSwitch default={defaultMode} /> : <span></span>}
    <div class:list={['seg', 'calc-angle', { 'is-hidden': !sci }]} role="radiogroup" aria-label="Angle mode" data-angle-switch>
      <button type="button" class="seg-btn is-active" role="radio" aria-checked="true" data-angle="deg">Deg</button>
      <button type="button" class="seg-btn" role="radio" aria-checked="false" data-angle="rad">Rad</button>
    </div>
  </div>

  <CalculatorDisplay id={id} />

  <div class="calc-keypads">
    <div class="sci-panel " data-sci-panel hidden={!sci}>
      <ScientificFunctions />
    </div>
    <BasicKeypad />
  </div>
</section>

<script>
  import './physical-calculator.client';
</script>
