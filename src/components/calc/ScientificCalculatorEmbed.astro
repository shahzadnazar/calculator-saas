---
/**
 * ScientificCalculatorEmbed — the Scientific configuration of PhysicalCalculator
 * for NON-dedicated-page contexts: the generated /embed page (R7D1) and the
 * "How to use a scientific calculator" guide.
 *
 * The dedicated live page (src/pages/math/scientific-calculator.astro) already
 * renders PhysicalCalculator directly with the same configuration. This thin
 * adapter keeps the remaining two consumers on that single implementation so the
 * legacy islands/ScientificCalculator.astro can be retired — leaving one
 * Scientific Calculator UI in the repository.
 */
import PhysicalCalculator from '@components/calc/PhysicalCalculator.astro';

interface Props {
  /** Unique per instance; defaults to the same id the live page uses. */
  id?: string;
}
const { id = 'scientific-calculator' } = Astro.props;
---

<PhysicalCalculator id={id} defaultMode="scientific" showModeSwitch={false} size="full" />
