---
/**
 * Scientific keypad — superset layout from the shared key catalog. Same
 * `data-act` contract as the Basic keypad, so the controller is layout-agnostic.
 * Deg/Rad lives in the wrapper; backspace lives beside the display.
 */
import { SCIENTIFIC_KEYS } from '@lib/calc/keys';
---

<div class="keypad keypad--scientific" role="group" aria-label="Scientific calculator keypad">
  {
    SCIENTIFIC_KEYS.map((k) => (
      <button
        type="button"
        class={`calc-key calc-key--${k.kind}`}
        data-act={JSON.stringify(k.act)}
        aria-label={k.aria}
      >
        <span set:html={k.label} />
      </button>
    ))
  }
</div>
