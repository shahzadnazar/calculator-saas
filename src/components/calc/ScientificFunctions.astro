---
/**
 * Scientific FUNCTION panel — five columns of evaluator-supported functions,
 * rendered ABOVE the shared Basic keypad in Scientific mode. Same `data-act`
 * contract as the keypad, so the controller stays layout-agnostic.
 */
import { SCI_FUNCTION_KEYS } from '@lib/calc/keys';
---

<div class="keypad keypad--sci-fn" role="group" aria-label="Scientific functions">
  {
    SCI_FUNCTION_KEYS.map((k) => (
      <button type="button" class={`calc-key calc-key--${k.kind}`} data-act={JSON.stringify(k.act)} aria-label={k.aria}>
        <span set:html={k.label} />
      </button>
    ))
  }
</div>
