---
/**
 * Hours calculator island — the reference's TWO independent calculators, stacked.
 *
 * They are two separate tools, not one behind a switch: each has its own form, its own primary
 * action and its own result, so the answer to one stays on screen while the other is used.
 *
 *   1. HOURS CALCULATOR — between two clock times on the same (or the next) day.
 *   2. HOURS BETWEEN TWO DATES — between two full date-and-time instants, so a span of several
 *      days is measured rather than guessed.
 *
 * The first cannot span more than a day and has to treat an earlier end time as the next morning;
 * the second asks which day each time is on and needs no such guess. That is why the reference
 * offers both, and why folding them together would lose something.
 *
 * Both run on the UNCHANGED standard-form runtime, one mount per root, with their own bindings in
 * @lib/calculators/hours-form wrapping the reviewed pure engine. Every field starts EMPTY; the
 * visitor presses that calculator's own button for its first result, then live-after-first. Each
 * guard lives in its binding's `resultValue`; neither uses `isUsableResult`.
 *
 * Static ids are namespaced per-instance WHEN more than one Hours page shares a document (the
 * R16B2.1 discipline), so an embed gallery has no duplicate ids.
 */
import ResultShell from '@components/result/ResultShell.astro';
import ResultValue from '@components/result/ResultValue.astro';
import ResultInterpretation from '@components/result/ResultInterpretation.astro';
import ResultBreakdown from '@components/result/ResultBreakdown.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';
---

<div class="hourspage mx-auto w-full max-w-4xl" data-hourspage>
  <!-- ============================================================ -->
  <!-- 1. Hours Calculator                                           -->
  <!-- ============================================================ -->
  <section class="hp-calc" data-hours aria-labelledby="hr-heading">
    <h2 class="hp-title" id="hr-heading">Hours Calculator</h2>
    <p class="hp-lede">The hours and minutes between two times.</p>

    <div class="grid gap-6 md:grid-cols-2 md:items-start">
      <form class="card p-4" data-form novalidate aria-label="Hours calculator">
        <div class="hr-rows">
          <div class="hr-row" data-field="start">
            <label class="field-label hr-row__label" for="hr-start">Start Time:</label>
            <div class="hr-row__control">
              <input class="field hr-time" id="hr-start" name="start" type="time" autocomplete="off" aria-describedby="hr-start-error" />
              <button type="button" class="hr-now" data-hr-now="start">Now</button>
            </div>
          </div>
          <p class="hr-field-error" id="hr-start-error" data-error-for="start" hidden></p>

          <div class="hr-row" data-field="end">
            <label class="field-label hr-row__label" for="hr-end">End Time:</label>
            <div class="hr-row__control">
              <input class="field hr-time" id="hr-end" name="end" type="time" autocomplete="off" aria-describedby="hr-end-error" />
              <button type="button" class="hr-now" data-hr-now="end">Now</button>
            </div>
          </div>
          <p class="hr-field-error" id="hr-end-error" data-error-for="end" hidden></p>

          <button type="button" class="hr-swap" data-hr-swap aria-label="Swap the start and end times">
            <span aria-hidden="true">⇅</span> Swap
          </button>
        </div>

        <!-- Beyond the reference: this site has no separate time-card calculator, so the break
             stays here as an optional deduction rather than being dropped. -->
        <div class="hr-extra" data-field="breakMin">
          <label class="field-label" for="hr-break">Break (minutes, optional)</label>
          <input class="field mt-1" id="hr-break" name="breakMin" type="number" min="0" step="any" inputmode="decimal" autocomplete="off" placeholder="e.g. 30" aria-describedby="hr-break-error" />
          <p class="hr-field-error" id="hr-break-error" data-error-for="breakMin" hidden></p>
        </div>

        <p class="hr-note">An end time earlier than the start counts as the next day. For a span over more than one day, use the calculator below.</p>

        <div class="mt-5 flex items-center gap-3">
          <button type="submit" class="btn btn-primary">Calculate Hours</button>
          <button type="button" class="btn btn-secondary" data-reset>Clear</button>
        </div>
        <p class="hr-live-note" data-live-note hidden>Changes update automatically.</p>
      </form>

      <ResultShell id="hr-result" state="empty" density="standard" label="Hours result" minHeight="16rem" placeholderAlignment="center">
        <ExampleNotice />
        <EmptyResult message="Enter a start time and an end time, then calculate the hours between them." />

        <div data-result-when="valid">
          <p class="hp-lead" data-hr-lead></p>
          <p class="hp-figure" data-hr-hours-line data-result-value>—</p>
          <p class="hp-figure hp-figure--second" data-hr-minutes-line>—</p>

          <ResultInterpretation>
            <span data-hr-interpretation></span>
          </ResultInterpretation>

          <ResultBreakdown title="For payroll">
            <dl class="hr-metrics">
              <div><dt>Decimal hours</dt><dd data-hr-decimal>—</dd></div>
            </dl>
          </ResultBreakdown>
        </div>

        <InvalidResult
          title="Check your entries"
          message="Enter a valid start and end time, and a break of zero or more minutes, to calculate."
        />

        <ResultAnnouncement id="hr-live" />
      </ResultShell>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 2. Hours Between Two Dates                                    -->
  <!-- ============================================================ -->
  <section class="hp-calc" data-hoursdates aria-labelledby="hd-heading">
    <h2 class="hp-title" id="hd-heading">Hours Between Two Dates</h2>
    <p class="hp-lede">Give each time a date, and the span can run over several days.</p>

    <div class="grid gap-6 md:grid-cols-2 md:items-start">
      <form class="card p-4" data-form novalidate aria-label="Hours between two dates">
        <fieldset class="hd-group">
          <legend class="field-label">Start Time:</legend>
          <div class="hd-pair">
            <div data-field="startDate">
              <input class="field" id="hd-start-date" name="startDate" type="date" autocomplete="off" aria-label="Start date" aria-describedby="hd-startDate-error" />
            </div>
            <div class="hr-row__control" data-field="startTime">
              <input class="field hr-time" id="hd-start-time" name="startTime" type="time" autocomplete="off" aria-label="Start time" aria-describedby="hd-startTime-error" />
              <button type="button" class="hr-now" data-hd-now="start">Now</button>
            </div>
          </div>
          <p class="hr-field-error" id="hd-startDate-error" data-error-for="startDate" hidden></p>
          <p class="hr-field-error" id="hd-startTime-error" data-error-for="startTime" hidden></p>
        </fieldset>

        <fieldset class="hd-group mt-3">
          <legend class="field-label">End Time:</legend>
          <div class="hd-pair">
            <div data-field="endDate">
              <input class="field" id="hd-end-date" name="endDate" type="date" autocomplete="off" aria-label="End date" aria-describedby="hd-endDate-error" />
            </div>
            <div class="hr-row__control" data-field="endTime">
              <input class="field hr-time" id="hd-end-time" name="endTime" type="time" autocomplete="off" aria-label="End time" aria-describedby="hd-endTime-error" />
              <button type="button" class="hr-now" data-hd-now="end">Now</button>
            </div>
          </div>
          <p class="hr-field-error" id="hd-endDate-error" data-error-for="endDate" hidden></p>
          <p class="hr-field-error" id="hd-endTime-error" data-error-for="endTime" hidden></p>
        </fieldset>

        <div class="mt-5 flex items-center gap-3">
          <button type="submit" class="btn btn-primary">Calculate Hours Between Dates</button>
          <button type="button" class="btn btn-secondary" data-reset>Clear</button>
        </div>
        <p class="hr-live-note" data-live-note hidden>Changes update automatically.</p>
      </form>

      <ResultShell id="hd-result" state="empty" density="standard" label="Hours between two dates result" minHeight="16rem" placeholderAlignment="center">
        <ExampleNotice />
        <EmptyResult message="Enter a start date and time and an end date and time to see the span between them." />

        <div data-result-when="valid">
          <p class="hp-lead" data-hd-lead></p>
          <p class="hp-figure" data-hd-hours-line data-result-value>—</p>
          <p class="hp-figure hp-figure--second" data-hd-minutes-line>—</p>

          <ResultBreakdown title="In other units">
            <dl class="hr-metrics">
              <div><dt>Days, hours, minutes</dt><dd data-hd-days>—</dd></div>
              <div><dt>Decimal hours</dt><dd data-hd-decimal>—</dd></div>
            </dl>
          </ResultBreakdown>

          <ResultInterpretation>
            <span data-hd-interpretation></span>
          </ResultInterpretation>
        </div>

        <InvalidResult title="Check your entries" message="Enter a valid date and time for both the start and the end." />

        <ResultAnnouncement id="hd-live" />
      </ResultShell>
    </div>
  </section>
</div>

<style>
  .hp-calc + .hp-calc {
    margin-top: 2.25rem;
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }
  .hp-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--heading);
  }
  .hp-lede {
    margin: 0.15rem 0 0.75rem;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--muted);
  }

  /* The reference reads "The time between 8:30 AM and 5:30 PM is:" then two plain figures. */
  .hp-lead {
    margin: 0 0 0.4rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--fg);
    text-wrap: balance;
  }
  .hp-figure {
    margin: 0;
    font-size: 1.75rem;
    line-height: 1.25;
    font-weight: 800;
    color: var(--heading);
    font-variant-numeric: tabular-nums;
  }
  .hp-figure--second {
    margin-top: 0.15rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--muted);
  }

  .hr-rows {
    display: grid;
    gap: 0.15rem;
  }
  .hr-row {
    display: grid;
    grid-template-columns: minmax(0, 7rem) minmax(0, 1fr);
    align-items: center;
    gap: 0.5rem;
    padding: 0.15rem 0;
  }
  .hr-row__label {
    margin: 0;
  }
  .hr-row__control {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .hr-time {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 2.75rem;
    font-variant-numeric: tabular-nums;
  }
  /* "Now" is a shortcut, not an action of its own — a link-weight control beside the field. */
  .hr-now {
    flex: none;
    padding: 0 0.35rem;
    min-height: 2.75rem;
    background: none;
    border: 0;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-brand-700);
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }
  :root[data-theme='dark'] .hr-now { color: var(--color-brand-200); }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .hr-now { color: var(--color-brand-200); }
  }
  .hr-swap {
    justify-self: start;
    margin-top: 0.1rem;
    padding: 0 0.35rem;
    min-height: 2.75rem;
    background: none;
    border: 0;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--muted);
    cursor: pointer;
  }
  .hr-swap:hover { color: var(--fg); }

  .hd-group {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .hd-pair {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }
  .hd-pair .field {
    min-height: 2.75rem;
  }

  .hr-extra {
    margin-top: 0.75rem;
    border-top: 1px solid var(--line);
    padding-top: 0.75rem;
  }

  .hr-field-error {
    margin: 0.3rem 0 0;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.3;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .hr-field-error { color: #fca5a5; }
  }
  :root[data-theme='dark'] .hr-field-error { color: #fca5a5; }

  .hr-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .hr-live-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .hr-metrics {
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }
  .hr-metrics > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .hr-metrics dt {
    color: var(--fg);
    font-weight: 600;
  }
  .hr-metrics dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--heading);
    font-weight: 700;
    text-align: right;
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import {
    hoursBinding,
    HOURS_EXAMPLE_VALUES,
    hoursDatesBinding,
    hoursDatesExampleValues,
  } from '@lib/calculators/hours-form';

  /** The visitor's own clock, as the two field formats need it. */
  const nowTime = (): string => {
    const d = new Date();
    return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
  };
  const nowDate = (): string => {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  };
  /** Setting a value in code fires nothing, so tell the runtime the field changed. */
  const setField = (el: HTMLInputElement | null, value: string) => {
    if (!el) return;
    el.value = value;
    el.dispatchEvent(new Event('input', { bubbles: true }));
    el.dispatchEvent(new Event('change', { bubbles: true }));
  };

  function uniquifyStaticIds(root: HTMLElement, suffix: string): void {
    const remap = new Map<string, string>();
    root.querySelectorAll<HTMLElement>('[id]').forEach((el) => {
      const next = `${el.id}-${suffix}`;
      remap.set(el.id, next);
      el.id = next;
    });
    const repoint = (attr: string) =>
      root.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((el) => {
        const next = el
          .getAttribute(attr)!
          .split(/\s+/)
          .map((token) => remap.get(token) ?? token)
          .join(' ');
        el.setAttribute(attr, next);
      });
    repoint('for');
    repoint('aria-describedby');
    repoint('aria-labelledby');
    repoint('aria-controls');
  }

  const pages = document.querySelectorAll<HTMLElement>('[data-hourspage]');
  pages.forEach((page, i) => {
    if (pages.length > 1) uniquifyStaticIds(page, `h${i + 1}`);

    /* ---- 1. Hours Calculator ---- */
    const hours = page.querySelector<HTMLElement>('[data-hours]');
    if (hours) {
      mountFormCalculator(hours, hoursBinding, {
        recalculationMode: 'live-after-first',
        example: { values: HOURS_EXAMPLE_VALUES },
        calculateButtonLabel: 'Calculate Hours',
      });

      hours.querySelectorAll<HTMLButtonElement>('[data-hr-now]').forEach((btn) => {
        btn.addEventListener('click', () => {
          setField(hours.querySelector<HTMLInputElement>(`[name="${btn.dataset.hrNow}"]`), nowTime());
        });
      });

      // Swapping is one edit, not two: read both first, then write, or the second write would
      // read a value the first had already replaced.
      hours.querySelector<HTMLButtonElement>('[data-hr-swap]')?.addEventListener('click', () => {
        const start = hours.querySelector<HTMLInputElement>('[name="start"]');
        const end = hours.querySelector<HTMLInputElement>('[name="end"]');
        const a = start?.value ?? '';
        const b = end?.value ?? '';
        setField(start, b);
        setField(end, a);
      });
    }

    /* ---- 2. Hours Between Two Dates ---- */
    const dates = page.querySelector<HTMLElement>('[data-hoursdates]');
    if (dates) {
      mountFormCalculator(dates, hoursDatesBinding, {
        recalculationMode: 'live-after-first',
        example: { values: hoursDatesExampleValues() },
        calculateButtonLabel: 'Calculate Hours Between Dates',
      });

      // "Now" here means this instant: the date as well as the time, since a time without its
      // date is exactly what this calculator exists to avoid.
      dates.querySelectorAll<HTMLButtonElement>('[data-hd-now]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const which = btn.dataset.hdNow === 'end' ? 'end' : 'start';
          setField(dates.querySelector<HTMLInputElement>(`[name="${which}Date"]`), nowDate());
          setField(dates.querySelector<HTMLInputElement>(`[name="${which}Time"]`), nowTime());
        });
      });
    }
  });
</script>
