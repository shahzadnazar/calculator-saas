---
/**
 * Amortization calculator island (R11B1 + R11B1.1 hardening).
 *
 * Task-first, direct-intent: all fields start EMPTY, the result is an instruction, and the visitor
 * presses "Calculate Amortization" for the first result; live-after-first afterwards. Compute,
 * validation, state, announcement and focus are owned by the shared runtime + the amortization
 * binding (@lib/calculators/amortization-form), which wraps the UNCHANGED calculateLoan / @lib/finance
 * engine. The complete-result guard lives in the binding's resultValue (a NaN sentinel → the runtime's
 * default finite gate) — there is NO isUsableResult.
 *
 * The schedule is a native <details> DISCLOSURE, closed by default: the dominant monthly payment +
 * totals show first, and the visitor opens "View amortization schedule" on demand. Inside, the FULL
 * schedule renders every row (yearly summary + monthly breakdown, no pagination / virtualization),
 * built with the DOM API (never innerHTML), into a semantic <table> (caption + scoped headers). The
 * Yearly (default) / Monthly view is NATIVE RADIO inputs the ISLAND owns — a presentation switch over
 * the already-rendered rows that never recomputes and never announces. The island also reacts to
 * runtime state changes it does not itself cause: leaving `valid` (an invalid live edit) drops the
 * stale/possibly-malformed rows; returning to `empty` (Reset) also closes the disclosure and restores
 * the Yearly default.
 */
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
---

<div class="amort mx-auto grid w-full max-w-5xl gap-4 lg:grid-cols-2" data-amort>
  <!-- Inputs -->
  <form class="card p-4" data-form novalidate aria-label="Amortization calculator">
    <div class="grid gap-4 sm:grid-cols-3">
      <div data-field="amount">
        <label class="field-label" for="am-amount">Loan amount</label>
        <div class="flex">
          <span class="field-affix rounded-l-lg border-r-0">$</span>
          <input class="field rounded-l-none" id="am-amount" name="amount" type="number" min="0" step="1000" inputmode="decimal" autocomplete="off" placeholder="e.g. 250000" aria-describedby="am-amount-error" />
        </div>
        <p class="am-field-error" id="am-amount-error" data-error-for="amount" hidden></p>
      </div>

      <div data-field="annualInterestRate">
        <label class="field-label" for="am-rate">Interest rate</label>
        <div class="flex">
          <input class="field rounded-r-none" id="am-rate" name="annualInterestRate" type="number" min="0" step="0.05" inputmode="decimal" autocomplete="off" placeholder="e.g. 6.5" aria-describedby="am-rate-error" />
          <span class="field-affix rounded-r-lg border-l-0">%</span>
        </div>
        <p class="am-field-error" id="am-rate-error" data-error-for="annualInterestRate" hidden></p>
      </div>

      <div data-field="termYears">
        <label class="field-label" for="am-term">Term (years)</label>
        <input class="field" id="am-term" name="termYears" type="number" min="1" max="30" step="1" inputmode="numeric" autocomplete="off" placeholder="e.g. 30" aria-describedby="am-term-error" />
        <p class="am-field-error" id="am-term-error" data-error-for="termYears" hidden></p>
      </div>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <button type="submit" class="btn btn-primary" data-am-submit>Calculate Amortization</button>
      <button type="button" class="btn btn-secondary" data-reset>Reset</button>
    </div>
    <p class="am-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result -->
  <ResultShell id="am-result" state="empty" density="complex" label="Amortization result" minHeight="12rem">
    <EmptyResult message="Enter your loan amount, interest rate, and term, then calculate to see your monthly payment and full amortization schedule." />

    <div data-result-when="valid">
      <div class="am-summary">
        <ResultSummary label="Estimated monthly payment">
          <ResultValue value="—" size="text-3xl" />
        </ResultSummary>
        <dl class="am-metrics">
          <div><dt>Total interest</dt><dd data-am-interest>—</dd></div>
          <div><dt>Total paid</dt><dd data-am-total>—</dd></div>
          <div><dt>Payments</dt><dd data-am-count>—</dd></div>
        </dl>
      </div>

      <details class="am-disclosure" data-am-disclosure>
        <summary class="am-disclosure__summary">
          <span>View amortization schedule</span>
          <svg class="am-disclosure__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>

        <div class="am-schedule" data-am-schedule data-am-view="yearly">
          <fieldset class="am-view">
            <legend class="sr-only">Schedule view</legend>
            <div class="am-view__group">
              <label class="am-view__opt"><input type="radio" name="am-view" value="yearly" checked data-am-view-radio /><span>Yearly</span></label>
              <label class="am-view__opt"><input type="radio" name="am-view" value="monthly" data-am-view-radio /><span>Monthly</span></label>
            </div>
          </fieldset>

          <div class="am-table-wrap">
            <table class="am-table">
              <caption class="sr-only">Amortization schedule showing principal paid, interest paid and remaining balance for each period.</caption>
              <thead>
                <tr>
                  <th scope="col" class="am-th-period">
                    <span data-am-when-view="yearly">Year</span><span data-am-when-view="monthly">Month</span>
                  </th>
                  <th scope="col" class="am-num">Principal</th>
                  <th scope="col" class="am-num">Interest</th>
                  <th scope="col" class="am-num">Balance</th>
                </tr>
              </thead>
              <tbody data-am-rows="yearly"></tbody>
              <tbody data-am-rows="monthly"></tbody>
            </table>
          </div>
          <p class="am-schedule__note">Balances are shown to the nearest dollar. Amounts are in US dollars (USD).</p>
        </div>
      </details>
    </div>

    <InvalidResult
      title="Check your entries"
      message="Enter a loan amount, an interest rate, and a whole loan term from 1 to 30 years."
    />

    <ResultAnnouncement id="am-live" />
  </ResultShell>
</div>

<style>
  .am-field-error {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .am-field-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .am-field-error {
    color: #fca5a5;
  }

  .am-live-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* Summary: dominant payment + supporting totals */
  .am-summary {
    display: grid;
    gap: 1rem;
    align-items: center;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .am-summary {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    }
  }
  .am-metrics {
    margin: 0;
    display: grid;
    gap: 0.25rem;
    align-self: center;
  }
  .am-metrics > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .am-metrics dt {
    color: var(--fg);
    font-weight: 600;
  }
  .am-metrics dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--heading);
    font-weight: 700;
    white-space: nowrap;
  }

  /* Disclosure */
  .am-disclosure {
    margin-top: 1.5rem;
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }
  .am-disclosure__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    cursor: pointer;
    list-style: none;
    font-weight: 700;
    color: var(--heading);
    padding: 0.35rem 0;
  }
  .am-disclosure__summary::-webkit-details-marker {
    display: none;
  }
  .am-disclosure__summary:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 3px;
    border-radius: 0.35rem;
  }
  .am-disclosure__chevron {
    flex: none;
    transition: transform 0.15s ease;
    color: var(--muted);
  }
  .am-disclosure[open] .am-disclosure__chevron {
    transform: rotate(180deg);
  }

  .am-schedule {
    margin-top: 0.75rem;
  }

  /* View selector — native radios styled as a segmented control */
  .am-view {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .am-view__group {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    padding: 0.125rem;
  }
  .am-view__opt {
    position: relative;
    display: inline-flex;
  }
  .am-view__opt input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .am-view__opt span {
    padding: 0.35rem 0.9rem;
    border-radius: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }
  .am-view__opt:has(input:checked) span {
    background: var(--color-brand-600);
    color: #fff;
  }
  .am-view__opt:has(input:focus-visible) span {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }

  .am-table-wrap {
    margin-top: 1rem;
    max-height: 24rem;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
  }
  .am-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .am-table thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--subtle);
    padding: 0.55rem 0.75rem;
    font-weight: 600;
    text-align: left;
    color: var(--fg);
    white-space: nowrap;
  }
  .am-table th.am-num,
  .am-table td.am-num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .am-table :global(.am-row) {
    border-top: 1px solid var(--line);
  }
  .am-table :global(.am-cell) {
    padding: 0.5rem 0.75rem;
  }
  .am-table :global(.am-cell--period) {
    text-align: left;
    font-weight: 600;
    color: var(--fg);
  }

  /* View gating — show only the active view's rows + header label */
  .am-schedule[data-am-view='yearly'] :global([data-am-rows='monthly']),
  .am-schedule[data-am-view='monthly'] :global([data-am-rows='yearly']) {
    display: none;
  }
  .am-schedule[data-am-view='yearly'] [data-am-when-view='monthly'],
  .am-schedule[data-am-view='monthly'] [data-am-when-view='yearly'] {
    display: none;
  }

  .am-schedule__note {
    margin: 0.75rem 0 0;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--muted);
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { amortizationBinding } from '@lib/calculators/amortization-form';

  document.querySelectorAll<HTMLElement>('[data-amort]').forEach((root) => {
    mountFormCalculator(root, amortizationBinding, {
      recalculationMode: 'live-after-first',
      calculateButtonLabel: 'Calculate Amortization',
    });

    const shell = root.querySelector<HTMLElement>('[data-result-shell]');
    const disclosure = root.querySelector<HTMLDetailsElement>('[data-am-disclosure]');
    const schedule = root.querySelector<HTMLElement>('[data-am-schedule]');
    const radios = Array.from(root.querySelectorAll<HTMLInputElement>('[data-am-view-radio]'));

    // The island owns the Yearly/Monthly view — a presentation-only switch over the schedule the
    // runtime already rendered in full. Native radios: focus stays on the selected radio, no
    // recompute (they sit OUTSIDE the form), no announcement.
    const applyView = () => {
      const checked = radios.find((r) => r.checked)?.value ?? 'yearly';
      if (schedule) schedule.dataset.amView = checked;
    };
    for (const r of radios) r.addEventListener('change', applyView);

    const clearRows = () =>
      root.querySelectorAll<HTMLElement>('[data-am-rows]').forEach((tb) => tb.replaceChildren());
    const restoreYearly = () => {
      for (const r of radios) r.checked = r.value === 'yearly';
      applyView();
    };

    // React to runtime state transitions the island does not itself cause. Leaving `valid` (an
    // invalid live edit) drops the stale/possibly-malformed rows so a malformed schedule can never
    // remain in the DOM; returning to `empty` (Reset) also closes the disclosure and restores Yearly.
    // A `valid` update is owned by the binding's renderResult, so the observer never touches it.
    if (shell) {
      const observer = new MutationObserver(() => {
        const state = shell.dataset.resultState;
        if (state === 'valid') return;
        clearRows();
        if (state === 'empty') {
          if (disclosure) disclosure.open = false;
          restoreYearly();
        }
      });
      observer.observe(shell, { attributes: true, attributeFilter: ['data-result-state'] });
    }
  });
</script>
