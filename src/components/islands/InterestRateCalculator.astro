---
/**
 * Interest Rate calculator island (R15B3 — Loan family follow-on, 3 of 3; task-first migration).
 *
 * Task-first, direct-intent: all fields start EMPTY, the result is an instruction, and the visitor
 * presses "Calculate Interest Rate" for the first result; live-after-first afterwards. Compute,
 * validation, state, announcement and focus are owned by the shared runtime + the Interest Rate
 * binding (@lib/calculators/interest-rate-form), which wraps the UNCHANGED solveAnnualRate (a bisection
 * over the shared @lib/finance `pmt`). The complete-result guard lives in the binding's resultValue (a
 * NaN sentinel → the runtime's default finite gate) — there is NO isUsableResult.
 *
 * INDEPENDENT of Loan / Home Equity / Amortization: this island imports the Interest Rate binding only
 * and shares no implementation file with any other calculator (mirror-not-share). The dominant result
 * is the estimated ANNUAL rate; the monthly rate and the supplied monthly payment are the prominent
 * secondary. The frozen contract exposes no schedule and only a "total repaid" figure — so NONE beyond
 * that is invented (no total-interest), and there is no amortization disclosure and no row-clearing
 * observer (nothing island-owned outlives a state change). Term is in MONTHS (the frozen source unit),
 * whole ≥ 1; a monthly payment too low to ever repay the loan is rejected, not shown as a misleading 0%.
 *
 * The estimator DISCLAIMER lives HERE (island-owned) so it appears exactly once on both the full page
 * and the embed (the embed renders only this island); it sits outside the live region, always visible.
 */
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';
---

<div class="ir mx-auto grid w-full max-w-5xl gap-4 md:grid-cols-2 md:items-start" data-ir>
  <!-- Inputs -->
  <form class="card p-4" data-form novalidate aria-label="Interest rate calculator">
    <div class="grid gap-4 sm:grid-cols-3">
      <div data-field="amount">
        <label class="field-label" for="ir-amount">Loan amount</label>
        <div class="flex">
          <span class="field-affix rounded-l-lg border-r-0">$</span>
          <input class="field rounded-l-none" id="ir-amount" name="amount" type="number" min="0" step="500" inputmode="decimal" autocomplete="off" placeholder="e.g. 20000" aria-describedby="ir-amount-error" />
        </div>
        <p class="ir-field-error" id="ir-amount-error" data-error-for="amount" hidden></p>
      </div>

      <div data-field="payment">
        <label class="field-label" for="ir-payment">Monthly payment</label>
        <div class="flex">
          <span class="field-affix rounded-l-lg border-r-0">$</span>
          <input class="field rounded-l-none" id="ir-payment" name="payment" type="number" min="0" step="1" inputmode="decimal" autocomplete="off" placeholder="e.g. 380" aria-describedby="ir-payment-error" />
        </div>
        <p class="ir-field-error" id="ir-payment-error" data-error-for="payment" hidden></p>
      </div>

      <div data-field="months">
        <label class="field-label" for="ir-months">Term (months)</label>
        <input class="field" id="ir-months" name="months" type="number" min="1" step="1" inputmode="numeric" autocomplete="off" placeholder="e.g. 60" aria-describedby="ir-months-error" />
        <p class="ir-field-error" id="ir-months-error" data-error-for="months" hidden></p>
      </div>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <button type="submit" class="btn btn-primary" data-ir-submit>Calculate Interest Rate</button>
      <button type="button" class="btn btn-secondary" data-reset>Reset</button>
    </div>
    <p class="ir-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result -->
  <ResultShell id="ir-result" state="empty" density="standard" label="Interest rate result" minHeight="11rem">
    <ExampleNotice />
    <EmptyResult message="Enter the loan amount, the monthly payment and the term in months, then calculate to see the annual interest rate those payments imply." />

    <div data-result-when="valid">
      <div class="ir-summary">
        <ResultSummary label="Estimated annual interest rate">
          <ResultValue value="—" size="text-4xl" />
        </ResultSummary>
        <dl class="ir-metrics">
          <div><dt>Monthly rate</dt><dd data-ir-monthly>—</dd></div>
          <div><dt>Monthly payment</dt><dd data-ir-payment>—</dd></div>
        </dl>
      </div>

      <dl class="ir-supporting">
        <div><dt>Loan amount</dt><dd data-ir-amount>—</dd></div>
        <div><dt>Payments</dt><dd data-ir-payments>—</dd></div>
        <div><dt>Total repaid</dt><dd data-ir-total>—</dd></div>
      </dl>

      <p class="ir-interpretation" data-ir-interpretation>—</p>
    </div>

    <InvalidResult
      title="Check your entries"
      message="Enter a loan amount, a monthly payment high enough to repay it, and a whole loan term of 1 month or more."
    />

    <ResultAnnouncement id="ir-live" />
  </ResultShell>

  <!-- Island-owned estimator disclaimer: rendered once on both the full page and the embed. -->
  <p class="ir-disclaimer" role="note">
    This estimates the interest rate implied by the amount, payment and term you enter — general
    educational information, not financial advice. A quoted APR may be higher once fees are included.
  </p>
</div>

<style>
  .ir-field-error {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .ir-field-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .ir-field-error {
    color: #fca5a5;
  }

  .ir-live-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* Summary: dominant annual rate + monthly rate / payment secondary */
  .ir-summary {
    display: grid;
    gap: 1rem;
    align-items: center;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .ir-summary {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    }
  }
  .ir-metrics {
    margin: 0;
    display: grid;
    gap: 0.25rem;
    align-self: center;
  }
  .ir-metrics > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .ir-metrics dt {
    color: var(--fg);
    font-weight: 600;
  }
  .ir-metrics dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--heading);
    font-weight: 700;
    white-space: nowrap;
  }

  /* Supporting row: amount / payments / total repaid */
  .ir-supporting {
    margin: 1.25rem 0 0;
    display: grid;
    gap: 0.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 480px) {
    .ir-supporting {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }
  .ir-supporting > div {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
  }
  .ir-supporting dt {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .ir-supporting dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--heading);
    font-weight: 700;
  }

  .ir-interpretation {
    margin: 1.25rem 0 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--fg);
  }

  .ir-disclaimer {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--muted);
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { interestRateBinding, INTEREST_RATE_EXAMPLE_VALUES } from '@lib/calculators/interest-rate-form';

  document.querySelectorAll<HTMLElement>('[data-ir]').forEach((root) => {
    mountFormCalculator(root, interestRateBinding, {
      recalculationMode: 'live-after-first',
      example: { values: INTEREST_RATE_EXAMPLE_VALUES },
      calculateButtonLabel: 'Calculate Interest Rate',
    });
  });
</script>
