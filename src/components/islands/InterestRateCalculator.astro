---
import { solveAnnualRate } from '@lib/calculators/interest-rate';
import { formatPercent, formatCurrency } from '@lib/format';

const d = { amount: 20000, payment: 377.42, months: 60 };
const rate = solveAnnualRate(d.amount, d.payment, d.months);
---

<div class="mx-auto grid w-full max-w-4xl gap-6 md:grid-cols-2" data-irate>
  <form class="card p-5 sm:p-6" data-ir-form novalidate>
    <div class="space-y-4">
      <div>
        <label class="field-label" for="ir-amount">Loan amount</label>
        <div class="flex"><span class="field-affix rounded-l-lg border-r-0">$</span><input class="field rounded-l-none" id="ir-amount" name="amount" type="number" min="0" step="500" value={d.amount} inputmode="decimal" /></div>
      </div>
      <div>
        <label class="field-label" for="ir-payment">Monthly payment</label>
        <div class="flex"><span class="field-affix rounded-l-lg border-r-0">$</span><input class="field rounded-l-none" id="ir-payment" name="payment" type="number" min="0" step="1" value={d.payment} inputmode="decimal" /></div>
      </div>
      <div>
        <label class="field-label" for="ir-months">Term (months)</label>
        <input class="field" id="ir-months" name="months" type="number" min="1" step="1" value={d.months} inputmode="decimal" />
      </div>
    </div>
  </form>

  <div class="card flex flex-col justify-center p-6 text-center">
    <p class="text-sm font-semibold" style="color: var(--muted)">Implied interest rate</p>
    <p class="mt-1 text-5xl font-extrabold tracking-tight" style="color: var(--heading)" data-ir-rate>{formatPercent(rate, 2)}</p>
    <p class="mt-3 text-sm" style="color: var(--muted)">per year (APR excludes fees)</p>
    <p class="mt-4 text-sm" style="color: var(--fg)">Total repaid: <strong data-ir-total>{formatCurrency(d.payment * d.months)}</strong></p>
  </div>
</div>

<script>
  import { solveAnnualRate } from '@lib/calculators/interest-rate';
  import { formatPercent, formatCurrency } from '@lib/format';
  document.querySelectorAll<HTMLElement>('[data-irate]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-ir-form]')!;
    const num = (n: string) => Number((form.elements.namedItem(n) as HTMLInputElement)?.value) || 0;
    const set = (sel: string, v: string) => { const el = root.querySelector<HTMLElement>(sel); if (el) el.textContent = v; };
    function recompute() {
      const amount = num('amount'), payment = num('payment'), months = num('months');
      const rate = solveAnnualRate(amount, payment, months);
      set('[data-ir-rate]', Number.isNaN(rate) ? '—' : formatPercent(rate, 2));
      set('[data-ir-total]', formatCurrency(payment * months));
    }
    form.addEventListener('input', recompute);
    recompute();
  });
</script>
