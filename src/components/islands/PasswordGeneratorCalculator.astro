---
/**
 * Password generator island (R4 — generator runtime pilot).
 *
 * Task-first: no password on load, an explicit "Generate Password", and
 * settings changes mark the existing output STALE (kept visible, Copy disabled)
 * rather than silently regenerating. All state, validation, Copy, Reset,
 * stale-handling and announcements are owned by the shared generator runtime
 * (@lib/result/generator-runtime) with the password binding
 * (@lib/calculators/password-form). Generation is client-only via the Web
 * Crypto API; the password is never announced, stored, logged or transmitted.
 */
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
---

<div class="pg mx-auto w-full max-w-5xl grid grid-cols-2 gap-4 items-stretch" data-passgen>
  <form class="card p-4" data-form novalidate aria-label="Password generator settings">
    <div>
      <div class="flex items-center justify-between">
        <label class="field-label mb-0" for="pg-length">Length</label>
        <span class="text-sm font-bold" data-length-display>16</span>
      </div>
      <input
        class="mt-2 w-full"
        id="pg-length"
        name="length"
        type="range"
        min="4"
        max="64"
        value="16"
        aria-describedby="pg-length-error"
      />
      <p class="pg-error" id="pg-length-error" data-error-for="length" hidden></p>
    </div>

    <fieldset class="mt-5" data-field="charsets">
      <legend class="field-label">Character types</legend>
      <div class="mt-2 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
        <label class="pg-check"><input type="checkbox" name="upper" checked aria-describedby="pg-charsets-error" /> A–Z</label>
        <label class="pg-check"><input type="checkbox" name="lower" checked aria-describedby="pg-charsets-error" /> a–z</label>
        <label class="pg-check"><input type="checkbox" name="digits" checked aria-describedby="pg-charsets-error" /> 0–9</label>
        <label class="pg-check"><input type="checkbox" name="symbols" checked aria-describedby="pg-charsets-error" /> !@#</label>
      </div>
      <p class="pg-error" id="pg-charsets-error" data-error-for="charsets" hidden></p>
    </fieldset>

    <div class="pg-actions mt-6">
      <button type="submit" class="btn btn-primary">Generate Password</button>
      <button type="button" class="btn btn-secondary" data-reset>Reset</button>
    </div>
    <p class="pg-trust">Generated in your browser. Your password is not sent anywhere.</p>
  </form>

  <ResultShell
    id="pg-result"
    class="pg-result h-full"
    density="compact"
    minHeight="9rem"
    placeholderAlignment="center"
    label="Generated password"
  >
    <EmptyResult message="Choose your settings, then generate a password." />

    <div data-result-when="valid">
      <ResultSummary label="Generated password">
        <div class="pg-output-row">
          <input
            class="field font-mono pg-output"
            data-generator-output
            type="text"
            readonly
            spellcheck="false"
            autocapitalize="off"
            autocorrect="off"
            autocomplete="off"
            aria-label="Generated password"
            aria-describedby="pg-stale-note"
            value=""
          />
          <button type="button" class="btn btn-secondary pg-copy" data-copy disabled aria-disabled="true">Copy</button>
          <span class="pg-copy-confirm" data-copy-confirm hidden></span>
        </div>
      </ResultSummary>

      <p class="pg-stale-note" id="pg-stale-note" data-stale-note hidden>Settings changed. Generate again to apply them.</p>

      <div class="pg-strength-row">
        <span class="pg-strength-caption">Strength:</span>
        <span class="pg-strength" data-strength>—</span>
        <span class="pg-meter" aria-hidden="true"><span class="pg-meter-fill" data-strength-meter style="width:0%"></span></span>
      </div>
      <p class="pg-meta" data-output-meta></p>
    </div>

    <InvalidResult title="Check your settings" message="Select at least one character type and a valid length." />
    <ResultAnnouncement id="pg-live" />
  </ResultShell>
</div>

<style>
  .pg-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
  }
  .pg-error {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .pg-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .pg-error {
    color: #fca5a5;
  }
  .pg-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .pg-trust {
    margin-top: 0.9rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .pg-output-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .pg-output {
    flex: 1 1 16rem;
    min-width: 0;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }
  /* Stale output reads as clearly not-current (with the note; not colour alone). */
  [data-stale='true'] .pg-output {
    opacity: 0.55;
  }
  .pg-copy {
    flex: 0 0 auto;
  }
  .pg-copy-confirm {
    font-size: 0.85rem;
    font-weight: 600;
    color: #059669;
  }
  .pg-stale-note {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: #b45309;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .pg-stale-note {
      color: #fbbf24;
    }
    :root:not([data-theme='light']) .pg-copy-confirm {
      color: #34d399;
    }
  }
  :root[data-theme='dark'] .pg-stale-note {
    color: #fbbf24;
  }
  :root[data-theme='dark'] .pg-copy-confirm {
    color: #34d399;
  }
  .pg-strength-row {
    margin-top: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .pg-strength-caption {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .pg-strength {
    font-weight: 700;
  }
  .pg-meter {
    flex: 1 1 auto;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--subtle);
    overflow: hidden;
    max-width: 12rem;
  }
  .pg-meter-fill {
    display: block;
    height: 100%;
    width: 0;
    background: var(--color-brand-500);
    transition: width 0.2s ease;
  }
  .pg-meter-fill[data-level='weak'] {
    background: #e11d48;
  }
  .pg-meter-fill[data-level='fair'] {
    background: #f59e0b;
  }
  .pg-meter-fill[data-level='strong'] {
    background: #10b981;
  }
  .pg-meter-fill[data-level='very-strong'] {
    background: #059669;
  }
  .pg-meta {
    margin: 0.6rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>

<script>
  import { mountGeneratorCalculator } from '@lib/result/generator-runtime';
  import { passwordBinding } from '@lib/calculators/password-form';

  document.querySelectorAll<HTMLElement>('[data-passgen]').forEach((root) => {
    // Reflect the slider value live (a display concern, not a generation).
    const slider = root.querySelector<HTMLInputElement>('#pg-length');
    const display = root.querySelector<HTMLElement>('[data-length-display]');
    slider?.addEventListener('input', () => {
      if (display) display.textContent = slider.value;
    });

    mountGeneratorCalculator(root, passwordBinding, {
      generateButtonLabel: 'Generate Password',
      regenerateButtonLabel: 'Generate New Password',
      liveRegeneration: false,
      invalidateOutputOnSettingsChange: true,
    });
  });
</script>
