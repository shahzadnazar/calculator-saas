---
/**
 * Password generator island — the reference's settings, our generator behaviour.
 *
 * Settings on the left, the password in the same row on the right: length (a number box and a
 * slider that move together), the four character classes, and the three exclusions the reference
 * offers — ambiguous characters, brackets, and repeated characters.
 *
 * Runs on the UNCHANGED generator runtime, exactly like the random number generator: an explicit
 * Generate, and a settings change that marks the shown password STALE — kept visible, Copy disabled
 * — rather than silently regenerating. The output area carries Copy and Regenerate, so a password
 * you do not like is one click from another without going back to the settings.
 *
 * Generation is client-only through the Web Crypto API; the password is never announced, stored,
 * logged or transmitted, and the server never bakes one into the page.
 */
import ResultShell from '@components/result/ResultShell.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';
import { MIN_LENGTH, MAX_LENGTH } from '@lib/calculators/password-generator';
---

<div class="pg mx-auto w-full max-w-5xl" data-passgen>
  <div class="pg-split">
    <form class="card pg-card" data-form novalidate aria-label="Password generator settings">
      <div class="pg-field">
        <label class="field-label pg-field__label" for="pg-length">Password Length</label>
        <div class="pg-field__control">
          <div class="pg-length-row">
            <input
              class="field pg-num"
              id="pg-length"
              name="length"
              type="number"
              inputmode="numeric"
              min={MIN_LENGTH}
              max={MAX_LENGTH}
              step="1"
              autocomplete="off"
              placeholder="10"
              value="10"
              aria-describedby="pg-length-error"
            />
            <input
              class="pg-slider"
              type="range"
              min={MIN_LENGTH}
              max="64"
              step="1"
              value="10"
              data-length-slider
              aria-label="Password length slider"
            />
          </div>
          <p class="pg-field-error" id="pg-length-error" data-error-for="length" hidden />
        </div>
      </div>

      <fieldset class="pg-options" data-field="charsets">
        <legend class="sr-only">Character types and exclusions</legend>
        <label class="pg-check">
          <input type="checkbox" name="lower" checked aria-describedby="pg-charsets-error" />
          <span>Include Lower Case Characters <code class="pg-hint">a-z</code></span>
        </label>
        <label class="pg-check">
          <input type="checkbox" name="upper" checked aria-describedby="pg-charsets-error" />
          <span>Include Upper Case Characters <code class="pg-hint">A-Z</code></span>
        </label>
        <label class="pg-check">
          <input type="checkbox" name="digits" checked aria-describedby="pg-charsets-error" />
          <span>Include Numbers <code class="pg-hint">0-9</code></span>
        </label>
        <label class="pg-check">
          <input type="checkbox" name="symbols" checked aria-describedby="pg-charsets-error" />
          <span>Include Symbols <code class="pg-hint">!"#$%&amp;'()*+,-./:;&lt;=&gt;?@[\]^_`&#123;|&#125;~</code></span>
        </label>
        <label class="pg-check">
          <input type="checkbox" name="excludeAmbiguous" checked aria-describedby="pg-charsets-error" />
          <span>Exclude Ambiguous Characters <code class="pg-hint">iIl1L| oO0 `'";:,.</code></span>
        </label>
        <label class="pg-check">
          <input type="checkbox" name="excludeBrackets" checked aria-describedby="pg-charsets-error" />
          <span>Exclude Brackets <code class="pg-hint">&lt;&gt;()[]&#123;&#125;</code></span>
        </label>
        <label class="pg-check">
          <input type="checkbox" name="noRepeats" aria-describedby="pg-charsets-error" />
          <span>No Repeated Characters</span>
        </label>
        <p class="pg-field-error" id="pg-charsets-error" data-error-for="charsets" hidden />
      </fieldset>

      <div class="mt-3 flex items-center gap-3">
        <button type="submit" class="btn btn-primary">Generate</button>
        <button type="button" class="btn btn-secondary" data-reset>Clear</button>
      </div>
      <p class="pg-trust">Generated in your browser with the Web Crypto API. Nothing is saved or sent anywhere.</p>
    </form>

    <ResultShell
      id="pg-result"
      state="empty"
      density="standard"
      label="Generated password"
      minHeight="0"
      class="pg-result"
    >
      <ExampleNotice />
      <EmptyResult message="Choose your settings, then generate a password." />

      <div data-result-when="valid">
        <label class="sr-only" for="pg-output">The generated password</label>
        <textarea
          class="pg-output"
          id="pg-output"
          data-generator-output
          rows="1"
          readonly
          spellcheck="false"
          placeholder="Your password will appear here"
          autocapitalize="off"
          autocorrect="off"
          autocomplete="off"></textarea>

        <div class="pg-strength">
          <p class="pg-strength__line">
            <span class="pg-strength__caption">Password Strength:</span>
            <span class="pg-strength__value" data-strength>—</span>
          </p>
          <span class="pg-meter" aria-hidden="true"
            ><span class="pg-meter__fill" data-strength-meter style="width:0%"></span></span
          >
          <p class="pg-strength__line">
            <span class="pg-strength__caption">Password Entropy:</span>
            <span class="pg-strength__value" data-entropy>—</span>
          </p>
        </div>

        <p class="pg-stale" data-stale-note hidden>Settings changed. Generate again to apply them.</p>
        <div class="pg-actions">
          <button type="button" class="btn btn-secondary pg-action" data-copy>Copy</button>
          <button type="button" class="btn btn-secondary pg-action" data-regenerate>Regenerate</button>
          <span class="pg-copied" data-copy-confirm hidden>Copied</span>
        </div>
      </div>

      <InvalidResult
        title="Check the settings"
        message="Pick a length and at least one character type that survives your exclusions."
      />
      <ResultAnnouncement id="pg-live" />
    </ResultShell>
  </div>
</div>

<style>
  .pg { min-width: 0; }

  /* Settings and the password side by side once there is room for both. */
  .pg-split {
    display: grid;
    gap: 1rem;
    align-items: start;
    min-width: 0;
  }
  @media (min-width: 58rem) {
    .pg-split { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }
  .pg-card { padding: 0.85rem; min-width: 0; }
  .pg :global(.pg-result) { min-width: 0; }

  .pg-field {
    display: grid;
    grid-template-columns: minmax(0, 8.5rem) minmax(0, 1fr);
    gap: 0.5rem;
    align-items: start;
  }
  .pg-field__label { margin: 0; padding-top: 0.7rem; }
  .pg-field__control { min-width: 0; }
  @media (max-width: 30rem) {
    .pg-field { grid-template-columns: minmax(0, 1fr); gap: 0.15rem; }
    .pg-field__label { padding-top: 0; }
  }

  .pg-length-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }
  .pg-num {
    min-height: 2.75rem;
    width: 5.5rem;
    flex: 0 0 auto;
    font-variant-numeric: tabular-nums;
  }
  .pg-slider {
    flex: 1 1 auto;
    min-width: 0;
    accent-color: var(--color-brand-500);
    height: 2.75rem;
  }

  .pg-field-error {
    margin: 0.2rem 0 0;
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.3;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .pg-field-error { color: #fca5a5; }
  }
  :root[data-theme='dark'] .pg-field-error { color: #fca5a5; }

  .pg-options {
    margin: 0.5rem 0 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  /* flex-start, not center: two of these labels wrap to a second line on a phone, and a centred
     box then floats away from the words it belongs to. */
  .pg-check {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    /* The whole label is the tap target, so it carries the 44px floor. */
    min-height: 2.75rem;
    padding: 0.2rem 0;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--fg);
    cursor: pointer;
  }
  .pg-check input {
    flex: 0 0 auto;
    margin-top: 0.22rem;
  }
  /* The character sets are reference material, not part of the label's sentence. */
  .pg-hint {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.76rem;
    font-weight: 500;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .pg-trust {
    margin: 0.8rem 0 0;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--muted);
  }

  /* ---- The output ------------------------------------------------ */
  /* A readonly field rather than a paragraph, so what is on screen is exactly what Copy puts on the
     clipboard — and so a long password can be selected with a keyboard. */
  .pg-output {
    display: block;
    width: 100%;
    border: 0;
    padding: 0;
    resize: none;
    background: transparent;
    color: var(--heading);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: clamp(1.05rem, 3.2vw, 1.4rem);
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.02em;
    overflow-wrap: anywhere;
    word-break: break-all;
  }
  .pg-output::placeholder {
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--muted);
    letter-spacing: normal;
  }
  .pg-output:focus-visible {
    outline: 2px solid var(--color-brand-500);
    outline-offset: 3px;
    border-radius: 0.35rem;
  }
  /* A stale password reads as clearly not-current — with the note, never colour alone. */
  [data-stale='true'] .pg-output { opacity: 0.55; }

  .pg-strength { margin-top: 0.7rem; }
  .pg-strength__line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
  }
  .pg-strength__caption { color: var(--muted); }
  .pg-strength__value { font-weight: 700; color: var(--heading); }
  .pg-meter {
    display: block;
    margin-top: 0.35rem;
    height: 0.5rem;
    max-width: 14rem;
    border-radius: 9999px;
    background: var(--subtle);
    overflow: hidden;
  }
  .pg-meter__fill {
    display: block;
    height: 100%;
    width: 0;
    background: var(--color-brand-500);
    transition: width 0.2s ease;
  }
  .pg-meter__fill[data-strength-level='weak'] { background: #e11d48; }
  .pg-meter__fill[data-strength-level='fair'] { background: #f59e0b; }
  .pg-meter__fill[data-strength-level='strong'] { background: #10b981; }
  .pg-meter__fill[data-strength-level='very-strong'] { background: #059669; }

  .pg-stale {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
  }
  .pg-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.8rem;
  }
  /* Brand-tinted rather than plain secondary: these are the two things you do WITH a password, and a
     white outline button beside a white card read as decoration. Tinted, not solid, so they stay
     subordinate to Generate. */
  .pg :global(.pg-action) {
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--color-brand-700);
    background: color-mix(in srgb, var(--color-brand-500) 12%, var(--card));
    border-color: color-mix(in srgb, var(--color-brand-500) 35%, var(--line));
  }
  .pg :global(.pg-action:hover:not(:disabled)) {
    background: color-mix(in srgb, var(--color-brand-500) 20%, var(--card));
    border-color: var(--color-brand-400);
  }
  .pg :global(.pg-action:disabled) { opacity: 0.5; cursor: not-allowed; }
  :root[data-theme='dark'] .pg :global(.pg-action) {
    color: var(--color-brand-300);
    background: color-mix(in srgb, var(--color-brand-400) 16%, var(--card));
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .pg :global(.pg-action) {
      color: var(--color-brand-300);
      background: color-mix(in srgb, var(--color-brand-400) 16%, var(--card));
    }
  }
  .pg-copied {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-brand-700);
  }
  :root[data-theme='dark'] .pg-copied { color: var(--color-brand-400); }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .pg-copied { color: var(--color-brand-400); }
  }
</style>

<script>
  import { mountGeneratorCalculator } from '@lib/result/generator-runtime';
  import { passwordBinding, PASSWORD_EXAMPLE_SETTINGS } from '@lib/calculators/password-form';

  /**
   * Namespace this instance's server-STATIC ids and repoint their in-root references, but ONLY when
   * more than one shares the document. A lone instance keeps the ids the server wrote.
   */
  function uniquifyStaticIds(root: HTMLElement, suffix: string): void {
    const remap = new Map<string, string>();
    root.querySelectorAll<HTMLElement>('[id]').forEach((el) => {
      const next = `${el.id}-${suffix}`;
      remap.set(el.id, next);
      el.id = next;
    });
    const repoint = (attr: string) =>
      root.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((el) => {
        const next = el
          .getAttribute(attr)!
          .split(/\s+/)
          .map((token) => remap.get(token) ?? token)
          .join(' ');
        el.setAttribute(attr, next);
      });
    repoint('for');
    repoint('aria-describedby');
    repoint('aria-labelledby');
    repoint('aria-controls');
  }

  /** Regenerate is the Generate button, pressed from where the visitor is already looking. */
  function wireRegenerate(root: HTMLElement): void {
    const form = root.querySelector<HTMLFormElement>('form[data-form]');
    root.querySelector<HTMLButtonElement>('[data-regenerate]')?.addEventListener('click', () => {
      form?.requestSubmit();
    });
  }

  /**
   * The number box and the slider are two views of one length. Keeping them in sync is a display
   * concern; the runtime still reads the number box, so only that one dispatches a settings change.
   */
  function wireLength(root: HTMLElement): void {
    const box = root.querySelector<HTMLInputElement>('[name="length"]');
    const slider = root.querySelector<HTMLInputElement>('[data-length-slider]');
    if (!box || !slider) return;
    slider.addEventListener('input', () => {
      if (box.value === slider.value) return;
      box.value = slider.value;
      box.dispatchEvent(new Event('input', { bubbles: true }));
    });
    box.addEventListener('input', () => {
      const value = Number(box.value);
      if (!Number.isFinite(value)) return;
      const min = Number(slider.min);
      const max = Number(slider.max);
      slider.value = String(Math.min(max, Math.max(min, value)));
    });
  }

  const roots = document.querySelectorAll<HTMLElement>('[data-passgen]');
  roots.forEach((root, i) => {
    if (roots.length > 1) uniquifyStaticIds(root, `p${i + 1}`);
    wireRegenerate(root);
    wireLength(root);
    mountGeneratorCalculator(root, passwordBinding, {
      generateButtonLabel: 'Generate',
      regenerateButtonLabel: 'Generate',
      example: { settings: PASSWORD_EXAMPLE_SETTINGS },
      liveRegeneration: false,
      invalidateOutputOnSettingsChange: true,
    });
  });
</script>
