---
/**
 * Password generator island. Generation happens on the client using the Web
 * Crypto API — passwords are never sent anywhere.
 */
---

<div class="mx-auto w-full max-w-3xl" data-passgen>
  <div class="card p-5 sm:p-6">
    <div class="flex gap-2">
      <input class="field font-mono text-lg" data-pg-output readonly aria-label="Generated password" value="" />
      <button type="button" class="btn btn-secondary shrink-0" data-pg-copy aria-label="Copy password">Copy</button>
      <button type="button" class="btn btn-primary shrink-0" data-pg-regen aria-label="Generate new password" title="Regenerate">↻</button>
    </div>

    <div class="mt-3 flex items-center gap-3">
      <div class="h-2 flex-1 overflow-hidden rounded-full" style="background: var(--subtle)">
        <span class="block h-full transition-all" data-pg-meter style="width: 0%"></span>
      </div>
      <span class="w-24 text-right text-sm font-semibold" data-pg-strength>—</span>
    </div>

    <form class="mt-6 space-y-4" data-pg-form>
      <div>
        <div class="flex items-center justify-between">
          <label class="field-label mb-0" for="pg-length">Length</label>
          <span class="text-sm font-bold" data-pg-length-val>16</span>
        </div>
        <input class="mt-2 w-full" id="pg-length" name="length" type="range" min="4" max="64" value="16" />
      </div>
      <div class="grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
        <label class="flex items-center gap-2 font-medium"><input type="checkbox" name="upper" checked /> A-Z</label>
        <label class="flex items-center gap-2 font-medium"><input type="checkbox" name="lower" checked /> a-z</label>
        <label class="flex items-center gap-2 font-medium"><input type="checkbox" name="digits" checked /> 0-9</label>
        <label class="flex items-center gap-2 font-medium"><input type="checkbox" name="symbols" checked /> !@#</label>
      </div>
    </form>
    <p class="mt-4 text-xs" style="color: var(--muted)" data-pg-status aria-live="polite">Generated locally in your browser — nothing is sent to any server.</p>
  </div>
</div>

<script>
  import { generatePassword, estimateEntropyBits, strengthLabel, type PasswordOptions } from '@lib/calculators/password-generator';

  const meterColor = (label: string) =>
    label === 'Weak' ? '#e11d48' : label === 'Fair' ? '#f59e0b' : label === 'Strong' ? '#10b981' : '#059669';

  document.querySelectorAll<HTMLElement>('[data-passgen]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-pg-form]')!;
    const output = root.querySelector<HTMLInputElement>('[data-pg-output]')!;
    const lengthVal = root.querySelector<HTMLElement>('[data-pg-length-val]')!;
    const meter = root.querySelector<HTMLElement>('[data-pg-meter]')!;
    const strengthEl = root.querySelector<HTMLElement>('[data-pg-strength]')!;
    const status = root.querySelector<HTMLElement>('[data-pg-status]')!;

    const opts = (): PasswordOptions => ({
      length: Number((form.elements.namedItem('length') as HTMLInputElement).value),
      upper: (form.elements.namedItem('upper') as HTMLInputElement).checked,
      lower: (form.elements.namedItem('lower') as HTMLInputElement).checked,
      digits: (form.elements.namedItem('digits') as HTMLInputElement).checked,
      symbols: (form.elements.namedItem('symbols') as HTMLInputElement).checked,
    });

    function regenerate() {
      const o = opts();
      lengthVal.textContent = String(o.length);
      output.value = generatePassword(o);
      const bits = estimateEntropyBits(o);
      const label = strengthLabel(bits);
      strengthEl.textContent = label;
      strengthEl.style.color = meterColor(label);
      meter.style.width = `${Math.min(100, (bits / 128) * 100)}%`;
      meter.style.background = meterColor(label);
    }

    root.querySelector('[data-pg-regen]')!.addEventListener('click', regenerate);
    form.addEventListener('input', regenerate);
    root.querySelector('[data-pg-copy]')!.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(output.value);
        status.textContent = 'Copied to clipboard.';
      } catch {
        output.select();
        status.textContent = 'Press Ctrl/Cmd+C to copy.';
      }
      setTimeout(() => (status.textContent = 'Generated locally in your browser — nothing is sent to any server.'), 2500);
    });

    regenerate();
  });
</script>
