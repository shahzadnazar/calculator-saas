---
/**
 * Credit-card payoff calculator island (R8C1 — standard-form wave, calculator #15;
 * product family MULTI-MODE, on the standard-form runtime + the accepted isUsableResult
 * gate).
 *
 * Task-first, direct-intent: mode defaults to By payment, all fields start EMPTY, the
 * result is empty (an instruction, not the legacy $5,000 / 19.99% / $200 sample), and the
 * visitor presses "Calculate Payoff Time" (or "Calculate Required Payment") for the first
 * result. Live-after-first afterwards. Compute, validation, state, announcement and focus
 * are owned by the shared runtime + the credit-card binding (@lib/calculators/credit-card-form).
 *
 * "Calculate by" is a native radio group — a STRUCTURAL selector the runtime recomputes on.
 * Its two modes swap ONE conditional field: By payment shows the monthly payment (and
 * solves for the payoff time + cost); By timeline shows the target months (and solves for
 * the required payment + cost). The island OWNS the conditional field's visibility + the
 * action label: the inactive field is hidden AND disabled, its stale error cleared and its
 * value preserved for an in-session switch; on a switch the mode-owned result is briefly
 * blanked. The binding owns formula selection, validating only the active field, the
 * mode-specific result — including the informational "Never" payoff — and clearing values
 * on reset.
 */
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import ResultBreakdown from '@components/result/ResultBreakdown.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
---

<div class="creditcard mx-auto grid w-full max-w-5xl gap-4 md:grid-cols-2 md:items-start" data-cc>
  <!-- Inputs -->
  <form class="card p-4" data-form novalidate aria-label="Credit card payoff calculator">
    <fieldset class="cc-modes">
      <legend class="field-label">Calculate by</legend>
      <div class="seg-group">
        <label class="seg"><input type="radio" name="mode" value="payment" checked /><span>Monthly payment</span></label>
        <label class="seg"><input type="radio" name="mode" value="months" /><span>Target payoff time</span></label>
      </div>
    </fieldset>

    <div class="mt-2 space-y-2">
      <div data-field="balance">
        <label class="field-label" for="cc-balance">Card balance</label>
        <div class="flex">
          <span class="field-affix rounded-l-lg border-r-0">$</span>
          <input
            class="field rounded-l-none"
            id="cc-balance"
            name="balance"
            type="number"
            min="0"
            step="100"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 5000"
            aria-describedby="cc-balance-error"
          />
        </div>
        <p class="cc-field-error" id="cc-balance-error" data-error-for="balance" hidden></p>
      </div>

      <div data-field="aprPct">
        <label class="field-label" for="cc-apr">APR</label>
        <div class="flex">
          <input
            class="field rounded-r-none"
            id="cc-apr"
            name="aprPct"
            type="number"
            min="0"
            step="0.01"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 19.99"
            aria-describedby="cc-apr-error"
          />
          <span class="field-affix rounded-r-lg border-l-0">%</span>
        </div>
        <p class="cc-field-error" id="cc-apr-error" data-error-for="aprPct" hidden></p>
      </div>

      <!-- Conditional: By payment shows the monthly payment. -->
      <div data-field="payment" data-cc-payment>
        <label class="field-label" for="cc-pay">Monthly payment</label>
        <div class="flex">
          <span class="field-affix rounded-l-lg border-r-0">$</span>
          <input
            class="field rounded-l-none"
            id="cc-pay"
            name="payment"
            type="number"
            min="0"
            step="10"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 200"
            aria-describedby="cc-pay-error"
          />
        </div>
        <p class="cc-field-error" id="cc-pay-error" data-error-for="payment" hidden></p>
      </div>

      <!-- Conditional: By timeline shows the target months. -->
      <div data-field="months" data-cc-months hidden>
        <label class="field-label" for="cc-mon">Target payoff time</label>
        <div class="flex">
          <input
            class="field rounded-r-none"
            id="cc-mon"
            name="months"
            type="number"
            min="1"
            step="1"
            inputmode="numeric"
            autocomplete="off"
            placeholder="e.g. 24"
            aria-describedby="cc-mon-error"
            disabled
          />
          <span class="field-affix rounded-r-lg border-l-0">months</span>
        </div>
        <p class="cc-field-error" id="cc-mon-error" data-error-for="months" hidden></p>
      </div>
    </div>

    <div class="mt-3 flex items-center gap-3">
      <button type="submit" class="btn btn-primary" data-cc-submit>Calculate Payoff Time</button>
      <button type="button" class="btn btn-secondary" data-reset>Reset</button>
    </div>
    <p class="cc-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result -->
  <ResultShell
    id="cc-result"
    state="empty"
    density="standard"
    label="Credit card payoff result"
    minHeight="22rem"
    placeholderAlignment="center"
  >
    <EmptyResult message="Enter your balance, APR, and payment details, then calculate your payoff." />

    <div data-result-when="valid">
      <ResultSummary label="Estimated payoff time">
        <ResultValue value="—" size="text-4xl" />
      </ResultSummary>

      <p class="cc-explanation" data-cc-explanation hidden></p>

      <div data-cc-breakdown>
        <ResultBreakdown title="Cost breakdown">
          <dl class="cc-metrics">
            <div><dt data-cc-interest-label>Estimated total interest</dt><dd data-cc-interest>—</dd></div>
            <div><dt data-cc-total-label>Estimated total paid</dt><dd data-cc-total>—</dd></div>
          </dl>
          <p class="cc-assumption" data-cc-assumption></p>
          <p class="cc-note">Amounts are in US dollars (USD).</p>
        </ResultBreakdown>
      </div>
    </div>

    <InvalidResult
      title="Check your entries"
      message="Enter your balance, APR, and — depending on the mode — a monthly payment or a target payoff time."
    />

    <ResultAnnouncement id="cc-live" />
  </ResultShell>
</div>

<style>
  .cc-modes {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .seg-group {
    display: inline-flex;
    margin-top: 0.4rem;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    padding: 0.125rem;
  }
  .seg {
    position: relative;
    display: inline-flex;
  }
  .seg input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .seg span {
    padding: 0.35rem 0.9rem;
    border-radius: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }
  .seg:has(input:checked) span {
    background: var(--color-brand-600);
    color: #fff;
  }
  .seg:has(input:focus-visible) span {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }

  .cc-field-error {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .cc-field-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .cc-field-error {
    color: #fca5a5;
  }

  .cc-live-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .cc-explanation {
    margin: 0.6rem 0 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--fg);
  }

  .cc-metrics {
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }
  .cc-metrics > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .cc-metrics dt {
    color: var(--fg);
    font-weight: 600;
  }
  .cc-metrics dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--heading);
    font-weight: 700;
    white-space: nowrap;
  }
  .cc-assumption {
    margin: 0.6rem 0 0;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .cc-note {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { creditCardBinding } from '@lib/calculators/credit-card-form';

  document.querySelectorAll<HTMLElement>('[data-cc]').forEach((root) => {
    mountFormCalculator(root, creditCardBinding, {
      recalculationMode: 'live-after-first',
      calculateButtonLabel: 'Calculate Payoff Time',
    });

    // The island owns the visible mode presentation. The runtime recomputes on the mode
    // radio's structural `input` (unchanged); here we keep the conditional field + action
    // label in step and, on a switch, blank the mode-owned result so no stale value shows
    // under the new mode while the live recompute is pending.
    const submitBtn = root.querySelector<HTMLElement>('[data-cc-submit]');
    const shell = root.querySelector<HTMLElement>('[data-result-shell]');
    const payWrap = root.querySelector<HTMLElement>('[data-cc-payment]');
    const monWrap = root.querySelector<HTMLElement>('[data-cc-months]');
    const payInput = payWrap?.querySelector<HTMLInputElement>('input');
    const monInput = monWrap?.querySelector<HTMLInputElement>('input');
    const isMonths = () => root.querySelector<HTMLInputElement>('[name="mode"]:checked')?.value === 'months';

    const clearError = (name: string) => {
      root.querySelector<HTMLElement>(`[name="${name}"]`)?.removeAttribute('aria-invalid');
      const err = root.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (err) {
        err.textContent = '';
        err.hidden = true;
      }
    };

    const syncMode = () => {
      const months = isMonths();
      if (submitBtn) submitBtn.textContent = months ? 'Calculate Required Payment' : 'Calculate Payoff Time';
      if (payWrap) payWrap.hidden = months;
      if (payInput) payInput.disabled = months;
      if (monWrap) monWrap.hidden = !months;
      if (monInput) monInput.disabled = !months;
      clearError(months ? 'payment' : 'months');
    };

    const blankResult = () => {
      for (const sel of [
        '[data-result-when~="valid"] [data-result-value]',
        '[data-result-when~="valid"] [data-result-value-a11y]',
        '[data-cc-interest]',
        '[data-cc-total]',
        '[data-cc-explanation]',
      ]) {
        const el = root.querySelector<HTMLElement>(sel);
        if (el) el.textContent = '—';
      }
    };

    root.querySelectorAll<HTMLInputElement>('[name="mode"]').forEach((r) =>
      r.addEventListener('change', () => {
        syncMode();
        if (shell?.dataset.resultState === 'valid') blankResult();
      }),
    );
    root.querySelector<HTMLElement>('[data-reset]')?.addEventListener('click', () => {
      const paymentRadio = root.querySelector<HTMLInputElement>('[name="mode"][value="payment"]');
      if (paymentRadio) paymentRadio.checked = true;
      syncMode();
    });
    syncMode();
  });
</script>
