---
/**
 * Payment calculator island (R8B1 — standard-form wave, calculator #14; product
 * family MULTI-MODE, on the standard-form runtime + the small `isUsableResult`
 * extension).
 *
 * Task-first, direct-intent: mode defaults to Fixed term, all fields start EMPTY,
 * the result is empty (an instruction, not the legacy $20,000 / 6% / 5-year sample),
 * and the visitor presses "Calculate Payment" (or "Calculate Payoff Time") for the
 * first result. Live-after-first afterwards. Compute, validation, state, announcement
 * and focus are owned by the shared runtime + the payment binding
 * (@lib/calculators/payment-form).
 *
 * "Solve for" is a native radio group — a STRUCTURAL selector the runtime recomputes
 * on. Its two modes swap ONE conditional field: Fixed term shows the loan term (and
 * solves for the monthly payment); Fixed payment shows the monthly payment (and solves
 * for the payoff time). The island OWNS the conditional field's visibility + the action
 * label: the inactive field is hidden AND disabled (out of the keyboard + a11y order,
 * never submitted), its stale error cleared and its VALUE preserved for an in-session
 * switch back; on a switch the mode-owned result is briefly blanked so no stale value
 * shows under the new mode. The binding owns formula selection, validating only the
 * active field, the mode-specific result — including the informational "Never" payoff —
 * and clearing every value on reset.
 */
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import ResultInterpretation from '@components/result/ResultInterpretation.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
---

<div class="payment mx-auto grid w-full max-w-5xl gap-4 md:grid-cols-2 md:items-start" data-payment>
  <!-- Inputs -->
  <form class="card p-4" data-form novalidate aria-label="Loan payment calculator">
    <fieldset class="pm-modes">
      <legend class="field-label">Solve for</legend>
      <div class="seg-group">
        <label class="seg"><input type="radio" name="mode" value="term" checked /><span>Monthly payment</span></label>
        <label class="seg"><input type="radio" name="mode" value="payment" /><span>Payoff time</span></label>
      </div>
    </fieldset>

    <div class="mt-5 space-y-4">
      <div data-field="principal">
        <label class="field-label" for="pm-principal">Loan amount</label>
        <div class="flex">
          <span class="field-affix rounded-l-lg border-r-0">$</span>
          <input
            class="field rounded-l-none"
            id="pm-principal"
            name="principal"
            type="number"
            min="0"
            step="500"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 20000"
            aria-describedby="pm-principal-error"
          />
        </div>
        <p class="pm-field-error" id="pm-principal-error" data-error-for="principal" hidden></p>
      </div>

      <div data-field="annualRatePct">
        <label class="field-label" for="pm-rate">Interest rate</label>
        <div class="flex">
          <input
            class="field rounded-r-none"
            id="pm-rate"
            name="annualRatePct"
            type="number"
            min="0"
            step="0.1"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 6"
            aria-describedby="pm-rate-error"
          />
          <span class="field-affix rounded-r-lg border-l-0">%</span>
        </div>
        <p class="pm-field-error" id="pm-rate-error" data-error-for="annualRatePct" hidden></p>
      </div>

      <!-- Conditional: Fixed term shows the loan term. -->
      <div data-field="termYears" data-pm-term>
        <label class="field-label" for="pm-term">Loan term</label>
        <div class="flex">
          <input
            class="field rounded-r-none"
            id="pm-term"
            name="termYears"
            type="number"
            min="0"
            step="0.5"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 5"
            aria-describedby="pm-term-error"
          />
          <span class="field-affix rounded-r-lg border-l-0">years</span>
        </div>
        <p class="pm-field-error" id="pm-term-error" data-error-for="termYears" hidden></p>
      </div>

      <!-- Conditional: Fixed payment shows the monthly payment. -->
      <div data-field="payment" data-pm-payment hidden>
        <label class="field-label" for="pm-payment">Monthly payment</label>
        <div class="flex">
          <span class="field-affix rounded-l-lg border-r-0">$</span>
          <input
            class="field rounded-l-none"
            id="pm-payment"
            name="payment"
            type="number"
            min="0"
            step="10"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 400"
            aria-describedby="pm-payment-error"
            disabled
          />
        </div>
        <p class="pm-field-error" id="pm-payment-error" data-error-for="payment" hidden></p>
      </div>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <button type="submit" class="btn btn-primary" data-pm-submit>Calculate Payment</button>
      <button type="button" class="btn btn-secondary" data-reset>Reset</button>
    </div>
    <p class="pm-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result -->
  <ResultShell
    id="pm-result"
    state="empty"
    density="standard"
    label="Loan payment result"
    minHeight="18rem"
    placeholderAlignment="center"
  >
    <EmptyResult message="Enter the loan details, then calculate the payment or payoff time." />

    <div data-result-when="valid">
      <ResultSummary label="Estimated monthly payment">
        <ResultValue value="—" size="text-4xl" />
      </ResultSummary>
      <ResultInterpretation>
        <span data-pm-detail></span>
      </ResultInterpretation>
    </div>

    <InvalidResult
      title="Check your entries"
      message="Enter the loan amount, interest rate, and — depending on the mode — a term or a monthly payment."
    />

    <ResultAnnouncement id="pm-live" />
  </ResultShell>
</div>

<style>
  .pm-modes {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .seg-group {
    display: inline-flex;
    margin-top: 0.4rem;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    padding: 0.125rem;
  }
  .seg {
    position: relative;
    display: inline-flex;
  }
  .seg input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .seg span {
    padding: 0.35rem 0.9rem;
    border-radius: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }
  .seg:has(input:checked) span {
    background: var(--color-brand-600);
    color: #fff;
  }
  .seg:has(input:focus-visible) span {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }

  .pm-field-error {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .pm-field-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .pm-field-error {
    color: #fca5a5;
  }

  .pm-live-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { paymentBinding } from '@lib/calculators/payment-form';

  document.querySelectorAll<HTMLElement>('[data-payment]').forEach((root) => {
    mountFormCalculator(root, paymentBinding, {
      recalculationMode: 'live-after-first',
      calculateButtonLabel: 'Calculate Payment',
    });

    // The island owns the visible mode presentation. The runtime recomputes on the
    // mode radio's structural `input` (unchanged); here we keep the conditional field
    // + action label in step and, on a switch, blank the mode-owned result so no stale
    // value shows under the new mode while the live recompute is pending.
    const submitBtn = root.querySelector<HTMLElement>('[data-pm-submit]');
    const shell = root.querySelector<HTMLElement>('[data-result-shell]');
    const termWrap = root.querySelector<HTMLElement>('[data-pm-term]');
    const payWrap = root.querySelector<HTMLElement>('[data-pm-payment]');
    const termInput = termWrap?.querySelector<HTMLInputElement>('input');
    const payInput = payWrap?.querySelector<HTMLInputElement>('input');
    const isPayoff = () => root.querySelector<HTMLInputElement>('[name="mode"]:checked')?.value === 'payment';

    const clearError = (name: string) => {
      root.querySelector<HTMLElement>(`[name="${name}"]`)?.removeAttribute('aria-invalid');
      const err = root.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (err) {
        err.textContent = '';
        err.hidden = true;
      }
    };

    // Conditional field: term XOR monthly payment. The inactive field is hidden AND
    // disabled (out of the keyboard + a11y order, never submitted); its stale error is
    // cleared and its entered VALUE preserved for an in-session switch back. The binding
    // excludes it from validation by mode and clears every value on reset.
    const syncMode = () => {
      const payoff = isPayoff();
      if (submitBtn) submitBtn.textContent = payoff ? 'Calculate Payoff Time' : 'Calculate Payment';
      if (termWrap) termWrap.hidden = payoff;
      if (termInput) termInput.disabled = payoff;
      if (payWrap) payWrap.hidden = !payoff;
      if (payInput) payInput.disabled = !payoff;
      clearError(payoff ? 'termYears' : 'payment');
    };

    const blankResult = () => {
      for (const sel of [
        '[data-result-when~="valid"] [data-result-value]',
        '[data-result-when~="valid"] [data-result-value-a11y]',
        '[data-pm-detail]',
      ]) {
        const el = root.querySelector<HTMLElement>(sel);
        if (el) el.textContent = '—';
      }
    };

    root.querySelectorAll<HTMLInputElement>('[name="mode"]').forEach((r) =>
      r.addEventListener('change', () => {
        syncMode();
        if (shell?.dataset.resultState === 'valid') blankResult();
      }),
    );
    root.querySelector<HTMLElement>('[data-reset]')?.addEventListener('click', () => {
      const termRadio = root.querySelector<HTMLInputElement>('[name="mode"][value="term"]');
      if (termRadio) termRadio.checked = true;
      syncMode();
    });
    syncMode();
  });
</script>
