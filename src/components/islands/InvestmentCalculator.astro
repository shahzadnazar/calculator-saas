---
/**
 * Investment calculator island (R11D1 — task-first migration, finance complex-form family).
 *
 * Task-first, summary-only: all fields start EMPTY, the result is empty, and the visitor presses
 * "Calculate Investment Growth" for the first result; live-after-first afterwards. Compute, validation,
 * state, announcement and focus are owned by the shared runtime + the investment binding
 * (@lib/calculators/investment-form), which wraps the UNCHANGED calculateInvestment / shared
 * compound-interest engine. The complete-result guard lives in the binding's resultValue (a NaN
 * sentinel) — NO isUsableResult. The latent yearly series is NOT rendered.
 *
 * No structural selector. Starting investment + monthly contribution are each optional but COLLECTIVELY
 * must fund the projection — a FORM-level funding error (Triangle precedent): the runtime shows/announces
 * it, and the island returns focus to Starting investment on an explicit submit and reveals the
 * funding-group message (associated with both funding fields via aria-describedby). The output is a
 * NOMINAL projection; investment growth may be negative and is shown SIGNED. The supplemental proportion
 * bar is aria-hidden (the text conveys every value) and is hidden entirely for negative growth so no
 * invalid width is produced.
 */
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
---

<div class="investment mx-auto grid w-full max-w-5xl gap-6 md:grid-cols-2 md:items-start" data-investment>
  <!-- Inputs -->
  <form class="card p-5 sm:p-6" data-form novalidate aria-label="Investment calculator">
    <div class="space-y-4">
      <div data-inv-funding>
        <div data-field="startingAmount">
          <label class="field-label" for="inv-start">Starting investment (USD)</label>
          <div class="flex">
            <span class="field-affix rounded-l-lg border-r-0">$</span>
            <input class="field rounded-l-none" id="inv-start" name="startingAmount" type="number" min="0" step="500" inputmode="decimal" autocomplete="off" placeholder="e.g. 10000" aria-describedby="inv-start-error inv-funding-error" />
          </div>
          <p class="inv-field-error" id="inv-start-error" data-error-for="startingAmount" hidden></p>
        </div>

        <div class="mt-4" data-field="monthlyContribution">
          <label class="field-label" for="inv-monthly">Monthly contribution (USD)</label>
          <div class="flex">
            <span class="field-affix rounded-l-lg border-r-0">$</span>
            <input class="field rounded-l-none" id="inv-monthly" name="monthlyContribution" type="number" min="0" step="50" inputmode="decimal" autocomplete="off" placeholder="e.g. 300" aria-describedby="inv-monthly-error inv-funding-error" />
          </div>
          <p class="inv-field-error" id="inv-monthly-error" data-error-for="monthlyContribution" hidden></p>
        </div>

        <p class="inv-field-error" id="inv-funding-error" data-inv-funding-error hidden>Enter a starting investment or a monthly contribution greater than zero.</p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div data-field="annualReturnPct">
          <label class="field-label" for="inv-return">Expected annual return</label>
          <div class="flex">
            <input class="field rounded-r-none" id="inv-return" name="annualReturnPct" type="number" step="0.1" inputmode="decimal" autocomplete="off" placeholder="e.g. 7" aria-describedby="inv-return-error" />
            <span class="field-affix rounded-r-lg border-l-0">%</span>
          </div>
          <p class="inv-field-error" id="inv-return-error" data-error-for="annualReturnPct" hidden></p>
        </div>
        <div data-field="years">
          <label class="field-label" for="inv-years">Projection period (years)</label>
          <input class="field" id="inv-years" name="years" type="number" min="1" max="100" step="1" inputmode="numeric" autocomplete="off" placeholder="e.g. 25" aria-describedby="inv-years-error" />
          <p class="inv-field-error" id="inv-years-error" data-error-for="years" hidden></p>
        </div>
      </div>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <button type="submit" class="btn btn-primary" data-inv-submit>Calculate Investment Growth</button>
      <button type="button" class="btn btn-secondary" data-reset>Reset</button>
    </div>
    <p class="inv-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result -->
  <ResultShell id="inv-result" state="empty" density="complex" label="Investment result" minHeight="20rem">
    <EmptyResult message="Enter a starting investment or a monthly contribution, an expected annual return, and a projection period, then calculate your projected investment value." />

    <div data-result-when="valid">
      <ResultSummary label="Projected investment value">
        <ResultValue value="—" size="text-4xl" />
      </ResultSummary>

      <p class="inv-interpretation" data-inv-interpretation></p>

      <div class="inv-bar" data-inv-bar aria-hidden="true">
        <span class="inv-seg" style="width:0%; background: var(--color-brand-600)" data-inv-seg="start"></span>
        <span class="inv-seg" style="width:0%; background: #64748b" data-inv-seg="contrib"></span>
        <span class="inv-seg" style="width:0%; background: var(--color-accent-500)" data-inv-seg="earn"></span>
      </div>

      <dl class="inv-metrics">
        <div><dt><span class="inv-dot" style="background: var(--color-brand-600)"></span>Starting investment</dt><dd data-inv-start>—</dd></div>
        <div><dt><span class="inv-dot" style="background: #64748b"></span>Total contributions</dt><dd data-inv-contrib>—</dd></div>
        <div><dt><span class="inv-dot" style="background: var(--color-accent-500)"></span>Investment growth</dt><dd data-inv-earn>—</dd></div>
      </dl>

      <p class="inv-assumptions">This is a <strong>nominal</strong> projection assuming monthly compounding and monthly contributions made at the end of each period. It does not adjust for inflation, taxes or investment fees. Amounts are in US dollars (USD).</p>
    </div>

    <InvalidResult
      title="Check your entries"
      message="Enter a starting investment or a monthly contribution, an expected annual return, and a whole projection period from 1 to 100 years."
    />

    <ResultAnnouncement id="inv-live" />
  </ResultShell>
</div>

<style>
  .inv-field-error {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .inv-field-error { color: #fca5a5; }
  }
  :root[data-theme='dark'] .inv-field-error { color: #fca5a5; }

  .inv-live-note { margin-top: 0.75rem; font-size: 0.8rem; color: var(--muted); }

  .inv-interpretation { margin: 0.6rem 0 0; font-size: 0.95rem; line-height: 1.5; color: var(--fg); }

  .inv-bar {
    margin-top: 1.1rem;
    display: flex;
    height: 0.75rem;
    width: 100%;
    overflow: hidden;
    border-radius: 9999px;
    background: var(--subtle);
  }
  .inv-seg { display: block; height: 100%; }

  .inv-metrics { margin: 1.1rem 0 0; display: grid; gap: 0.25rem; }
  .inv-metrics > div {
    display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
    padding: 0.4rem 0; border-bottom: 1px solid var(--line); font-size: 0.95rem;
  }
  .inv-metrics dt { display: flex; align-items: center; gap: 0.5rem; color: var(--fg); font-weight: 600; }
  .inv-metrics dd { margin: 0; font-variant-numeric: tabular-nums; color: var(--heading); font-weight: 700; white-space: nowrap; }
  .inv-dot { display: inline-block; height: 0.6rem; width: 0.6rem; border-radius: 9999px; flex: none; }

  .inv-assumptions { margin: 0.9rem 0 0; font-size: 0.78rem; line-height: 1.5; color: var(--muted); }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { investmentBinding, validateInvestmentValues } from '@lib/calculators/investment-form';

  document.querySelectorAll<HTMLElement>('[data-investment]').forEach((root) => {
    mountFormCalculator(root, investmentBinding, {
      recalculationMode: 'live-after-first',
      calculateButtonLabel: 'Calculate Investment Growth',
    });

    // The runtime owns field-error focus; the island owns the field-less FUNDING error (both amounts
    // collectively zero — the Triangle domain-error precedent). On an explicit submit that fails funding,
    // return the visitor to Starting investment and reveal the funding-group message (aria-describedby
    // ties it to both funding fields). Live edits keep it in step and never move focus.
    const form = root.querySelector<HTMLFormElement>('[data-form]');
    const fundingError = root.querySelector<HTMLElement>('[data-inv-funding-error]');
    const start = root.querySelector<HTMLInputElement>('[name="startingAmount"]');

    const fundingFailure = () => {
      const v = validateInvestmentValues(investmentBinding.readValues(root));
      return !v.ok && Boolean(v.formError);
    };
    const syncFunding = () => {
      if (fundingError) fundingError.hidden = !fundingFailure();
    };

    form?.addEventListener('submit', () => {
      syncFunding();
      if (fundingFailure()) start?.focus();
    });
    form?.addEventListener('input', syncFunding);
    root.querySelector<HTMLElement>('[data-reset]')?.addEventListener('click', () => {
      if (fundingError) fundingError.hidden = true;
    });
  });
</script>
