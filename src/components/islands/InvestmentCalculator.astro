---
import { calculateInvestment } from '@lib/calculators/investment';
import { formatCurrency, formatCurrencyRounded } from '@lib/format';

const defaults = { startingAmount: 10000, monthlyContribution: 300, annualReturnPct: 7, years: 25 };
const r = calculateInvestment(defaults);
const pct = (v: number) => (r.futureValue ? (v / r.futureValue) * 100 : 0);
---

<div class="mx-auto grid w-full max-w-5xl gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]" data-investment>
  <form class="card p-5 sm:p-6" data-inv-form novalidate>
    <div class="space-y-4">
      <div>
        <label class="field-label" for="inv-start">Starting amount</label>
        <div class="flex"><span class="field-affix rounded-l-lg border-r-0">$</span><input class="field rounded-l-none" id="inv-start" name="startingAmount" type="number" min="0" step="500" value={defaults.startingAmount} inputmode="decimal" /></div>
      </div>
      <div>
        <label class="field-label" for="inv-monthly">Monthly contribution</label>
        <div class="flex"><span class="field-affix rounded-l-lg border-r-0">$</span><input class="field rounded-l-none" id="inv-monthly" name="monthlyContribution" type="number" min="0" step="50" value={defaults.monthlyContribution} inputmode="decimal" /></div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="field-label" for="inv-return">Annual return</label>
          <div class="flex"><input class="field rounded-r-none" id="inv-return" name="annualReturnPct" type="number" min="0" step="0.1" value={defaults.annualReturnPct} inputmode="decimal" /><span class="field-affix rounded-r-lg border-l-0">%</span></div>
        </div>
        <div>
          <label class="field-label" for="inv-years">Years</label>
          <input class="field" id="inv-years" name="years" type="number" min="1" step="1" value={defaults.years} inputmode="decimal" />
        </div>
      </div>
    </div>
  </form>

  <div class="card p-5 sm:p-6">
    <p class="result-label">Projected value</p>
    <p class="mt-1 text-4xl result-value" data-inv-fv>{formatCurrency(r.futureValue)}</p>
    <div class="mt-5 flex h-3 w-full overflow-hidden rounded-full" style="background: var(--subtle)" aria-hidden="true">
      <span style={`width:${pct(r.startingAmount)}%; background: var(--color-brand-600)`} data-inv-seg="start"></span>
      <span style={`width:${pct(r.totalContributions)}%; background: #64748b`} data-inv-seg="contrib"></span>
      <span style={`width:${pct(r.totalEarnings)}%; background: var(--color-accent-500)`} data-inv-seg="earn"></span>
    </div>
    <dl class="mt-5 space-y-2 text-sm">
      <div class="flex items-center justify-between"><dt class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full" style="background: var(--color-brand-600)"></span>Starting amount</dt><dd class="font-semibold" data-inv-start>{formatCurrencyRounded(r.startingAmount)}</dd></div>
      <div class="flex items-center justify-between"><dt class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full" style="background: #64748b"></span>Contributions</dt><dd class="font-semibold" data-inv-contrib>{formatCurrencyRounded(r.totalContributions)}</dd></div>
      <div class="flex items-center justify-between"><dt class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full" style="background: var(--color-accent-500)"></span>Investment earnings</dt><dd class="font-semibold" data-inv-earn>{formatCurrencyRounded(r.totalEarnings)}</dd></div>
    </dl>
  </div>
</div>

<script>
  import { calculateInvestment } from '@lib/calculators/investment';
  import { formatCurrency, formatCurrencyRounded } from '@lib/format';
  document.querySelectorAll<HTMLElement>('[data-investment]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-inv-form]')!;
    const num = (n: string) => Number((form.elements.namedItem(n) as HTMLInputElement)?.value) || 0;
    const set = (sel: string, v: string) => { const el = root.querySelector<HTMLElement>(sel); if (el) el.textContent = v; };
    function recompute() {
      const r = calculateInvestment({ startingAmount: num('startingAmount'), monthlyContribution: num('monthlyContribution'), annualReturnPct: num('annualReturnPct'), years: num('years') });
      const pct = (v: number) => (r.futureValue ? (v / r.futureValue) * 100 : 0);
      set('[data-inv-fv]', formatCurrency(r.futureValue));
      set('[data-inv-start]', formatCurrencyRounded(r.startingAmount));
      set('[data-inv-contrib]', formatCurrencyRounded(r.totalContributions));
      set('[data-inv-earn]', formatCurrencyRounded(r.totalEarnings));
      const segs: Record<string, number> = { start: r.startingAmount, contrib: r.totalContributions, earn: r.totalEarnings };
      root.querySelectorAll<HTMLElement>('[data-inv-seg]').forEach((el) => { el.style.width = `${pct(segs[el.dataset.invSeg!] ?? 0)}%`; });
    }
    form.addEventListener('input', recompute);
    recompute();
  });
</script>
