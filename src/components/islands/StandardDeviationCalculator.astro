---
/**
 * Standard deviation island — the reference's calculator, its working and its margin of error.
 *
 * This used to be the statistics island wearing a different hero. It is not the same tool: it asks
 * whether the numbers are a population or a sample, which changes the divisor and every symbol
 * below it, and it answers with the derivation, the confidence intervals around the mean and a
 * frequency table. None of that belongs in a descriptive-statistics summary, and the summary's
 * table does not belong here.
 *
 * The result sits directly under the box that produced it, full width, because the working and the
 * two tables need the width and because the answer should be where the visitor is already looking
 * when they press Calculate.
 *
 * Runs on the UNCHANGED standard-form runtime; the complete-result guard lives in `resultValue`,
 * and there is no `isUsableResult`.
 */
import ResultShell from '@components/result/ResultShell.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';
---

<div class="sd mx-auto w-full max-w-4xl" data-sd>
  <form class="card sd-card" data-form novalidate aria-label="Standard deviation calculator">
    <label class="field-label" for="sd-input">Numbers</label>
    <textarea
      class="field mt-1 sd-input font-mono"
      id="sd-input"
      name="values"
      rows="4"
      spellcheck="false"
      inputmode="decimal"
      autocomplete="off"
      placeholder="10, 12, 23, 23, 16, 23, 21, 16"
      aria-describedby="sd-help sd-values-error"></textarea>
    <p class="sd-field-error" id="sd-values-error" data-error-for="values" hidden></p>
    <p class="sd-help" id="sd-help">Separate them with commas, spaces or new lines.</p>

    <fieldset class="sd-mode">
      <legend class="sd-mode__legend">It is a</legend>
      <label class="sd-radio">
        <input type="radio" name="mode" value="population" checked />
        <span>Population</span>
      </label>
      <label class="sd-radio">
        <input type="radio" name="mode" value="sample" />
        <span>Sample</span>
      </label>
      <p class="sd-mode__hint">
        A <strong>population</strong> is every member of the group you care about, and divides by
        N. A <strong>sample</strong> is a subset drawn from a larger group, and divides by n − 1.
      </p>
    </fieldset>

    <div class="mt-4 flex items-center gap-3">
      <button type="submit" class="btn btn-primary" data-sd-submit>Calculate</button>
      <button type="button" class="btn btn-secondary" data-reset>Clear</button>
    </div>
    <p class="sd-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <ResultShell id="sd-result" state="empty" density="complex" label="Standard deviation result" minHeight="0" class="sd-result">
    <ExampleNotice />
    <EmptyResult message="Enter your numbers, say whether they are a population or a sample, then calculate." />

    <div data-result-when="valid">
      <p class="sd-headline">
        <span class="sd-headline__label" data-sd-label>Standard Deviation, σ:</span>
        <span class="sd-headline__value" data-result-value>—</span>
      </p>
      <span class="sr-only" data-result-value-a11y></span>

      <dl class="sd-summary">
        <div><dt data-sd-count-label>Count, N:</dt><dd data-sd-count>—</dd></div>
        <div><dt>Sum, Σx:</dt><dd data-sd-sum>—</dd></div>
        <div><dt data-sd-mean-label>Mean, μ:</dt><dd data-sd-mean>—</dd></div>
        <div><dt data-sd-variance-label>Variance, σ²:</dt><dd data-sd-variance>—</dd></div>
      </dl>

      <h3 class="sd-heading">Steps</h3>
      <p class="sd-formula" data-sd-formula></p>
      <div class="sd-steps" data-sd-steps></div>

      <h3 class="sd-heading">Margin of Error (Confidence Interval)</h3>
      <p class="sd-prose">
        The sampling mean most likely follows a normal distribution, so the standard error of the
        mean is the standard deviation divided by the square root of the count:
      </p>
      <p class="sd-formula" data-sd-sem></p>
      <p class="sd-prose">
        These are the margins of error at each confidence level. Depending on the field, 95% is the
        level usually reported.
      </p>
      <div class="sd-scroll">
        <table class="sd-table">
          <thead>
            <tr><th scope="col">Confidence Level</th><th scope="col">Margin of Error</th><th scope="col">Error Bar</th></tr>
          </thead>
          <tbody data-sd-confidence></tbody>
        </table>
      </div>

      <h3 class="sd-heading">Frequency Table</h3>
      <div class="sd-scroll">
        <table class="sd-table sd-table--narrow">
          <thead>
            <tr><th scope="col">Value</th><th scope="col">Frequency</th></tr>
          </thead>
          <tbody data-sd-frequency></tbody>
        </table>
      </div>
    </div>

    <InvalidResult
      title="Check your numbers"
      message="Enter at least one number, separated by commas, spaces or new lines. A sample needs at least two."
    />

    <ResultAnnouncement id="sd-live" />
  </ResultShell>
</div>

<style>
  .sd-card { padding: 0.85rem; }
  .sd-input { min-height: 5.5rem; }
  .sd-help { margin-top: 0.4rem; font-size: 0.8rem; color: var(--muted); }
  .sd-live-note { margin-top: 0.6rem; font-size: 0.8rem; color: var(--muted); }

  .sd-field-error {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.35;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .sd-field-error { color: #fca5a5; }
  }
  :root[data-theme='dark'] .sd-field-error { color: #fca5a5; }

  /* The one question this calculator asks that the statistics table never does. */
  .sd-mode {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    margin: 0.7rem 0 0;
    padding: 0;
    border: 0;
  }
  .sd-mode__legend {
    float: left;
    padding: 0;
    margin-right: 0.6rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--fg);
  }
  .sd-radio {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--fg);
    cursor: pointer;
  }
  .sd-mode__hint {
    flex: 1 1 100%;
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--muted);
  }

  /* ResultShell owns this element, so it is reached with :global(). */
  .sd :global(.sd-result) {
    margin-top: 1rem;
  }

  .sd-headline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
  }
  .sd-headline__label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--muted);
  }
  .sd-headline__value {
    font-size: clamp(1.35rem, 5vw, 1.9rem);
    font-weight: 800;
    color: var(--heading);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  .sd-summary {
    margin: 0.8rem 0 0;
    display: grid;
    gap: 0.15rem;
    max-width: 22rem;
  }
  .sd-summary > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.9rem;
  }
  .sd-summary dt { color: var(--muted); font-weight: 600; }
  .sd-summary dd {
    margin: 0;
    color: var(--heading);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  .sd-heading {
    margin: 1.25rem 0 0.4rem;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--heading);
  }
  .sd-prose {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--fg);
    max-width: 68ch;
  }
  .sd-formula {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--heading);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  /* Built in JS, so its rules must be :global() beneath an element the template owns. */
  .sd-steps { display: grid; gap: 0.25rem; }
  .sd :global(.sd-step) {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.4rem;
    align-items: baseline;
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
  }
  .sd :global(.sd-step__lead) {
    text-align: right;
    font-weight: 700;
    color: var(--muted);
  }
  .sd :global(.sd-step__body) {
    color: var(--heading);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  /* Wide tables scroll in their own container; the page never scrolls sideways. */
  .sd-scroll { overflow-x: auto; }
  .sd-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .sd-table--narrow { max-width: 22rem; }
  /* The body rows are built in JS, so their rules must be :global() — Astro's scoping only reaches
     markup it compiled itself, and without this the cells lose their padding, rule and alignment. */
  .sd-table th,
  .sd-table td,
  .sd :global(.sd-table tbody th),
  .sd :global(.sd-table tbody td) {
    padding: 0.35rem 0.55rem;
    text-align: left;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }
  .sd-table thead th {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--muted);
    white-space: nowrap;
  }
  .sd :global(.sd-table tbody th) {
    font-weight: 600;
    color: var(--fg);
    white-space: nowrap;
  }
  .sd :global(.sd-table tbody td) {
    color: var(--heading);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .sd :global(.sd-bar-cell) { width: 40%; min-width: 9rem; }

  /* The mean drawn on a 0 → mean + margin axis, with the ± whisker across it. */
  .sd :global(.sd-bar) {
    position: relative;
    height: 1.1rem;
    width: 100%;
    min-width: 8rem;
  }
  .sd :global(.sd-bar__fill) {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: 0.15rem;
    background: color-mix(in srgb, var(--color-brand-500) 45%, transparent);
  }
  .sd :global(.sd-bar__whisker) {
    position: absolute;
    top: calc(50% - 1px);
    height: 2px;
    background: var(--color-danger, #dc2626);
  }
  .sd :global(.sd-bar__whisker::before),
  .sd :global(.sd-bar__whisker::after) {
    content: '';
    position: absolute;
    top: -0.3rem;
    width: 2px;
    height: 0.8rem;
    background: var(--color-danger, #dc2626);
  }
  .sd :global(.sd-bar__whisker::before) { left: 0; }
  .sd :global(.sd-bar__whisker::after) { right: 0; }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { standardDeviationBinding, SD_EXAMPLE_VALUES } from '@lib/calculators/standard-deviation-form';

  document.querySelectorAll<HTMLElement>('[data-sd]').forEach((root) => {
    mountFormCalculator(root, standardDeviationBinding, {
      recalculationMode: 'live-after-first',
      example: { values: SD_EXAMPLE_VALUES },
      calculateButtonLabel: 'Calculate',
    });
  });
</script>
