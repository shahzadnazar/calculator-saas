---
/**
 * VAT island — the reference's four-field solver on the UNCHANGED standard-form runtime.
 *
 * VAT rate, net price, gross price, tax amount: fill any two, leave two blank, and the blanks
 * are what get worked out. There is deliberately NO mode selector — the blank fields are the
 * mode, so the tool can never be set to one thing while you are typing another.
 *
 * All four start empty, because none of them is more "the input" than the others.
 *
 * Amounts carry no currency symbol on purpose: VAT is levied in more than 170 countries, and
 * the tool works the same in every one of them.
 */
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import ResultInterpretation from '@components/result/ResultInterpretation.astro';
import ResultBreakdown from '@components/result/ResultBreakdown.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';
---

<div class="vatcalc mx-auto grid w-full max-w-4xl gap-6 md:grid-cols-2 md:items-start" data-vat>
  <!-- Inputs -->
  <form class="card p-4" data-form novalidate aria-label="VAT calculator">
    <p class="vat-lede">Fill in any two and leave the other two blank — those are the ones worked out.</p>

    <div class="vat-fields">
      <div class="vat-row" data-field="rate">
        <label class="field-label vat-row__label" for="vat-rate">VAT rate</label>
        <div class="vat-money">
          <input class="field vat-input vat-input--pct" id="vat-rate" name="rate" type="number" min="0" step="any" inputmode="decimal" autocomplete="off" placeholder="20" aria-describedby="vat-rate-error" />
          <span class="vat-affix vat-affix--suffix">%</span>
        </div>
      </div>
      <p class="vat-error" id="vat-rate-error" data-error-for="rate" hidden></p>

      <div class="vat-row" data-field="net">
        <label class="field-label vat-row__label" for="vat-net">Net price</label>
        <div class="vat-money">
          <input class="field vat-input" id="vat-net" name="net" type="number" min="0" step="any" inputmode="decimal" autocomplete="off" placeholder="1200" aria-describedby="vat-net-hint vat-net-error" />
        </div>
      </div>
      <p class="vat-hint" id="vat-net-hint">Price before VAT</p>
      <p class="vat-error" id="vat-net-error" data-error-for="net" hidden></p>

      <div class="vat-row" data-field="gross">
        <label class="field-label vat-row__label" for="vat-gross">Gross price</label>
        <div class="vat-money">
          <input class="field vat-input" id="vat-gross" name="gross" type="number" min="0" step="any" inputmode="decimal" autocomplete="off" placeholder="1440" aria-describedby="vat-gross-hint vat-gross-error" />
        </div>
      </div>
      <p class="vat-hint" id="vat-gross-hint">Price including VAT</p>
      <p class="vat-error" id="vat-gross-error" data-error-for="gross" hidden></p>

      <div class="vat-row" data-field="tax">
        <label class="field-label vat-row__label" for="vat-tax">Tax amount</label>
        <div class="vat-money">
          <input class="field vat-input" id="vat-tax" name="tax" type="number" min="0" step="any" inputmode="decimal" autocomplete="off" placeholder="240" aria-describedby="vat-tax-hint vat-tax-error" />
        </div>
      </div>
      <p class="vat-hint" id="vat-tax-hint">The VAT itself</p>
      <p class="vat-error" id="vat-tax-error" data-error-for="tax" hidden></p>
    </div>

    <div class="vat-actions">
      <button type="submit" class="btn btn-primary vat-btn">Calculate VAT</button>
      <button type="button" class="btn btn-secondary vat-btn" data-reset>Clear</button>
    </div>
    <p class="vat-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result -->
  <ResultShell id="vat-result" state="example" density="standard" label="VAT result" minHeight="16rem" placeholderAlignment="center">
    <ExampleNotice caption="Sample: a net price of 1,200 at a 20% VAT rate." />
    <EmptyResult message="Enter any two of the four, then calculate." />

    <div data-result-when="valid">
      <ResultSummary label="Gross price">
        <ResultValue value="—" size="text-4xl" />
      </ResultSummary>
      <ResultInterpretation>
        <span data-vat-interpretation></span>
      </ResultInterpretation>

      <ResultBreakdown title="All four figures">
        <dl class="vat-metrics">
          <div data-vat-row="ratePct">
            <dt>VAT rate<span class="vat-tag" data-vat-tag hidden>worked out</span></dt>
            <dd data-vat-rate>—</dd>
          </div>
          <div data-vat-row="net">
            <dt>Net price<span class="vat-tag" data-vat-tag hidden>worked out</span></dt>
            <dd data-vat-net>—</dd>
          </div>
          <div data-vat-row="tax">
            <dt>Tax amount<span class="vat-tag" data-vat-tag hidden>worked out</span></dt>
            <dd data-vat-tax>—</dd>
          </div>
          <div data-vat-row="gross">
            <dt>Gross price<span class="vat-tag" data-vat-tag hidden>worked out</span></dt>
            <dd data-vat-gross>—</dd>
          </div>
        </dl>
        <p class="vat-note">Amounts are currency-neutral — the arithmetic is the same in any currency.</p>
      </ResultBreakdown>
    </div>

    <InvalidResult
      title="Check your entries"
      message="Fill in exactly two of the four, using a VAT rate of zero or more and amounts of zero or more."
    />

    <ResultAnnouncement id="vat-live" />
  </ResultShell>
</div>

<style>
  .vat-lede {
    margin: 0 0 0.75rem;
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .vat-fields {
    display: grid;
    gap: 0.1rem;
  }

  .vat-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.3rem 0 0.1rem;
  }
  .vat-row__label {
    margin: 0;
    font-size: 0.9rem;
  }

  .vat-money {
    display: inline-flex;
    align-items: stretch;
    flex: 0 0 auto;
  }
  .vat-affix {
    display: inline-flex;
    align-items: center;
    padding: 0 0.55rem;
    border: 1px solid var(--line);
    border-left: 0;
    border-radius: 0 0.5rem 0.5rem 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .vat-input {
    width: 9rem;
    min-height: 2.75rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  /* The rate is the only field with an affix, so it is narrowed by the affix's own width —
     input + "%" then measures the same 9rem as the three bare amount fields and all four
     right edges line up. */
  .vat-input--pct {
    width: 7rem;
    border-radius: 0.5rem 0 0 0.5rem;
  }

  /* Sits under its field, in the label column's shadow, so the four rows still scan as a
     stack of four rather than eight. */
  .vat-hint {
    margin: 0 0 0.2rem;
    font-size: 0.74rem;
    line-height: 1.3;
    color: var(--muted);
  }

  .vat-error {
    margin: 0 0 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .vat-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .vat-error {
    color: #fca5a5;
  }

  .vat-actions {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .vat-btn {
    min-height: 2.75rem;
  }
  .vat-live-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .vat-metrics {
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }
  .vat-metrics > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .vat-metrics > div:last-child {
    border-bottom: 0;
  }
  .vat-metrics dt {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    color: var(--fg);
    font-weight: 600;
  }
  .vat-metrics dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--heading);
    font-weight: 700;
    white-space: nowrap;
  }

  /* Which two the tool supplied. A WORD, not a colour — the tag is the meaning and the
     weight change merely follows it. */
  .vat-tag {
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-brand-600);
  }
  .vat-metrics > div[data-vat-derived='false'] dd {
    font-weight: 600;
    color: var(--fg);
  }

  .vat-note {
    margin: 0.6rem 0 0;
    font-size: 0.76rem;
    line-height: 1.4;
    color: var(--muted);
  }

  @media (max-width: 26rem) {
    .vat-row {
      flex-wrap: wrap;
    }
    .vat-input {
      width: 7rem;
    }
    .vat-input--pct {
      width: 5rem;
    }
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { vatBinding, VAT_EXAMPLE_VALUES } from '@lib/calculators/vat-form';

  document.querySelectorAll<HTMLElement>('[data-vat]').forEach((root) => {
    mountFormCalculator(root, vatBinding, {
      recalculationMode: 'live-after-first',
      example: { values: VAT_EXAMPLE_VALUES },
      calculateButtonLabel: 'Calculate VAT',
    });

    // Blank the four figures whenever the shell leaves the valid state, so nothing stale
    // lingers behind the hidden valid region. Presentation only.
    const shell = root.querySelector<HTMLElement>('[data-result-shell]');
    if (shell) {
      new MutationObserver(() => {
        if (shell.dataset.resultState === 'valid') return;
        root
          .querySelectorAll<HTMLElement>('[data-vat-rate], [data-vat-net], [data-vat-tax], [data-vat-gross]')
          .forEach((el) => {
            el.textContent = '—';
          });
        root.querySelectorAll<HTMLElement>('[data-vat-tag]').forEach((el) => {
          el.hidden = true;
        });
      }).observe(shell, { attributes: true, attributeFilter: ['data-result-state'] });
    }
  });
</script>
