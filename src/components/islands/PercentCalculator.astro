---
/**
 * Percentage calculator island — three common questions in one view.
 * SSR defaults + live recompute via src/lib/calculators/percent.ts.
 */
import { percentOf, whatPercent, percentChange } from '@lib/calculators/percent';
import { formatNumber } from '@lib/format';

const d = { a1: 15, b1: 200, a2: 30, b2: 200, a3: 200, b3: 250 };
const fmt = (v: number) => (Number.isNaN(v) ? '—' : formatNumber(v, 2));
---

<div class="mx-auto grid w-full max-w-4xl gap-4 sm:grid-cols-1" data-percent>
  <!-- Mode 1 -->
  <div class="card p-5" data-pc-row="of">
    <p class="result-label">What is a percentage of a number?</p>
    <div class="mt-3 flex flex-wrap items-center gap-2 text-lg">
      <span>What is</span>
      <input class="field w-24" type="number" data-pc="p" value={d.a1} inputmode="decimal" aria-label="percent" />
      <span>% of</span>
      <input class="field w-32" type="number" data-pc="v" value={d.b1} inputmode="decimal" aria-label="value" />
      <span>=</span>
      <strong class="text-xl" style="color: var(--color-brand-700)" data-pc-out>{fmt(percentOf(d.a1, d.b1))}</strong>
    </div>
  </div>

  <!-- Mode 2 -->
  <div class="card p-5" data-pc-row="what">
    <p class="result-label">A number is what percent of another?</p>
    <div class="mt-3 flex flex-wrap items-center gap-2 text-lg">
      <input class="field w-32" type="number" data-pc="part" value={d.a2} inputmode="decimal" aria-label="part" />
      <span>is what % of</span>
      <input class="field w-32" type="number" data-pc="whole" value={d.b2} inputmode="decimal" aria-label="whole" />
      <span>=</span>
      <strong class="text-xl" style="color: var(--color-brand-700)"><span data-pc-out>{fmt(whatPercent(d.a2, d.b2))}</span>%</strong>
    </div>
  </div>

  <!-- Mode 3 -->
  <div class="card p-5" data-pc-row="change">
    <p class="result-label">Percentage increase or decrease</p>
    <div class="mt-3 flex flex-wrap items-center gap-2 text-lg">
      <span>From</span>
      <input class="field w-32" type="number" data-pc="from" value={d.a3} inputmode="decimal" aria-label="from" />
      <span>to</span>
      <input class="field w-32" type="number" data-pc="to" value={d.b3} inputmode="decimal" aria-label="to" />
      <span>=</span>
      <strong class="text-xl" style="color: var(--color-brand-700)" data-pc-out>{fmt(percentChange(d.a3, d.b3))}%</strong>
      <span class="text-sm" style="color: var(--muted)" data-pc-dir>increase</span>
    </div>
  </div>
</div>

<script>
  import { percentOf, whatPercent, percentChange } from '@lib/calculators/percent';
  import { formatNumber } from '@lib/format';

  const fmt = (v: number) => (Number.isNaN(v) ? '—' : formatNumber(v, 2));

  document.querySelectorAll<HTMLElement>('[data-percent]').forEach((root) => {
    const val = (row: string, key: string) => {
      const el = root.querySelector<HTMLInputElement>(`[data-pc-row="${row}"] [data-pc="${key}"]`);
      return el ? Number(el.value) : NaN;
    };
    const out = (row: string) => root.querySelector<HTMLElement>(`[data-pc-row="${row}"] [data-pc-out]`)!;

    function recompute() {
      out('of').textContent = fmt(percentOf(val('of', 'p'), val('of', 'v')));
      out('what').textContent = fmt(whatPercent(val('what', 'part'), val('what', 'whole')));
      const change = percentChange(val('change', 'from'), val('change', 'to'));
      out('change').textContent = `${fmt(change)}%`;
      const dir = root.querySelector<HTMLElement>('[data-pc-dir]')!;
      dir.textContent = Number.isNaN(change) ? '' : change > 0 ? 'increase' : change < 0 ? 'decrease' : 'no change';
    }
    root.addEventListener('input', recompute);
    recompute();
  });
</script>
