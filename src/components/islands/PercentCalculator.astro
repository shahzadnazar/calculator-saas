---
/**
 * Percentage calculator island (R3 — equation runtime pilot).
 *
 * Six INDEPENDENT natural-language equations, each its own `<form
 * data-equation>` bound to a separate equation-runtime instance
 * (@lib/result/equation-runtime) with the percentage bindings
 * (@lib/calculators/percent-form). Task-first: operands start EMPTY. Each result
 * panel opens on a clearly-labelled worked Example (engine-computed at build
 * time) which the visitor dismisses by typing or via "Start with my values";
 * after that it is the ordinary empty → valid flow. A task-specific Calculate per
 * equation, live-after-first, per-equation Reset and announcement. Nothing an
 * equation does can affect another — including dismissing its example.
 */
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';
import { percentExamples } from '@lib/calculators/percent-form';

// Each equation shows its own labelled example, computed at build time by the same
// reviewed engines the calculator runs. The three are independent: dismissing one
// leaves the other two standing.
const ex = percentExamples();
---

<div class="pct mx-auto grid grid-cols-2  gap-4" data-percent>
  <!-- Equation 1 — What is X% of Y? -->
  <form class="eq card" data-equation="percent-of" novalidate aria-label="What is a percentage of a number">
    <p class="eq-q">What is a percentage of a number?</p>
    <div class="eq-line">
      <span>What is</span>
      <span class="eq-in">
        <input id="pof-percent" name="percent" class="field eq-field" type="number" step="any" inputmode="decimal" autocomplete="off" placeholder="15" aria-label="percentage" aria-describedby="pof-percent-error" />
        <span class="eq-suffix">%</span>
      </span>
      <span>of</span>
      <input id="pof-value" name="value" class="field eq-field" type="number" step="any" inputmode="decimal" autocomplete="off" placeholder="200" aria-label="value" aria-describedby="pof-value-error" />
      <span>?</span>
    </div>
    <p class="eq-error" id="pof-percent-error" data-error-for="percent" hidden></p>
    <p class="eq-error" id="pof-value-error" data-error-for="value" hidden></p>
    <div class="eq-actions">
      <button type="submit" class="btn btn-primary eq-btn">Calculate amount</button>
      <button type="button" class="btn btn-secondary eq-btn" data-reset>Reset</button>
      <span class="eq-live-note" data-live-note hidden>Changes update automatically.</span>
    </div>
    <ResultShell density="compact" minHeight="5rem" placeholderAlignment="center" boxed={false} label="Amount result" class="eq-result">
      <ExampleNotice />
      <EmptyResult message="Enter the values, then calculate the amount." />
      <div data-result-when="valid">
        <ResultSummary label="Amount">
          <ResultValue value="—" size="text-3xl" />
        </ResultSummary>
        <p class="eq-steps" data-eq-steps></p>
      </div>
      <InvalidResult message="Enter both values to calculate." />
      <ResultAnnouncement id="pof-live" />
    </ResultShell>
  </form>

  <!-- Equation 2 — X is what percentage of Y? -->
  <form class="eq card" data-equation="what-percent" novalidate aria-label="A number is what percentage of another">
    <p class="eq-q">A number is what percentage of another?</p>
    <div class="eq-line">
      <input id="wp-part" name="part" class="field eq-field" type="number" step="any" inputmode="decimal" autocomplete="off" placeholder="50" aria-label="value" aria-describedby="wp-part-error" />
      <span>is what percent of</span>
      <input id="wp-whole" name="whole" class="field eq-field" type="number" step="any" inputmode="decimal" autocomplete="off" placeholder="200" aria-label="total value" aria-describedby="wp-whole-error" />
      <span>?</span>
    </div>
    <p class="eq-error" id="wp-part-error" data-error-for="part" hidden></p>
    <p class="eq-error" id="wp-whole-error" data-error-for="whole" hidden></p>
    <div class="eq-actions">
      <button type="submit" class="btn btn-primary eq-btn">Calculate percentage</button>
      <button type="button" class="btn btn-secondary eq-btn" data-reset>Reset</button>
      <span class="eq-live-note" data-live-note hidden>Changes update automatically.</span>
    </div>
    <ResultShell density="compact" minHeight="5rem" placeholderAlignment="center" boxed={false} label="Percentage result" class="eq-result">
      <ExampleNotice />
      <EmptyResult message="Enter both values, then calculate the percentage." />
      <div data-result-when="valid">
        <ResultSummary label="Percentage">
          <ResultValue value="—" unit="%" size="text-3xl" />
        </ResultSummary>
        <p class="eq-steps" data-eq-steps></p>
      </div>
      <InvalidResult message="Enter both values to calculate." />
      <ResultAnnouncement id="wp-live" />
    </ResultShell>
  </form>

  <!-- Equation 3 — Percentage change from X to Y? -->
  <form class="eq card" data-equation="percent-change" novalidate aria-label="Percentage change from one value to another">
    <p class="eq-q">What is the percentage change from one value to another?</p>
    <div class="eq-line">
      <span>From</span>
      <input id="pc-from" name="from" class="field eq-field" type="number" step="any" inputmode="decimal" autocomplete="off" placeholder="80" aria-label="starting value" aria-describedby="pc-from-error" />
      <span>to</span>
      <input id="pc-to" name="to" class="field eq-field" type="number" step="any" inputmode="decimal" autocomplete="off" placeholder="100" aria-label="ending value" aria-describedby="pc-to-error" />
      <span>?</span>
    </div>
    <p class="eq-error" id="pc-from-error" data-error-for="from" hidden></p>
    <p class="eq-error" id="pc-to-error" data-error-for="to" hidden></p>
    <div class="eq-actions">
      <button type="submit" class="btn btn-primary eq-btn">Calculate percentage change</button>
      <button type="button" class="btn btn-secondary eq-btn" data-reset>Reset</button>
      <span class="eq-live-note" data-live-note hidden>Changes update automatically.</span>
    </div>
    <ResultShell density="compact" minHeight="6rem" placeholderAlignment="center" boxed={false} label="Percentage change result" class="eq-result">
      <ExampleNotice />
      <EmptyResult message="Enter both values, then calculate the change." />
      <div data-result-when="valid">
        <ResultSummary label="Percentage change">
          <ResultValue value="—" unit="%" size="text-3xl" />
        </ResultSummary>
        <p class="eq-direction" data-eq-direction></p>
        <p class="eq-steps" data-eq-steps></p>
      </div>
      <InvalidResult message="Enter both values to calculate." />
      <ResultAnnouncement id="pc-live" />
    </ResultShell>
  </form>

  <!-- Equation 4 — X is Y% of what? (solve for the whole) -->
  <form class="eq card" data-equation="percent-of-what" novalidate aria-label="A number is a percentage of what">
    <p class="eq-q">A number is a percentage of what?</p>
    <div class="eq-line">
      <input id="pow-part" name="part" class="field eq-field" type="number" step="any" inputmode="decimal" autocomplete="off" placeholder="30" aria-label="value" aria-describedby="pow-part-error" />
      <span>is</span>
      <span class="eq-in">
        <input id="pow-percent" name="percent" class="field eq-field" type="number" step="any" inputmode="decimal" autocomplete="off" placeholder="15" aria-label="percentage" aria-describedby="pow-percent-error" />
        <span class="eq-suffix">%</span>
      </span>
      <span>of what?</span>
    </div>
    <p class="eq-error" id="pow-part-error" data-error-for="part" hidden></p>
    <p class="eq-error" id="pow-percent-error" data-error-for="percent" hidden></p>
    <div class="eq-actions">
      <button type="submit" class="btn btn-primary eq-btn">Calculate the total</button>
      <button type="button" class="btn btn-secondary eq-btn" data-reset>Reset</button>
      <span class="eq-live-note" data-live-note hidden>Changes update automatically.</span>
    </div>
    <ResultShell density="compact" minHeight="5rem" placeholderAlignment="center" boxed={false} label="Total result" class="eq-result">
      <ExampleNotice />
      <EmptyResult message="Enter the value and the percentage, then calculate the total." />
      <div data-result-when="valid">
        <ResultSummary label="Total">
          <ResultValue value="—" size="text-3xl" />
        </ResultSummary>
        <p class="eq-steps" data-eq-steps></p>
      </div>
      <InvalidResult message="Enter both values to calculate." />
      <ResultAnnouncement id="pow-live" />
    </ResultShell>
  </form>

  <!-- Equation 5 — percentage DIFFERENCE (symmetric, against the mean) -->
  <form class="eq card" data-equation="percent-difference" novalidate aria-label="Percentage difference between two values">
    <p class="eq-q">What is the percentage difference between two values?</p>
    <div class="eq-line">
      <span>Between</span>
      <input id="pd-a" name="a" class="field eq-field" type="number" step="any" inputmode="decimal" autocomplete="off" placeholder="10" aria-label="first value" aria-describedby="pd-a-error" />
      <span>and</span>
      <input id="pd-b" name="b" class="field eq-field" type="number" step="any" inputmode="decimal" autocomplete="off" placeholder="6" aria-label="second value" aria-describedby="pd-b-error" />
      <span>?</span>
    </div>
    <p class="eq-error" id="pd-a-error" data-error-for="a" hidden></p>
    <p class="eq-error" id="pd-b-error" data-error-for="b" hidden></p>
    <div class="eq-actions">
      <button type="submit" class="btn btn-primary eq-btn">Calculate difference</button>
      <button type="button" class="btn btn-secondary eq-btn" data-reset>Reset</button>
      <span class="eq-live-note" data-live-note hidden>Changes update automatically.</span>
    </div>
    <ResultShell density="compact" minHeight="6rem" placeholderAlignment="center" boxed={false} label="Percentage difference result" class="eq-result">
      <ExampleNotice />
      <EmptyResult message="Enter both values, then calculate the difference." />
      <div data-result-when="valid">
        <ResultSummary label="Percentage difference">
          <ResultValue value="—" unit="%" size="text-3xl" />
        </ResultSummary>
        <p class="eq-steps" data-eq-steps></p>
        <p class="eq-note">Measured against the average of the two — the order you enter them does not matter.</p>
      </div>
      <InvalidResult message="Enter both values to calculate." />
      <ResultAnnouncement id="pd-live" />
    </ResultShell>
  </form>

  <!-- Equation 6 — apply an increase / decrease to a value -->
  <form class="eq card" data-equation="apply-change" novalidate aria-label="Increase or decrease a value by a percentage">
    <p class="eq-q">Increase or decrease a value</p>
    <div class="eq-line">
      <input id="ac-value" name="value" class="field eq-field" type="number" step="any" inputmode="decimal" autocomplete="off" placeholder="500" aria-label="starting value" aria-describedby="ac-value-error" />
      <label class="sr-only" for="ac-direction">Direction</label>
      <select id="ac-direction" name="direction" class="field eq-select" aria-describedby="ac-direction-error">
        <option value="increase">increased by</option>
        <option value="decrease">decreased by</option>
      </select>
      <span class="eq-in">
        <input id="ac-percent" name="percent" class="field eq-field" type="number" step="any" inputmode="decimal" autocomplete="off" placeholder="10" aria-label="percentage" aria-describedby="ac-percent-error" />
        <span class="eq-suffix">%</span>
      </span>
      <span>=</span>
    </div>
    <p class="eq-error" id="ac-value-error" data-error-for="value" hidden></p>
    <p class="eq-error" id="ac-direction-error" data-error-for="direction" hidden></p>
    <p class="eq-error" id="ac-percent-error" data-error-for="percent" hidden></p>
    <div class="eq-actions">
      <button type="submit" class="btn btn-primary eq-btn">Calculate new value</button>
      <button type="button" class="btn btn-secondary eq-btn" data-reset>Reset</button>
      <span class="eq-live-note" data-live-note hidden>Changes update automatically.</span>
    </div>
    <ResultShell density="compact" minHeight="5rem" placeholderAlignment="center" boxed={false} label="New value result" class="eq-result">
      <ExampleNotice />
      <EmptyResult message="Enter a value and a percentage, then calculate the new value." />
      <div data-result-when="valid">
        <ResultSummary label="New value">
          <ResultValue value="—" size="text-3xl" />
        </ResultSummary>
        <p class="eq-steps" data-eq-steps></p>
      </div>
      <InvalidResult message="Enter a value and a percentage to calculate." />
      <ResultAnnouncement id="ac-live" />
    </ResultShell>
  </form>
</div>

<style>
  .eq {
    padding: 1.1rem 1.25rem;
  }
  .eq-q {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: 0 0 0.75rem;
  }
  .eq-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.05rem;
    color: var(--heading);
  }
  .eq-in {
    display: inline-flex;
    align-items: stretch;
  }
  .eq-field {
    width: 6rem;
    text-align: right;
  }
  .eq-in .eq-field {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
  }
  .eq-suffix {
    display: inline-flex;
    align-items: center;
    padding: 0 0.6rem;
    border: 1px solid var(--line);
    border-left: 0;
    border-radius: 0 0.5rem 0.5rem 0;
    background: var(--subtle);
    color: var(--muted);
    font-weight: 600;
  }
  .eq-select {
    width: auto;
    padding-block: 0.4rem;
  }
  .eq-note {
    margin: 0.4rem 0 0;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .eq-error {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .eq-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .eq-error {
    color: #fca5a5;
  }
  .eq-actions {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }
  .eq-btn {
    padding: 0.45rem 0.9rem;
    font-size: 0.9rem;
  }
  .eq-live-note {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .eq-result {
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }
  /* The working under the answer: readable arithmetic, never competing with the
     result it explains. Empty means absent, so the empty and invalid states show
     no stray gap. */
  .eq-steps {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .eq-steps:empty { display: none; }
  .eq-steps::before {
    content: 'Steps: ';
    font-weight: 700;
    color: var(--heading);
  }

  .eq-direction {
    margin: 0.15rem 0 0;
    font-size: 0.95rem;
    font-weight: 700;
  }
  .eq-direction[data-direction='increase'] {
    color: #059669;
  }
  .eq-direction[data-direction='decrease'] {
    color: #e11d48;
  }
  .eq-direction[data-direction='none'] {
    color: var(--muted);
  }
</style>

<script>
  import {
    mountEquationCalculator,
    type EquationCalculatorBinding,
  } from '@lib/result/equation-runtime';
  import {
    percentOfBinding,
    whatPercentBinding,
    percentChangeBinding,
    percentOfWhatBinding,
    percentDifferenceBinding,
    applyChangeBinding,
    PERCENT_OF_EXAMPLE_VALUES,
    WHAT_PERCENT_EXAMPLE_VALUES,
    PERCENT_CHANGE_EXAMPLE_VALUES,
    PERCENT_OF_WHAT_EXAMPLE_VALUES,
    PERCENT_DIFFERENCE_EXAMPLE_VALUES,
    APPLY_CHANGE_EXAMPLE_VALUES,
  } from '@lib/calculators/percent-form';

  type EqKind =
    | 'percent-of'
    | 'what-percent'
    | 'percent-change'
    | 'percent-of-what'
    | 'percent-difference'
    | 'apply-change';
  // A heterogeneous registry: each binding has its own operand type, so the
  // registry value type is intentionally operand-agnostic (the runtime is
  // generic and each is mounted against its own matching form).
  const BINDINGS: Record<EqKind, EquationCalculatorBinding<unknown, unknown>> = {
    'percent-of': percentOfBinding as EquationCalculatorBinding<unknown, unknown>,
    'what-percent': whatPercentBinding as EquationCalculatorBinding<unknown, unknown>,
    'percent-change': percentChangeBinding as EquationCalculatorBinding<unknown, unknown>,
    'percent-of-what': percentOfWhatBinding as EquationCalculatorBinding<unknown, unknown>,
    'percent-difference': percentDifferenceBinding as EquationCalculatorBinding<unknown, unknown>,
    'apply-change': applyChangeBinding as EquationCalculatorBinding<unknown, unknown>,
  };
  // Each equation gets its OWN example, so dismissing one leaves the other two standing.
  const EXAMPLES: Record<EqKind, unknown> = {
    'percent-of': PERCENT_OF_EXAMPLE_VALUES,
    'what-percent': WHAT_PERCENT_EXAMPLE_VALUES,
    'percent-change': PERCENT_CHANGE_EXAMPLE_VALUES,
    'percent-of-what': PERCENT_OF_WHAT_EXAMPLE_VALUES,
    'percent-difference': PERCENT_DIFFERENCE_EXAMPLE_VALUES,
    'apply-change': APPLY_CHANGE_EXAMPLE_VALUES,
  };
  const LABELS: Record<EqKind, string> = {
    'percent-of': 'Calculate amount',
    'what-percent': 'Calculate percentage',
    'percent-change': 'Calculate percentage change',
    'percent-of-what': 'Calculate the total',
    'percent-difference': 'Calculate difference',
    'apply-change': 'Calculate new value',
  };

  document.querySelectorAll<HTMLFormElement>('form[data-equation]').forEach((form) => {
    const kind = form.dataset.equation as EqKind;
    const binding = BINDINGS[kind];
    if (!binding) return;
    mountEquationCalculator(form, binding, {
      calculateButtonLabel: LABELS[kind],
      recalculationMode: 'live-after-first',
      example: { values: EXAMPLES[kind] },
    });
  });
</script>
