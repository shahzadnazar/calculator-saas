---
/**
 * Concrete island — the reference's FIVE independent calculators.
 *
 * Slabs / Square Footings / Walls, Hole / Column / Round Footings, Circular Slab or Tube, Curb and
 * Gutter Barrier, and Stairs. Each is its own calculator with its own fields, button and result.
 *
 * Same anatomy as the area and volume islands — the result lives INSIDE the form's card, directly
 * under Calculate — because they are the same kind of tool and a visitor moving between them should
 * not have to relearn where the answer appears.
 *
 * The result is a fixed shape here, unlike area and volume: three volume lines and a weight table,
 * every time. So it is written as static markup with slots the binding fills, rather than built in
 * JS. The bag counts are the part that matters — a cubic yard figure does not tell someone standing
 * in a builders' merchant what to load.
 *
 * The five sections are RENDERED FROM `CONCRETE_SHAPES`, so markup and bindings come from one list.
 * All five run on the UNCHANGED standard-form runtime; the complete-result guard lives in
 * `resultValue`, and there is no `isUsableResult`.
 */
import ResultShell from '@components/result/ResultShell.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';
import { CONCRETE_SHAPES, DEFAULT_UNIT } from '@lib/calculators/concrete-form';
import { LENGTH_UNITS } from '@lib/calculators/area-units';
import { BAG_SIZES_LB, DENSITY_KG_PER_M3, DENSITY_LB_PER_FT3 } from '@lib/calculators/concrete';

export interface Props {
  /** Calculators per row on a wide screen. One card per row, or two side by side. */
  columns?: 1 | 2;
}
const { columns = 2 } = Astro.props;

/**
 * A labelled figure per pour, drawn as the reference draws them: the shape with each measurement
 * named on the edge it belongs to. That is what makes "Flag Thickness" or "Platform Depth" mean
 * something — the words alone do not say which edge of a kerb or a stair they refer to.
 */
const DIAGRAMS: Record<string, string> = {
  slab: `
    <polygon class="f" points="52,74 88,52 176,52 140,74" />
    <polygon class="f" points="52,74 140,74 140,94 52,94" />
    <polygon class="f" points="140,74 176,52 176,72 140,94" />
    <path class="a" d="M186,52 L186,72" />
    <text class="d s" x="192" y="66">h</text>
    <path class="a" d="M146,102 L182,80" />
    <text class="d s" x="188" y="92">w</text>
    <path class="a" d="M52,102 L140,102" />
    <text class="d" x="96" y="116">l</text>`,
  footing: `
    <ellipse class="f" cx="106" cy="46" rx="48" ry="13" />
    <path class="f" d="M58,46 L58,110" /><path class="f" d="M154,46 L154,110" />
    <path class="f" d="M58,110 A48 13 0 0 0 154,110" />
    <path class="a" d="M58,46 L154,46" />
    <text class="d" x="106" y="40">d</text>
    <path class="a" d="M168,46 L168,110" />
    <text class="d s" x="176" y="82">h</text>`,
  tube: `
    <ellipse class="f" cx="112" cy="44" rx="54" ry="14" />
    <ellipse class="f" cx="112" cy="44" rx="25" ry="7" />
    <path class="f" d="M58,44 L58,104" /><path class="f" d="M166,44 L166,104" />
    <path class="f" d="M58,104 A54 14 0 0 0 166,104" />
    <path class="a" d="M87,44 L137,44" />
    <text class="d" x="112" y="36">d₂</text>
    <path class="a" d="M58,124 L166,124" />
    <text class="d" x="112" y="138">d₁</text>
    <path class="a" d="M44,44 L44,104" />
    <text class="d e" x="38" y="78">h</text>`,
  curb: `
    <polygon class="f" points="74,80 104,60 178,60 148,80" />
    <polygon class="f" points="74,80 148,80 148,98 74,98" />
    <polygon class="f" points="148,80 178,60 178,78 148,98" />
    <polygon class="f" points="104,60 104,42 178,42 178,60" />
    <path class="a" d="M74,76 L104,56" />
    <text class="d e" x="70" y="56">Curb depth</text>
    <path class="a" d="M104,34 L178,34" />
    <text class="d" x="141" y="26">Gutter width</text>
    <path class="a" d="M188,42 L188,60" />
    <text class="d s" x="194" y="55">Curb ht.</text>
    <path class="a" d="M188,80 L188,98" />
    <text class="d s" x="194" y="93">Flag</text>
    <path class="a" d="M74,106 L148,106" />
    <text class="d" x="111" y="120">Length</text>`,
  stairs: `
    <path class="f" d="M56,116 L56,92 L88,92 L88,72 L120,72 L120,52 L182,52" />
    <path class="f" d="M56,116 L182,116 L182,52" />
    <path class="f" d="M88,92 L104,82 L104,62" />
    <path class="f" d="M120,72 L136,62 L136,52" />
    <path class="a" d="M124,44 L182,44" />
    <text class="d" x="153" y="36">Platform</text>
    <path class="a" d="M88,66 L120,66" />
    <text class="d" x="104" y="60">Run</text>
    <path class="a" d="M48,92 L48,116" />
    <text class="d e" x="42" y="108">Rise</text>
    <path class="a" d="M56,126 L182,126" />
    <text class="d" x="119" y="140">Width</text>`,
};
---

<div class:list={['ccpage', columns === 2 && 'ccpage--two']} data-ccpage data-cc-columns={String(columns)}>
  {
    CONCRETE_SHAPES.map((spec) => (
      <section class="cc-calc" data-cc-shape={spec.key} aria-labelledby={`cc-${spec.key}-heading`}>
        <div class="cc-head">
          <h2 class="cc-title" id={`cc-${spec.key}-heading`}>{spec.title}</h2>
          <p class="cc-lede">{spec.lede}</p>
        </div>

        <div class="card cc-card">
          <form data-form novalidate aria-label={`${spec.title} concrete calculator`}>
            <div class="cc-stage">
              <div class="cc-fields">
            {spec.fields.map((f) => (
              <div class="cc-field" data-field={f.name}>
                <div class="cc-row">
                  <label class="field-label cc-row__label" for={`cc-${spec.key}-${f.name}`}>
                    {f.label}
                  </label>
                  <div class="cc-row__control">
                    <input
                      class="field cc-num"
                      id={`cc-${spec.key}-${f.name}`}
                      name={f.name}
                      type="number"
                      min={f.kind === 'count' ? '1' : '0'}
                      step={f.kind === 'count' ? '1' : 'any'}
                      value={f.name === 'quantity' ? '1' : undefined}
                      inputmode={f.kind === 'count' ? 'numeric' : 'decimal'}
                      autocomplete="off"
                      aria-describedby={`cc-${spec.key}-${f.name}-error`}
                    />
                    {f.kind === 'length' ? (
                      <select class="field cc-unit" name={`${f.name}Unit`} aria-label={`${f.label} unit`}>
                        {LENGTH_UNITS.map((u) => (
                          <option value={u.value} selected={u.value === DEFAULT_UNIT}>
                            {u.label}
                          </option>
                        ))}
                      </select>
                    ) : (
                      <span class="cc-unit-spacer" aria-hidden="true" />
                    )}
                  </div>
                </div>
                <p class="cc-field-error" id={`cc-${spec.key}-${f.name}-error`} data-error-for={f.name} hidden />
              </div>
            ))}
              </div>
              {/* Named on the edge it belongs to, so "Flag Thickness" has somewhere to point. */}
              <svg class="cc-figure" viewBox="0 0 240 150" role="img" aria-label={`${spec.title}: the measurements this calculator asks for`} set:html={DIAGRAMS[spec.key]} />
            </div>

            <div class="mt-4 flex items-center gap-3">
              <button type="submit" class="btn btn-primary">Calculate</button>
              <button type="button" class="btn btn-secondary" data-reset>Clear</button>
            </div>
          </form>

          <ResultShell
            id={`cc-${spec.key}-result`}
            state="empty"
            density="standard"
            boxed={false}
            label={`${spec.title} result`}
            minHeight="0"
            class="cc-result"
          >
            <ExampleNotice />
            <EmptyResult message="Enter the measurements above, then calculate how much concrete the pour needs." />

            <div data-result-when="valid">
              <p class="cc-volume">
                <span class="cc-volume__label">Volume:</span>
                <span class="cc-volume__figure" data-result-value>—</span>
                <span class="cc-volume__unit">cubic feet</span>
              </p>
              <p class="cc-volume cc-volume--alt">
                <span class="cc-volume__label">or</span>
                <span class="cc-volume__figure" data-cc-yd3>—</span>
                <span class="cc-volume__unit">cubic yards</span>
              </p>
              <p class="cc-volume cc-volume--alt">
                <span class="cc-volume__label">or</span>
                <span class="cc-volume__figure" data-cc-m3>—</span>
                <span class="cc-volume__unit">cubic meters</span>
              </p>
              <span class="sr-only" data-result-value-a11y />

              <p class="cc-density">
                If using pre-mixed concrete with density of {DENSITY_KG_PER_M3.toLocaleString('en-US')} kg/m³
                or {DENSITY_LB_PER_FT3} lbs/ft³<span aria-hidden="true">*</span>:
              </p>
              <dl class="cc-weights">
                <div>
                  <dt>Weight needed</dt>
                  <dd><strong data-cc-lbs>—</strong> lbs or <strong data-cc-kg>—</strong> kg</dd>
                </div>
                {BAG_SIZES_LB.map((size, i) => (
                  <div>
                    <dt>Using {size}-lb bags</dt>
                    <dd><strong data-cc-bags={String(i)}>—</strong> bags</dd>
                  </div>
                ))}
              </dl>
              <p class="cc-footnote">
                <span aria-hidden="true">*</span> Different types of concrete can have very different
                densities. Order a little more than the estimate — running short mid-pour is far
                worse than having a bag left over.
              </p>
            </div>

            <InvalidResult
              title="Check your entries"
              message="Every measurement must be a number greater than zero."
            />

            <ResultAnnouncement id={`cc-${spec.key}-live`} />
          </ResultShell>

          <p class="cc-live-note" data-live-note hidden>Changes update automatically.</p>
        </div>
      </section>
    ))
  }
</div>

<style>
  .ccpage {
    display: grid;
    gap: 1.75rem;
    width: 100%;
  }
  /* Two cards abreast only once there is room for both without squeezing the fields. */
  @media (min-width: 60rem) {
    .ccpage--two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
    /* One per row still keeps a calculator-sized box: a number field a thousand pixels wide
       tells the visitor nothing and makes the label and its input strangers. */
    .ccpage:not(.ccpage--two) .cc-calc {
      max-width: 36rem;
    }
  }

  .cc-head {
    margin-bottom: 0.6rem;
  }
  .cc-title {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--heading);
  }
  .cc-lede {
    margin: 0.1rem 0 0;
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .cc-card { padding: 1rem; }

  /* Fields on the left, the labelled figure beside them, as the reference lays it out. It wraps
     underneath rather than squeezing when the card is too narrow to hold both. */
  .cc-stage {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.75rem 1rem;
  }
  .cc-fields {
    flex: 1 1 17rem;
    min-width: 0;
  }
  .cc-figure {
    flex: 0 1 11rem;
    align-self: center;
    width: 11rem;
    max-width: 100%;
    height: auto;
  }
  .cc-figure :global(.f) {
    fill: none;
    stroke: var(--fg);
    stroke-width: 2;
    stroke-linejoin: round;
    opacity: 0.75;
  }
  .cc-figure :global(.a) {
    fill: none;
    stroke: var(--color-brand-600, var(--muted));
    stroke-width: 1.5;
    stroke-dasharray: 3 2;
  }
  .cc-figure :global(.d) {
    fill: var(--muted);
    stroke: none;
    font-size: 11px;
    font-weight: 600;
    text-anchor: middle;
  }
  /* Labels at the edges anchor away from the shape so they stay inside the viewBox. */
  .cc-figure :global(.d.s) { text-anchor: start; }
  .cc-figure :global(.d.e) { text-anchor: end; }

  .cc-field + .cc-field { margin-top: 0.4rem; }
  .cc-row {
    display: grid;
    grid-template-columns: minmax(0, 10.5rem) minmax(0, 1fr);
    align-items: center;
    gap: 0.5rem;
  }
  .cc-row__label { margin: 0; }
  .cc-row__control {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
  }
  .cc-num {
    flex: 1 1 0;
    min-width: 0;
    min-height: 2.75rem;
    font-variant-numeric: tabular-nums;
  }
  .cc-unit {
    flex: 0 1 auto;
    width: auto;
    min-width: 0;
    min-height: 2.75rem;
    font-size: 0.86rem;
  }
  /* A count has no unit, but its input should still line up with the ones that do. */
  .cc-unit-spacer {
    flex: 0 1 auto;
    width: 6.5rem;
  }
  @media (max-width: 30rem) {
    .cc-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.2rem;
    }
    .cc-unit-spacer { display: none; }
  }

  .cc-field-error {
    margin: 0.3rem 0 0;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.3;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .cc-field-error { color: #fca5a5; }
  }
  :root[data-theme='dark'] .cc-field-error { color: #fca5a5; }

  .cc-live-note {
    margin-top: 0.7rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* ResultShell owns this element, so the separating rule is reached with :global(). */
  .cc-calc :global(.cc-result) {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .cc-volume {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.3;
  }
  .cc-volume--alt {
    font-size: 1rem;
    margin-top: 0.1rem;
    padding-left: 0.15rem;
  }
  .cc-volume__label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--muted);
  }
  .cc-volume__figure {
    font-weight: 800;
    color: var(--heading);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .cc-volume--alt .cc-volume__figure { font-weight: 700; }
  .cc-volume__unit {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--muted);
  }

  .cc-density {
    margin: 0.9rem 0 0.4rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--fg);
  }
  .cc-weights {
    margin: 0;
    display: grid;
    gap: 0.2rem;
  }
  .cc-weights > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.9rem;
  }
  .cc-weights dt {
    color: var(--fg);
    font-weight: 600;
  }
  .cc-weights dd {
    margin: 0;
    text-align: right;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .cc-weights dd strong { color: var(--heading); }

  .cc-footnote {
    margin: 0.6rem 0 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--muted);
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { CONCRETE_SHAPES, makeConcreteBinding, concreteExampleValues } from '@lib/calculators/concrete-form';

  function uniquifyStaticIds(root: HTMLElement, suffix: string): void {
    const remap = new Map<string, string>();
    root.querySelectorAll<HTMLElement>('[id]').forEach((el) => {
      const next = `${el.id}-${suffix}`;
      remap.set(el.id, next);
      el.id = next;
    });
    const repoint = (attr: string) =>
      root.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((el) => {
        const next = el
          .getAttribute(attr)!
          .split(/\s+/)
          .map((token) => remap.get(token) ?? token)
          .join(' ');
        el.setAttribute(attr, next);
      });
    repoint('for');
    repoint('aria-describedby');
    repoint('aria-labelledby');
    repoint('aria-controls');
  }

  const pages = document.querySelectorAll<HTMLElement>('[data-ccpage]');
  pages.forEach((page, i) => {
    if (pages.length > 1) uniquifyStaticIds(page, `c${i + 1}`);

    for (const spec of CONCRETE_SHAPES) {
      const section = page.querySelector<HTMLElement>(`[data-cc-shape="${spec.key}"]`);
      if (!section) continue;
      mountFormCalculator(section, makeConcreteBinding(spec), {
        recalculationMode: 'live-after-first',
        example: { values: concreteExampleValues(spec) },
        calculateButtonLabel: 'Calculate',
      });
    }
  });
</script>
