---
/**
 * Tip island — TWO independent calculators on one page, each its own `<form data-equation>`
 * on the equation runtime, the way the percentage and inflation pages already work.
 * Calculating or clearing one leaves the other exactly as it was.
 *
 *   1. Tip Calculator — one price, every customary rate priced out in a table. Nobody
 *      arrives knowing the exact rate they want; they want the options side by side.
 *   2. Shared Bill Tip Calculator — price, rate and party size, down to what each person
 *      hands over.
 *
 * The price starts EMPTY in both. The tip rate and the party size carry the product's own
 * documented defaults (15% and one person) — those are ours, not the visitor's figures.
 */
import { TIP_PERCENTAGES, CUSTOMARY_TIP_PCT, DEFAULT_TIP_PCT, DEFAULT_PEOPLE } from '@lib/calculators/tip-form';
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import ResultInterpretation from '@components/result/ResultInterpretation.astro';
import ResultBreakdown from '@components/result/ResultBreakdown.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';
---

<div class="tipcalc" data-tip>
  <div class="tipcalc__row">
  <!-- 1 — Tip Calculator -->
  <section class="tpeq" data-equation="quick" aria-label="Tip calculator">
    <h2 class="tpeq-q">Tip Calculator</h2>
    <p class="tpeq-lede">
      Calculates the tip for a range of percentages of the cost of the service, and the total
      including the tip. In the U.S., a tip of 15% of the before-tax price is typically expected.
    </p>

    <div class="tpeq-split">
    <form class="card tpeq-form" novalidate>
      <div class="tpeq-fields">
        <div class="tpeq-field" data-field="price">
          <label class="field-label" for="tp-price">Price</label>
          <div class="tpeq-money">
            <span class="tpeq-affix">$</span>
            <input class="field tpeq-input" id="tp-price" name="price" type="number" min="0" step="any" inputmode="decimal" autocomplete="off" placeholder="55" aria-describedby="tp-price-error" />
          </div>
          <p class="tpeq-error" id="tp-price-error" data-error-for="price" hidden></p>
        </div>
      </div>

      <div class="tpeq-actions">
        <button type="submit" class="btn btn-primary tpeq-btn" aria-label="Calculate the tip table">Calculate</button>
        <button type="button" class="btn btn-secondary tpeq-btn" data-reset aria-label="Clear the tip table">Clear</button>
        <span class="tpeq-live-note" data-live-note hidden>Changes update automatically.</span>
      </div>
    </form>

    <ResultShell state="example" density="standard" minHeight="7rem" placeholderAlignment="center" label="Tip table result" class="tpeq-result">
      <ExampleNotice caption="Sample: a $55 bill." />
      <EmptyResult message="Enter a price, then calculate." />

      <div data-result-when="valid">
        <ResultSummary label={`Total at ${CUSTOMARY_TIP_PCT}%`}>
          <ResultValue value="—" size="text-3xl" />
        </ResultSummary>
        <ResultInterpretation>
          <span data-tip-interpretation></span>
        </ResultInterpretation>

        <ResultBreakdown title="Every rate">
          <div class="tpeq-table-wrap">
            <table class="tpeq-table">
              <caption class="sr-only">Tip amount and total at each percentage</caption>
              <thead>
                <tr>
                  <th scope="col">Tip %</th>
                  <th scope="col">Tip Amount</th>
                  <th scope="col">Total</th>
                </tr>
              </thead>
              <tbody>
                {TIP_PERCENTAGES.map((pct) => (
                  <tr class={pct === CUSTOMARY_TIP_PCT ? 'tpeq-row--customary' : undefined}>
                    <th scope="row">
                      {pct}%{pct === CUSTOMARY_TIP_PCT && <span class="tpeq-tag"> typical</span>}
                    </th>
                    <td data-tip-amount={pct}>—</td>
                    <td data-tip-total={pct}>—</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </ResultBreakdown>
      </div>

      <InvalidResult message="Enter a price of zero or more." />
      <ResultAnnouncement id="tp-live" />
    </ResultShell>
    </div>
  </section>

  <!-- 2 — Shared Bill Tip Calculator -->
  <section class="tpeq" data-equation="shared" aria-label="Shared bill tip calculator">
    <h2 class="tpeq-q">Shared Bill Tip Calculator</h2>
    <p class="tpeq-lede">
      Takes the cost of the service, the number of people and the chosen tip percentage, and works
      out the tip per person as well as the total cost per person.
    </p>

    <div class="tpeq-split">
    <form class="card tpeq-form" novalidate>
      <div class="tpeq-fields">
        <div class="tpeq-field" data-field="price">
          <label class="field-label" for="tps-price">Price</label>
          <div class="tpeq-money">
            <span class="tpeq-affix">$</span>
            <input class="field tpeq-input" id="tps-price" name="price" type="number" min="0" step="any" inputmode="decimal" autocomplete="off" placeholder="55" aria-describedby="tps-price-error" />
          </div>
          <p class="tpeq-error" id="tps-price-error" data-error-for="price" hidden></p>
        </div>

        <div class="tpeq-field" data-field="tipPct">
          <label class="field-label" for="tps-tip">Tip %</label>
          <div class="tpeq-money">
            <input class="field tpeq-input tpeq-input--pct" id="tps-tip" name="tipPct" type="number" min="0" step="any" inputmode="decimal" autocomplete="off" value={DEFAULT_TIP_PCT} aria-describedby="tps-tip-error" />
            <span class="tpeq-affix tpeq-affix--suffix">%</span>
          </div>
          <p class="tpeq-error" id="tps-tip-error" data-error-for="tipPct" hidden></p>
        </div>

        <div class="tpeq-field" data-field="people">
          <label class="field-label" for="tps-people">Number of People</label>
          <input class="field tpeq-input tpeq-input--plain" id="tps-people" name="people" type="number" min="1" step="1" inputmode="numeric" autocomplete="off" value={DEFAULT_PEOPLE} aria-describedby="tps-people-error" />
          <p class="tpeq-error" id="tps-people-error" data-error-for="people" hidden></p>
        </div>
      </div>

      <div class="tpeq-actions">
        <button type="submit" class="btn btn-primary tpeq-btn" aria-label="Calculate the shared bill">Calculate</button>
        <button type="button" class="btn btn-secondary tpeq-btn" data-reset aria-label="Clear the shared bill">Clear</button>
        <span class="tpeq-live-note" data-live-note hidden>Changes update automatically.</span>
      </div>
    </form>

    <ResultShell state="example" density="standard" minHeight="7rem" placeholderAlignment="center" label="Shared bill result" class="tpeq-result">
      <ExampleNotice caption="Sample: a $55 bill at 15%, split one way." />
      <EmptyResult message="Enter a price, a tip percentage and the number of people, then calculate." />

      <div data-result-when="valid">
        <ResultSummary label="Total Amount">
          <ResultValue value="—" size="text-3xl" />
        </ResultSummary>
        <ResultInterpretation>
          <span data-shared-interpretation></span>
        </ResultInterpretation>

        <ResultBreakdown title="The split">
          <dl class="tpeq-metrics">
            <div><dt data-shared-tip-label>Tip</dt><dd data-shared-tip>—</dd></div>
            <div><dt data-shared-total-label>Total Amount</dt><dd data-shared-total>—</dd></div>
          </dl>
          <dl class="tpeq-metrics tpeq-metrics--whole" data-shared-whole hidden>
            <div><dt>Tip (whole bill)</dt><dd data-shared-bill-tip>—</dd></div>
            <div><dt>Total (whole bill)</dt><dd data-shared-bill-total>—</dd></div>
          </dl>
        </ResultBreakdown>
      </div>

      <InvalidResult message="Enter a price, a tip percentage of zero or more, and at least one person." />
      <ResultAnnouncement id="tps-live" />
    </ResultShell>
    </div>
  </section>
  </div>
</div>

<style>
  .tipcalc {
    /* The container the queries below measure. `.tool-shell__core` is not one, so
       a bare @container query would resolve against the whole page shell and be
       wrong the moment a side rail takes 300px of it. Declaring it here also
       keeps the layout correct on an embed, where this island owns the width. */
    container-type: inline-size;
  }

  /* The two calculators sit side by side, each one stacked: its form, then its
     answer underneath. */
  .tipcalc__row {
    display: grid;
    gap: 1rem;
    align-items: start;
    min-width: 0;
  }
  .tpeq { min-width: 0; }
  .tpeq-form {
    padding: 0.9rem 1rem 1rem;
    min-width: 0;
  }

  /* The heading sits above its own two cards — the form and the result — rather
     than one card wrapping both, so this reads like the rest of the fleet. */
  .tpeq-split {
    display: grid;
    gap: 0.75rem;
    align-items: start;
    min-width: 0;
    margin-top: 0.6rem;
  }

  /* AFTER the base rules above on purpose: a container query adds no specificity,
     so at equal weight the later rule wins — declared first, `display: grid` on
     .tpeq-split would beat the `display: contents` this needs. */
  @container (min-width: 54rem) {
    .tipcalc__row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      /* heading · lede · form · result */
      grid-template-rows: auto auto auto auto;
      column-gap: 1.5rem;
      row-gap: 0.75rem;
    }
    /* Subgrid so the two columns share their row heights: the headings line up,
       and so do the two answer cards, even though one form has three fields and
       the other has one. `display: contents` lets the form and the result be
       rows of that subgrid rather than one block between them. */
    .tpeq {
      display: grid;
      grid-template-rows: subgrid;
      grid-row: span 4;
      row-gap: 0.75rem;
    }
    .tpeq-split { display: contents; }
    .tpeq-q,
    .tpeq-lede { margin: 0; }
  }
  .tpeq :global(.tpeq-result) { min-width: 0; }

  .tpeq-q {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--heading);
  }
  .tpeq-lede {
    margin: 0.2rem 0 0;
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--muted);
  }

  /* Two fields to a row. */
  .tpeq-fields {
    margin-top: 0.7rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem 0.9rem;
  }
  .tpeq-field {
    min-width: 0;
  }
  @media (max-width: 32rem) {
    .tpeq-fields {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .tpeq-field .field-label {
    display: block;
    font-size: 0.84rem;
  }

  .tpeq-money {
    margin-top: 0.2rem;
    display: flex;
    align-items: stretch;
  }
  .tpeq-affix {
    display: inline-flex;
    align-items: center;
    padding: 0 0.55rem;
    border: 1px solid var(--line);
    border-right: 0;
    border-radius: 0.5rem 0 0 0.5rem;
    background: var(--surface-2, transparent);
    font-size: 0.88rem;
    color: var(--muted);
  }
  .tpeq-affix--suffix {
    border-right: 1px solid var(--line);
    border-left: 0;
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .tpeq-input {
    width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    border-radius: 0 0.5rem 0.5rem 0;
    font-variant-numeric: tabular-nums;
  }
  .tpeq-input--pct {
    border-radius: 0.5rem 0 0 0.5rem;
  }
  .tpeq-input--plain {
    margin-top: 0.2rem;
    border-radius: 0.5rem;
  }

  .tpeq-error {
    margin: 0.2rem 0 0;
    font-size: 0.76rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .tpeq-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .tpeq-error {
    color: #fca5a5;
  }

  .tpeq-actions {
    margin-top: 0.8rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }
  .tpeq-btn {
    min-height: 2.75rem;
  }
  .tpeq-live-note {
    font-size: 0.78rem;
    color: var(--muted);
  }

  .tpeq-result {
    margin-top: 0.75rem;
  }

  .tpeq-table-wrap {
    overflow-x: auto;
  }
  .tpeq-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }
  .tpeq-table th,
  .tpeq-table td {
    padding: 0.32rem 0.5rem;
    border-bottom: 1px solid var(--line);
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .tpeq-table thead th {
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--muted);
  }
  .tpeq-table tbody th {
    text-align: left;
    font-weight: 600;
    color: var(--fg);
  }
  .tpeq-table tbody td {
    color: var(--heading);
    font-weight: 600;
  }
  .tpeq-table tbody tr:last-child th,
  .tpeq-table tbody tr:last-child td {
    border-bottom: 0;
  }
  /* The customary row is called out by weight, a tint AND the word "typical" — never by
     colour alone, which would leave it invisible to anyone who cannot separate the hues. */
  .tpeq-row--customary th,
  .tpeq-row--customary td {
    font-weight: 800;
    color: var(--color-brand-700);
    background: var(--color-brand-50);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .tpeq-row--customary th,
    :root:not([data-theme='light']) .tpeq-row--customary td {
      color: var(--color-brand-300);
      background: color-mix(in srgb, var(--color-brand-600) 18%, transparent);
    }
  }
  :root[data-theme='dark'] .tpeq-row--customary th,
  :root[data-theme='dark'] .tpeq-row--customary td {
    color: var(--color-brand-300);
    background: color-mix(in srgb, var(--color-brand-600) 18%, transparent);
  }
  .tpeq-tag {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .tpeq-metrics {
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }
  .tpeq-metrics--whole {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--line);
  }
  .tpeq-metrics > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.3rem 0;
    font-size: 0.95rem;
  }
  .tpeq-metrics dt {
    color: var(--fg);
    font-weight: 600;
  }
  .tpeq-metrics dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--heading);
    font-weight: 700;
    white-space: nowrap;
  }
</style>

<script>
  import {
    mountEquationCalculator,
    type EquationCalculatorBinding,
  } from '@lib/result/equation-runtime';
  import {
    quickTipBinding,
    sharedTipBinding,
    QUICK_TIP_EXAMPLE_VALUES,
    SHARED_TIP_EXAMPLE_VALUES,
  } from '@lib/calculators/tip-form';

  type EqKind = 'quick' | 'shared';
  // Each binding has its own operand type; the registry is deliberately operand-agnostic
  // because every form is mounted against its own binding.
  const BINDINGS: Record<EqKind, EquationCalculatorBinding<unknown, unknown>> = {
    quick: quickTipBinding as EquationCalculatorBinding<unknown, unknown>,
    shared: sharedTipBinding as EquationCalculatorBinding<unknown, unknown>,
  };
  // Each form gets its OWN example, so dismissing one leaves the other standing.
  const EXAMPLES: Record<EqKind, unknown> = {
    quick: QUICK_TIP_EXAMPLE_VALUES,
    shared: SHARED_TIP_EXAMPLE_VALUES,
  };

  // The root is the SECTION, not the form: the runtime finds the form inside it
  // and the result shell beside it, which is what lets them be two separate cards.
  document.querySelectorAll<HTMLElement>('[data-equation]').forEach((root) => {
    const kind = root.dataset.equation as EqKind;
    const binding = BINDINGS[kind];
    if (!binding) return;
    mountEquationCalculator(root, binding, {
      calculateButtonLabel: 'Calculate',
      recalculationMode: 'live-after-first',
      example: { values: EXAMPLES[kind] },
    });
  });
</script>
