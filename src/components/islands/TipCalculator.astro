---
import { calculateTip } from '@lib/calculators/tip';
import { formatCurrency } from '@lib/format';

const d = { bill: 50, tipPct: 18, people: 1 };
const r = calculateTip(d);
const presets = [10, 15, 18, 20, 25];
---

<div class="mx-auto grid w-full max-w-4xl gap-6 md:grid-cols-2" data-tip>
  <form class="card p-5 sm:p-6" data-tp-form novalidate>
    <div class="space-y-4">
      <div>
        <label class="field-label" for="tp-bill">Bill amount</label>
        <div class="flex"><span class="field-affix rounded-l-lg border-r-0">$</span><input class="field rounded-l-none" id="tp-bill" name="bill" type="number" min="0" step="0.01" value={d.bill} inputmode="decimal" /></div>
      </div>
      <div>
        <label class="field-label" for="tp-tip">Tip percentage</label>
        <div class="flex"><input class="field rounded-r-none" id="tp-tip" name="tipPct" type="number" min="0" step="1" value={d.tipPct} inputmode="decimal" /><span class="field-affix rounded-r-lg border-l-0">%</span></div>
        <div class="mt-2 flex flex-wrap gap-2">
          {presets.map((p) => (<button type="button" class="rounded-lg border px-3 py-1 text-sm font-semibold" style="border-color: var(--line); color: var(--color-brand-700)" data-tp-preset={p}>{p}%</button>))}
        </div>
      </div>
      <div>
        <label class="field-label" for="tp-people">Split between</label>
        <div class="flex"><input class="field rounded-r-none" id="tp-people" name="people" type="number" min="1" step="1" value={d.people} inputmode="numeric" /><span class="field-affix rounded-r-lg border-l-0">people</span></div>
      </div>
    </div>
  </form>

  <div class="card p-5 sm:p-6">
    <p class="text-sm font-semibold" style="color: var(--muted)">Total per person</p>
    <p class="mt-1 text-4xl font-extrabold tracking-tight" style="color: var(--heading)" data-tp-perperson>{formatCurrency(r.perPersonTotal)}</p>
    <dl class="mt-5 space-y-2 border-t pt-4 text-sm" style="border-color: var(--line)">
      <div class="flex justify-between"><dt style="color: var(--muted)">Tip amount</dt><dd class="font-semibold" style="color: var(--color-accent-600)" data-tp-tip>{formatCurrency(r.tipAmount)}</dd></div>
      <div class="flex justify-between"><dt style="color: var(--muted)">Total bill</dt><dd class="font-semibold" data-tp-total>{formatCurrency(r.total)}</dd></div>
      <div class="flex justify-between"><dt style="color: var(--muted)">Tip per person</dt><dd class="font-semibold" data-tp-tipperson>{formatCurrency(r.perPersonTip)}</dd></div>
    </dl>
  </div>
</div>

<script>
  import { calculateTip } from '@lib/calculators/tip';
  import { formatCurrency } from '@lib/format';
  document.querySelectorAll<HTMLElement>('[data-tip]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-tp-form]')!;
    const num = (n: string) => Number((form.elements.namedItem(n) as HTMLInputElement)?.value) || 0;
    const set = (sel: string, v: string) => { const el = root.querySelector<HTMLElement>(sel); if (el) el.textContent = v; };
    function recompute() {
      const r = calculateTip({ bill: num('bill'), tipPct: num('tipPct'), people: num('people') });
      set('[data-tp-perperson]', formatCurrency(r.perPersonTotal));
      set('[data-tp-tip]', formatCurrency(r.tipAmount));
      set('[data-tp-total]', formatCurrency(r.total));
      set('[data-tp-tipperson]', formatCurrency(r.perPersonTip));
    }
    root.querySelectorAll<HTMLButtonElement>('[data-tp-preset]').forEach((b) => b.addEventListener('click', () => {
      (form.elements.namedItem('tipPct') as HTMLInputElement).value = b.dataset.tpPreset!;
      recompute();
    }));
    form.addEventListener('input', recompute);
    recompute();
  });
</script>
