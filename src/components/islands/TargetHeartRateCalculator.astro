---
/**
 * Target heart-rate island — the reference's fields, its "+ Settings" disclosure and its
 * zone table, on the UNCHANGED standard-form runtime.
 *
 * The reference stacks its result above its form. Ours sits BESIDE it — inputs on the left,
 * result on the right — so a change and its consequence are visible at once rather than one
 * scrolling the other off screen.
 *
 * "Max Heart Rate" is a choice, not a field: estimate it from age, or type in what a test
 * measured. Whichever is chosen, the other box leaves the form so nothing invisible can
 * reach a result.
 *
 * The zone table is coloured from cool to hot the way the reference colours it, but the
 * colour is never the only signal — every row is named and every band is written out.
 */
import {
  MAX_HR_MODES,
  MHR_FORMULAS,
  INTENSITY_SCALES,
  INTENSITY_BANDS,
  AGE_MIN,
  AGE_MAX,
  MAX_HR_MIN,
  MAX_HR_MAX,
  RESTING_MIN,
  RESTING_MAX,
} from '@lib/calculators/target-heart-rate-form';
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultInterpretation from '@components/result/ResultInterpretation.astro';
import ResultBreakdown from '@components/result/ResultBreakdown.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';
---

<div class="thr mx-auto grid w-full max-w-4xl gap-6 md:grid-cols-2 md:items-start" data-thr>
  <!-- Inputs -->
  <form class="card p-4" data-form novalidate aria-label="Target heart rate calculator">
    <fieldset class="thr-modes" data-field="mode">
      <legend class="field-label thr-modes__legend">Max Heart Rate</legend>
      <div class="thr-radios">
        {MAX_HR_MODES.map((m, i) => (
          <label class="thr-radio"><input type="radio" name="mode" value={m.value} checked={i === 0} /><span>{m.label}</span></label>
        ))}
      </div>
    </fieldset>

    <div class="thr-row" data-field="age" data-mode-group="age">
      <label class="field-label thr-row__label" for="thr-age">Age</label>
      <div class="thr-inputs">
        <input class="field thr-input" id="thr-age" name="age" type="number" min={AGE_MIN} max={AGE_MAX} step="1" inputmode="numeric" autocomplete="off" placeholder="30" aria-describedby="thr-age-error" />
      </div>
    </div>
    <p class="thr-error" id="thr-age-error" data-error-for="age" hidden></p>

    <div class="thr-row" data-field="measuredMaxHr" data-mode-group="test" hidden>
      <label class="field-label thr-row__label" for="thr-max">Max Heart Rate</label>
      <div class="thr-inputs">
        <input class="field thr-input" id="thr-max" name="measuredMaxHr" type="number" min={MAX_HR_MIN} max={MAX_HR_MAX} step="1" inputmode="numeric" autocomplete="off" placeholder="190" aria-describedby="thr-measuredMaxHr-error" />
        <span class="thr-unit">bpm</span>
      </div>
    </div>
    <p class="thr-error" id="thr-measuredMaxHr-error" data-error-for="measuredMaxHr" hidden></p>

    <div class="thr-row" data-field="restingHr">
      <label class="field-label thr-row__label" for="thr-resting">Resting Heart Rate</label>
      <div class="thr-inputs">
        <input class="field thr-input" id="thr-resting" name="restingHr" type="number" min={RESTING_MIN} max={RESTING_MAX} step="1" inputmode="numeric" autocomplete="off" placeholder="70" aria-describedby="thr-restingHr-error" />
        <span class="thr-unit">bpm</span>
        <span class="thr-hint">(optional)</span>
      </div>
    </div>
    <p class="thr-error" id="thr-restingHr-error" data-error-for="restingHr" hidden></p>

    <button type="button" class="thr-settings-toggle" data-settings-toggle aria-expanded="false" aria-controls="thr-settings">
      <span class="thr-settings-toggle__sign" aria-hidden="true">+</span> Settings
    </button>

    <div class="thr-settings" id="thr-settings" data-settings hidden>
      <fieldset class="thr-set" data-field="formula">
        <legend class="thr-set__legend">Max heart rate estimation formula:</legend>
        <div class="thr-set__options thr-set__options--stacked">
          {MHR_FORMULAS.map((f, i) => (
            <label class="thr-radio"><input type="radio" name="formula" value={f.value} checked={i === 0} /><span>{f.label}</span></label>
          ))}
        </div>
      </fieldset>

      <fieldset class="thr-set" data-field="scale">
        <legend class="thr-set__legend">Activity intensity scale:</legend>
        <div class="thr-set__options thr-set__options--stacked">
          {INTENSITY_SCALES.map((s, i) => (
            <label class="thr-radio"><input type="radio" name="scale" value={s.value} checked={i === 0} /><span>{s.label}</span></label>
          ))}
        </div>
      </fieldset>
    </div>

    <div class="mt-5 flex items-center gap-3">
      <button type="submit" class="btn btn-primary">Calculate</button>
      <button type="button" class="btn btn-secondary" data-reset>Clear</button>
    </div>
    <p class="thr-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result -->
  <ResultShell
    id="thr-result"
    state="empty"
    density="standard"
    label="Your target heart rate result"
    minHeight="20rem"
    placeholderAlignment="center"
  >
    <ExampleNotice />
    <EmptyResult message="Enter your age — or a measured maximum heart rate — then calculate." />

    <div data-result-when="valid">
      <ResultSummary label="Target heart rate during aerobic exercise">
        <span aria-hidden="true">
          <span class="result-value text-4xl" data-thr-low>—</span><span class="thr-sep">–</span><span class="result-value text-4xl" data-thr-high>—</span>&nbsp;<span class="result-unit">bpm</span>
        </span>
        <span class="sr-only" data-thr-a11y></span>
      </ResultSummary>
      <ResultInterpretation>
        <span data-thr-headline>—</span>
      </ResultInterpretation>

      <ResultBreakdown title="Zones by exercise intensity">
        <table class="thr-zones">
          <thead>
            <tr>
              <th scope="col">Exercise Intensity</th>
              <th scope="col" data-thr-column>Heart Rate Reserve</th>
              <th scope="col" class="thr-num">Target Heart Rate (bpm)</th>
            </tr>
          </thead>
          <tbody>
            {INTENSITY_BANDS.map((band) => (
              <tr data-zone={band.key} class={`thr-zone thr-zone--${band.key}`}>
                <th scope="row"><span class="thr-swatch" aria-hidden="true"></span>{band.label}</th>
                <td data-zone-scale>—</td>
                <td class="thr-num" data-zone-bpm>—</td>
              </tr>
            ))}
          </tbody>
        </table>
        <dl class="thr-facts">
          <div class="thr-fact">
            <dt>Maximum heart rate</dt>
            <dd><span data-thr-max>—</span> bpm</dd>
          </div>
          <div class="thr-fact" data-thr-reserve-row hidden>
            <dt>Heart rate reserve</dt>
            <dd><span data-thr-reserve>—</span> bpm</dd>
          </div>
        </dl>
        <p class="thr-note">
          Percentages are of your <span data-thr-basis>heart rate reserve</span>. Add a resting
          heart rate and the zones use the Karvonen method (reserve); leave it out and they are
          plain percentages of your maximum, which run lower. This is educational information,
          not medical advice.
        </p>
      </ResultBreakdown>
    </div>

    <InvalidResult title="Check your entries" message="Enter an age, or the maximum heart rate a test measured." />

    <ResultAnnouncement id="thr-live" />
  </ResultShell>
</div>

<style>
  /* The two entry modes get the full width: at the label-column width they wrapped
     "Estimate from age" onto two lines. */
  .thr-modes {
    border: 0;
    margin: 0;
    padding: 0.3rem 0;
  }
  .thr-modes__legend {
    display: block;
    margin: 0 0 0.1rem;
    padding: 0;
    font-size: 0.86rem;
  }
  .thr-row {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    align-items: center;
    gap: 0.6rem;
    padding: 0.3rem 0;
    border: 0;
    margin: 0;
  }
  .thr-row__label {
    margin: 0;
    font-size: 0.86rem;
  }
  .thr-inputs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .thr-input {
    width: 6rem;
    min-height: 2.75rem;
    font-variant-numeric: tabular-nums;
  }
  .thr-unit,
  .thr-hint {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .thr-radios {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  .thr-radio {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    font-size: 0.88rem;
    color: var(--fg);
    cursor: pointer;
  }
  .thr-radio input {
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
    accent-color: var(--color-brand-600);
  }
  .thr-error {
    margin: 0.1rem 0 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .thr-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .thr-error {
    color: #fca5a5;
  }
  .thr-live-note {
    margin-top: 0.7rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .thr-settings-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 2.75rem;
    margin-top: 0.2rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-brand-700);
    cursor: pointer;
  }
  .thr-settings-toggle__sign {
    font-size: 1rem;
    line-height: 1;
  }
  :root[data-theme='dark'] .thr-settings-toggle {
    color: var(--color-brand-300);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .thr-settings-toggle {
      color: var(--color-brand-300);
    }
  }
  .thr-settings {
    margin-top: 0.4rem;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--subtle);
  }
  .thr-set {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .thr-set + .thr-set {
    margin-top: 0.8rem;
  }
  .thr-set__legend {
    display: block;
    padding: 0;
    margin-bottom: 0.1rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--heading);
  }
  .thr-set__options--stacked {
    display: grid;
    gap: 0;
  }
  .thr-set__options--stacked .thr-radio {
    min-height: 2.5rem;
    font-size: 0.84rem;
  }

  /* Result ---------------------------------------------------------- */
  .thr-sep {
    margin: 0 0.3rem;
    font-size: 1.6rem;
    line-height: 1;
    vertical-align: 0.12em;
    color: var(--muted);
    font-weight: 600;
  }
  .thr-zones {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.84rem;
  }
  .thr-zones th,
  .thr-zones td {
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }
  .thr-zones thead th {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    font-weight: 700;
  }
  .thr-zones tbody th {
    font-weight: 500;
    color: var(--fg);
    padding-right: 0.6rem;
  }
  .thr-num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .thr-zones tbody td.thr-num {
    font-weight: 700;
    color: var(--heading);
  }
  /* Cool to hot, as the reference colours it — but the swatch only ever REPEATS what the
     row already says in words, so nothing here is carried by colour alone. */
  .thr-swatch {
    display: inline-block;
    width: 0.55rem;
    height: 0.55rem;
    margin-right: 0.45rem;
    border-radius: 0.15rem;
    vertical-align: 0.02em;
    background: var(--zone, var(--line));
  }
  .thr-zone--very-light {
    --zone: #fde68a;
  }
  .thr-zone--light {
    --zone: #fcd34d;
  }
  .thr-zone--moderate {
    --zone: #fb923c;
  }
  .thr-zone--hard {
    --zone: #f97316;
  }
  .thr-zone--vo2max {
    --zone: #dc2626;
  }

  .thr-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin: 0.75rem 0 0;
  }
  .thr-fact {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .thr-fact dt {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .thr-fact dd {
    margin: 0;
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--heading);
    font-variant-numeric: tabular-nums;
  }
  .thr-note {
    margin: 0.7rem 0 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 26rem) {
    .thr-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import {
    targetHeartRateBinding,
    TARGET_HEART_RATE_EXAMPLE_VALUES,
  } from '@lib/calculators/target-heart-rate-form';

  document.querySelectorAll<HTMLElement>('[data-thr]').forEach((root) => {
    mountFormCalculator(root, targetHeartRateBinding, {
      recalculationMode: 'live-after-first',
      example: { values: TARGET_HEART_RATE_EXAMPLE_VALUES },
      calculateButtonLabel: 'Calculate',
    });

    // "+ Settings" — a plain disclosure, closed on load.
    const settings = root.querySelector<HTMLElement>('[data-settings]');
    const settingsToggle = root.querySelector<HTMLButtonElement>('[data-settings-toggle]');
    const sign = settingsToggle?.querySelector<HTMLElement>('.thr-settings-toggle__sign');
    if (settings && settingsToggle) {
      settingsToggle.addEventListener('click', () => {
        const open = settings.hidden;
        settings.hidden = !open;
        settingsToggle.setAttribute('aria-expanded', String(open));
        if (sign) sign.textContent = open ? '−' : '+';
      });
    }

    /**
     * Age or a measured maximum — never both on screen. The box that leaves is emptied, so a
     * figure the visitor typed and then walked away from can never reach a result whose input
     * they can no longer see.
     */
    const syncMode = () => {
      const mode = root.querySelector<HTMLInputElement>('[name="mode"]:checked')?.value ?? 'age';
      root.querySelectorAll<HTMLElement>('[data-mode-group]').forEach((group) => {
        const wanted = group.dataset.modeGroup === mode;
        group.hidden = !wanted;
        if (wanted) return;
        group.querySelectorAll<HTMLInputElement>('input').forEach((el) => {
          el.value = '';
        });
        const err = root.querySelector<HTMLElement>(`[data-error-for="${group.dataset.field}"]`);
        if (err) err.hidden = true;
      });
    };
    root.querySelectorAll<HTMLInputElement>('[name="mode"]').forEach((r) =>
      r.addEventListener('change', syncMode),
    );
    syncMode();

    // Reset restores the radios silently, so re-derive what depends on them.
    root.addEventListener('calculator:reset', syncMode);
  });
</script>
