---
/**
 * Body fat island — the reference's report and its three unit tabs, on the UNCHANGED
 * standard-form runtime.
 *
 * One set of boxes serves both unit systems. Switching between them relabels the units,
 * shows or hides the second box of a pair, and CONVERTS what is already typed — because the
 * visitor measured a body, not a number, and the tape does not change when the label above
 * the box does. Clearing their work to change units would be the rude answer.
 *
 * "Other Units" is not a third system. It opens the shared `UnitConverterPanel` ABOVE the
 * calculator, so someone whose scales read in stones can turn that into a figure the boxes
 * accept. That panel reuses the site's own tested `CATEGORIES` / `convert`, so there is no
 * second table of factors to drift out of step with the conversion calculator.
 *
 * The hip box exists only for women, because only the female formula uses it, and it is
 * emptied on the way out so invisible state can never reach a result.
 */
import { UNIT_TABS, REPORT_ROWS, CATEGORY_BANDS } from '@lib/calculators/body-fat-form';
import UnitConverterPanel from '@components/calc/UnitConverterPanel.astro';
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import ResultInterpretation from '@components/result/ResultInterpretation.astro';
import ResultBreakdown from '@components/result/ResultBreakdown.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';

/** Unit wording per tab: [main box, second box or null]. */
const UNIT_LABELS: Record<string, Record<string, [string, string | null]>> = {
  us: {
    weight: ['pounds', null],
    height: ['feet', 'inches'],
    neck: ['feet', 'inches'],
    waist: ['feet', 'inches'],
    hip: ['feet', 'inches'],
  },
  metric: {
    weight: ['kg', null],
    height: ['cm', null],
    neck: ['cm', null],
    waist: ['cm', null],
    hip: ['cm', null],
  },
};

const MEASUREMENTS: { name: string; part: string; label: string; id: string }[] = [
  { name: 'weight', part: 'weightLb', label: 'Weight', id: 'bf-weight' },
  { name: 'height', part: 'heightIn', label: 'Height', id: 'bf-height' },
  { name: 'neck', part: 'neckIn', label: 'Neck', id: 'bf-neck' },
  { name: 'waist', part: 'waistIn', label: 'Waist', id: 'bf-waist' },
  { name: 'hip', part: 'hipIn', label: 'Hip', id: 'bf-hip' },
];

/** Gauge segments: the band edges plus a run past the last one for the pointer. */
const gaugeFor = (sex: 'male' | 'female') => {
  const { edges, labels } = CATEGORY_BANDS[sex];
  const max = edges[edges.length - 1] * 1.6;
  const stops = [...edges, max];
  return labels.map((label, i) => ({
    label,
    from: stops[i],
    to: stops[i + 1],
    width: ((stops[i + 1] - stops[i]) / max) * 100,
    left: (stops[i] / max) * 100,
  }));
};
const GAUGES = { male: gaugeFor('male'), female: gaugeFor('female') };
---

<div class="bfwrap mx-auto w-full max-w-4xl" data-body-fat>
  <UnitConverterPanel id="bf-converter" />

  <div class="bfcalc grid gap-6 md:grid-cols-2 md:items-start">
  <!-- Inputs -->
  <form class="card p-4" data-form novalidate aria-label="Body fat calculator">
    <div class="bf-tabs">
      <fieldset class="bf-tabs__systems" data-field="unitTab">
        <legend class="sr-only">Units</legend>
        {UNIT_TABS.map((t) => (
          <label class="bf-tab">
            <input type="radio" name="unitTab" value={t.value} checked={t.value === 'us'} />
            <span>{t.label}</span>
          </label>
        ))}
      </fieldset>
      <button type="button" class="bf-tab bf-tab--toggle" data-converter-toggle aria-expanded="false" aria-controls="bf-converter">
        <span>Other Units</span>
      </button>
    </div>

    <fieldset class="bf-row bf-row--radios" data-field="sex">
      <legend class="field-label bf-row__label">Gender</legend>
      <div class="bf-radios">
        <label class="bf-radio"><input type="radio" name="sex" value="male" checked /><span>male</span></label>
        <label class="bf-radio"><input type="radio" name="sex" value="female" /><span>female</span></label>
      </div>
    </fieldset>

    <div class="bf-row" data-field="age">
      <label class="field-label bf-row__label" for="bf-age">Age</label>
      <div class="bf-inputs">
        <input class="field bf-input" id="bf-age" name="age" type="number" min="2" max="120" step="1" inputmode="numeric" autocomplete="off" placeholder="25" aria-describedby="bf-age-error" />
      </div>
    </div>
    <p class="bf-error" id="bf-age-error" data-error-for="age" hidden></p>

    {MEASUREMENTS.map((m) => (
      <div class="bf-row" data-field={m.name} data-measure={m.name} hidden={m.name === 'hip'}>
        <label class="field-label bf-row__label" for={m.id}>{m.label}</label>
        <div class="bf-inputs">
          <span class="bf-pair">
            <input class="field bf-input" id={m.id} name={m.name} type="number" min="0" step="any" inputmode="decimal" autocomplete="off" aria-describedby={`${m.id}-error`} />
            <span class="bf-affix" data-affix-main={m.name}>{UNIT_LABELS.us[m.name][0]}</span>
          </span>
          <span class="bf-pair" data-part-for={m.name} hidden={UNIT_LABELS.us[m.name][1] === null}>
            <input class="field bf-input" id={`${m.id}-part`} name={m.part} type="number" min="0" step="any" inputmode="decimal" autocomplete="off" aria-label={`${m.label}, ${UNIT_LABELS.us[m.name][1] ?? ''}`} />
            <span class="bf-affix" data-affix-part={m.name}>{UNIT_LABELS.us[m.name][1] ?? ''}</span>
          </span>
        </div>
      </div>
      <p class="bf-error" id={`${m.id}-error`} data-error-for={m.name} hidden></p>
    ))}

    <div class="bf-actions">
      <button type="submit" class="btn btn-primary bf-btn">Calculate</button>
      <button type="button" class="btn btn-secondary bf-btn" data-reset>Clear</button>
    </div>
    <p class="bf-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result -->
  <ResultShell id="bf-result" state="example" density="standard" label="Body fat result" minHeight="20rem" placeholderAlignment="center">
    <ExampleNotice caption="Sample: a 25-year-old man, 70 kg, 178 cm, neck 50 cm, waist 96 cm." />
    <EmptyResult message="Enter your measurements, then calculate." />

    <div data-result-when="valid">
      <ResultSummary label="Body Fat">
        <ResultValue value="—" size="text-4xl" />
      </ResultSummary>
      <ResultInterpretation>
        <span data-bf-interpretation></span>
      </ResultInterpretation>

      {(['male', 'female'] as const).map((sex) => (
        <figure class="bf-gauge" data-gauge-for={sex} hidden={sex === 'female'}>
          <div class="bf-gauge__track" data-bf-gauge={sex === 'male' ? '' : undefined} role="img" aria-label="Body fat category scale">
            {GAUGES[sex].map((band) => (
              <span class="bf-gauge__band" style={`left:${band.left}%;width:${band.width}%`} data-band={band.label}>
                <span class="bf-gauge__edge">{band.from}%</span>
              </span>
            ))}
            <span class="bf-gauge__pointer" data-bf-pointer style="left:0%">—</span>
          </div>
          <figcaption class="bf-gauge__legend">
            {GAUGES[sex].map((band) => <span class="bf-gauge__key" data-key={band.label}>{band.label}</span>)}
          </figcaption>
        </figure>
      ))}

      <ResultBreakdown title="The full report">
        <table class="bf-table">
          <caption class="sr-only">Body composition estimates</caption>
          <tbody>
            {REPORT_ROWS.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td data-bf-row={row.key}>—</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="bf-note">
          Circumference estimates, not a body scan. The Navy method reads where fat sits; the BMI
          method knows only height, weight and age and cannot tell muscle from fat, which is why
          the two rarely agree. Useful for tracking a direction over months, not for a diagnosis.
        </p>
      </ResultBreakdown>
    </div>

    <InvalidResult
      title="Check your measurements"
      message="Enter an age and every measurement. The waist must be larger than the neck for the formula to work."
    />

    <ResultAnnouncement id="bf-live" />
  </ResultShell>
  </div>
</div>

<style>
  .bf-tabs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.9rem;
  }
  .bf-tabs__systems {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    border: 0;
    padding: 0;
    margin: 0;
  }
  .bf-tab--toggle {
    background: var(--card);
  }
  .bf-tab--toggle[aria-expanded='true'] {
    border-color: var(--color-brand-600);
    background: var(--color-brand-50);
    color: var(--color-brand-700);
  }
  .bf-tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--fg);
    cursor: pointer;
  }
  /* The input covers the pill so the whole thing is the control, not just the label. */
  .bf-tab input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .bf-tab:has(input:checked) {
    border-color: var(--color-brand-600);
    background: var(--color-brand-50);
    color: var(--color-brand-700);
  }
  .bf-tab:has(input:focus-visible) {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .bf-tab:has(input:checked) {
      background: color-mix(in srgb, var(--color-brand-600) 22%, transparent);
      color: var(--color-brand-300);
    }
  }
  :root[data-theme='dark'] .bf-tab:has(input:checked) {
    background: color-mix(in srgb, var(--color-brand-600) 22%, transparent);
    color: var(--color-brand-300);
  }

  .bf-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.22rem 0;
    border: 0;
  }
  .bf-row--radios {
    padding: 0.22rem 0;
  }
  .bf-row__label {
    margin: 0;
    font-size: 0.9rem;
  }

  .bf-inputs {
    display: flex;
    align-items: stretch;
    gap: 0.4rem;
    flex: 0 0 auto;
  }
  .bf-pair {
    display: inline-flex;
    align-items: stretch;
  }
  .bf-input {
    width: 5rem;
    min-height: 2.75rem;
    border-radius: 0.5rem 0 0 0.5rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .bf-row[data-measure] .bf-inputs > .bf-pair:only-child .bf-input {
    width: 8rem;
  }
  .bf-affix {
    display: inline-flex;
    align-items: center;
    padding: 0 0.5rem;
    border: 1px solid var(--line);
    border-left: 0;
    border-radius: 0 0.5rem 0.5rem 0;
    background: var(--subtle);
    font-size: 0.8rem;
    color: var(--muted);
    white-space: nowrap;
  }
  #bf-age {
    width: 8rem;
    border-radius: 0.5rem;
  }

  .bf-radios {
    display: flex;
    gap: 0.9rem;
  }
  .bf-radio {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    font-size: 0.9rem;
    cursor: pointer;
  }
  .bf-radio input {
    width: 1.05rem;
    height: 1.05rem;
    accent-color: var(--color-brand-600);
  }

  .bf-error {
    margin: 0 0 0.25rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .bf-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .bf-error {
    color: #fca5a5;
  }

  .bf-actions {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .bf-btn {
    min-height: 2.75rem;
  }
  .bf-live-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* Gauge --------------------------------------------------------- */
  .bf-gauge {
    margin: 1.1rem 0 0;
  }
  .bf-gauge__track {
    position: relative;
    height: 1.15rem;
    margin-top: 1.6rem;
    border-radius: 0.3rem;
    overflow: visible;
  }
  .bf-gauge__band {
    position: absolute;
    top: 0;
    height: 100%;
    background: var(--subtle);
    border-right: 1px solid var(--card);
  }
  .bf-gauge__band:first-of-type {
    border-radius: 0.3rem 0 0 0.3rem;
  }
  .bf-gauge__band:nth-of-type(2) { background: var(--color-brand-100); }
  .bf-gauge__band:nth-of-type(3) { background: var(--color-brand-300); }
  .bf-gauge__band:nth-of-type(4) { background: var(--color-brand-500); }
  .bf-gauge__band:nth-of-type(5) { background: var(--color-brand-700); border-radius: 0 0.3rem 0.3rem 0; }
  /* Edge numbers sit BELOW the bar; the pointer owns the space above it, and the two
     collide if they share a line. */
  .bf-gauge__edge {
    position: absolute;
    top: 1.3rem;
    left: 0;
    font-size: 0.68rem;
    color: var(--muted);
    transform: translateX(-50%);
  }
  .bf-gauge__pointer {
    position: absolute;
    top: -1.5rem;
    transform: translateX(-50%);
    font-size: 0.76rem;
    font-weight: 800;
    color: var(--heading);
    white-space: nowrap;
  }
  .bf-gauge__pointer::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 1.05rem;
    transform: translateX(-50%);
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid var(--heading);
  }
  .bf-gauge__legend {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.2rem;
    font-size: 0.66rem;
    line-height: 1.2;
    color: var(--muted);
    text-align: center;
  }

  .bf-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }
  .bf-table th,
  .bf-table td {
    padding: 0.34rem 0.4rem;
    border-bottom: 1px solid var(--line);
  }
  .bf-table th {
    text-align: left;
    font-weight: 500;
    color: var(--fg);
  }
  .bf-table td {
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    color: var(--heading);
    white-space: nowrap;
  }
  .bf-table tbody tr:first-child th,
  .bf-table tbody tr:first-child td {
    font-weight: 800;
  }
  .bf-table tbody tr:last-child th,
  .bf-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .bf-note {
    margin: 0.8rem 0 0;
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 30rem) {
    .bf-row {
      flex-wrap: wrap;
    }
    .bf-input {
      width: 4.5rem;
    }
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { mountUnitConverterPanel } from '@lib/calculators/unit-converter-panel';
  import {
    bodyFatBinding,
    convertMeasurements,
    BODY_FAT_EXAMPLE_VALUES,
    type UnitTab,
  } from '@lib/calculators/body-fat-form';

  const UNIT_LABELS: Record<string, Record<string, [string, string | null]>> = {
    us: { weight: ['pounds', null], height: ['feet', 'inches'], neck: ['feet', 'inches'], waist: ['feet', 'inches'], hip: ['feet', 'inches'] },
    metric: { weight: ['kg', null], height: ['cm', null], neck: ['cm', null], waist: ['cm', null], hip: ['cm', null] },
  };
  const NAMES = ['weight', 'height', 'neck', 'waist', 'hip'] as const;

  document.querySelectorAll<HTMLElement>('[data-body-fat]').forEach((root) => {
    mountFormCalculator(root, bodyFatBinding, {
      recalculationMode: 'live-after-first',
      example: { values: BODY_FAT_EXAMPLE_VALUES },
      calculateButtonLabel: 'Calculate',
    });

    const field = (name: string) => root.querySelector<HTMLInputElement>(`[name="${name}"]`);
    const tabNow = () =>
      (root.querySelector<HTMLInputElement>('[name="unitTab"]:checked')?.value ?? 'us') as UnitTab;
    const sexNow = () => root.querySelector<HTMLInputElement>('[name="sex"]:checked')?.value ?? 'male';

    /** Relabel the boxes and show or hide the second of each pair. */
    const applyLabels = (tab: UnitTab) => {
      for (const name of NAMES) {
        const [main, part] = UNIT_LABELS[tab][name];
        const mainAffix = root.querySelector<HTMLElement>(`[data-affix-main="${name}"]`);
        if (mainAffix) mainAffix.textContent = main;
        const partAffix = root.querySelector<HTMLElement>(`[data-affix-part="${name}"]`);
        if (partAffix) partAffix.textContent = part ?? '';
        const partWrap = root.querySelector<HTMLElement>(`[data-part-for="${name}"]`);
        if (partWrap) partWrap.hidden = part === null;
      }
    };

    let current: UnitTab = tabNow();
    applyLabels(current);

    // Switching tabs converts what is already typed rather than throwing it away.
    root.querySelectorAll<HTMLInputElement>('[name="unitTab"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        const next = tabNow();
        if (next === current) return;
        const converted = convertMeasurements(bodyFatBinding.readValues(root), current, next);
        for (const [name, value] of Object.entries(converted)) {
          if (name === 'unitTab' || name === 'sex') continue;
          const el = field(name);
          if (el) el.value = String(value);
        }
        current = next;
        applyLabels(next);
        // A relabelled box is a changed input as far as a live result is concerned.
        field('waist')?.dispatchEvent(new Event('input', { bubbles: true }));
      });
    });

    /** Only the female formula uses a hip measurement, so the box exists only for women. */
    const syncHip = () => {
      const female = sexNow() === 'female';
      const row = root.querySelector<HTMLElement>('[data-measure="hip"]');
      if (row) row.hidden = !female;
      const err = root.querySelector<HTMLElement>('[data-error-for="hip"]');
      if (err && !female) err.hidden = true;
      if (!female) {
        const hip = field('hip');
        const hipPart = field('hipIn');
        if (hip) hip.value = '';
        if (hipPart) hipPart.value = '';
      }
    };
    root.querySelectorAll<HTMLInputElement>('[name="sex"]').forEach((r) =>
      r.addEventListener('change', syncHip),
    );
    syncHip();

    /** The gauge is drawn per sex; show the one that matches. */
    const syncGauge = () => {
      const sex = sexNow();
      root.querySelectorAll<HTMLElement>('[data-gauge-for]').forEach((g) => {
        g.hidden = g.dataset.gaugeFor !== sex;
      });
    };
    root.querySelectorAll<HTMLInputElement>('[name="sex"]').forEach((r) =>
      r.addEventListener('change', syncGauge),
    );
    syncGauge();

    // The "Other Units" converter, shared with the ideal-weight calculator.
    mountUnitConverterPanel(root);

    // Blank the report whenever the shell leaves the valid state, so nothing stale lingers.
    const shell = root.querySelector<HTMLElement>('[data-result-shell]');
    if (shell) {
      new MutationObserver(() => {
        if (shell.dataset.resultState === 'valid') return;
        root.querySelectorAll<HTMLElement>('[data-bf-row]').forEach((el) => {
          el.textContent = '—';
        });
      }).observe(shell, { attributes: true, attributeFilter: ['data-result-state'] });
    }
  });
</script>
