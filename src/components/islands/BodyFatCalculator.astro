---
import { calculateBodyFat, type BodyFatCategory } from '@lib/calculators/body-fat';
import { formatNumber } from '@lib/format';

const r = calculateBodyFat({ sex: 'male', system: 'metric', heightCm: 180, neckCm: 38, waistCm: 85 });
const catColor: Record<BodyFatCategory, string> = {
  'Essential fat': '#3b82f6', Athletes: '#059669', Fitness: '#10b981', Average: '#f59e0b', Obese: '#e11d48',
};
const show = (v: number) => (Number.isNaN(v) ? '—' : `${formatNumber(v, 1)}%`);
---

<div class="mx-auto grid w-full max-w-4xl gap-6 md:grid-cols-2" data-bodyfat>
  <form class="card p-5 sm:p-6" data-bf-form novalidate>
    <div class="flex flex-wrap gap-3">
      <div class="inline-flex rounded-lg border p-0.5" role="radiogroup" aria-label="Sex" style="border-color: var(--line)">
        <button type="button" class="seg-btn is-active" data-sex="male" role="radio" aria-checked="true">Male</button>
        <button type="button" class="seg-btn" data-sex="female" role="radio" aria-checked="false">Female</button>
      </div>
      <div class="inline-flex rounded-lg border p-0.5" role="radiogroup" aria-label="Units" style="border-color: var(--line)">
        <button type="button" class="unit-btn is-active" data-unit="metric" role="radio" aria-checked="true">Metric</button>
        <button type="button" class="unit-btn" data-unit="imperial" role="radio" aria-checked="false">Imperial</button>
      </div>
    </div>
    <div class="mt-5 space-y-4">
      <div>
        <label class="field-label" for="bf-height">Height</label>
        <div class="flex"><input class="field rounded-r-none" id="bf-height" name="height" type="number" min="0" value="180" inputmode="decimal" /><span class="field-affix rounded-r-lg border-l-0" data-bf-unit>cm</span></div>
      </div>
      <div>
        <label class="field-label" for="bf-neck">Neck circumference</label>
        <div class="flex"><input class="field rounded-r-none" id="bf-neck" name="neck" type="number" min="0" value="38" inputmode="decimal" /><span class="field-affix rounded-r-lg border-l-0" data-bf-unit>cm</span></div>
      </div>
      <div>
        <label class="field-label" for="bf-waist">Waist circumference</label>
        <div class="flex"><input class="field rounded-r-none" id="bf-waist" name="waist" type="number" min="0" value="85" inputmode="decimal" /><span class="field-affix rounded-r-lg border-l-0" data-bf-unit>cm</span></div>
      </div>
      <div data-bf-hip hidden>
        <label class="field-label" for="bf-hip">Hip circumference</label>
        <div class="flex"><input class="field rounded-r-none" id="bf-hip" name="hip" type="number" min="0" value="96" inputmode="decimal" /><span class="field-affix rounded-r-lg border-l-0" data-bf-unit>cm</span></div>
      </div>
    </div>
  </form>

  <div class="card flex flex-col justify-center p-6 text-center">
    <p class="result-label">Estimated body fat</p>
    <p class="mt-2 text-5xl result-value" data-bf-value>{show(r.bodyFatPct)}</p>
    <p class="mt-3"><span class="rounded-full px-3 py-1 text-sm font-bold text-white" style={`background:${catColor[r.category]}`} data-bf-cat>{r.category}</span></p>
    <p class="mt-4 text-sm" style="color: var(--muted)">Based on the U.S. Navy circumference method. Measure at the navel (waist) and just below the larynx (neck).</p>
  </div>
</div>

<style>
  .seg-btn, .unit-btn { padding: 0.35rem 0.9rem; border-radius: 0.45rem; font-size: 0.85rem; font-weight: 600; color: var(--muted); cursor: pointer; }
  .seg-btn.is-active, .unit-btn.is-active { background: var(--color-brand-600); color: #fff; }
</style>

<script>
  import { calculateBodyFat, type Sex, type UnitSystem, type BodyFatCategory } from '@lib/calculators/body-fat';
  const catColor: Record<BodyFatCategory, string> = {
    'Essential fat': '#3b82f6', Athletes: '#059669', Fitness: '#10b981', Average: '#f59e0b', Obese: '#e11d48',
  };
  const show = (v: number) => (Number.isNaN(v) ? '—' : `${v.toFixed(1)}%`);

  document.querySelectorAll<HTMLElement>('[data-bodyfat]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-bf-form]')!;
    let sex: Sex = 'male';
    let system: UnitSystem = 'metric';
    const hipRow = root.querySelector<HTMLElement>('[data-bf-hip]')!;
    const num = (n: string) => Number((form.elements.namedItem(n) as HTMLInputElement)?.value) || 0;

    function recompute() {
      const dims = system === 'metric'
        ? { heightCm: num('height'), neckCm: num('neck'), waistCm: num('waist'), hipCm: num('hip') }
        : { heightIn: num('height'), neckIn: num('neck'), waistIn: num('waist'), hipIn: num('hip') };
      const r = calculateBodyFat({ sex, system, ...dims });
      const valueEl = root.querySelector<HTMLElement>('[data-bf-value]')!;
      const catEl = root.querySelector<HTMLElement>('[data-bf-cat]')!;
      valueEl.textContent = show(r.bodyFatPct);
      if (Number.isNaN(r.bodyFatPct)) { catEl.textContent = 'Check measurements'; catEl.style.background = 'var(--muted)'; }
      else { catEl.textContent = r.category; catEl.style.background = catColor[r.category]; }
    }
    root.querySelectorAll<HTMLButtonElement>('.seg-btn').forEach((b) => b.addEventListener('click', () => {
      sex = (b.dataset.sex as Sex) ?? 'male';
      root.querySelectorAll('.seg-btn').forEach((x) => { const a = x === b; x.classList.toggle('is-active', a); x.setAttribute('aria-checked', String(a)); });
      hipRow.hidden = sex !== 'female';
      recompute();
    }));
    root.querySelectorAll<HTMLButtonElement>('.unit-btn').forEach((b) => b.addEventListener('click', () => {
      system = (b.dataset.unit as UnitSystem) ?? 'metric';
      root.querySelectorAll('.unit-btn').forEach((x) => { const a = x === b; x.classList.toggle('is-active', a); x.setAttribute('aria-checked', String(a)); });
      root.querySelectorAll('[data-bf-unit]').forEach((el) => (el.textContent = system === 'metric' ? 'cm' : 'in'));
      recompute();
    }));
    form.addEventListener('input', recompute);
    recompute();
  });
</script>
