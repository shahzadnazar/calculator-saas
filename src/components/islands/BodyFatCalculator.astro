---
/**
 * Body fat calculator island (R7C-2A — standard-form wave, calculator #3).
 *
 * The FIRST standard-form migration with CONDITIONAL inputs: the U.S. Navy
 * method needs a hip measurement for women that men don't provide. Task-first,
 * direct-intent: all measurements start EMPTY, the result is empty (an
 * instruction, no sample percentage / category), and the visitor presses
 * "Calculate Body Fat" for the first result. Live-after-first afterwards. All
 * interaction, validation, state, announcement and focus are owned by the shared
 * runtime (UNCHANGED); this island is markup + the body-fat binding
 * (@lib/calculators/body-fat-form) + one small conditional-visibility helper the
 * runtime deliberately does not own.
 *
 * Sex is a native fieldset/legend radio group (its changes flow through the
 * runtime's `input` path); Metric/Imperial is the runtime's `[data-unit]`
 * selector. The hip row (`[data-bf-hip]`, one per unit group) is shown only for
 * women — the binding excludes it from validation for men and re-hides it on
 * reset. The PRIMARY result is the dominant percentage; the classification is
 * conveyed as TEXT (never colour alone) with a SECONDARY, accessible category
 * scale (sex-specific ranges, the visitor's category highlighted).
 */
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import ResultInterpretation from '@components/result/ResultInterpretation.astro';
import ResultBreakdown from '@components/result/ResultBreakdown.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';

const BANDS = ['Essential fat', 'Athletes', 'Fitness', 'Average', 'Obese'];
---

<div class="bodyfat mx-auto grid w-full max-w-4xl gap-6 md:grid-cols-2 md:items-start" data-bodyfat>
  <!-- Inputs -->
  <form class="card p-4" data-form novalidate aria-label="Body fat calculator">
    <div class="flex flex-wrap gap-3">
      <fieldset class="seg-group">
        <legend class="sr-only">Sex</legend>
        <label class="seg"><input type="radio" name="sex" value="male" checked /><span>Male</span></label>
        <label class="seg"><input type="radio" name="sex" value="female" /><span>Female</span></label>
      </fieldset>
      <div class="inline-flex rounded-lg border p-0.5" role="radiogroup" aria-label="Unit system" style="border-color: var(--line)">
        <button type="button" class="unit-btn is-active" data-unit="metric" role="radio" aria-checked="true">Metric</button>
        <button type="button" class="unit-btn" data-unit="imperial" role="radio" aria-checked="false">Imperial (US)</button>
      </div>
    </div>

    <div class="mt-5">
      <!-- Metric -->
      <div class="space-y-4" data-group="metric">
        <div data-field="heightCm">
          <label class="field-label" for="bf-height-cm">Height</label>
          <div class="flex">
            <input class="field rounded-r-none" id="bf-height-cm" name="heightCm" type="number" min="0" step="0.1" inputmode="decimal" autocomplete="off" placeholder="e.g. 180" aria-describedby="bf-heightCm-error" />
            <span class="field-affix rounded-r-lg border-l-0">cm</span>
          </div>
          <p class="bf-field-error" id="bf-heightCm-error" data-error-for="heightCm" hidden></p>
        </div>
        <div data-field="neckCm">
          <label class="field-label" for="bf-neck-cm">Neck circumference</label>
          <div class="flex">
            <input class="field rounded-r-none" id="bf-neck-cm" name="neckCm" type="number" min="0" step="0.1" inputmode="decimal" autocomplete="off" placeholder="e.g. 38" aria-describedby="bf-neckCm-error" />
            <span class="field-affix rounded-r-lg border-l-0">cm</span>
          </div>
          <p class="bf-field-error" id="bf-neckCm-error" data-error-for="neckCm" hidden></p>
        </div>
        <div data-field="waistCm">
          <label class="field-label" for="bf-waist-cm">Waist circumference</label>
          <div class="flex">
            <input class="field rounded-r-none" id="bf-waist-cm" name="waistCm" type="number" min="0" step="0.1" inputmode="decimal" autocomplete="off" placeholder="e.g. 85" aria-describedby="bf-waistCm-error" />
            <span class="field-affix rounded-r-lg border-l-0">cm</span>
          </div>
          <p class="bf-field-error" id="bf-waistCm-error" data-error-for="waistCm" hidden></p>
        </div>
        <div data-field="hipCm" data-bf-hip hidden>
          <label class="field-label" for="bf-hip-cm">Hip circumference</label>
          <div class="flex">
            <input class="field rounded-r-none" id="bf-hip-cm" name="hipCm" type="number" min="0" step="0.1" inputmode="decimal" autocomplete="off" placeholder="e.g. 96" aria-describedby="bf-hipCm-error" disabled />
            <span class="field-affix rounded-r-lg border-l-0">cm</span>
          </div>
          <p class="bf-field-error" id="bf-hipCm-error" data-error-for="hipCm" hidden></p>
        </div>
      </div>

      <!-- Imperial -->
      <div class="space-y-4" data-group="imperial" hidden>
        <div data-field="heightIn">
          <label class="field-label" for="bf-height-in">Height</label>
          <div class="flex">
            <input class="field rounded-r-none" id="bf-height-in" name="heightIn" type="number" min="0" step="0.1" inputmode="decimal" autocomplete="off" placeholder="e.g. 71" aria-describedby="bf-heightIn-error" />
            <span class="field-affix rounded-r-lg border-l-0">in</span>
          </div>
          <p class="bf-field-error" id="bf-heightIn-error" data-error-for="heightIn" hidden></p>
        </div>
        <div data-field="neckIn">
          <label class="field-label" for="bf-neck-in">Neck circumference</label>
          <div class="flex">
            <input class="field rounded-r-none" id="bf-neck-in" name="neckIn" type="number" min="0" step="0.1" inputmode="decimal" autocomplete="off" placeholder="e.g. 15" aria-describedby="bf-neckIn-error" />
            <span class="field-affix rounded-r-lg border-l-0">in</span>
          </div>
          <p class="bf-field-error" id="bf-neckIn-error" data-error-for="neckIn" hidden></p>
        </div>
        <div data-field="waistIn">
          <label class="field-label" for="bf-waist-in">Waist circumference</label>
          <div class="flex">
            <input class="field rounded-r-none" id="bf-waist-in" name="waistIn" type="number" min="0" step="0.1" inputmode="decimal" autocomplete="off" placeholder="e.g. 34" aria-describedby="bf-waistIn-error" />
            <span class="field-affix rounded-r-lg border-l-0">in</span>
          </div>
          <p class="bf-field-error" id="bf-waistIn-error" data-error-for="waistIn" hidden></p>
        </div>
        <div data-field="hipIn" data-bf-hip hidden>
          <label class="field-label" for="bf-hip-in">Hip circumference</label>
          <div class="flex">
            <input class="field rounded-r-none" id="bf-hip-in" name="hipIn" type="number" min="0" step="0.1" inputmode="decimal" autocomplete="off" placeholder="e.g. 38" aria-describedby="bf-hipIn-error" disabled />
            <span class="field-affix rounded-r-lg border-l-0">in</span>
          </div>
          <p class="bf-field-error" id="bf-hipIn-error" data-error-for="hipIn" hidden></p>
        </div>
      </div>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <button type="submit" class="btn btn-primary">Calculate Body Fat</button>
      <button type="button" class="btn btn-secondary" data-reset>Reset</button>
    </div>
    <p class="bf-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result -->
  <ResultShell
    id="bf-result"
    state="empty"
    density="standard"
    label="Your body fat result"
    minHeight="24rem"
    placeholderAlignment="center"
  >
    <EmptyResult message="Enter your measurements, then calculate your estimated body-fat percentage." />

    <div data-result-when="valid">
      <ResultSummary label="Estimated body fat">
        <ResultValue value="—" unit="%" />
      </ResultSummary>
      <p class="bf-class">Your category: <strong data-bf-category>—</strong></p>
      <ResultInterpretation>
        <span data-bf-interpretation></span>
      </ResultInterpretation>

      <ResultBreakdown title="Body-fat categories">
        <table class="bf-bands">
          <thead>
            <tr><th scope="col">Category</th><th scope="col" class="bf-num">Range</th></tr>
          </thead>
          <tbody>
            {BANDS.map((name) => (
              <tr data-bf-band><th scope="row">{name}<span class="sr-only" data-bf-own></span></th><td class="bf-num" data-bf-band-range>—</td></tr>
            ))}
          </tbody>
        </table>
        <p class="bf-note">
          U.S. Navy circumference method. Category ranges differ by sex — a general estimate, not a medical diagnosis.
        </p>
      </ResultBreakdown>
    </div>

    <InvalidResult title="Check your measurements" message="Enter your height, neck and waist — plus hip for women — to estimate your body fat." />

    <ResultAnnouncement id="bf-live" />
  </ResultShell>
</div>

<style>
  .seg-group {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    padding: 0.125rem;
  }
  .seg {
    position: relative;
    display: inline-flex;
  }
  .seg input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .seg span {
    padding: 0.35rem 0.9rem;
    border-radius: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }
  .seg:has(input:checked) span {
    background: var(--color-brand-600);
    color: #fff;
  }
  .seg:has(input:focus-visible) span {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }

  .unit-btn {
    padding: 0.35rem 0.9rem;
    border-radius: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    cursor: pointer;
  }
  .unit-btn.is-active {
    background: var(--color-brand-600);
    color: #fff;
  }

  .bf-field-error {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .bf-field-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .bf-field-error {
    color: #fca5a5;
  }

  .bf-live-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* Classification — text-forward, never colour alone. */
  .bf-class {
    margin: 0.6rem 0 0;
    font-size: 1rem;
    color: var(--fg);
  }
  .bf-class strong {
    color: var(--heading);
    font-weight: 700;
  }

  /* Secondary category scale — clearly subordinate to the dominant percentage. */
  .bf-bands {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .bf-bands th,
  .bf-bands td {
    padding: 0.4rem 0.4rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }
  .bf-bands thead th {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    font-weight: 700;
  }
  .bf-bands tbody th {
    font-weight: 600;
    color: var(--fg);
  }
  .bf-num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--muted);
  }
  /* Visitor's category — a neutral brand highlight (no health-coded colours, so
     no colour-only meaning and no diagnostic implication); the category name is
     the signal, this only ties the scale row to the figure above. */
  .bf-bands tbody tr[aria-current='true'] {
    background: color-mix(in srgb, var(--color-brand-500) 10%, transparent);
  }
  .bf-bands tbody tr[aria-current='true'] th,
  .bf-bands tbody tr[aria-current='true'] td {
    color: var(--color-brand-700);
    font-weight: 700;
  }
  :root[data-theme='dark'] .bf-bands tbody tr[aria-current='true'] th,
  :root[data-theme='dark'] .bf-bands tbody tr[aria-current='true'] td {
    color: var(--color-brand-300);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .bf-bands tbody tr[aria-current='true'] th,
    :root:not([data-theme='light']) .bf-bands tbody tr[aria-current='true'] td {
      color: var(--color-brand-300);
    }
  }
  .bf-note {
    margin: 0.7rem 0 0;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--muted);
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { bodyFatBinding } from '@lib/calculators/body-fat-form';

  document.querySelectorAll<HTMLElement>('[data-bodyfat]').forEach((root) => {
    mountFormCalculator(root, bodyFatBinding, {
      recalculationMode: 'live-after-first',
      calculateButtonLabel: 'Calculate Body Fat',
    });

    // Conditional field: the hip measurement is only for women. Keep it in sync
    // with the sex selection (before AND after the first calculation — the runtime
    // owns recompute/validation, not field visibility). When not applicable the
    // row is hidden AND its input disabled (so it leaves the keyboard + a11y order
    // and is never submitted), and any stale hip error is cleared; the entered
    // VALUE is preserved for an in-session switch back. The binding re-hides +
    // disables + clears it on reset and excludes it from validation for men.
    const syncHip = () => {
      const female = root.querySelector<HTMLInputElement>('[name="sex"][value="female"]')?.checked ?? false;
      root.querySelectorAll<HTMLElement>('[data-bf-hip]').forEach((wrap) => {
        wrap.hidden = !female;
        const inp = wrap.querySelector<HTMLInputElement>('input');
        if (inp) inp.disabled = !female;
        if (!female) {
          inp?.removeAttribute('aria-invalid');
          const err = wrap.querySelector<HTMLElement>('[data-error-for]');
          if (err) {
            err.textContent = '';
            err.hidden = true;
          }
        }
      });
    };
    root.addEventListener('input', syncHip);
    syncHip();
  });
</script>
