---
/**
 * BMI calculator island (R2 — standard-form runtime pilot).
 *
 * Direct-intent, task-first: personal fields start EMPTY and STAY empty behind a
 * labelled worked example the shared runtime renders into this island's own
 * valid region; the visitor presses "Calculate BMI" for their first result. After that first success, edits update automatically
 * (live-after-first). All interaction, validation, state, announcements and
 * focus are owned by the shared runtime (@lib/result/form-runtime); this island
 * is only markup + the tiny BMI binding (@lib/calculators/bmi-form).
 */
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import ResultInterpretation from '@components/result/ResultInterpretation.astro';
import ResultBreakdown from '@components/result/ResultBreakdown.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';
---

<div class="bmi mx-auto grid w-full max-w-4xl gap-6 md:grid-cols-2 md:items-start" data-bmi>
  <!-- Inputs -->
  <form class="card p-4" data-form novalidate aria-label="BMI calculator">
    <div
      class="inline-flex rounded-lg border p-0.5"
      role="radiogroup"
      aria-label="Unit system"
      style="border-color: var(--line)"
    >
      <button type="button" class="unit-btn is-active" data-unit="metric" role="radio" aria-checked="true">Metric</button>
      <button type="button" class="unit-btn" data-unit="imperial" role="radio" aria-checked="false">Imperial (US)</button>
    </div>

    <!-- Metric -->
    <div class="mt-5 space-y-4" data-group="metric">
      <div data-field="heightCm">
        <label class="field-label" for="bmi-height-cm">Height</label>
        <div class="flex">
          <input
            class="field rounded-r-none"
            id="bmi-height-cm"
            name="heightCm"
            type="number"
            min="0"
            step="0.1"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 175"
            aria-describedby="bmi-heightCm-error"
          />
          <span class="field-affix rounded-r-lg border-l-0">cm</span>
        </div>
        <p class="bmi-field-error" id="bmi-heightCm-error" data-error-for="heightCm" hidden></p>
      </div>
      <div data-field="weightKg">
        <label class="field-label" for="bmi-weight-kg">Weight</label>
        <div class="flex">
          <input
            class="field rounded-r-none"
            id="bmi-weight-kg"
            name="weightKg"
            type="number"
            min="0"
            step="0.1"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 70"
            aria-describedby="bmi-weightKg-error"
          />
          <span class="field-affix rounded-r-lg border-l-0">kg</span>
        </div>
        <p class="bmi-field-error" id="bmi-weightKg-error" data-error-for="weightKg" hidden></p>
      </div>
    </div>

    <!-- Imperial -->
    <div class="mt-5 space-y-4" data-group="imperial" hidden>
      <div data-field="height">
        <label class="field-label" for="bmi-height-ft">Height</label>
        <div class="grid grid-cols-2 gap-3">
          <div class="flex">
            <input
              class="field rounded-r-none"
              id="bmi-height-ft"
              name="heightFt"
              type="number"
              min="0"
              step="1"
              inputmode="numeric"
              autocomplete="off"
              placeholder="5"
              aria-label="Height, feet"
              aria-describedby="bmi-height-error"
            />
            <span class="field-affix rounded-r-lg border-l-0">ft</span>
          </div>
          <div class="flex">
            <input
              class="field rounded-r-none"
              id="bmi-height-in"
              name="heightIn"
              type="number"
              min="0"
              max="11"
              step="1"
              inputmode="numeric"
              autocomplete="off"
              placeholder="9"
              aria-label="Height, inches"
              aria-describedby="bmi-height-error"
            />
            <span class="field-affix rounded-r-lg border-l-0">in</span>
          </div>
        </div>
        <p class="bmi-field-error" id="bmi-height-error" data-error-for="height" hidden></p>
      </div>
      <div data-field="weightLb">
        <label class="field-label" for="bmi-weight-lb">Weight</label>
        <div class="flex">
          <input
            class="field rounded-r-none"
            id="bmi-weight-lb"
            name="weightLb"
            type="number"
            min="0"
            step="0.1"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 154"
            aria-describedby="bmi-weightLb-error"
          />
          <span class="field-affix rounded-r-lg border-l-0">lb</span>
        </div>
        <p class="bmi-field-error" id="bmi-weightLb-error" data-error-for="weightLb" hidden></p>
      </div>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <button type="submit" class="btn btn-primary">Calculate BMI</button>
      <button type="button" class="btn btn-secondary" data-reset>Reset</button>
    </div>
    <p class="bmi-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result -->
  <!-- Reserve the valid-state height so live editing never jumps; the shared
       `placeholderAlignment="center"` prop vertically centres the short
       empty/invalid placeholders so the reserved card reads as intentional. -->
  <ResultShell
    id="bmi-result"
    density="standard"
    label="Your BMI result"
    minHeight="22rem"
    placeholderAlignment="center"
  >
    <ExampleNotice />
    <EmptyResult message="Enter your height and weight, then calculate your BMI." />

    <div data-result-when="valid">
      <ResultSummary label="Your BMI">
        <ResultValue value="—" unit="kg/m²" />
      </ResultSummary>
      <ResultInterpretation>
        <strong data-bmi-category>—</strong> <span data-bmi-phrase style="color: var(--muted)"></span>
      </ResultInterpretation>

      <!-- Category scale. Decorative; the category NAME above carries meaning,
           so classification never relies on colour alone. -->
      <div class="bmi-scale" aria-hidden="true">
        <div class="bmi-scale__bar">
          <span class="bmi-scale__marker" data-bmi-marker style="left: 0%"></span>
        </div>
        <div class="bmi-scale__labels">
          <span>Under</span><span>Normal</span><span>Over</span><span>Obese</span>
        </div>
      </div>

      <ResultBreakdown title="Healthy weight range">
        <p class="text-sm" style="color: var(--fg)">
          A healthy weight for your height is <strong data-bmi-range>—</strong>.
        </p>
      </ResultBreakdown>

      <p class="bmi-footnote">
        WHO adult classification (healthy BMI 18.5–24.9). BMI is a screening tool, not a diagnosis.
      </p>
    </div>

    <InvalidResult title="Check your entries" message="Enter your height and weight to calculate your BMI." />

    <ResultAnnouncement id="bmi-live" />
  </ResultShell>
</div>

<style>
  .unit-btn {
    padding: 0.35rem 0.9rem;
    border-radius: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    cursor: pointer;
  }
  .unit-btn.is-active {
    background: var(--color-brand-600);
    color: #fff;
  }

  .bmi-field-error {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .bmi-field-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .bmi-field-error {
    color: #fca5a5;
  }

  .bmi-live-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .bmi-scale {
    margin-top: 1rem;
  }
  .bmi-scale__bar {
    position: relative;
    height: 0.75rem;
    width: 100%;
    border-radius: 9999px;
    background: linear-gradient(90deg, #3b82f6 0 14%, #059669 14% 40%, #f59e0b 40% 60%, #e11d48 60% 100%);
  }
  .bmi-scale__marker {
    position: absolute;
    top: -0.375rem;
    height: 1.5rem;
    width: 0.375rem;
    transform: translateX(-50%);
    border-radius: 9999px;
    background: var(--heading);
    box-shadow: 0 0 0 2px var(--card);
  }
  .bmi-scale__labels {
    margin-top: 0.5rem;
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--muted);
  }

  .bmi-example-category {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
  }
  .bmi-example-range {
    margin: 0.85rem 0 0;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--fg);
  }

  .bmi-footnote {
    margin-top: 1rem;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--muted);
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { bmiBinding, BMI_EXAMPLE_VALUES } from '@lib/calculators/bmi-form';

  document.querySelectorAll<HTMLElement>('[data-bmi]').forEach((root) =>
    mountFormCalculator(root, bmiBinding, {
      recalculationMode: 'live-after-first',
      example: { values: BMI_EXAMPLE_VALUES },
      calculateButtonLabel: 'Calculate BMI',
    }),
  );
</script>
