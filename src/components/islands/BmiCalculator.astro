---
/**
 * BMI calculator island (R2 — standard-form runtime pilot).
 *
 * Direct-intent, task-first: personal fields start EMPTY and STAY empty behind a
 * labelled worked example the shared runtime renders into this island's own
 * valid region; the visitor presses "Calculate BMI" for their first result. After that first success, edits update automatically
 * (live-after-first). All interaction, validation, state, announcements and
 * focus are owned by the shared runtime (@lib/result/form-runtime); this island
 * is only markup + the tiny BMI binding (@lib/calculators/bmi-form).
 */
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import ResultInterpretation from '@components/result/ResultInterpretation.astro';
import ResultBreakdown from '@components/result/ResultBreakdown.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';
import { CATEGORIES } from '@lib/calculators/conversion';

// The "Other units" helper reuses the site's OWN reviewed conversion engine and its
// category/unit table — no second copy of the factors lives here.
const CONVERTER_CATEGORIES = CATEGORIES;
---

<div class="bmi mx-auto grid w-full max-w-4xl gap-6 md:grid-cols-2 md:items-start" data-bmi>
  <!-- Inputs -->
  <form class="card p-4" data-form novalidate aria-label="BMI calculator">
    <div class="bmi-controls">
      <div class="seg-group" role="radiogroup" aria-label="Sex">
        <label class="seg"><input type="radio" name="sex" value="male" checked /><span>Male</span></label>
        <label class="seg"><input type="radio" name="sex" value="female" /><span>Female</span></label>
      </div>

      <div
        class="inline-flex rounded-lg border p-0.5"
        role="radiogroup"
        aria-label="Unit system"
        style="border-color: var(--line)"
      >
        <button type="button" class="unit-btn is-active" data-unit="metric" role="radio" aria-checked="true">Metric</button>
        <button type="button" class="unit-btn" data-unit="imperial" role="radio" aria-checked="false">Imperial (US)</button>
      </div>

      <!-- A HELPER, not a third unit system: it opens a converter and leaves the
           calculator on whichever system is selected above. Hence a toggle button
           with aria-expanded, never a third radio in the unit group. -->
      <button
        type="button"
        class="unit-btn bmi-other-toggle"
        data-bmi-other-toggle
        aria-expanded="false"
        aria-controls="bmi-other-units"
      >Other units</button>
    </div>

    <!-- Other units: convert any measurement into the unit this calculator accepts. -->
    <div class="bmi-other" id="bmi-other-units" data-bmi-other hidden>
      <p class="bmi-other__lede">Convert a measurement, then type the result into the field above.</p>
      <div class="bmi-other__row">
        <label class="sr-only" for="bmi-conv-category">Category</label>
        <select class="field" id="bmi-conv-category" data-bmi-conv-category>
          {CONVERTER_CATEGORIES.map((c) => <option value={c.key}>{c.label}</option>)}
        </select>
        <label class="sr-only" for="bmi-conv-value">Value to convert</label>
        <input
          class="field"
          id="bmi-conv-value"
          data-bmi-conv-value
          type="number"
          step="any"
          inputmode="decimal"
          autocomplete="off"
          placeholder="1"
        />
      </div>
      <div class="bmi-other__row">
        <label class="sr-only" for="bmi-conv-from">From unit</label>
        <select class="field" id="bmi-conv-from" data-bmi-conv-from></select>
        <label class="sr-only" for="bmi-conv-to">To unit</label>
        <select class="field" id="bmi-conv-to" data-bmi-conv-to></select>
      </div>
      <output class="bmi-other__out" data-bmi-conv-out aria-live="polite"></output>
    </div>

    <!-- Metric -->
    <div class="mt-5 space-y-4" data-group="metric">
      <div data-field="heightCm">
        <label class="field-label" for="bmi-height-cm">Height</label>
        <div class="flex">
          <input
            class="field rounded-r-none"
            id="bmi-height-cm"
            name="heightCm"
            type="number"
            min="0"
            step="0.1"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 175"
            aria-describedby="bmi-heightCm-error"
          />
          <span class="field-affix rounded-r-lg border-l-0">cm</span>
        </div>
        <p class="bmi-field-error" id="bmi-heightCm-error" data-error-for="heightCm" hidden></p>
      </div>
      <div data-field="weightKg">
        <label class="field-label" for="bmi-weight-kg">Weight</label>
        <div class="flex">
          <input
            class="field rounded-r-none"
            id="bmi-weight-kg"
            name="weightKg"
            type="number"
            min="0"
            step="0.1"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 70"
            aria-describedby="bmi-weightKg-error"
          />
          <span class="field-affix rounded-r-lg border-l-0">kg</span>
        </div>
        <p class="bmi-field-error" id="bmi-weightKg-error" data-error-for="weightKg" hidden></p>
      </div>
    </div>

    <!-- Imperial -->
    <div class="mt-5 space-y-4" data-group="imperial" hidden>
      <div data-field="height">
        <label class="field-label" for="bmi-height-ft">Height</label>
        <div class="grid grid-cols-2 gap-3">
          <div class="flex">
            <input
              class="field rounded-r-none"
              id="bmi-height-ft"
              name="heightFt"
              type="number"
              min="0"
              step="1"
              inputmode="numeric"
              autocomplete="off"
              placeholder="5"
              aria-label="Height, feet"
              aria-describedby="bmi-height-error"
            />
            <span class="field-affix rounded-r-lg border-l-0">ft</span>
          </div>
          <div class="flex">
            <input
              class="field rounded-r-none"
              id="bmi-height-in"
              name="heightIn"
              type="number"
              min="0"
              max="11"
              step="1"
              inputmode="numeric"
              autocomplete="off"
              placeholder="9"
              aria-label="Height, inches"
              aria-describedby="bmi-height-error"
            />
            <span class="field-affix rounded-r-lg border-l-0">in</span>
          </div>
        </div>
        <p class="bmi-field-error" id="bmi-height-error" data-error-for="height" hidden></p>
      </div>
      <div data-field="weightLb">
        <label class="field-label" for="bmi-weight-lb">Weight</label>
        <div class="flex">
          <input
            class="field rounded-r-none"
            id="bmi-weight-lb"
            name="weightLb"
            type="number"
            min="0"
            step="0.1"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 154"
            aria-describedby="bmi-weightLb-error"
          />
          <span class="field-affix rounded-r-lg border-l-0">lb</span>
        </div>
        <p class="bmi-field-error" id="bmi-weightLb-error" data-error-for="weightLb" hidden></p>
      </div>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <button type="submit" class="btn btn-primary">Calculate BMI</button>
      <button type="button" class="btn btn-secondary" data-reset>Reset</button>
    </div>
    <p class="bmi-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result -->
  <!-- Reserve the valid-state height so live editing never jumps; the shared
       `placeholderAlignment="center"` prop vertically centres the short
       empty/invalid placeholders so the reserved card reads as intentional. -->
  <ResultShell
    id="bmi-result"
    density="standard"
    label="Your BMI result"
    minHeight="22rem"
    placeholderAlignment="center"
  >
    <ExampleNotice />
    <EmptyResult message="Enter your height and weight, then calculate your BMI." />

    <div data-result-when="valid">
      <ResultSummary label="Your BMI">
        <ResultValue value="—" unit="kg/m²" />
      </ResultSummary>
      <ResultInterpretation>
        <strong data-bmi-category>—</strong> <span data-bmi-phrase style="color: var(--muted)"></span>
      </ResultInterpretation>

      <!-- Category gauge. DECORATIVE: the category NAME above already carries the
           classification in words, so nothing here is meaning-by-colour-alone. The
           needle angle comes from the same tested markerPosition() as the bar
           below, so the two readings can never disagree. -->
      <figure class="bmi-gauge" aria-hidden="true">
        <svg viewBox="0 0 200 118" role="presentation" focusable="false">
          <!-- Bands, underweight -> obesity. The arc breakpoints are the SAME 14 /
               40 / 60 percent stops as the linear scale's gradient below, so the
               needle can never point at one band while the bar shows another. -->
          <g fill="none" stroke-width="18" stroke-linecap="butt">
            <path d="M 15 100 A 85 85 0 0 1 23.09 63.81" stroke="#3b82f6" />
            <path d="M 23.09 63.81 A 85 85 0 0 1 73.73 19.16" stroke="#059669" />
            <path d="M 73.73 19.16 A 85 85 0 0 1 126.27 19.16" stroke="#f59e0b" />
            <path d="M 126.27 19.16 A 85 85 0 0 1 185 100" stroke="#e11d48" />
          </g>
          <!-- Needle: rotated about the hub by the binding. The BMI number itself is
               NOT repeated inside the gauge — it is already the dominant value
               directly above, and a second copy would only crowd the needle. -->
          <g data-bmi-needle transform="rotate(-90 100 100)">
            <line x1="100" y1="100" x2="100" y2="34" stroke="var(--heading)" stroke-width="3" stroke-linecap="round" />
          </g>
          <circle cx="100" cy="100" r="6" fill="var(--heading)" />
        </svg>
        <figcaption class="bmi-gauge__labels">
          <span>Under</span><span>Normal</span><span>Over</span><span>Obese</span>
        </figcaption>
      </figure>

      <!-- The linear scale stays as the precise reading beneath the gauge. -->
      <div class="bmi-scale" aria-hidden="true">
        <div class="bmi-scale__bar">
          <span class="bmi-scale__marker" data-bmi-marker style="left: 0%"></span>
        </div>
      </div>

      <ResultBreakdown title="Healthy weight range">
        <p class="text-sm" style="color: var(--fg)">
          A healthy weight for your height is <strong data-bmi-range>—</strong>.
        </p>
      </ResultBreakdown>

      <p class="bmi-footnote">
        WHO adult classification (healthy BMI 18.5–24.9). BMI is a screening tool, not a diagnosis.
      </p>
    </div>

    <InvalidResult title="Check your entries" message="Enter your height and weight to calculate your BMI." />

    <ResultAnnouncement id="bmi-live" />
  </ResultShell>
</div>

<style>
  .unit-btn {
    padding: 0.35rem 0.9rem;
    border-radius: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    cursor: pointer;
  }
  .unit-btn.is-active {
    background: var(--color-brand-600);
    color: #fff;
  }

  /* Controls row: sex + unit system + the Other-units toggle. */
  .bmi-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .seg-group {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    padding: 0.125rem;
  }
  .seg {
    position: relative;
    display: inline-flex;
  }
  .seg input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .seg span {
    padding: 0.35rem 0.9rem;
    border-radius: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }
  .seg:has(input:checked) span {
    background: var(--color-brand-600);
    color: #fff;
  }
  .seg:has(input:focus-visible) span {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }

  .bmi-other-toggle {
    border: 1px solid var(--line);
  }
  .bmi-other-toggle[aria-expanded='true'] {
    background: var(--color-brand-600);
    border-color: var(--color-brand-600);
    color: #fff;
  }

  /* Other units — a converter helper, visually subordinate to the real inputs. */
  .bmi-other {
    margin-top: 0.85rem;
    padding: 0.85rem;
    border: 1px dashed var(--line);
    border-radius: 0.65rem;
    background: var(--subtle);
  }
  .bmi-other__lede {
    margin: 0 0 0.6rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .bmi-other__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
  .bmi-other__row + .bmi-other__row {
    margin-top: 0.5rem;
  }
  .bmi-other__out {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--heading);
    font-variant-numeric: tabular-nums;
    min-height: 1.4em;
  }

  /* Category gauge. */
  .bmi-gauge {
    margin: 1rem 0 0;
  }
  .bmi-gauge svg {
    display: block;
    width: 100%;
    max-width: 17rem;
    margin: 0 auto;
    height: auto;
  }
  .bmi-gauge__labels {
    display: flex;
    justify-content: space-between;
    max-width: 17rem;
    margin: 0.15rem auto 0;
    font-size: 0.7rem;
    color: var(--muted);
  }

  .bmi-field-error {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .bmi-field-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .bmi-field-error {
    color: #fca5a5;
  }

  .bmi-live-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .bmi-scale {
    margin-top: 1rem;
  }
  .bmi-scale__bar {
    position: relative;
    height: 0.75rem;
    width: 100%;
    border-radius: 9999px;
    background: linear-gradient(90deg, #3b82f6 0 14%, #059669 14% 40%, #f59e0b 40% 60%, #e11d48 60% 100%);
  }
  .bmi-scale__marker {
    position: absolute;
    top: -0.375rem;
    height: 1.5rem;
    width: 0.375rem;
    transform: translateX(-50%);
    border-radius: 9999px;
    background: var(--heading);
    box-shadow: 0 0 0 2px var(--card);
  }
  .bmi-scale__labels {
    margin-top: 0.5rem;
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--muted);
  }

  .bmi-example-category {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
  }
  .bmi-example-range {
    margin: 0.85rem 0 0;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--fg);
  }

  .bmi-footnote {
    margin-top: 1rem;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--muted);
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { CATEGORIES, convert } from '@lib/calculators/conversion';
  import { formatNumber } from '@lib/format';
  import { bmiBinding, BMI_EXAMPLE_VALUES } from '@lib/calculators/bmi-form';

  /**
   * The "Other units" helper. It converts a measurement so the visitor can type the
   * result into a field — it NEVER writes into the BMI inputs and never triggers a
   * calculation, so the calculator's own logic is untouched by it.
   */
  function mountConverter(root: HTMLElement) {
    const panel = root.querySelector<HTMLElement>('[data-bmi-other]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-bmi-other-toggle]');
    const catSel = root.querySelector<HTMLSelectElement>('[data-bmi-conv-category]');
    const fromSel = root.querySelector<HTMLSelectElement>('[data-bmi-conv-from]');
    const toSel = root.querySelector<HTMLSelectElement>('[data-bmi-conv-to]');
    const valueEl = root.querySelector<HTMLInputElement>('[data-bmi-conv-value]');
    const out = root.querySelector<HTMLElement>('[data-bmi-conv-out]');
    if (!panel || !toggle || !catSel || !fromSel || !toSel || !valueEl || !out) return;

    const categoryOf = (key: string) => CATEGORIES.find((c) => c.key === key) ?? CATEGORIES[0];

    const fillUnits = () => {
      const cat = categoryOf(catSel.value);
      for (const sel of [fromSel, toSel]) {
        sel.replaceChildren();
        for (const u of cat.units) {
          const opt = document.createElement('option');
          opt.value = u.key;
          opt.textContent = u.label;
          sel.appendChild(opt);
        }
      }
      // Default to the pair a BMI visitor actually needs, where the category has
      // one; otherwise the first two units of that category.
      const preferred: Record<string, [string, string]> = {
        length: ['cm', 'in'],
        mass: ['kg', 'lb'],
        weight: ['kg', 'lb'],
      };
      const pick = preferred[cat.key];
      const index = (key: string | undefined, fallback: number) => {
        const i = cat.units.findIndex((u) => u.key === key);
        return i === -1 ? fallback : i;
      };
      fromSel.selectedIndex = index(pick?.[0], 0);
      toSel.selectedIndex = index(pick?.[1], Math.min(1, cat.units.length - 1));
    };

    const render = () => {
      const raw = valueEl.value.trim();
      if (raw === '') {
        out.textContent = '';
        return;
      }
      const n = Number(raw);
      if (!Number.isFinite(n)) {
        out.textContent = 'Enter a number to convert.';
        return;
      }
      const cat = categoryOf(catSel.value);
      const result = convert(n, fromSel.value, toSel.value, cat.key);
      if (!Number.isFinite(result)) {
        out.textContent = 'That conversion is not available.';
        return;
      }
      const fromLabel = cat.units.find((u) => u.key === fromSel.value)?.label ?? fromSel.value;
      const toLabel = cat.units.find((u) => u.key === toSel.value)?.label ?? toSel.value;
      out.textContent = `${formatNumber(n, 4)} ${fromLabel} = ${formatNumber(result, 4)} ${toLabel}`;
    };

    fillUnits();

    // The helper sits inside the <form>, so its own input/change events would
    // otherwise bubble to the runtime and be read as the visitor starting to
    // enter values — dismissing the worked example and arming live recalculation.
    // Containing them here keeps the converter genuinely inert with respect to
    // the calculator: the runtime never sees a keystroke it did not receive from
    // a real BMI field.
    for (const type of ['input', 'change'] as const) {
      panel.addEventListener(type, (e) => e.stopPropagation());
    }

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
    catSel.addEventListener('change', () => {
      fillUnits();
      render();
    });
    for (const el of [fromSel, toSel]) el.addEventListener('change', render);
    valueEl.addEventListener('input', render);
  }

  document.querySelectorAll<HTMLElement>('[data-bmi]').forEach((root) => {
    mountConverter(root);
    mountFormCalculator(root, bmiBinding, {
      recalculationMode: 'live-after-first',
      example: { values: BMI_EXAMPLE_VALUES },
      calculateButtonLabel: 'Calculate BMI',
    });
  });
</script>
