---
/**
 * Protein island — the reference's fields, its "+ Settings" disclosure and its report, on
 * the UNCHANGED standard-form runtime.
 *
 * Three tabs, two of which are unit systems; "Other Units" opens the shared five-category
 * `UnitConverterPanel` above the calculator and leaves the selected system alone.
 *
 * The report answers on two bases. The DOMINANT figure is the recommended dietary
 * allowance, because it is the one number every other row is measured against; under it, a
 * table gives the recommended range, the highly-active range and the share of the visitor's
 * own daily Calories. That last row is the reason the form asks for height, activity and an
 * equation at all — without them there is no calorie figure to take a share of.
 */
import {
  ACTIVITY_BANDS,
  ACTIVITY_BAND_NOTES,
  DEFAULT_ACTIVITY,
  BMR_FORMULAS,
  PROTEIN_AGE_MIN,
  PROTEIN_AGE_MAX,
} from '@lib/calculators/protein-form';
import UnitConverterPanel from '@components/calc/UnitConverterPanel.astro';
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultInterpretation from '@components/result/ResultInterpretation.astro';
import ResultBreakdown from '@components/result/ResultBreakdown.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';

const UNIT_TABS = [
  { value: 'imperial', label: 'US Units' },
  { value: 'metric', label: 'Metric Units' },
];

/** Row labels and bases are static; only the gram figures change at runtime. */
const BASIS_ROWS = [
  { key: 'rda', label: 'Recommended dietary allowance', basis: '0.8 g/kg' },
  { key: 'range', label: 'Recommended range', basis: '0.8 - 1.8 g/kg' },
  { key: 'highly-active', label: 'Highly active', basis: '1.8 - 2 g/kg' },
  { key: 'amdr', label: 'Share of your daily Calories', basis: '10 - 35% of Calories' },
];
---

<div class="prwrap mx-auto w-full max-w-4xl" data-protein>
  <UnitConverterPanel id="pr-converter" />

  <div class="prcalc grid gap-6 md:grid-cols-2 md:items-start">
    <!-- Inputs -->
    <div>
      <form class="card p-4" data-form novalidate aria-label="Protein calculator">
        <div class="pr-tabs">
          <div class="pr-tabs__systems" role="radiogroup" aria-label="Unit system">
            {UNIT_TABS.map((t, i) => (
              <button type="button" class:list={['pr-tab', i === 0 && 'is-active']} data-unit={t.value} role="radio" aria-checked={i === 0 ? 'true' : 'false'}>
                {t.label}
              </button>
            ))}
          </div>
          <button type="button" class="pr-tab pr-tab--toggle" data-converter-toggle aria-expanded="false" aria-controls="pr-converter">
            Other Units
          </button>
        </div>

        <div class="pr-row" data-field="age">
          <label class="field-label pr-row__label" for="pr-age">Age</label>
          <div class="pr-inputs">
            <input class="field pr-input" id="pr-age" name="age" type="number" min={PROTEIN_AGE_MIN} max={PROTEIN_AGE_MAX} step="1" inputmode="numeric" autocomplete="off" placeholder="25" aria-describedby="pr-age-error" />
            <span class="pr-hint">ages {PROTEIN_AGE_MIN} - {PROTEIN_AGE_MAX}</span>
          </div>
        </div>
        <p class="pr-error" id="pr-age-error" data-error-for="age" hidden></p>

        <fieldset class="pr-row pr-row--radios" data-field="sex">
          <legend class="field-label pr-row__label">Gender</legend>
          <div class="pr-radios">
            <label class="pr-radio"><input type="radio" name="sex" value="male" checked /><span>male</span></label>
            <label class="pr-radio"><input type="radio" name="sex" value="female" /><span>female</span></label>
          </div>
        </fieldset>

        <!-- US height + weight -->
        <div data-group="imperial">
          <div class="pr-row" data-field="height">
            <label class="field-label pr-row__label" for="pr-ft">Height</label>
            <div class="pr-inputs">
              <div class="pr-pair">
                <input class="field pr-input" id="pr-ft" name="heightFt" type="number" min="0" step="1" inputmode="numeric" autocomplete="off" placeholder="5" aria-label="Height, feet" aria-describedby="pr-height-error" />
                <span class="pr-unit">feet</span>
              </div>
              <div class="pr-pair">
                <input class="field pr-input" id="pr-in" name="heightIn" type="number" min="0" max="11" step="1" inputmode="numeric" autocomplete="off" placeholder="10" aria-label="Height, inches" aria-describedby="pr-height-error" />
                <span class="pr-unit">inches</span>
              </div>
            </div>
          </div>
          <p class="pr-error" id="pr-height-error" data-error-for="height" hidden></p>

          <div class="pr-row" data-field="weightLb">
            <label class="field-label pr-row__label" for="pr-lb">Weight</label>
            <div class="pr-inputs">
              <div class="pr-pair">
                <input class="field pr-input pr-input--wide" id="pr-lb" name="weightLb" type="number" min="0" step="0.1" inputmode="decimal" autocomplete="off" placeholder="160" aria-describedby="pr-weightLb-error" />
                <span class="pr-unit">pounds</span>
              </div>
            </div>
          </div>
          <p class="pr-error" id="pr-weightLb-error" data-error-for="weightLb" hidden></p>
        </div>

        <!-- Metric height + weight -->
        <div data-group="metric" hidden>
          <div class="pr-row" data-field="heightCm">
            <label class="field-label pr-row__label" for="pr-cm">Height</label>
            <div class="pr-inputs">
              <div class="pr-pair">
                <input class="field pr-input pr-input--wide" id="pr-cm" name="heightCm" type="number" min="0" step="0.1" inputmode="decimal" autocomplete="off" placeholder="180" aria-describedby="pr-heightCm-error" />
                <span class="pr-unit">cm</span>
              </div>
            </div>
          </div>
          <p class="pr-error" id="pr-heightCm-error" data-error-for="heightCm" hidden></p>

          <div class="pr-row" data-field="weightKg">
            <label class="field-label pr-row__label" for="pr-kg">Weight</label>
            <div class="pr-inputs">
              <div class="pr-pair">
                <input class="field pr-input pr-input--wide" id="pr-kg" name="weightKg" type="number" min="0" step="0.1" inputmode="decimal" autocomplete="off" placeholder="60" aria-describedby="pr-weightKg-error" />
                <span class="pr-unit">kg</span>
              </div>
            </div>
          </div>
          <p class="pr-error" id="pr-weightKg-error" data-error-for="weightKg" hidden></p>
        </div>

        <div class="pr-row pr-row--activity" data-field="activity">
          <label class="field-label pr-row__label" for="pr-activity">Activity</label>
          <select class="field pr-select" id="pr-activity" name="activity" aria-describedby="pr-activity-error">
            {ACTIVITY_BANDS.map((b) => (
              <option value={b.value} selected={b.value === DEFAULT_ACTIVITY}>{b.selectLabel}</option>
            ))}
          </select>
        </div>
        <p class="pr-error" id="pr-activity-error" data-error-for="activity" hidden></p>

        <button type="button" class="pr-settings-toggle" data-settings-toggle aria-expanded="false" aria-controls="pr-settings">
          <span class="pr-settings-toggle__sign" aria-hidden="true">+</span> Settings
        </button>

        <div class="pr-settings" id="pr-settings" data-settings hidden>
          <fieldset class="pr-set" data-field="formula">
            <legend class="pr-set__legend">BMR estimation formula</legend>
            <div class="pr-set__options">
              {BMR_FORMULAS.map((f, i) => (
                <label class="pr-radio"><input type="radio" name="formula" value={f.value} checked={i === 0} /><span>{f.label}</span></label>
              ))}
            </div>
          </fieldset>

          <div class="pr-set" data-field="bodyFatPct" data-bodyfat hidden>
            <label class="pr-set__legend" for="pr-bf">Body fat percentage</label>
            <div class="pr-inputs">
              <div class="pr-pair">
                <input class="field pr-input" id="pr-bf" name="bodyFatPct" type="number" min="0" max="99.9" step="0.1" inputmode="decimal" autocomplete="off" placeholder="20" aria-describedby="pr-bodyFatPct-error" />
                <span class="pr-unit">%</span>
              </div>
              <span class="pr-hint">Katch-McArdle works from lean mass</span>
            </div>
            <p class="pr-error" id="pr-bodyFatPct-error" data-error-for="bodyFatPct" hidden></p>
          </div>
        </div>

        <div class="mt-5 flex items-center gap-3">
          <button type="submit" class="btn btn-primary">Calculate</button>
          <button type="button" class="btn btn-secondary" data-reset>Clear</button>
        </div>
        <p class="pr-live-note" data-live-note hidden>Changes update automatically.</p>
      </form>

      <ul class="pr-notes">
        {ACTIVITY_BAND_NOTES.map((n) => <li>{n}</li>)}
      </ul>
    </div>

    <!-- Result -->
    <ResultShell
      id="pr-result"
      state="empty"
      density="standard"
      label="Your daily protein result"
      minHeight="20rem"
      placeholderAlignment="center"
    >
      <ExampleNotice />
      <EmptyResult message="Enter your age, gender, height, weight and activity level, then calculate." />

      <div data-result-when="valid">
        <ResultSummary label="Recommended daily protein">
          <span aria-hidden="true">
            <span class="result-value text-4xl" data-protein-rda>—</span>&nbsp;<span class="result-unit">grams/day</span>
          </span>
          <span class="sr-only" data-protein-rda-a11y></span>
        </ResultSummary>
        <ResultInterpretation>
          The recommended dietary allowance for an adult, at 0.8 grams per kilogram of body
          weight. It is a floor, not a target: the table below shows how much further the
          recommendation runs once activity and goals are accounted for.
        </ResultInterpretation>

        <ResultBreakdown title="Protein by basis">
          <div class="pr-bases__scroll">
          <table class="pr-bases">
            <thead>
              <tr><th scope="col">Based on</th><th scope="col">Rate</th><th scope="col" class="pr-num">Protein</th></tr>
            </thead>
            <tbody>
              {BASIS_ROWS.map((row) => (
                <tr data-basis={row.key}>
                  <th scope="row">{row.label}</th>
                  <td class="pr-rate">{row.basis}</td>
                  <td class="pr-num" data-basis-grams>—</td>
                </tr>
              ))}
            </tbody>
          </table>
          </div>
          <p class="pr-note">
            The last row is a share of the <span data-protein-calories>—</span> Calories a day your
            entries work out to, at protein's 4 Calories per gram — which is why this calculator
            asks for your height and activity, and not only your weight.
          </p>
        </ResultBreakdown>
      </div>

      <InvalidResult title="Check your entries" message="Enter your age, height, weight and activity level to estimate your protein needs." />

      <ResultAnnouncement id="pr-live" />
    </ResultShell>
  </div>
</div>

<style>
  .pr-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-bottom: 0.9rem;
  }
  .pr-tabs__systems {
    display: flex;
    gap: 0.3rem;
  }
  .pr-tab {
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: var(--card);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--fg);
    cursor: pointer;
  }
  .pr-tab.is-active {
    border-color: var(--color-brand-600);
    background: var(--color-brand-600);
    color: #fff;
  }
  .pr-tab:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }
  .pr-tab--toggle[aria-expanded='true'] {
    border-color: var(--color-brand-600);
    color: var(--color-brand-700);
  }

  .pr-row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.6rem;
    padding: 0.3rem 0;
    border: 0;
    margin: 0;
  }
  .pr-row__label {
    margin: 0;
    font-size: 0.86rem;
  }
  .pr-inputs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .pr-pair {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .pr-input {
    width: 5rem;
    min-height: 2.75rem;
    font-variant-numeric: tabular-nums;
  }
  .pr-input--wide {
    width: 7rem;
  }
  .pr-select {
    width: 100%;
    min-height: 2.75rem;
    font-size: 0.84rem;
  }
  .pr-unit,
  .pr-hint {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .pr-radios {
    display: flex;
    gap: 0.9rem;
  }
  .pr-radio {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    font-size: 0.88rem;
    color: var(--fg);
    cursor: pointer;
  }
  .pr-radio input {
    width: 1.05rem;
    height: 1.05rem;
    accent-color: var(--color-brand-600);
  }
  .pr-error {
    margin: 0.1rem 0 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .pr-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .pr-error {
    color: #fca5a5;
  }
  .pr-live-note {
    margin-top: 0.7rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .pr-notes {
    margin: 0.7rem 0 0;
    padding: 0 0 0 1.1rem;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .pr-settings-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 2.75rem;
    margin-top: 0.2rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-brand-700);
    cursor: pointer;
  }
  .pr-settings-toggle__sign {
    font-size: 1rem;
    line-height: 1;
  }
  :root[data-theme='dark'] .pr-settings-toggle {
    color: var(--color-brand-300);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .pr-settings-toggle {
      color: var(--color-brand-300);
    }
  }
  .pr-settings {
    margin-top: 0.4rem;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--subtle);
  }
  .pr-set {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .pr-set + .pr-set {
    margin-top: 0.6rem;
  }
  .pr-set__legend {
    display: block;
    padding: 0;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--heading);
  }
  .pr-set__options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  /* Three columns of prose and figures do not fit a 390px phone. The table scrolls inside
     its own box rather than pushing the page sideways, and the rate wraps instead of
     forcing a minimum width. */
  .pr-bases__scroll {
    overflow-x: auto;
  }
  .pr-bases {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.84rem;
  }
  .pr-bases th,
  .pr-bases td {
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: baseline;
  }
  .pr-bases thead th {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    font-weight: 700;
  }
  .pr-bases tbody th {
    font-weight: 500;
    color: var(--fg);
    padding-right: 0.6rem;
  }
  .pr-rate {
    color: var(--muted);
    font-size: 0.78rem;
    padding-right: 0.6rem;
  }
  .pr-num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .pr-bases tbody td.pr-num {
    font-weight: 700;
    color: var(--heading);
  }
  .pr-note {
    margin: 0.7rem 0 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 26rem) {
    .pr-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { mountUnitConverterPanel } from '@lib/calculators/unit-converter-panel';
  import {
    proteinBinding,
    PROTEIN_EXAMPLE_VALUES,
    needsBodyFat,
    type BmrFormula,
  } from '@lib/calculators/protein-form';

  document.querySelectorAll<HTMLElement>('[data-protein]').forEach((root) => {
    mountFormCalculator(root, proteinBinding, {
      recalculationMode: 'live-after-first',
      example: { values: PROTEIN_EXAMPLE_VALUES },
      calculateButtonLabel: 'Calculate',
    });

    mountUnitConverterPanel(root);

    // "+ Settings" — a plain disclosure, closed on load.
    const settings = root.querySelector<HTMLElement>('[data-settings]');
    const settingsToggle = root.querySelector<HTMLButtonElement>('[data-settings-toggle]');
    const sign = settingsToggle?.querySelector<HTMLElement>('.pr-settings-toggle__sign');
    if (settings && settingsToggle) {
      settingsToggle.addEventListener('click', () => {
        const open = settings.hidden;
        settings.hidden = !open;
        settingsToggle.setAttribute('aria-expanded', String(open));
        if (sign) sign.textContent = open ? '−' : '+';
      });
    }

    /** Only Katch-McArdle reads a body-fat percentage, so only it asks for one. */
    const bodyFatRow = root.querySelector<HTMLElement>('[data-bodyfat]');
    const bodyFat = root.querySelector<HTMLInputElement>('[name="bodyFatPct"]');
    const syncBodyFat = () => {
      const formula = (root.querySelector<HTMLInputElement>('[name="formula"]:checked')?.value ??
        'mifflin') as BmrFormula;
      const wanted = needsBodyFat(formula);
      if (bodyFatRow) bodyFatRow.hidden = !wanted;
      if (!wanted) {
        if (bodyFat) bodyFat.value = '';
        const err = root.querySelector<HTMLElement>('[data-error-for="bodyFatPct"]');
        if (err) err.hidden = true;
      }
    };
    root.querySelectorAll<HTMLInputElement>('[name="formula"]').forEach((r) =>
      r.addEventListener('change', syncBodyFat),
    );
    syncBodyFat();

    // Reset restores the radios silently, so re-derive what depends on them.
    root.addEventListener('calculator:reset', syncBodyFat);

    // A required box behind a closed Settings panel is a dead end; open it first.
    root.querySelector<HTMLFormElement>('[data-form]')?.addEventListener(
      'submit',
      () => {
        if (!settings || !settingsToggle || !settings.hidden) return;
        if (!bodyFatRow || bodyFatRow.hidden) return;
        settings.hidden = false;
        settingsToggle.setAttribute('aria-expanded', 'true');
        if (sign) sign.textContent = '−';
      },
      true,
    );
  });
</script>
