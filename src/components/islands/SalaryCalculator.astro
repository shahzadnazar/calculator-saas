---
/**
 * Salary calculator island — the reference's pay-schedule table on the UNCHANGED
 * standard-form runtime.
 *
 * One figure in, sixteen out: eight pay frequencies read two ways, ignoring time off and
 * with holidays and vacation priced in. The AMOUNT starts empty behind a labelled worked
 * example; the five schedule fields carry the reference's documented assumptions (40 hours
 * over 5 days, 10 holidays, 15 vacation days) and are restored on Reset.
 *
 * All arithmetic is `computePaySchedule` in salary.ts via the binding. `convertSalary` is
 * untouched, so the salary-conversion reference table is unaffected.
 *
 * Static ids are namespaced per-instance WHEN more than one Salary calculator shares a
 * document, so an embed gallery has no duplicate ids.
 */
import { PAY_FREQUENCIES, PAY_ROWS, DEFAULT_FREQUENCY, DEFAULT_HOURS_PER_WEEK, DEFAULT_DAYS_PER_WEEK, DEFAULT_HOLIDAYS, DEFAULT_VACATION_DAYS } from '@lib/calculators/salary-form';
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import ResultInterpretation from '@components/result/ResultInterpretation.astro';
import ResultBreakdown from '@components/result/ResultBreakdown.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';

const SCHEDULE: { name: string; id: string; label: string; value: string; step: string; min: string; max?: string }[] = [
  { name: 'hoursPerWeek', id: 'sal-hpw', label: 'Hours per week', value: DEFAULT_HOURS_PER_WEEK, step: '0.5', min: '0.5' },
  { name: 'daysPerWeek', id: 'sal-dpw', label: 'Days per week', value: DEFAULT_DAYS_PER_WEEK, step: '1', min: '1', max: '7' },
  { name: 'holidaysPerYear', id: 'sal-hol', label: 'Holidays per year', value: DEFAULT_HOLIDAYS, step: '1', min: '0' },
  { name: 'vacationDaysPerYear', id: 'sal-vac', label: 'Vacation days per year', value: DEFAULT_VACATION_DAYS, step: '1', min: '0' },
];
---

<div class="salcalc mx-auto grid w-full max-w-5xl gap-6 md:grid-cols-2 md:items-start" data-salary>
  <!-- Inputs -->
  <form class="card p-4" data-form novalidate aria-label="Salary calculator">
    <div class="sal-fields">
      <div data-field="amount">
        <label class="field-label" for="sal-amount">Salary amount</label>
        <div class="sal-amount-row">
          <span class="sal-affix">$</span>
          <input class="field sal-amount" id="sal-amount" name="amount" type="number" min="0" step="any" inputmode="decimal" autocomplete="off" placeholder="50" aria-describedby="sal-amount-error" />
          <span class="sal-per">per</span>
          <select class="field sal-freq" id="sal-frequency" name="frequency" aria-label="Pay period">
            {PAY_FREQUENCIES.map((f) => <option value={f.value} selected={f.value === DEFAULT_FREQUENCY}>{f.label}</option>)}
          </select>
        </div>
        <p class="sal-error" id="sal-amount-error" data-error-for="amount" hidden></p>
      </div>

      {SCHEDULE.map((f) => (
        <div data-field={f.name}>
          <div class="sal-row">
            <label class="field-label sal-row__label" for={f.id}>{f.label}</label>
            <input class="field sal-row__input" id={f.id} name={f.name} type="number" min={f.min} max={f.max} step={f.step} inputmode="decimal" autocomplete="off" value={f.value} aria-describedby={`${f.id}-error`} />
          </div>
          <p class="sal-error" id={`${f.id}-error`} data-error-for={f.name} hidden></p>
        </div>
      ))}
    </div>

    <div class="mt-5 flex items-center gap-3">
      <button type="submit" class="btn btn-primary sal-btn">Calculate</button>
      <button type="button" class="btn btn-secondary sal-btn" data-reset>Clear</button>
    </div>
    <p class="sal-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result -->
  <ResultShell id="salary-result" state="example" density="standard" label="Salary result" minHeight="18rem" placeholderAlignment="center">
    <ExampleNotice caption="Sample: $50 per hour, 40 hours over 5 days, 10 holidays and 15 vacation days." />
    <EmptyResult message="Enter a salary amount and choose its period, then calculate." />

    <div data-result-when="valid">
      <ResultSummary label="Annual salary, adjusted for time off">
        <ResultValue value="—" size="text-4xl" />
      </ResultSummary>
      <ResultInterpretation>
        <span data-sal-interpretation></span>
      </ResultInterpretation>

      <ResultBreakdown title="Every pay frequency">
        <div class="sal-table-wrap">
          <table class="sal-table">
            <caption class="sr-only">Pay at each frequency, before and after holidays and vacation days</caption>
            <thead>
              <tr>
                <th scope="col"><span class="sr-only">Pay frequency</span></th>
                <th scope="col">Unadjusted</th>
                <th scope="col">Holidays &amp; vacation days adjusted</th>
              </tr>
            </thead>
            <tbody>
              {PAY_ROWS.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  <td data-sal-unadjusted={row.key}>—</td>
                  <td data-sal-adjusted={row.key}>—</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="sal-note">
          Hourly and daily amounts you enter are treated as unadjusted; any longer period is
          treated as already covering time off. Based on 52 weeks a year. Gross figures, before tax.
        </p>
      </ResultBreakdown>
    </div>

    <InvalidResult
      title="Check your entries"
      message="Enter a salary amount of zero or more, a positive weekly schedule, and time off that leaves days to work."
    />

    <ResultAnnouncement id="salary-live" />
  </ResultShell>
</div>

<style>
  .sal-fields {
    display: grid;
    gap: 0.75rem;
  }

  .sal-amount-row {
    margin-top: 0.25rem;
    display: flex;
    align-items: stretch;
    gap: 0.4rem;
  }
  .sal-affix {
    display: inline-flex;
    align-items: center;
    padding: 0 0.55rem;
    border: 1px solid var(--line);
    border-right: 0;
    border-radius: 0.5rem 0 0 0.5rem;
    background: var(--surface-2, transparent);
    color: var(--muted);
    font-size: 0.9rem;
  }
  .sal-amount {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 2.75rem;
    border-radius: 0 0.5rem 0.5rem 0;
    margin-left: -0.4rem;
    font-variant-numeric: tabular-nums;
  }
  .sal-per {
    display: inline-flex;
    align-items: center;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .sal-freq {
    width: auto;
    min-width: 7.5rem;
    min-height: 2.75rem;
    font-size: 0.9rem;
  }

  .sal-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .sal-row__label {
    margin: 0;
  }
  .sal-row__input {
    width: 6.5rem;
    flex: 0 0 auto;
    min-height: 2.75rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .sal-error {
    margin: 0.3rem 0 0;
    font-size: 0.78rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .sal-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .sal-error {
    color: #fca5a5;
  }

  .sal-btn {
    min-height: 2.75rem;
  }

  .sal-live-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* A wide table must scroll in its own box, never push the page sideways. */
  .sal-table-wrap {
    overflow-x: auto;
  }
  .sal-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    table-layout: fixed;
  }
  .sal-table th,
  .sal-table td {
    padding: 0.4rem 0.5rem;
    border-bottom: 1px solid var(--line);
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .sal-table thead th {
    font-size: 0.76rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--muted);
    white-space: normal;
    vertical-align: bottom;
  }
  .sal-table tbody th {
    text-align: left;
    font-weight: 600;
    color: var(--fg);
  }
  .sal-table tbody td {
    color: var(--heading);
    font-weight: 700;
  }
  .sal-table tbody tr:last-child th,
  .sal-table tbody tr:last-child td {
    border-bottom: 0;
  }
  .sal-table tbody tr:last-child td,
  .sal-table tbody tr:last-child th {
    font-size: 0.95rem;
  }

  .sal-note {
    margin: 0.7rem 0 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 26rem) {
    .sal-amount-row {
      flex-wrap: wrap;
    }
    .sal-freq {
      min-width: 6.5rem;
    }
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { salaryBinding, SALARY_EXAMPLE_VALUES } from '@lib/calculators/salary-form';

  let ns = 0; // module-global → static-id namespace suffix, one per multi-instance root

  // When more than one Salary calculator shares a document (e.g. an embed gallery), the
  // server-static ids collide. Namespace THIS root's ids and repoint its in-root references
  // so associations stay instance-local; a lone instance is left untouched.
  function uniquifyStaticIds(root: HTMLElement, suffix: string): void {
    const remap = new Map<string, string>();
    root.querySelectorAll<HTMLElement>('[id]').forEach((el) => {
      const next = `${el.id}-${suffix}`;
      remap.set(el.id, next);
      el.id = next;
    });
    const repoint = (attr: string) =>
      root.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((el) => {
        const next = el
          .getAttribute(attr)!
          .split(/\s+/)
          .map((token) => remap.get(token) ?? token)
          .join(' ');
        el.setAttribute(attr, next);
      });
    repoint('for');
    repoint('aria-describedby');
    repoint('aria-labelledby');
    repoint('aria-controls');
  }

  document.querySelectorAll<HTMLElement>('[data-salary]').forEach((root) => {
    if (document.querySelectorAll('[data-salary]').length > 1) uniquifyStaticIds(root, `s${++ns}`);

    mountFormCalculator(root, salaryBinding, {
      recalculationMode: 'live-after-first',
      example: { values: SALARY_EXAMPLE_VALUES },
      calculateButtonLabel: 'Calculate',
    });

    // Blank every cell whenever the shell leaves the valid state (an invalid live edit, or
    // Reset), so no stale figure lingers behind the hidden valid region. Presentation only.
    const shell = root.querySelector<HTMLElement>('[data-result-shell]');
    if (shell) {
      const clear = () => {
        root
          .querySelectorAll<HTMLElement>('[data-sal-unadjusted], [data-sal-adjusted]')
          .forEach((el) => {
            el.textContent = '—';
          });
        root
          .querySelectorAll<HTMLElement>(
            '[data-result-when~="valid"] [data-result-value], [data-result-when~="valid"] [data-result-value-a11y]',
          )
          .forEach((el) => {
            el.textContent = '—';
          });
      };
      new MutationObserver(() => {
        if (shell.dataset.resultState !== 'valid') clear();
      }).observe(shell, { attributes: true, attributeFilter: ['data-result-state'] });
    }
  });
</script>
