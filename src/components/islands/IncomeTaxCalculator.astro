---
/**
 * Income tax calculator island (R18B1 — task-first; bounded Finance singleton; product
 * family COMPLEX-FORM with a multi-mode FILING-STATUS selector, on the standard-form
 * runtime UNCHANGED).
 *
 * A single form on the UNCHANGED standard-form runtime + the Income Tax binding
 * (@lib/calculators/income-tax-form), which wraps the UNCHANGED calculateIncomeTax /
 * STANDARD_DEDUCTION (2024 brackets). Task-first, direct-intent: the gross income + the
 * optional pre-tax deductions start EMPTY (the legacy island prefilled $75,000 and
 * auto-calculated a baked-in SSR result); filing status defaults to Single; the result
 * is an EMPTY instruction on the server AND after hydration — no precomputed value, no
 * flash. The visitor presses "Calculate Tax" for the first result, then live-after-first.
 * The DOMINANT result is the estimated federal tax (a valid $0 for income at or below the
 * deduction). Compute, validation, state, announcement and focus are owned by the shared
 * runtime; the binding owns formula selection + the complete-result guard. NO
 * isUsableResult. No runtime change; NO generic tax / bracket / filing-status abstraction.
 *
 * Filing status is a native radio group — a STRUCTURAL selector the runtime recomputes on.
 * The island OWNS one small piece of visible presentation: the standard-deduction note
 * updates with the selected status (informational only — it never calculates). Static ids
 * are namespaced per-instance WHEN more than one Income Tax calculator shares a document
 * (the R16B2.1 discipline), so an embed gallery has no duplicate ids.
 */
import { STANDARD_DEDUCTION } from '@lib/calculators/income-tax';
import { formatCurrencyRounded } from '@lib/format';
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import ResultInterpretation from '@components/result/ResultInterpretation.astro';
import ResultBreakdown from '@components/result/ResultBreakdown.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
---

<div class="incometax mx-auto grid w-full max-w-4xl gap-6 md:grid-cols-2 md:items-start" data-incometax>
  <!-- Inputs -->
  <form class="card p-5 sm:p-6" data-form novalidate aria-label="Income tax calculator">
    <fieldset class="it-modes">
      <legend class="field-label">Filing status</legend>
      <div class="seg-group">
        <label class="seg"><input type="radio" name="filingStatus" value="single" checked /><span>Single</span></label>
        <label class="seg"><input type="radio" name="filingStatus" value="married" /><span>Married (joint)</span></label>
      </div>
    </fieldset>

    <div class="mt-5 space-y-4">
      <div data-field="grossIncome">
        <label class="field-label" for="it-gross">Gross annual income</label>
        <div class="flex">
          <span class="field-affix rounded-l-lg border-r-0">$</span>
          <input
            class="field rounded-l-none"
            id="it-gross"
            name="grossIncome"
            type="number"
            min="0"
            step="1000"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 60000"
            aria-describedby="it-gross-error"
          />
        </div>
        <p class="it-field-error" id="it-gross-error" data-error-for="grossIncome" hidden></p>
      </div>

      <div data-field="additionalDeductions">
        <label class="field-label" for="it-ded">Pre-tax deductions (optional)</label>
        <div class="flex">
          <span class="field-affix rounded-l-lg border-r-0">$</span>
          <input
            class="field rounded-l-none"
            id="it-ded"
            name="additionalDeductions"
            type="number"
            min="0"
            step="500"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 0"
            aria-describedby="it-ded-error"
          />
        </div>
        <p class="it-hint">Standard deduction applied automatically (<span data-it-std>{formatCurrencyRounded(STANDARD_DEDUCTION.single)}</span>). Add 401(k), HSA or other pre-tax amounts here.</p>
        <p class="it-field-error" id="it-ded-error" data-error-for="additionalDeductions" hidden></p>
      </div>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <button type="submit" class="btn btn-primary">Calculate Tax</button>
      <button type="button" class="btn btn-secondary" data-reset>Reset</button>
    </div>
    <p class="it-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result -->
  <ResultShell
    id="it-result"
    state="empty"
    density="standard"
    label="Income tax result"
    minHeight="20rem"
    placeholderAlignment="center"
  >
    <EmptyResult message="Enter your income, choose a filing status, then calculate your estimated tax." />

    <div data-result-when="valid">
      <ResultSummary label="Estimated federal income tax">
        <ResultValue value="—" size="text-4xl" />
      </ResultSummary>
      <ResultInterpretation>
        <span data-it-interpretation></span>
      </ResultInterpretation>

      <ResultBreakdown title="Breakdown">
        <dl class="it-metrics">
          <div><dt>Taxable income</dt><dd data-it-taxable>—</dd></div>
          <div><dt>After-tax income</dt><dd data-it-after>—</dd></div>
          <div><dt>Effective rate</dt><dd data-it-eff>—</dd></div>
          <div><dt>Marginal (top) rate</dt><dd data-it-marg>—</dd></div>
        </dl>
        <p class="it-note">2024 federal brackets. Estimate only — excludes credits, state tax and payroll (FICA) taxes.</p>
      </ResultBreakdown>
    </div>

    <InvalidResult
      title="Check your entries"
      message="Enter your gross annual income (zero or more) to estimate your tax."
    />

    <ResultAnnouncement id="it-live" />
  </ResultShell>
</div>

<style>
  .it-modes {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .seg-group {
    display: inline-flex;
    margin-top: 0.4rem;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    padding: 0.125rem;
  }
  .seg {
    position: relative;
    display: inline-flex;
  }
  .seg input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .seg span {
    padding: 0.35rem 0.9rem;
    border-radius: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }
  .seg:has(input:checked) span {
    background: var(--color-brand-600);
    color: #fff;
  }
  .seg:has(input:focus-visible) span {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }

  .it-hint {
    margin: 0.4rem 0 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .it-field-error {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .it-field-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .it-field-error {
    color: #fca5a5;
  }

  .it-live-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .it-metrics {
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }
  .it-metrics > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .it-metrics dt {
    color: var(--fg);
    font-weight: 600;
  }
  .it-metrics dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--heading);
    font-weight: 700;
    white-space: nowrap;
  }
  .it-note {
    margin: 0.7rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { incomeTaxBinding } from '@lib/calculators/income-tax-form';
  import { STANDARD_DEDUCTION } from '@lib/calculators/income-tax';
  import { formatCurrencyRounded } from '@lib/format';

  let ns = 0; // module-global → static-id namespace suffix, one per multi-instance root

  // When more than one Income Tax calculator shares a document (e.g. an embed gallery),
  // the server-static ids (the two money fields + their error slots, the result shell,
  // the live region) collide. Namespace THIS root's ids and repoint its in-root
  // references so associations stay instance-local; a lone instance is left untouched.
  // The runtime targets fields by [name] / [data-*], never these ids.
  function uniquifyStaticIds(root: HTMLElement, suffix: string): void {
    const remap = new Map<string, string>();
    root.querySelectorAll<HTMLElement>('[id]').forEach((el) => {
      const next = `${el.id}-${suffix}`;
      remap.set(el.id, next);
      el.id = next;
    });
    const repoint = (attr: string) =>
      root.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((el) => {
        const next = el
          .getAttribute(attr)!
          .split(/\s+/)
          .map((token) => remap.get(token) ?? token)
          .join(' ');
        el.setAttribute(attr, next);
      });
    repoint('for');
    repoint('aria-describedby');
    repoint('aria-labelledby');
    repoint('aria-controls');
  }

  document.querySelectorAll<HTMLElement>('[data-incometax]').forEach((root) => {
    if (document.querySelectorAll('[data-incometax]').length > 1) uniquifyStaticIds(root, `it${++ns}`);

    mountFormCalculator(root, incomeTaxBinding, {
      recalculationMode: 'live-after-first',
      calculateButtonLabel: 'Calculate Tax',
    });

    // The island owns one visible detail: the standard-deduction note tracks the selected
    // filing status. This is purely informational (a source constant), never a calculation,
    // so it updates on every status change — before and after the first calculation. The
    // runtime independently recomputes on the same structural radio change once a first
    // calculation has happened.
    const stdEl = root.querySelector<HTMLElement>('[data-it-std]');
    const readStatus = () =>
      root.querySelector<HTMLInputElement>('[name="filingStatus"]:checked')?.value === 'married' ? 'married' : 'single';
    const syncStd = () => {
      if (stdEl) stdEl.textContent = formatCurrencyRounded(STANDARD_DEDUCTION[readStatus()]);
    };
    root.querySelectorAll<HTMLInputElement>('[name="filingStatus"]').forEach((r) =>
      r.addEventListener('change', syncStd),
    );
    root.querySelector<HTMLElement>('[data-reset]')?.addEventListener('click', () => {
      const single = root.querySelector<HTMLInputElement>('[name="filingStatus"][value="single"]');
      if (single) single.checked = true;
      syncStd();
    });
    syncStd();
  });
</script>
