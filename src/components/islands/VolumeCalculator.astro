---
/**
 * Volume calculator island (R12C1 — task-first migration, geometry shape-picker family; follow-on).
 *
 * Task-first: every dimension starts EMPTY, the result is empty, and the visitor presses "Calculate
 * Volume" for the first result; live-after-first afterwards. Compute, validation, state, announcement and
 * focus are owned by the shared runtime + the volume binding (@lib/calculators/volume-form), which wraps
 * the UNCHANGED calculateVolume / VOLUME_SHAPES. The complete-result guard lives in the binding's
 * resultValue (a NaN sentinel → the runtime's default finite gate) — there is NO isUsableResult.
 *
 * Volume is an INDEPENDENT product that follows the pattern proven by Area — it shares NO configuration,
 * binding or island logic with Area. The SHAPE is a structural <select> (default CUBE — the verified
 * source default, not Area's rectangle). Each shape owns ONLY its source dimensions, rendered
 * SHAPE-SCOPED (name="<shape>.<key>") so a visitor's values survive switching away and back; the ISLAND
 * shows/enables only the active group and hides + disables the rest, so inactive fields never parse,
 * validate, receive errors or take focus. The UNIT is INTERPRETIVE — it labels the entered-dimension unit
 * and the cubed result unit and NEVER converts numbers; the island keeps the dimension-unit affixes in
 * step. On Reset the runtime restores cube + m and clears every field; the island re-syncs visibility.
 */
import { VOLUME_SHAPES } from '@lib/calculators/volume';
import { VOLUME_UNITS, DEFAULT_SHAPE, DEFAULT_UNIT, VOLUME_EXAMPLE_VALUES } from '@lib/calculators/volume-form';
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';
---

<div class="volume mx-auto grid w-full max-w-4xl gap-6 md:grid-cols-2 md:items-start" data-volume>
  <!-- Inputs -->
  <form class="card p-4" data-form novalidate aria-label="Volume calculator">
    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="field-label" for="vo-shape">Shape</label>
        <select class="field" id="vo-shape" name="shape" data-vo-shape>
          {VOLUME_SHAPES.map((s) => <option value={s.key} selected={s.key === DEFAULT_SHAPE}>{s.label}</option>)}
        </select>
      </div>
      <div>
        <label class="field-label" for="vo-unit">Unit</label>
        <select class="field" id="vo-unit" name="unit" data-vo-unit>
          {VOLUME_UNITS.map((u) => <option value={u} selected={u === DEFAULT_UNIT}>{u}</option>)}
        </select>
      </div>
    </div>

    <p class="vo-help">Enter every dimension in the selected unit. Changing the unit does not convert values already entered.</p>

    <div class="mt-4">
      {VOLUME_SHAPES.map((s) => (
        <div class="vo-group space-y-3" data-vo-group={s.key} hidden={s.key !== DEFAULT_SHAPE}>
          {s.inputs.map((inp) => (
            <div data-field={`${s.key}.${inp.key}`}>
              <label class="field-label" for={`vo-${s.key}-${inp.key}`}>{inp.label}</label>
              <div class="flex">
                <input
                  class="field rounded-r-none"
                  id={`vo-${s.key}-${inp.key}`}
                  name={`${s.key}.${inp.key}`}
                  type="number"
                  min="0"
                  step="0.1"
                  inputmode="decimal"
                  autocomplete="off"
                  placeholder="e.g. 5"
                  disabled={s.key !== DEFAULT_SHAPE}
                  aria-describedby={`vo-${s.key}-${inp.key}-error`}
                />
                <span class="field-affix rounded-r-lg border-l-0" data-vo-dim-unit>{DEFAULT_UNIT}</span>
              </div>
              <p class="vo-field-error" id={`vo-${s.key}-${inp.key}-error`} data-error-for={`${s.key}.${inp.key}`} hidden></p>
            </div>
          ))}
        </div>
      ))}
    </div>

    <div class="mt-6 flex items-center gap-3">
      <button type="submit" class="btn btn-primary" data-vo-submit>Calculate Volume</button>
      <button type="button" class="btn btn-secondary" data-reset>Reset</button>
    </div>
    <p class="vo-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result -->
  <ResultShell id="vo-result" state="empty" density="standard" label="Volume result" minHeight="14rem">
    <ExampleNotice />
    <EmptyResult message="Choose a shape and enter its dimensions to calculate the volume." />

    <div data-result-when="valid" class="text-center">
      <ResultSummary label="Volume">
        <ResultValue value="—" size="text-5xl" />
      </ResultSummary>
      <p class="vo-unit-cubed"><span data-vo-unit-cubed>m³</span></p>
      <p class="vo-interpretation" data-vo-interpretation></p>
      <p class="vo-assumptions">Enter all dimensions in the same unit; the volume comes out in that unit cubed. The unit selector labels your measurements — it does not convert them.</p>
    </div>

    <InvalidResult
      title="Check your entries"
      message="Enter every dimension for the selected shape as a number greater than zero."
    />

    <ResultAnnouncement id="vo-live" />
  </ResultShell>
</div>

<style>
  .vo-help { margin-top: 0.75rem; font-size: 0.8rem; line-height: 1.45; color: var(--muted); }
  .vo-field-error {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .vo-field-error { color: #fca5a5; }
  }
  :root[data-theme='dark'] .vo-field-error { color: #fca5a5; }
  .vo-live-note { margin-top: 0.75rem; font-size: 0.8rem; color: var(--muted); }

  .vo-unit-cubed { margin-top: 0.25rem; font-size: 1.125rem; color: var(--muted); }
  .vo-interpretation { margin: 0.9rem 0 0; font-size: 0.95rem; line-height: 1.5; color: var(--fg); }
  .vo-assumptions { margin: 0.9rem 0 0; font-size: 0.78rem; line-height: 1.5; color: var(--muted); }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { volumeBinding, DEFAULT_SHAPE, DEFAULT_UNIT, VOLUME_EXAMPLE_VALUES } from '@lib/calculators/volume-form';

  document.querySelectorAll<HTMLElement>('[data-volume]').forEach((root) => {
    mountFormCalculator(root, volumeBinding, {
      recalculationMode: 'live-after-first',
      example: { values: VOLUME_EXAMPLE_VALUES },
      calculateButtonLabel: 'Calculate Volume',
    });

    const shapeSel = root.querySelector<HTMLSelectElement>('[data-vo-shape]');
    const unitSel = root.querySelector<HTMLSelectElement>('[data-vo-unit]');
    const groups = Array.from(root.querySelectorAll<HTMLElement>('[data-vo-group]'));
    const shell = root.querySelector<HTMLElement>('[data-result-shell]');

    // The island owns conditional-field visibility: show + enable only the active shape's group; hide +
    // DISABLE every other shape's inputs so they never parse, validate, receive errors or take focus.
    // Values in the inactive (disabled) controls are retained so switching back restores the visitor's work.
    const applyShapeVisibility = () => {
      const active = shapeSel?.value ?? DEFAULT_SHAPE;
      for (const g of groups) {
        const on = g.dataset.voGroup === active;
        g.hidden = !on;
        g.querySelectorAll<HTMLInputElement>('input').forEach((el) => {
          el.disabled = !on;
        });
      }
    };
    // The unit is interpretive: it relabels the dimension-unit affixes (and, via the binding, the cubed
    // result unit) but never converts numbers. The affixes update immediately, even before the first calc.
    const applyUnitLabels = () => {
      const u = unitSel?.value ?? DEFAULT_UNIT;
      root.querySelectorAll<HTMLElement>('[data-vo-dim-unit]').forEach((el) => {
        el.textContent = u;
      });
    };

    shapeSel?.addEventListener('change', applyShapeVisibility);
    unitSel?.addEventListener('change', applyUnitLabels);
    applyShapeVisibility();
    applyUnitLabels();

    // On Reset the runtime restores shape → cube + unit → m and clears every field; re-sync the
    // island-owned visibility + unit labels when the shell returns to `empty`.
    if (shell) {
      const observer = new MutationObserver(() => {
        if (shell.dataset.resultState === 'empty') {
          applyShapeVisibility();
          applyUnitLabels();
        }
      });
      observer.observe(shell, { attributes: true, attributeFilter: ['data-result-state'] });
    }
  });
</script>
