---
/**
 * Volume island — the reference's ELEVEN independent calculators.
 *
 * Sphere, Cone, Cube, Cylinder, Rectangular Tank, Capsule, Spherical Cap, Conical Frustum,
 * Ellipsoid, Square Pyramid and Tube. Each is its own calculator: its own fields, its own Calculate
 * button and its own result, none of them touching another.
 *
 * Same anatomy as the area island — the result lives INSIDE the form's card, directly under
 * Calculate, and shows its working — because they are the same kind of tool and a visitor moving
 * between them should not have to relearn where the answer appears.
 *
 * The Spherical Cap is the exception worth knowing about: it asks for any TWO of its three fields
 * and, given both radii, has TWO answers. Its result therefore carries two headline figures and a
 * "Steps:" block working each through, which is why the working is rendered from a step list rather
 * than poured into fixed slots.
 *
 * The eleven sections are RENDERED FROM `VOLUME_SHAPES`, so the markup and the bindings are built
 * from one list and cannot drift.
 *
 * All eleven run on the UNCHANGED standard-form runtime, one mount per section, sharing one binding
 * built by `makeVolumeBinding`. The complete-result guard lives in `resultValue`; no
 * `isUsableResult`.
 */
import ResultShell from '@components/result/ResultShell.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';
import { VOLUME_SHAPES, DEFAULT_UNIT } from '@lib/calculators/volume-form';
import { LENGTH_UNITS } from '@lib/calculators/area-units';

export interface Props {
  /** Calculators per row on a wide screen. One card per row, or two side by side. */
  columns?: 1 | 2;
}
const { columns = 2 } = Astro.props;

/** One small line drawing per shape, so a section is recognisable before it is read. */
const DIAGRAMS: Record<string, string> = {
  sphere: '<circle cx="60" cy="40" r="27" /><ellipse cx="60" cy="40" rx="27" ry="9" stroke-dasharray="4 3" />',
  cone: '<path d="M60 12 L92 62" /><path d="M60 12 L28 62" /><ellipse cx="60" cy="62" rx="32" ry="9" />',
  cube: '<rect x="20" y="24" width="52" height="44" /><path d="M20 24 L40 10 L92 10 L72 24" /><path d="M92 10 L92 54 L72 68" />',
  cylinder: '<ellipse cx="60" cy="20" rx="28" ry="8" /><path d="M32 20 L32 60" /><path d="M88 20 L88 60" /><path d="M32 60 A28 8 0 0 0 88 60" />',
  'rectangular-tank': '<rect x="20" y="26" width="50" height="42" /><path d="M20 26 L42 10 L92 10 L70 26" /><path d="M92 10 L92 52 L70 68" />',
  capsule: '<path d="M34 28 A26 20 0 0 1 86 28" /><path d="M34 28 L34 52" /><path d="M86 28 L86 52" /><path d="M34 52 A26 20 0 0 0 86 52" /><ellipse cx="60" cy="28" rx="26" ry="8" stroke-dasharray="4 3" />',
  'spherical-cap': '<path d="M22 50 A44 44 0 0 1 98 50" /><ellipse cx="60" cy="50" rx="38" ry="10" stroke-dasharray="4 3" />',
  'conical-frustum': '<path d="M40 18 L26 62" /><path d="M80 18 L94 62" /><ellipse cx="60" cy="18" rx="20" ry="6" /><ellipse cx="60" cy="62" rx="34" ry="9" />',
  ellipsoid: '<ellipse cx="60" cy="40" rx="34" ry="24" /><ellipse cx="60" cy="40" rx="34" ry="10" stroke-dasharray="4 3" /><ellipse cx="60" cy="40" rx="12" ry="24" stroke-dasharray="4 3" />',
  'square-pyramid': '<path d="M60 10 L22 62 L98 62 Z" /><path d="M60 10 L74 50 L22 62" stroke-dasharray="4 3" /><path d="M74 50 L98 62" stroke-dasharray="4 3" />',
  tube: '<ellipse cx="60" cy="22" rx="30" ry="9" /><ellipse cx="60" cy="22" rx="13" ry="4" /><path d="M30 22 L30 54" /><path d="M90 22 L90 54" /><path d="M30 54 A30 9 0 0 0 90 54" />',
};
---

<div class:list={['vlpage', columns === 2 && 'vlpage--two']} data-vlpage data-vl-columns={String(columns)}>
  {
    VOLUME_SHAPES.map((spec) => (
      <section class="vl-calc" data-vl-shape={spec.key} aria-labelledby={`vl-${spec.key}-heading`}>
        <div class="vl-head">
          <svg class="vl-diagram" viewBox="0 0 120 80" aria-hidden="true" focusable="false" set:html={DIAGRAMS[spec.key]} />
          <div>
            <h2 class="vl-title" id={`vl-${spec.key}-heading`}>{spec.title}</h2>
            <p class="vl-lede">{spec.lede}</p>
          </div>
        </div>

        <div class="card vl-card">
          <form data-form novalidate aria-label={`${spec.title} volume calculator`}>
            {spec.note && <p class="vl-instruction">{spec.note}</p>}

            {spec.fields.map((field) => (
              <div class="vl-field" data-field={field.name}>
                <div class="vl-row">
                  <label class="field-label vl-row__label" for={`vl-${spec.key}-${field.name}`}>
                    {field.label}
                  </label>
                  <div class="vl-row__control">
                    <input
                      class="field vl-num"
                      id={`vl-${spec.key}-${field.name}`}
                      name={field.name}
                      type="number"
                      min="0"
                      step="any"
                      inputmode="decimal"
                      autocomplete="off"
                      aria-describedby={`vl-${spec.key}-${field.name}-error`}
                    />
                    <select class="field vl-unit" name={`${field.name}Unit`} aria-label={`${field.label} unit`}>
                      {LENGTH_UNITS.map((u) => (
                        <option value={u.value} selected={u.value === DEFAULT_UNIT}>
                          {u.label}
                        </option>
                      ))}
                    </select>
                  </div>
                </div>
                <p class="vl-field-error" id={`vl-${spec.key}-${field.name}-error`} data-error-for={field.name} hidden />
              </div>
            ))}

            <div class="mt-4 flex items-center gap-3">
              <button type="submit" class="btn btn-primary">Calculate {spec.title}</button>
              <button type="button" class="btn btn-secondary" data-reset>Clear</button>
            </div>
          </form>

          <ResultShell
            id={`vl-${spec.key}-result`}
            state="empty"
            density="standard"
            boxed={false}
            label={`${spec.title} volume result`}
            minHeight="0"
            class="vl-result"
          >
            <ExampleNotice />
            <EmptyResult message={`Enter the ${spec.fields.map((x) => x.label.replace(/\s*\([^)]*\)/, '').toLowerCase()).join(' and ')}, then calculate the volume.`} />

            <div data-result-when="valid">
              {/* The working IS the result: its headline lines carry the answer, exactly as the
                  reference prints it. A spherical cap can have two of them. */}
              <div class="vl-steps" data-vl-steps />
              <span class="sr-only" data-result-value-a11y />
              <p class="vl-mixed" data-vl-mixed hidden>
                Your measurements were in different units, so each was converted into the first
                field's unit before the formula ran.
              </p>
            </div>

            <InvalidResult
              title="Check your entries"
              message="Every measurement must be a number greater than zero."
            />

            <ResultAnnouncement id={`vl-${spec.key}-live`} />
          </ResultShell>

          <p class="vl-live-note" data-live-note hidden>Changes update automatically.</p>
        </div>
      </section>
    ))
  }
</div>

<style>
  .vlpage {
    display: grid;
    gap: 1.75rem;
    width: 100%;
  }
  /* Two cards abreast only once there is room for both without squeezing the fields. */
  @media (min-width: 60rem) {
    .vlpage--two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
    /* One per row still keeps a calculator-sized box: a number field a thousand pixels wide
       tells the visitor nothing and makes the label and its input strangers. */
    .vlpage:not(.vlpage--two) .vl-calc {
      max-width: 34rem;
    }
  }

  .vl-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
  }
  .vl-diagram {
    flex: none;
    width: 3rem;
    height: 2rem;
    fill: none;
    stroke: var(--muted);
    stroke-width: 4;
    stroke-linejoin: round;
    opacity: 0.7;
  }
  .vl-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--heading);
  }
  .vl-lede {
    margin: 0.1rem 0 0;
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .vl-card {
    padding: 1rem;
  }
  .vl-instruction {
    margin: 0 0 0.6rem;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--fg);
    font-weight: 600;
  }

  .vl-field + .vl-field {
    margin-top: 0.4rem;
  }
  .vl-row {
    display: grid;
    grid-template-columns: minmax(0, 9.5rem) minmax(0, 1fr);
    align-items: center;
    gap: 0.5rem;
  }
  .vl-row__label {
    margin: 0;
  }
  .vl-row__control {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
  }
  .vl-num {
    flex: 1 1 0;
    min-width: 0;
    min-height: 2.75rem;
    font-variant-numeric: tabular-nums;
  }
  .vl-unit {
    flex: 0 1 auto;
    width: auto;
    min-width: 0;
    min-height: 2.75rem;
    font-size: 0.86rem;
  }
  @media (max-width: 30rem) {
    .vl-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.2rem;
    }
  }

  .vl-field-error {
    margin: 0.3rem 0 0;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.3;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .vl-field-error { color: #fca5a5; }
  }
  :root[data-theme='dark'] .vl-field-error { color: #fca5a5; }

  .vl-live-note {
    margin-top: 0.7rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* ResultShell owns this element, so the rule that separates the answer from the form has to
     be reached with :global() beneath the section this template does own. */
  .vl-calc :global(.vl-result) {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  /* The working. These rows are BUILT IN JS, so Astro's scoping never reaches them — they have
     to be matched with :global() beneath a container the template does own. */
  .vl-steps {
    display: grid;
    gap: 0.1rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--fg);
  }
  .vl-steps :global(.vl-step) {
    display: grid;
    grid-template-columns: minmax(0, auto) auto minmax(0, 1fr);
    align-items: baseline;
  }
  .vl-steps :global(.vl-step__label) {
    justify-self: end;
    font-weight: 600;
    color: var(--muted);
    white-space: nowrap;
  }
  .vl-steps :global(.vl-step__eq) {
    color: var(--muted);
    white-space: pre;
  }
  .vl-steps :global(.vl-step__expr) {
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .vl-steps :global(.vl-step__unit) {
    font-weight: 600;
    color: var(--muted);
  }
  /* A headline answer. A spherical cap has two of them. */
  .vl-steps :global(.vl-step--final) {
    margin-top: 0.3rem;
    font-size: 1.3rem;
    line-height: 1.3;
  }
  .vl-steps :global(.vl-step--final .vl-step__expr) {
    font-weight: 800;
    color: var(--heading);
  }
  .vl-steps :global(.vl-step--final .vl-step__unit) {
    font-size: 0.9rem;
    font-weight: 700;
  }
  .vl-steps :global(.vl-step-note) {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .vl-steps :global(.vl-steps-heading) {
    margin: 1rem 0 0.2rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--fg);
  }

  .vl-mixed {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--muted);
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { VOLUME_SHAPES, makeVolumeBinding, volumeExampleValues } from '@lib/calculators/volume-form';

  function uniquifyStaticIds(root: HTMLElement, suffix: string): void {
    const remap = new Map<string, string>();
    root.querySelectorAll<HTMLElement>('[id]').forEach((el) => {
      const next = `${el.id}-${suffix}`;
      remap.set(el.id, next);
      el.id = next;
    });
    const repoint = (attr: string) =>
      root.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((el) => {
        const next = el
          .getAttribute(attr)!
          .split(/\s+/)
          .map((token) => remap.get(token) ?? token)
          .join(' ');
        el.setAttribute(attr, next);
      });
    repoint('for');
    repoint('aria-describedby');
    repoint('aria-labelledby');
    repoint('aria-controls');
  }

  const pages = document.querySelectorAll<HTMLElement>('[data-vlpage]');
  pages.forEach((page, i) => {
    if (pages.length > 1) uniquifyStaticIds(page, `v${i + 1}`);

    for (const spec of VOLUME_SHAPES) {
      const section = page.querySelector<HTMLElement>(`[data-vl-shape="${spec.key}"]`);
      if (!section) continue;
      mountFormCalculator(section, makeVolumeBinding(spec), {
        recalculationMode: 'live-after-first',
        example: { values: volumeExampleValues(spec) },
        calculateButtonLabel: `Calculate ${spec.title}`,
      });
    }
  });
</script>
