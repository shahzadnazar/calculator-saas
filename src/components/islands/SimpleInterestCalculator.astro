---
/**
 * Simple-interest calculator island (R9A1 — standard-form wave, calculator #17; product family
 * FINANCE-SIMPLE, on the standard-form runtime UNCHANGED — no isUsableResult).
 *
 * Task-first, direct-intent: a single mode, no structural selectors. All fields start EMPTY,
 * the result is empty (an instruction, not the legacy $5,000 / 5% / 3-year sample), and the
 * visitor presses "Calculate Simple Interest" for the first result. Live-after-first afterwards.
 * Compute, validation, state, the single announcement, focus and Reset are owned by the shared
 * runtime (UNCHANGED) + the simple-interest binding (@lib/calculators/simple-interest-form).
 *
 * Interest earned is the DOMINANT result; the total amount is the secondary breakdown. Amounts
 * are US dollars (USD). This island is also embedded by the guide
 * src/content/guides/simple-interest-explained.mdx — it injects no page H1 or breadcrumb, so it
 * renders cleanly inside guide prose as well as on the calculator page and the /embed route.
 */
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import ResultInterpretation from '@components/result/ResultInterpretation.astro';
import ResultBreakdown from '@components/result/ResultBreakdown.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
---

<div class="simpleinterest mx-auto grid w-full max-w-4xl gap-6 md:grid-cols-2 md:items-start" data-simple-interest>
  <!-- Inputs -->
  <form class="card p-4" data-form novalidate aria-label="Simple interest calculator">
    <div class="space-y-4">
      <div data-field="principal">
        <label class="field-label" for="si-principal">Principal amount in USD</label>
        <div class="flex">
          <span class="field-affix rounded-l-lg border-r-0">$</span>
          <input
            class="field rounded-l-none"
            id="si-principal"
            name="principal"
            type="number"
            min="0"
            step="100"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 5000"
            aria-describedby="si-principal-error"
          />
        </div>
        <p class="si-field-error" id="si-principal-error" data-error-for="principal" hidden></p>
      </div>

      <div data-field="annualRatePct">
        <label class="field-label" for="si-rate">Annual interest rate</label>
        <div class="flex">
          <input
            class="field rounded-r-none"
            id="si-rate"
            name="annualRatePct"
            type="number"
            min="0"
            step="0.1"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 5"
            aria-describedby="si-rate-error"
          />
          <span class="field-affix rounded-r-lg border-l-0">%</span>
        </div>
        <p class="si-field-error" id="si-rate-error" data-error-for="annualRatePct" hidden></p>
      </div>

      <div data-field="years">
        <label class="field-label" for="si-years">Time</label>
        <div class="flex">
          <input
            class="field rounded-r-none"
            id="si-years"
            name="years"
            type="number"
            min="0"
            step="0.5"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 3"
            aria-describedby="si-years-error"
          />
          <span class="field-affix rounded-r-lg border-l-0">years</span>
        </div>
        <p class="si-field-error" id="si-years-error" data-error-for="years" hidden></p>
      </div>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <button type="submit" class="btn btn-primary">Calculate Simple Interest</button>
      <button type="button" class="btn btn-secondary" data-reset>Reset</button>
    </div>
    <p class="si-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result -->
  <ResultShell
    id="si-result"
    state="empty"
    density="standard"
    label="Simple interest result"
    minHeight="20rem"
    placeholderAlignment="center"
  >
    <EmptyResult message="Enter a principal amount, annual interest rate, and time period to calculate simple interest." />

    <div data-result-when="valid">
      <ResultSummary label="Interest earned">
        <ResultValue value="—" size="text-4xl" />
      </ResultSummary>
      <ResultInterpretation>
        <span data-si-interpretation></span>
      </ResultInterpretation>

      <ResultBreakdown title="Breakdown">
        <dl class="si-metrics">
          <div><dt>Total amount</dt><dd data-si-total>—</dd></div>
        </dl>
        <p class="si-note">Interest and total are in US dollars (USD).</p>
      </ResultBreakdown>
    </div>

    <InvalidResult
      title="Check your entries"
      message="Enter a principal amount, an annual interest rate, and a time period in years to calculate."
    />

    <ResultAnnouncement id="si-live" />
  </ResultShell>
</div>

<style>
  .si-field-error {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .si-field-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .si-field-error {
    color: #fca5a5;
  }

  .si-live-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .si-metrics {
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }
  .si-metrics > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .si-metrics dt {
    color: var(--fg);
    font-weight: 600;
  }
  .si-metrics dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--heading);
    font-weight: 700;
    white-space: nowrap;
  }
  .si-note {
    margin: 0.7rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { simpleInterestBinding } from '@lib/calculators/simple-interest-form';

  document.querySelectorAll<HTMLElement>('[data-simple-interest]').forEach((root) => {
    mountFormCalculator(root, simpleInterestBinding, {
      recalculationMode: 'live-after-first',
      calculateButtonLabel: 'Calculate Simple Interest',
    });
  });
</script>
