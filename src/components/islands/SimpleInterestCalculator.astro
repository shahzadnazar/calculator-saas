---
import { calculateSimpleInterest } from '@lib/calculators/simple-interest';
import { formatCurrency } from '@lib/format';

const defaults = { principal: 5000, annualRatePct: 5, years: 3 };
const r = calculateSimpleInterest(defaults);
---

<div class="mx-auto grid w-full max-w-4xl gap-6 md:grid-cols-2" data-si>
  <form class="card p-5 sm:p-6" data-si-form novalidate>
    <div class="space-y-4">
      <div>
        <label class="field-label" for="si-principal">Principal amount</label>
        <div class="flex"><span class="field-affix rounded-l-lg border-r-0">$</span><input class="field rounded-l-none" id="si-principal" name="principal" type="number" min="0" step="100" value={defaults.principal} inputmode="decimal" /></div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="field-label" for="si-rate">Annual rate</label>
          <div class="flex"><input class="field rounded-r-none" id="si-rate" name="annualRatePct" type="number" min="0" step="0.1" value={defaults.annualRatePct} inputmode="decimal" /><span class="field-affix rounded-r-lg border-l-0">%</span></div>
        </div>
        <div>
          <label class="field-label" for="si-years">Time (years)</label>
          <input class="field" id="si-years" name="years" type="number" min="0" step="0.5" value={defaults.years} inputmode="decimal" />
        </div>
      </div>
    </div>
  </form>

  <div class="card p-5 sm:p-6">
    <p class="text-sm font-semibold" style="color: var(--muted)">Interest earned</p>
    <p class="mt-1 text-4xl font-extrabold tracking-tight" style="color: var(--color-accent-600)" data-si-interest>{formatCurrency(r.interest)}</p>
    <div class="mt-5 flex items-center justify-between border-t pt-5" style="border-color: var(--line)">
      <span class="font-semibold">Total value</span>
      <span class="text-xl font-bold" data-si-total>{formatCurrency(r.total)}</span>
    </div>
  </div>
</div>

<script>
  import { calculateSimpleInterest } from '@lib/calculators/simple-interest';
  import { formatCurrency } from '@lib/format';
  document.querySelectorAll<HTMLElement>('[data-si]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-si-form]')!;
    const num = (n: string) => Number((form.elements.namedItem(n) as HTMLInputElement)?.value) || 0;
    const set = (sel: string, v: string) => { const el = root.querySelector<HTMLElement>(sel); if (el) el.textContent = v; };
    function recompute() {
      const r = calculateSimpleInterest({ principal: num('principal'), annualRatePct: num('annualRatePct'), years: num('years') });
      set('[data-si-interest]', formatCurrency(r.interest));
      set('[data-si-total]', formatCurrency(r.total));
    }
    form.addEventListener('input', recompute);
    recompute();
  });
</script>
