---
/**
 * Unit conversion island.
 *
 * One calculator, not a page of them — but laid out like the rest of the recent fleet: the result
 * lives INSIDE the form's card, directly under Convert, so it reads fill → press → answer straight
 * down rather than across.
 *
 * The result does more than answer the question asked. Converting into ONE unit throws away the
 * most useful part of the work: the same quantity in every other unit of the category costs nothing
 * to compute, and a visitor converting a recipe wants tablespoons AND millilitres, not one of them
 * and a second trip through the form. So the requested pair is shown large, and the whole category
 * follows beneath it with the source and target marked.
 *
 * The category → From/To dependency stays calculator-owned here rather than becoming a runtime: on a
 * category change the two unit lists are rebuilt and the category's own default pair selected. The
 * options are built with DOM text APIs, never innerHTML.
 *
 * Runs on the UNCHANGED standard-form runtime. The complete-result guard lives in `resultValue`;
 * there is no `isUsableResult`. The neutral value of 1 is the ratified converter-family behaviour.
 */
import ResultShell from '@components/result/ResultShell.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';
import { CATEGORIES } from '@lib/calculators/conversion';
import { DEFAULT_CATEGORY, defaultUnits } from '@lib/calculators/conversion-form';

const defCat = CATEGORIES.find((c) => c.key === DEFAULT_CATEGORY)!;
const { from: defFrom, to: defTo } = defaultUnits(DEFAULT_CATEGORY);
---

<div class="cvcalc mx-auto w-full max-w-3xl" data-convert>
  <div class="card cv-card">
    <form data-form novalidate aria-label="Unit conversion calculator">
      <div class="cv-field" data-field="category">
        <label class="field-label" for="cv-cat">Category</label>
        <select class="field mt-1" id="cv-cat" name="category" data-cv-cat>
          {CATEGORIES.map((c) => <option value={c.key} selected={c.key === DEFAULT_CATEGORY}>{c.label}</option>)}
        </select>
      </div>

      <div class="cv-convert">
        <div class="cv-field" data-field="value">
          <label class="field-label" for="cv-value">Value</label>
          <input class="field mt-1 cv-value" id="cv-value" name="value" type="number" step="any" inputmode="decimal" autocomplete="off" value="1" aria-describedby="cv-value-error" />
        </div>

        <div class="cv-field">
          <label class="field-label" for="cv-from">From</label>
          <select class="field mt-1" id="cv-from" name="from" data-cv-from>
            {defCat.units.map((u) => <option value={u.key} selected={u.key === defFrom}>{u.label}</option>)}
          </select>
        </div>

        <button type="button" class="cv-swap" data-cv-swap aria-label="Swap the From and To units">
          <span aria-hidden="true">⇄</span>
        </button>

        <div class="cv-field">
          <label class="field-label" for="cv-to">To</label>
          <select class="field mt-1" id="cv-to" name="to" data-cv-to>
            {defCat.units.map((u) => <option value={u.key} selected={u.key === defTo}>{u.label}</option>)}
          </select>
        </div>
      </div>
      <p class="cv-error" id="cv-value-error" data-error-for="value" hidden></p>

      <div class="mt-4 flex items-center gap-3">
        <button type="submit" class="btn btn-primary">Convert</button>
        <button type="button" class="btn btn-secondary" data-reset>Reset</button>
      </div>
      <p class="cv-live-note" data-live-note hidden>Changes update automatically.</p>
    </form>

    <ResultShell
      id="cv-result"
      state="empty"
      density="standard"
      boxed={false}
      label="Conversion result"
      minHeight="0"
      class="cv-result"
    >
      <ExampleNotice />
      <EmptyResult message="Choose a category and units, enter a value, then convert." />

      <div data-result-when="valid">
        <p class="cv-answer">
          <span class="cv-answer__figure" data-result-value>—</span>
          <span class="cv-answer__unit" data-cv-unit>—</span>
        </p>
        <p class="cv-equation" data-cv-equation></p>
        <span class="sr-only" data-result-value-a11y></span>

        <div class="cv-all">
          <h3 class="cv-all__title">The same amount in every <span data-cv-category>unit</span> unit</h3>
          <dl class="cv-all__list" data-cv-all></dl>
        </div>
      </div>

      <InvalidResult
        title="Check your value"
        message="Enter a number to convert, then choose the units."
      />

      <ResultAnnouncement id="cv-live" />
    </ResultShell>
  </div>
</div>

<style>
  .cv-card { padding: 1rem; }
  .cv-field + .cv-field { margin-top: 0; }

  /* Value, From, swap, To on one line once there is room — the shape of the question. */
  .cv-convert {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: end;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  @media (max-width: 40rem) {
    .cv-convert {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    }
    .cv-convert > .cv-field:first-child { grid-column: 1 / -1; }
  }
  .cv-convert .field { min-height: 2.75rem; }
  .cv-value { font-variant-numeric: tabular-nums; }

  .cv-swap {
    align-self: end;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    min-height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: none;
    font-size: 1.05rem;
    color: var(--color-brand-700, var(--fg));
    cursor: pointer;
  }
  .cv-swap:hover { background: var(--surface-2, rgba(0, 0, 0, 0.04)); }
  :root[data-theme='dark'] .cv-swap { color: var(--color-brand-200); }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .cv-swap { color: var(--color-brand-200); }
  }

  .cv-error {
    margin: 0.4rem 0 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .cv-error { color: #fca5a5; }
  }
  :root[data-theme='dark'] .cv-error { color: #fca5a5; }

  .cv-live-note {
    margin-top: 0.7rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* ResultShell owns this element, so the separating rule is reached with :global(). */
  .cvcalc :global(.cv-result) {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .cv-answer {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
  }
  .cv-answer__figure {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.15;
    color: var(--heading);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .cv-answer__unit {
    font-size: 1rem;
    font-weight: 700;
    color: var(--muted);
  }
  .cv-equation {
    margin: 0.35rem 0 0;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .cv-all {
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
  }
  .cv-all__title {
    margin: 0 0 0.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cv-all__list {
    margin: 0;
    display: grid;
    gap: 0.15rem;
  }
  @media (min-width: 34rem) {
    .cv-all__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.15rem 1.5rem; }
  }
  .cvcalc :global(.cv-row) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.9rem;
  }
  .cvcalc :global(.cv-row dt) { color: var(--fg); }
  .cvcalc :global(.cv-row dd) {
    margin: 0;
    text-align: right;
    font-weight: 700;
    color: var(--heading);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .cvcalc :global(.cv-row__note) {
    color: var(--muted);
    font-size: 0.82em;
  }
  /* The unit asked for, so the headline answer can be found again in the list. */
  .cvcalc :global(.cv-row--target dt),
  .cvcalc :global(.cv-row--target dd) { color: var(--color-brand-700, var(--heading)); font-weight: 700; }
  :root[data-theme='dark'] .cvcalc :global(.cv-row--target dt),
  :root[data-theme='dark'] .cvcalc :global(.cv-row--target dd) { color: var(--color-brand-200); }
  .cvcalc :global(.cv-row--source dt) { font-weight: 600; }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { CATEGORIES } from '@lib/calculators/conversion';
  import {
    conversionBinding,
    defaultUnits,
    CONVERSION_EXAMPLE_VALUES,
  } from '@lib/calculators/conversion-form';

  const catMap = new Map(CATEGORIES.map((c) => [c.key, c]));
  let ns = 0;

  function uniquifyStaticIds(root: HTMLElement, suffix: string): void {
    const remap = new Map<string, string>();
    root.querySelectorAll<HTMLElement>('[id]').forEach((el) => {
      const next = `${el.id}-${suffix}`;
      remap.set(el.id, next);
      el.id = next;
    });
    const repoint = (attr: string) =>
      root.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((el) => {
        const next = el
          .getAttribute(attr)!
          .split(/\s+/)
          .map((token) => remap.get(token) ?? token)
          .join(' ');
        el.setAttribute(attr, next);
      });
    repoint('for');
    repoint('aria-describedby');
    repoint('aria-labelledby');
    repoint('aria-controls');
  }

  /** Setting a value in code fires nothing, so tell the runtime the field changed. */
  const announce = (el: HTMLElement) => {
    el.dispatchEvent(new Event('input', { bubbles: true }));
    el.dispatchEvent(new Event('change', { bubbles: true }));
  };

  document.querySelectorAll<HTMLElement>('[data-convert]').forEach((root) => {
    if (document.querySelectorAll('[data-convert]').length > 1) uniquifyStaticIds(root, `c${++ns}`);

    const catSel = root.querySelector<HTMLSelectElement>('[data-cv-cat]')!;
    const fromSel = root.querySelector<HTMLSelectElement>('[data-cv-from]')!;
    const toSel = root.querySelector<HTMLSelectElement>('[data-cv-to]')!;
    const shell = root.querySelector<HTMLElement>('[data-result-shell]');

    // The category → From/To dependency is calculator-owned. On a category change both unit lists
    // are rebuilt and the category's own default pair selected; the numeric value is preserved.
    const fillUnits = () => {
      const cat = catMap.get(catSel.value) ?? CATEGORIES[0];
      for (const select of [fromSel, toSel]) {
        select.textContent = '';
        for (const unit of cat.units) {
          const option = document.createElement('option');
          option.value = unit.key;
          option.textContent = unit.note ? `${unit.label} (${unit.note})` : unit.label;
          select.appendChild(option);
        }
      }
      const { from, to } = defaultUnits(cat.key);
      fromSel.value = from;
      toSel.value = to;
    };
    catSel.addEventListener('change', fillUnits);

    root.querySelector<HTMLElement>('[data-cv-swap]')?.addEventListener('click', () => {
      // Read both before writing either, or the second write reads what the first replaced.
      const from = fromSel.value;
      const to = toSel.value;
      fromSel.value = to;
      toSel.value = from;
      announce(fromSel);
      announce(toSel);
    });

    mountFormCalculator(root, conversionBinding, {
      recalculationMode: 'live-after-first',
      example: { values: CONVERSION_EXAMPLE_VALUES },
      calculateButtonLabel: 'Convert',
    });

    // On Reset the runtime restores the default category and value and returns the shell to `empty`;
    // re-sync the calculator-owned unit lists and clear the stale result. Presentation only.
    if (shell) {
      const clear = () => {
        root.querySelectorAll<HTMLElement>('[data-cv-unit]').forEach((el) => (el.textContent = '—'));
        root
          .querySelectorAll<HTMLElement>(
            '[data-result-when~="valid"] [data-result-value], [data-result-when~="valid"] [data-result-value-a11y]',
          )
          .forEach((el) => (el.textContent = '—'));
        const eq = root.querySelector<HTMLElement>('[data-cv-equation]');
        if (eq) eq.textContent = '';
        const all = root.querySelector<HTMLElement>('[data-cv-all]');
        if (all) all.textContent = '';
      };
      new MutationObserver(() => {
        const state = shell.dataset.resultState;
        if (state !== 'valid') clear();
        if (state === 'empty') fillUnits(); // reset restored the default category; rebuild its units
      }).observe(shell, { attributes: true, attributeFilter: ['data-result-state'] });
    }
  });
</script>
