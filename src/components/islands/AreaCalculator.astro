---
/**
 * Area island — the reference's SEVEN independent calculators.
 *
 * Rectangle, Triangle, Trapezoid, Circle, Sector, Ellipse and Parallelogram. Each is its own
 * calculator: its own fields, its own Calculate button and its own result, none of them touching
 * another, so an answer stays on screen while the next shape is worked out.
 *
 * Two things differ from the square-footage island, and both come from the reference:
 *
 *  - The RESULT LIVES INSIDE THE FORM'S CARD, directly under Calculate, rather than beside it. Fill
 *    in, press, read straight down: one card is one question and its answer.
 *  - The result SHOWS ITS WORKING — the formula, then the same formula with the entered numbers
 *    substituted, then the answer. The steps are generated by the engine beside the formula they
 *    describe and rendered here with text APIs only, never markup from a string.
 *
 * The seven sections are RENDERED FROM `AREA_SHAPES`, not written out seven times, so the markup
 * and the bindings are built from one list and cannot drift.
 *
 * All seven run on the UNCHANGED standard-form runtime, one mount per section, sharing one binding
 * built by `makeAreaBinding`. The complete-result guard lives in `resultValue`; no `isUsableResult`.
 *
 * Static ids are namespaced per-instance WHEN more than one area page shares a document (the
 * R16B2.1 discipline), so an embed gallery has no duplicate ids.
 */
import ResultShell from '@components/result/ResultShell.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';
import { AREA_SHAPES, DEFAULT_UNIT } from '@lib/calculators/area-form';
import { LENGTH_UNITS, ANGLE_UNITS, AREA_UNITS } from '@lib/calculators/area-units';

/** One small line drawing per shape, so a section is recognisable before it is read. */
const DIAGRAMS: Record<string, string> = {
  rectangle: '<rect x="8" y="14" width="104" height="52" />',
  triangle: '<polygon points="10,66 110,66 78,14" />',
  trapezoid: '<polygon points="10,66 110,66 88,14 32,14" />',
  circle: '<circle cx="60" cy="40" r="26" />',
  sector: '<path d="M60 66 L60 14 A52 52 0 0 1 112 66 Z" />',
  ellipse: '<ellipse cx="60" cy="40" rx="50" ry="26" />',
  parallelogram: '<polygon points="10,66 86,66 110,14 34,14" />',
};
---

<div class="arpage" data-arpage>
  {
    AREA_SHAPES.map((spec) => (
      <section class="ar-calc" data-ar-shape={spec.key} aria-labelledby={`ar-${spec.key}-heading`}>
        <div class="ar-head">
          <svg class="ar-diagram" viewBox="0 0 120 80" aria-hidden="true" focusable="false" set:html={DIAGRAMS[spec.key]} />
          <div>
            <h2 class="ar-title" id={`ar-${spec.key}-heading`}>{spec.title}</h2>
            <p class="ar-lede">{spec.lede}</p>
          </div>
        </div>

        <div class="card ar-card">
          <form data-form novalidate aria-label={`${spec.title} area calculator`}>
            {spec.fields.map((f) => (
              <div class="ar-field" data-field={f.name}>
                <div class="ar-row">
                  <label class="field-label ar-row__label" for={`ar-${spec.key}-${f.name}`}>
                    {f.label}
                  </label>
                  <div class="ar-row__control">
                    <input
                      class="field ar-num"
                      id={`ar-${spec.key}-${f.name}`}
                      name={f.name}
                      type="number"
                      min="0"
                      step="any"
                      inputmode="decimal"
                      autocomplete="off"
                      aria-describedby={`ar-${spec.key}-${f.name}-error`}
                    />
                    <select class="field ar-unit" name={`${f.name}Unit`} aria-label={`${f.label} unit`}>
                      {(f.kind === 'angle' ? ANGLE_UNITS : LENGTH_UNITS).map((u) => (
                        <option value={u.value} selected={f.kind === 'length' && u.value === DEFAULT_UNIT}>
                          {u.label}
                        </option>
                      ))}
                    </select>
                  </div>
                </div>
                <p class="ar-field-error" id={`ar-${spec.key}-${f.name}-error`} data-error-for={f.name} hidden />
              </div>
            ))}

            {spec.note && (
              <p class="ar-note">
                <a href={spec.note.href}>{spec.note.linkText}</a> {spec.note.text}
              </p>
            )}

            <div class="mt-4 flex items-center gap-3">
              <button type="submit" class="btn btn-primary">Calculate {spec.title}</button>
              <button type="button" class="btn btn-secondary" data-reset>Clear</button>
            </div>
          </form>

          <ResultShell
            id={`ar-${spec.key}-result`}
            state="empty"
            density="standard"
            boxed={false}
            label={`${spec.title} area result`}
            minHeight="0"
            class="ar-result"
          >
            <ExampleNotice />
            <EmptyResult message={`Enter the ${spec.fields.map((f) => f.label.replace(/\s*\([^)]*\)/, '').toLowerCase()).join(' and ')}, then calculate the area.`} />

            <div data-result-when="valid">
              {/* The working IS the result: its last line is the answer, weighted and carrying
                  [data-result-value], exactly as the reference prints it. Showing the figure again
                  underneath would say the same thing twice. */}
              <div class="ar-steps" data-ar-steps />
              <p class="ar-mixed" data-ar-mixed hidden>
                Your measurements were in different units, so each was converted into the first
                field's unit before the formula ran.
              </p>

              <details class="ar-others-box">
                <summary class="ar-others-toggle">Show result in other units</summary>
                <dl class="ar-others">
                  {AREA_UNITS.map((u) => (
                    <div data-ar-other={u.value}>
                      <dt>{u.plural}</dt>
                      <dd data-ar-other-value>—</dd>
                    </div>
                  ))}
                </dl>
              </details>
            </div>

            <InvalidResult
              title="Check your entries"
              message="Every measurement must be a number greater than zero."
            />

            <ResultAnnouncement id={`ar-${spec.key}-live`} />
          </ResultShell>

          <p class="ar-live-note" data-live-note hidden>Changes update automatically.</p>
        </div>
      </section>
    ))
  }
</div>

<style>
  .arpage {
    display: grid;
    gap: 1.75rem;
    width: 100%;
  }
  /* Two cards abreast, but only once there is room for both without squeezing the fields.
     Seven shapes one-per-row is a long scroll for no gain, now that each card carries its own
     answer and needs no partner column. */
  @media (min-width: 60rem) {
    .arpage {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }

  .ar-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
  }
  .ar-diagram {
    flex: none;
    width: 3rem;
    height: 2rem;
    fill: none;
    stroke: var(--muted);
    stroke-width: 5;
    stroke-linejoin: round;
    opacity: 0.7;
  }
  .ar-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--heading);
  }
  .ar-lede {
    margin: 0.1rem 0 0;
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .ar-card {
    padding: 1rem;
  }

  .ar-field + .ar-field {
    margin-top: 0.4rem;
  }
  /* Label, then the number and its unit together on one row — the reference's anatomy. */
  .ar-row {
    display: grid;
    grid-template-columns: minmax(0, 9.5rem) minmax(0, 1fr);
    align-items: center;
    gap: 0.5rem;
  }
  .ar-row__label {
    margin: 0;
  }
  .ar-row__control {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
  }
  .ar-num {
    flex: 1 1 0;
    min-width: 0;
    min-height: 2.75rem;
    font-variant-numeric: tabular-nums;
  }
  .ar-unit {
    flex: 0 1 auto;
    width: auto;
    min-width: 0;
    min-height: 2.75rem;
    font-size: 0.86rem;
  }

  @media (max-width: 30rem) {
    .ar-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.2rem;
    }
  }

  .ar-field-error {
    margin: 0.3rem 0 0;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.3;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .ar-field-error { color: #fca5a5; }
  }
  :root[data-theme='dark'] .ar-field-error { color: #fca5a5; }

  .ar-note {
    margin: 0.75rem 0 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .ar-live-note {
    margin-top: 0.7rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* The result sits inside the same card, under the form, separated by a rule rather than a box. */
  /* ResultShell owns this element, so the rule that separates the answer from the form has to
     be reached with :global() beneath the section this template does own. */
  .ar-calc :global(.ar-result) {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  /* The working: an equals column so every line lines up under the one above it.
     These rows are BUILT IN JS, so Astro's scoping never reaches them — they have to be matched
     with :global() beneath a container the template does own. */
  .ar-steps {
    display: grid;
    gap: 0.1rem;
    margin-bottom: 0.2rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--fg);
  }
  .ar-steps :global(.ar-step) {
    display: grid;
    grid-template-columns: minmax(0, auto) auto minmax(0, 1fr);
    align-items: baseline;
  }
  .ar-steps :global(.ar-step__label) {
    justify-self: end;
    font-weight: 600;
    color: var(--muted);
    white-space: nowrap;
  }
  .ar-steps :global(.ar-step__eq) {
    color: var(--muted);
    white-space: pre;
  }
  .ar-steps :global(.ar-step__expr) {
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .ar-steps :global(.ar-step__unit) {
    font-weight: 600;
    color: var(--muted);
  }
  /* The answer is the working's last line, so it carries the weight rather than a second figure. */
  .ar-steps :global(.ar-step--final) {
    margin-top: 0.35rem;
    padding-top: 0.35rem;
    border-top: 1px dashed var(--line);
    font-size: 1.35rem;
    line-height: 1.3;
  }
  .ar-steps :global(.ar-step--final .ar-step__expr) {
    font-weight: 800;
    color: var(--heading);
  }
  .ar-steps :global(.ar-step--final .ar-step__unit) {
    font-size: 0.95rem;
    font-weight: 700;
  }

  .ar-mixed {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--muted);
  }

  /* The reference offers the other units behind a link rather than spending card height on them. */
  .ar-others-box {
    margin-top: 0.7rem;
  }
  .ar-others-toggle {
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-brand-700);
    text-decoration: underline;
    text-underline-offset: 2px;
    padding: 0.3rem 0;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
  }
  :root[data-theme='dark'] .ar-others-toggle { color: var(--color-brand-200); }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .ar-others-toggle { color: var(--color-brand-200); }
  }

  .ar-others {
    margin: 0;
    display: grid;
    gap: 0.2rem;
  }
  .ar-others > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.25rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.88rem;
  }
  .ar-others dt {
    color: var(--fg);
    font-weight: 600;
  }
  .ar-others dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--heading);
    font-weight: 700;
    text-align: right;
    overflow-wrap: anywhere;
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { AREA_SHAPES, makeAreaBinding, areaExampleValues } from '@lib/calculators/area-form';

  function uniquifyStaticIds(root: HTMLElement, suffix: string): void {
    const remap = new Map<string, string>();
    root.querySelectorAll<HTMLElement>('[id]').forEach((el) => {
      const next = `${el.id}-${suffix}`;
      remap.set(el.id, next);
      el.id = next;
    });
    const repoint = (attr: string) =>
      root.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((el) => {
        const next = el
          .getAttribute(attr)!
          .split(/\s+/)
          .map((token) => remap.get(token) ?? token)
          .join(' ');
        el.setAttribute(attr, next);
      });
    repoint('for');
    repoint('aria-describedby');
    repoint('aria-labelledby');
    repoint('aria-controls');
  }

  const pages = document.querySelectorAll<HTMLElement>('[data-arpage]');
  pages.forEach((page, i) => {
    if (pages.length > 1) uniquifyStaticIds(page, `a${i + 1}`);

    for (const spec of AREA_SHAPES) {
      const section = page.querySelector<HTMLElement>(`[data-ar-shape="${spec.key}"]`);
      if (!section) continue;
      mountFormCalculator(section, makeAreaBinding(spec), {
        recalculationMode: 'live-after-first',
        example: { values: areaExampleValues(spec) },
        calculateButtonLabel: `Calculate ${spec.title}`,
      });
    }
  });
</script>
