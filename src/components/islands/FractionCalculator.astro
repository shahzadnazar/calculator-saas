---
import { computeFraction } from '@lib/calculators/fraction';
import { formatNumber } from '@lib/format';

const r = computeFraction({ num: 1, den: 2 }, 'add', { num: 1, den: 3 });
---

<div class="mx-auto w-full max-w-3xl" data-fraction>
  <form class="card p-5 sm:p-6" data-fr-form novalidate>
    <div class="flex flex-wrap items-center justify-center gap-4">
      <div class="flex flex-col items-center">
        <input class="field w-20 text-center" name="an" type="number" value="1" aria-label="first numerator" inputmode="numeric" />
        <div class="my-1 h-px w-16" style="background: var(--fg)"></div>
        <input class="field w-20 text-center" name="ad" type="number" value="2" aria-label="first denominator" inputmode="numeric" />
      </div>

      <select class="field w-16 text-center text-xl" name="op" aria-label="operation">
        <option value="add">+</option>
        <option value="subtract">−</option>
        <option value="multiply">×</option>
        <option value="divide">÷</option>
      </select>

      <div class="flex flex-col items-center">
        <input class="field w-20 text-center" name="bn" type="number" value="1" aria-label="second numerator" inputmode="numeric" />
        <div class="my-1 h-px w-16" style="background: var(--fg)"></div>
        <input class="field w-20 text-center" name="bd" type="number" value="3" aria-label="second denominator" inputmode="numeric" />
      </div>

      <span class="text-2xl font-bold">=</span>

      <div class="text-center">
        <p class="text-3xl result-value" style="color: var(--color-brand-700)" data-fr-result>{r.fraction.num}/{r.fraction.den}</p>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-2 gap-3 text-center text-sm">
      <div class="rounded-lg p-3" style="background: var(--subtle)"><p style="color: var(--muted)">Mixed number</p><p class="mt-1 text-lg font-bold" data-fr-mixed>{r.mixed}</p></div>
      <div class="rounded-lg p-3" style="background: var(--subtle)"><p style="color: var(--muted)">Decimal</p><p class="mt-1 text-lg font-bold" data-fr-decimal>{formatNumber(r.decimal, 4)}</p></div>
    </div>
  </form>
</div>

<script>
  import { computeFraction, type FractionOp } from '@lib/calculators/fraction';
  import { formatNumber } from '@lib/format';
  document.querySelectorAll<HTMLElement>('[data-fraction]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-fr-form]')!;
    const num = (n: string) => Number((form.elements.namedItem(n) as HTMLInputElement)?.value);
    const set = (sel: string, v: string) => { const el = root.querySelector<HTMLElement>(sel); if (el) el.textContent = v; };
    function recompute() {
      const op = (form.elements.namedItem('op') as HTMLSelectElement).value as FractionOp;
      const r = computeFraction({ num: num('an'), den: num('ad') }, op, { num: num('bn'), den: num('bd') });
      if (Number.isNaN(r.fraction.num)) {
        set('[data-fr-result]', '—'); set('[data-fr-mixed]', '—'); set('[data-fr-decimal]', '—');
        return;
      }
      set('[data-fr-result]', `${r.fraction.num}/${r.fraction.den}`);
      set('[data-fr-mixed]', r.mixed);
      set('[data-fr-decimal]', formatNumber(r.decimal, 4));
    }
    form.addEventListener('input', recompute);
    recompute();
  });
</script>
