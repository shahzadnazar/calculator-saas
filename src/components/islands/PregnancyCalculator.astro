---
/**
 * Pregnancy island — the reference's five dating methods, on the UNCHANGED standard-form
 * runtime.
 *
 * The visitor says how they are dating the pregnancy and only that method's fields appear;
 * the fields a method does not use leave the form and are emptied, so a date entered under
 * one route can never reach a result computed under another. Five routes rather than the
 * due-date calculator's four, because this one can take the due date ITSELF — someone
 * already carrying a date from their provider wants the schedule that goes with it.
 *
 * The dominant result is the CURRENT gestational age while the pregnancy is ongoing (how far
 * along — the calculator's purpose); once the estimated due date has passed it becomes the
 * due date, with a neutral note and no unbounded progress. Below it, the whole pregnancy as
 * a dated schedule with the visitor's own row slotted into it.
 *
 * The medical disclaimer lives INSIDE this island, so the generated embed carries it too —
 * exactly one instance, visible without interaction, outside the result live region.
 */
import { PREGNANCY_DATING_METHODS, EMBRYO_AGES, CYCLE_MIN, CYCLE_MAX, REFERENCE_CYCLE_DAYS } from '@lib/calculators/pregnancy-form';
import { milestones } from '@lib/calculators/due-date';
import ResultShell from '@components/result/ResultShell.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';

/** Row labels are static; only the dates and ages change at runtime. */
const SCHEDULE_ROWS = milestones(new Date(0)).map((m) => ({ key: m.key, label: m.label }));

/** How much each route can be trusted — said out loud rather than implied. */
const METHOD_NOTES: Record<string, string> = {
  due: 'Uses the date you were given, and works the whole schedule backwards from it.',
  lmp: 'Naegele’s rule: 280 days after the first day of your last period. Reliable when your cycles are regular.',
  ultrasound: 'The most reliable route early on, because the scan measures the pregnancy rather than estimating it.',
  conception: 'Counts 266 days from conception — the same rule, started two weeks later.',
  ivf: 'The most precise of the five: the embryo’s age on transfer day is known exactly, not estimated.',
};
---

<div class="pregnancy mx-auto w-full max-w-4xl" data-pregnancy>
  <!-- The result carries the dominant figure and a 3-column schedule, so it gets the wider
       half; the form's fields are narrow and have slack to give. -->
  <div class="grid gap-6 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] md:items-start">
    <!-- Input -->
    <form class="card p-4" data-form novalidate aria-label="Pregnancy calculator">
      <fieldset class="pg-methods" data-field="method">
        <legend class="field-label pg-methods__legend">Calculate based on</legend>
        <div class="pg-radios">
          {PREGNANCY_DATING_METHODS.map((m, i) => (
            <label class="pg-radio"><input type="radio" name="method" value={m.value} checked={i === 0} /><span>{m.label}</span></label>
          ))}
        </div>
      </fieldset>

      <!-- Due Date -->
      <div data-method-group="due">
        <div class="pg-row" data-field="dueDate">
          <label class="field-label pg-row__label" for="pg-due-date">Your estimated due date</label>
          <input class="field pg-date" id="pg-due-date" name="dueDate" type="date" autocomplete="off" aria-describedby="pg-dueDate-error" />
        </div>
        <p class="pg-field-error" id="pg-dueDate-error" data-error-for="dueDate" hidden></p>
      </div>

      <!-- Last Period -->
      <div data-method-group="lmp" hidden>
        <div class="pg-row" data-field="lmp">
          <label class="field-label pg-row__label" for="pg-lmp">First day of your last period</label>
          <input class="field pg-date" id="pg-lmp" name="lmp" type="date" autocomplete="off" aria-describedby="pg-lmp-error" />
        </div>
        <p class="pg-field-error" id="pg-lmp-error" data-error-for="lmp" hidden></p>

        <div class="pg-row" data-field="cycleDays">
          <label class="field-label pg-row__label" for="pg-cycle">Average length of your cycles</label>
          <div class="pg-inputs">
            <input class="field pg-num" id="pg-cycle" name="cycleDays" type="number" min={CYCLE_MIN} max={CYCLE_MAX} step="1" inputmode="numeric" autocomplete="off" placeholder={String(REFERENCE_CYCLE_DAYS)} aria-describedby="pg-cycleDays-error" />
            <span class="pg-unit">days (optional)</span>
          </div>
        </div>
        <p class="pg-field-error" id="pg-cycleDays-error" data-error-for="cycleDays" hidden></p>
      </div>

      <!-- Ultrasound -->
      <div data-method-group="ultrasound" hidden>
        <div class="pg-row" data-field="scanDate">
          <label class="field-label pg-row__label" for="pg-scan">Date of the ultrasound</label>
          <input class="field pg-date" id="pg-scan" name="scanDate" type="date" autocomplete="off" aria-describedby="pg-scanDate-error" />
        </div>
        <p class="pg-field-error" id="pg-scanDate-error" data-error-for="scanDate" hidden></p>

        <div class="pg-row" data-field="scanAge">
          <label class="field-label pg-row__label" for="pg-scan-weeks">Length of pregnancy at that time</label>
          <div class="pg-inputs">
            <input class="field pg-num" id="pg-scan-weeks" name="scanWeeks" type="number" min="0" max="42" step="1" inputmode="numeric" autocomplete="off" placeholder="12" aria-label="Scan weeks" aria-describedby="pg-scanAge-error" />
            <span class="pg-unit">weeks</span>
            <input class="field pg-num" name="scanDays" type="number" min="0" max="6" step="1" inputmode="numeric" autocomplete="off" placeholder="3" aria-label="Scan days" aria-describedby="pg-scanAge-error" />
            <span class="pg-unit">days</span>
          </div>
        </div>
        <p class="pg-field-error" id="pg-scanAge-error" data-error-for="scanAge" hidden></p>
      </div>

      <!-- Conception Date -->
      <div data-method-group="conception" hidden>
        <div class="pg-row" data-field="conception">
          <label class="field-label pg-row__label" for="pg-conception">Conception date</label>
          <input class="field pg-date" id="pg-conception" name="conception" type="date" autocomplete="off" aria-describedby="pg-conception-error" />
        </div>
        <p class="pg-field-error" id="pg-conception-error" data-error-for="conception" hidden></p>
      </div>

      <!-- IVF Transfer Date -->
      <div data-method-group="ivf" hidden>
        <div class="pg-row" data-field="transferDate">
          <label class="field-label pg-row__label" for="pg-transfer">IVF transfer date</label>
          <input class="field pg-date" id="pg-transfer" name="transferDate" type="date" autocomplete="off" aria-describedby="pg-transferDate-error" />
        </div>
        <p class="pg-field-error" id="pg-transferDate-error" data-error-for="transferDate" hidden></p>

        <div class="pg-row" data-field="embryoAge">
          <label class="field-label pg-row__label" for="pg-embryo">Embryo age at transfer</label>
          <select class="field pg-select" id="pg-embryo" name="embryoAge">
            {EMBRYO_AGES.map((e) => (
              <option value={e.value} selected={e.value === 5}>{e.label}</option>
            ))}
          </select>
        </div>
      </div>

      <p class="pg-help" data-pg-method-note>{METHOD_NOTES.due}</p>

      <div class="mt-5 flex items-center gap-3">
        <button type="submit" class="btn btn-primary" data-pg-submit>Calculate Pregnancy Progress</button>
        <button type="button" class="btn btn-secondary" data-reset>Reset</button>
      </div>
      <p class="pg-live-note" data-live-note hidden>Changes update automatically.</p>
    </form>

    <!-- Result -->
    <ResultShell
      id="pg-result"
      state="empty"
      density="standard"
      label="Pregnancy progress result"
      minHeight="18rem"
      placeholderAlignment="center"
    >
    <ExampleNotice />
      <EmptyResult message="Choose how you are dating the pregnancy, fill in that method's dates, and calculate." />

      <div data-result-when="valid">
        <!-- Dominant: current gestational age (ongoing) / estimated due date (past-due) -->
        <div class="text-center">
          <p class="result-label" data-pg-headline-label>Pregnancy progress</p>
          <p class="pg-headline" data-pg-headline data-result-value>—</p>
        </div>

        <!-- Prominent secondary: current trimester + estimated due date (hidden past-due) -->
        <div class="pg-secondary mt-5" data-pg-secondary>
          <div><p class="pg-stat" data-pg-trimester>—</p><p class="pg-sub">trimester</p></div>
          <div><p class="pg-stat" data-pg-due-secondary>—</p><p class="pg-sub">estimated due date</p></div>
        </div>

        <!-- Progress toward the due date (hidden past-due); time-remaining is supporting -->
        <div class="pg-progress mt-5" data-pg-progress>
          <div class="pg-track" role="presentation">
            <span class="pg-bar" data-pg-bar style="width: 0%"></span>
          </div>
          <p class="pg-remaining" data-pg-remaining></p>
        </div>

        <!-- Supporting: the whole pregnancy as a dated schedule, with the visitor's own row -->
        <table class="pg-schedule">
          <caption class="pg-schedule__caption">Your pregnancy schedule</caption>
          <thead>
            <tr><th scope="col">Milestone</th><th scope="col">Date</th><th scope="col" class="pg-numeric">Gestational age</th></tr>
          </thead>
          <tbody>
            {SCHEDULE_ROWS.map((row) => (
              <tr data-pg-row={row.key}>
                <th scope="row">{row.label}</th>
                <td data-pg-row-date>—</td>
                <td class="pg-numeric" data-pg-row-age>—</td>
              </tr>
            ))}
            <tr class="pg-schedule__today" data-pg-row="today" hidden>
              <th scope="row">Today</th>
              <td data-pg-row-date>—</td>
              <td class="pg-numeric" data-pg-row-age>—</td>
            </tr>
          </tbody>
        </table>

        <p class="pg-interpretation" data-pg-interpretation></p>
      </div>

      <InvalidResult title="Check the dates" message="Fill in the dates the method you chose asks for." />

      <ResultAnnouncement id="pg-live" />
    </ResultShell>
  </div>

  <p class="pg-disclaimer" data-pg-disclaimer>
    This is general information, not medical advice. Your healthcare provider's dating takes precedence.
  </p>
</div>

<style>
  .pg-methods {
    border: 0;
    margin: 0 0 0.4rem;
    padding: 0;
  }
  .pg-methods__legend {
    display: block;
    margin: 0 0 0.1rem;
    padding: 0;
    font-size: 0.86rem;
  }
  /* A tidy grid at the workspace's column width instead of a ragged final row. */
  .pg-radios {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 0.1rem 0.9rem;
  }
  .pg-radio {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    font-size: 0.86rem;
    color: var(--fg);
    cursor: pointer;
  }
  .pg-radio input {
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
    accent-color: var(--color-brand-600);
  }

  .pg-row {
    padding: 0.3rem 0;
  }
  .pg-row__label {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.86rem;
  }
  .pg-date {
    width: 100%;
    min-height: 2.75rem;
  }
  .pg-select {
    min-height: 2.75rem;
    font-size: 0.86rem;
  }
  .pg-inputs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .pg-num {
    width: 4.5rem;
    min-height: 2.75rem;
    font-variant-numeric: tabular-nums;
  }
  .pg-unit {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .pg-field-error {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .pg-field-error { color: #fca5a5; }
  }
  :root[data-theme='dark'] .pg-field-error { color: #fca5a5; }

  .pg-help { margin-top: 0.75rem; font-size: 0.8rem; line-height: 1.45; color: var(--muted); }
  .pg-live-note { margin-top: 0.75rem; font-size: 0.8rem; color: var(--muted); }

  .pg-headline { margin-top: 0.25rem; font-size: 1.75rem; line-height: 1.15; font-weight: 800; color: var(--heading); }
  @media (min-width: 640px) { .pg-headline { font-size: 2rem; } }
  /* Past due, the dominant slot holds a full weekday date instead of a short duration. The
     longest is "Wednesday, September 30, 2027"; scale it to the column rather than let it
     orphan the year, and balance the wrap on the narrow viewports where it still breaks. */
  .pg-headline[data-kind='date'] {
    font-size: clamp(1.1875rem, 1.6vw + 0.5rem, 1.625rem);
    line-height: 1.2;
    text-wrap: balance;
  }
  @media (min-width: 640px) { .pg-headline[data-kind='date'] { font-size: clamp(1.1875rem, 1.6vw + 0.5rem, 1.625rem); } }

  .pg-secondary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    border-top: 1px solid var(--line);
    padding-top: 1rem;
    text-align: center;
  }
  .pg-stat { font-size: 1.25rem; font-weight: 700; line-height: 1.2; color: var(--heading); }
  @media (min-width: 640px) { .pg-stat { font-size: 1.5rem; } }
  .pg-sub { margin-top: 0.15rem; font-size: 0.75rem; color: var(--muted); }
  .pg-remaining { margin-top: 0.5rem; font-size: 0.8rem; text-align: center; color: var(--muted); }

  .pg-track {
    height: 0.75rem;
    width: 100%;
    overflow: hidden;
    border-radius: 9999px;
    background: var(--subtle);
  }
  .pg-bar {
    display: block;
    height: 100%;
    border-radius: 9999px;
    background: var(--color-brand-600);
    transition: width 0.3s ease;
  }
  @media (prefers-reduced-motion: reduce) { .pg-bar { transition: none; } }

  .pg-schedule {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1.25rem;
    font-size: 0.82rem;
  }
  .pg-schedule__caption {
    caption-side: top;
    text-align: left;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    padding-bottom: 0.35rem;
  }
  .pg-schedule th,
  .pg-schedule td {
    padding: 0.3rem 0.6rem 0.3rem 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }
  .pg-schedule th:last-child,
  .pg-schedule td:last-child {
    padding-right: 0;
  }
  .pg-schedule thead th {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    font-weight: 700;
  }
  .pg-schedule tbody th {
    font-weight: 500;
    color: var(--fg);
  }
  .pg-schedule tbody td {
    font-weight: 600;
    color: var(--heading);
    white-space: nowrap;
  }
  /* nowrap belongs to the values, not the header: "Gestational age" would otherwise hold
     the column open and fold every date onto two lines on a phone. */
  .pg-numeric {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  /* The visitor's own row. Marked by weight and a rule as well as colour, never by colour
     alone, and the row header carries the word "Today" so it never depends on styling. */
  .pg-schedule__today th,
  .pg-schedule__today td {
    background: var(--subtle);
    color: var(--color-brand-700);
    font-weight: 700;
    border-top: 2px solid var(--color-brand-600);
    border-bottom-color: var(--color-brand-600);
  }
  :root[data-theme='dark'] .pg-schedule__today th,
  :root[data-theme='dark'] .pg-schedule__today td {
    color: var(--color-brand-200);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .pg-schedule__today th,
    :root:not([data-theme='light']) .pg-schedule__today td {
      color: var(--color-brand-200);
    }
  }

  .pg-interpretation { margin: 0.9rem 0 0; font-size: 0.95rem; line-height: 1.5; color: var(--fg); }

  .pg-disclaimer {
    margin-top: 1.25rem;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--muted);
    text-align: center;
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { pregnancyBinding, pregnancyExampleValues, todayISO } from '@lib/calculators/pregnancy-form';

  const METHOD_NOTES: Record<string, string> = {
    due: 'Uses the date you were given, and works the whole schedule backwards from it.',
    lmp: 'Naegele’s rule: 280 days after the first day of your last period. Reliable when your cycles are regular.',
    ultrasound: 'The most reliable route early on, because the scan measures the pregnancy rather than estimating it.',
    conception: 'Counts 266 days from conception — the same rule, started two weeks later.',
    ivf: 'The most precise of the five: the embryo’s age on transfer day is known exactly, not estimated.',
  };

  document.querySelectorAll<HTMLElement>('[data-pregnancy]').forEach((root) => {
    mountFormCalculator(root, pregnancyBinding, {
      recalculationMode: 'live-after-first',
      example: { values: pregnancyExampleValues() },
      calculateButtonLabel: 'Calculate Pregnancy Progress',
    });

    /**
     * Every date here except the due date is one that has already happened, so cap those
     * pickers at the visitor's own today. The due date is the exception — it is normally
     * ahead of them — so it is capped at the furthest one a pregnancy could have, 280 days
     * out, which is the same as saying the last period cannot be in the future. The binding
     * validates all of this independently; this only saves the round trip.
     */
    const today = todayISO();
    const furthestDue = new Date(Date.parse(`${today}T00:00:00Z`) + 280 * 86_400_000)
      .toISOString()
      .slice(0, 10);
    root.querySelectorAll<HTMLInputElement>('input[type="date"]').forEach((el) => {
      el.max = el.name === 'dueDate' ? furthestDue : today;
    });

    /**
     * Only the chosen method's fields are on screen, and the ones that leave are emptied —
     * a date the visitor typed under one method must never reach a result computed under
     * another.
     */
    const note = root.querySelector<HTMLElement>('[data-pg-method-note]');
    const syncMethod = () => {
      const method = root.querySelector<HTMLInputElement>('[name="method"]:checked')?.value ?? 'due';
      root.querySelectorAll<HTMLElement>('[data-method-group]').forEach((group) => {
        const wanted = group.dataset.methodGroup === method;
        group.hidden = !wanted;
        if (wanted) return;
        group.querySelectorAll<HTMLInputElement>('input').forEach((el) => {
          el.value = '';
        });
        group.querySelectorAll<HTMLElement>('[data-field]').forEach((row) => {
          const err = root.querySelector<HTMLElement>(`[data-error-for="${row.dataset.field}"]`);
          if (err) err.hidden = true;
        });
      });
      if (note) note.textContent = METHOD_NOTES[method] ?? '';
    };
    root.querySelectorAll<HTMLInputElement>('[name="method"]').forEach((r) =>
      r.addEventListener('change', syncMethod),
    );
    syncMethod();

    // Reset restores the radio silently, so re-derive which fields are on screen.
    root.addEventListener('calculator:reset', syncMethod);

    /**
     * Clear the stale result whenever the shell leaves the valid state (an invalid live
     * edit, or Reset), so no stale progress or schedule lingers behind the hidden valid
     * region. Presentation only — the runtime still owns state, focus and announcement.
     */
    const shell = root.querySelector<HTMLElement>('[data-result-shell]');
    if (shell) {
      const clear = () => {
        root
          .querySelectorAll<HTMLElement>(
            '[data-pg-headline], [data-pg-trimester], [data-pg-due-secondary], [data-pg-row-date], [data-pg-row-age]',
          )
          .forEach((el) => {
            el.textContent = '—';
          });
        ['[data-pg-remaining]', '[data-pg-interpretation]'].forEach((sel) => {
          const el = root.querySelector<HTMLElement>(sel);
          if (el) el.textContent = '';
        });
        const label = root.querySelector<HTMLElement>('[data-pg-headline-label]');
        if (label) label.textContent = 'Pregnancy progress';
        const headline = root.querySelector<HTMLElement>('[data-pg-headline]');
        if (headline) headline.dataset.kind = 'progress';
        const bar = root.querySelector<HTMLElement>('[data-pg-bar]');
        if (bar) bar.style.width = '0%';
        ['[data-pg-secondary]', '[data-pg-progress]'].forEach((sel) => {
          const el = root.querySelector<HTMLElement>(sel);
          if (el) el.hidden = false;
        });
        const todayRow = root.querySelector<HTMLElement>('[data-pg-row="today"]');
        if (todayRow) todayRow.hidden = true;
      };
      new MutationObserver(() => {
        if (shell.dataset.resultState !== 'valid') clear();
      }).observe(shell, { attributes: true, attributeFilter: ['data-result-state'] });
    }
  });
</script>
