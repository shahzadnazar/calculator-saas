---
/**
 * Interest calculator island (R20A1 — task-first; finance; standard-form runtime UNCHANGED).
 *
 * A single form on the UNCHANGED standard-form runtime + the Interest binding
 * (@lib/calculators/interest-form), which is the Interest-specific COMPOSITION layer over two FROZEN
 * engines — calculateSimpleInterest + calculateCompoundInterest. The SAME principal / rate / years
 * feed both; only the compound side receives the compounding frequency; the "compounding advantage"
 * is compound.totalInterest − simple.interest. Task-first: every input starts EMPTY, the frequency
 * defaults to Monthly, the result is empty on the server AND after hydration (the legacy island
 * SSR-seeded a $10,000 / 5% / 10y result and recomputed live on every keystroke), and the visitor
 * presses "Calculate" for the first result (live-after-first).
 *
 * The DOMINANT result is the COMPOUND interest earned (+ the final balance); simple interest earned,
 * simple final balance and the compounding advantage are supporting — ALL from the single composed
 * result (no duplicated calculation; no legacy innerHTML math). NO isUsableResult — the complete-result
 * guard lives in the binding's resultValue (a finite compound-interest sentinel; a valid $0 is the
 * finite 0 the default gate accepts). No runtime change; neither engine is touched, so Compound
 * Interest / Investment / Savings / Retirement and the reference tables stay byte-identical.
 *
 * Static ids are namespaced per-instance WHEN more than one Interest calculator shares a document
 * (the R16B2.1 discipline), so an embed gallery has no duplicate ids.
 */
import { COMPOUND_FREQUENCIES, DEFAULT_FREQUENCY } from '@lib/calculators/interest-form';
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import ResultBreakdown from '@components/result/ResultBreakdown.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
---

<div class="intcalc mx-auto grid w-full max-w-4xl gap-6 md:grid-cols-2 md:items-start" data-interest>
  <!-- Inputs -->
  <form class="card p-4" data-form novalidate aria-label="Interest calculator">
    <div class="space-y-4">
      <div data-field="principal">
        <label class="field-label" for="int-principal">Principal</label>
        <div class="mt-1 flex">
          <span class="field-affix rounded-l-lg border-r-0">$</span>
          <input class="field rounded-l-none" id="int-principal" name="principal" type="number" min="0" step="500" inputmode="decimal" autocomplete="off" placeholder="e.g. 10000" aria-describedby="int-principal-error" />
        </div>
        <p class="int-error" id="int-principal-error" data-error-for="principal" hidden></p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div data-field="annualRatePct">
          <label class="field-label" for="int-rate">Annual rate</label>
          <div class="mt-1 flex">
            <input class="field rounded-r-none" id="int-rate" name="annualRatePct" type="number" min="0" step="0.1" inputmode="decimal" autocomplete="off" placeholder="e.g. 5" aria-describedby="int-rate-error" />
            <span class="field-affix rounded-r-lg border-l-0">%</span>
          </div>
          <p class="int-error" id="int-rate-error" data-error-for="annualRatePct" hidden></p>
        </div>
        <div data-field="years">
          <label class="field-label" for="int-years">Years</label>
          <input class="field mt-1" id="int-years" name="years" type="number" min="0" step="1" inputmode="decimal" autocomplete="off" placeholder="e.g. 10" aria-describedby="int-years-error" />
          <p class="int-error" id="int-years-error" data-error-for="years" hidden></p>
        </div>
      </div>

      <div data-field="compoundsPerYear">
        <label class="field-label" for="int-freq">Compounding</label>
        <select class="field mt-1" id="int-freq" name="compoundsPerYear" aria-label="Compounding frequency">
          {COMPOUND_FREQUENCIES.map((f) => <option value={f.value} selected={f.value === DEFAULT_FREQUENCY}>{f.label}</option>)}
        </select>
      </div>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <button type="submit" class="btn btn-primary">Calculate</button>
      <button type="button" class="btn btn-secondary" data-reset>Reset</button>
    </div>
    <p class="int-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result -->
  <ResultShell id="interest-result" state="empty" density="standard" label="Interest result" minHeight="18rem" placeholderAlignment="center">
    <EmptyResult message="Enter a principal, rate and time, then calculate to compare simple and compound interest." />

    <div data-result-when="valid">
      <ResultSummary label="Compound interest earned">
        <ResultValue value="—" size="text-4xl" />
      </ResultSummary>
      <p class="int-final">Final balance <strong data-int-final>—</strong></p>

      <ResultBreakdown title="Simple vs. compound">
        <dl class="int-metrics">
          <div><dt>Simple interest earned</dt><dd data-int-simple>—</dd></div>
          <div><dt>Simple final balance</dt><dd data-int-simple-final>—</dd></div>
          <div class="int-advantage-row"><dt>Compounding advantage</dt><dd data-int-advantage>—</dd></div>
        </dl>
      </ResultBreakdown>

      <p class="int-note">The compounding advantage is the extra earned purely because interest earns interest. Gross figures, before tax.</p>
    </div>

    <InvalidResult
      title="Check your entries"
      message="Enter a principal, rate and number of years of zero or more."
    />

    <ResultAnnouncement id="interest-live" />
  </ResultShell>
</div>

<style>
  .int-error {
    margin: 0.3rem 0 0;
    font-size: 0.78rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .int-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .int-error {
    color: #fca5a5;
  }

  .int-live-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .int-final {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .int-final strong {
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  .int-metrics {
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }
  .int-metrics > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .int-metrics dt {
    color: var(--fg);
    font-weight: 600;
  }
  .int-metrics dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--heading);
    font-weight: 700;
    white-space: nowrap;
  }
  .int-metrics .int-advantage-row {
    border-bottom: none;
  }
  .int-metrics .int-advantage-row dd {
    color: var(--color-brand-700);
  }
  .int-note {
    margin: 0.9rem 0 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--muted);
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { interestBinding } from '@lib/calculators/interest-form';

  let ns = 0; // module-global → static-id namespace suffix, one per multi-instance root

  // When more than one Interest calculator shares a document (e.g. an embed gallery), the server-static
  // ids (the three inputs, the frequency select, the error slots, the result shell, the live region)
  // collide. Namespace THIS root's ids and repoint its in-root references so associations stay
  // instance-local; a lone instance is left untouched. The runtime targets fields by [name] / [data-*].
  function uniquifyStaticIds(root: HTMLElement, suffix: string): void {
    const remap = new Map<string, string>();
    root.querySelectorAll<HTMLElement>('[id]').forEach((el) => {
      const next = `${el.id}-${suffix}`;
      remap.set(el.id, next);
      el.id = next;
    });
    const repoint = (attr: string) =>
      root.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((el) => {
        const next = el
          .getAttribute(attr)!
          .split(/\s+/)
          .map((token) => remap.get(token) ?? token)
          .join(' ');
        el.setAttribute(attr, next);
      });
    repoint('for');
    repoint('aria-describedby');
    repoint('aria-labelledby');
    repoint('aria-controls');
  }

  document.querySelectorAll<HTMLElement>('[data-interest]').forEach((root) => {
    if (document.querySelectorAll('[data-interest]').length > 1) uniquifyStaticIds(root, `i${++ns}`);

    mountFormCalculator(root, interestBinding, {
      recalculationMode: 'live-after-first',
      calculateButtonLabel: 'Calculate',
    });

    // Clear the stale figures whenever the shell leaves the valid state (an invalid live edit, or
    // Reset), so no stale figure lingers behind the hidden valid region. Presentation only.
    const shell = root.querySelector<HTMLElement>('[data-result-shell]');
    if (shell) {
      const clear = () => {
        ['[data-int-final]', '[data-int-simple]', '[data-int-simple-final]', '[data-int-advantage]'].forEach((sel) => {
          const el = root.querySelector<HTMLElement>(sel);
          if (el) el.textContent = '—';
        });
        root.querySelectorAll<HTMLElement>('[data-result-when~="valid"] [data-result-value], [data-result-when~="valid"] [data-result-value-a11y]').forEach((el) => {
          el.textContent = '—';
        });
      };
      new MutationObserver(() => {
        if (shell.dataset.resultState !== 'valid') clear();
      }).observe(shell, { attributes: true, attributeFilter: ['data-result-state'] });
    }
  });
</script>
