---
import { calculateSimpleInterest } from '@lib/calculators/simple-interest';
import { calculateCompoundInterest } from '@lib/calculators/compound-interest';
import { formatCurrency } from '@lib/format';

const d = { principal: 10000, annualRatePct: 5, years: 10, compoundsPerYear: 12 };
const simple = calculateSimpleInterest({ principal: d.principal, annualRatePct: d.annualRatePct, years: d.years });
const compound = calculateCompoundInterest({ principal: d.principal, annualRatePct: d.annualRatePct, years: d.years, compoundsPerYear: d.compoundsPerYear });
---

<div class="mx-auto grid w-full max-w-4xl gap-6 md:grid-cols-2" data-interest>
  <form class="card p-5 sm:p-6" data-int-form novalidate>
    <div class="space-y-4">
      <div>
        <label class="field-label" for="int-principal">Principal</label>
        <div class="flex"><span class="field-affix rounded-l-lg border-r-0">$</span><input class="field rounded-l-none" id="int-principal" name="principal" type="number" min="0" step="500" value={d.principal} inputmode="decimal" /></div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="field-label" for="int-rate">Annual rate</label>
          <div class="flex"><input class="field rounded-r-none" id="int-rate" name="annualRatePct" type="number" min="0" step="0.1" value={d.annualRatePct} inputmode="decimal" /><span class="field-affix rounded-r-lg border-l-0">%</span></div>
        </div>
        <div>
          <label class="field-label" for="int-years">Years</label>
          <input class="field" id="int-years" name="years" type="number" min="0" step="1" value={d.years} inputmode="decimal" />
        </div>
      </div>
      <div>
        <label class="field-label" for="int-freq">Compounding</label>
        <select class="field" id="int-freq" name="compoundsPerYear">
          {[{v:1,l:'Annually'},{v:4,l:'Quarterly'},{v:12,l:'Monthly'},{v:365,l:'Daily'}].map((f) => (<option value={f.v} selected={f.v===d.compoundsPerYear}>{f.l}</option>))}
        </select>
      </div>
    </div>
  </form>

  <div class="card p-5 sm:p-6">
    <div class="rounded-lg p-4" style="background: var(--subtle)">
      <p class="text-sm" style="color: var(--muted)">Compound interest earned</p>
      <p class="text-3xl result-value" style="color: var(--color-accent-600)" data-int-compound>{formatCurrency(compound.totalInterest)}</p>
      <p class="text-sm" style="color: var(--muted)">Final balance <strong data-int-compound-total style="color: var(--fg)">{formatCurrency(compound.futureValue)}</strong></p>
    </div>
    <dl class="mt-4 space-y-2 text-sm">
      <div class="flex justify-between"><dt style="color: var(--muted)">Simple interest earned</dt><dd class="font-semibold" data-int-simple>{formatCurrency(simple.interest)}</dd></div>
      <div class="flex justify-between"><dt style="color: var(--muted)">Simple final balance</dt><dd class="font-semibold" data-int-simple-total>{formatCurrency(simple.total)}</dd></div>
      <div class="flex justify-between border-t pt-2" style="border-color: var(--line)"><dt class="font-semibold">Compounding advantage</dt><dd class="font-bold" style="color: var(--color-brand-700)" data-int-diff>{formatCurrency(compound.totalInterest - simple.interest)}</dd></div>
    </dl>
  </div>
</div>

<script>
  import { calculateSimpleInterest } from '@lib/calculators/simple-interest';
  import { calculateCompoundInterest } from '@lib/calculators/compound-interest';
  import { formatCurrency } from '@lib/format';
  document.querySelectorAll<HTMLElement>('[data-interest]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-int-form]')!;
    const num = (n: string) => Number((form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement)?.value) || 0;
    const set = (sel: string, v: string) => { const el = root.querySelector<HTMLElement>(sel); if (el) el.textContent = v; };
    function recompute() {
      const principal = num('principal'), annualRatePct = num('annualRatePct'), years = num('years');
      const s = calculateSimpleInterest({ principal, annualRatePct, years });
      const c = calculateCompoundInterest({ principal, annualRatePct, years, compoundsPerYear: num('compoundsPerYear') });
      set('[data-int-compound]', formatCurrency(c.totalInterest));
      set('[data-int-compound-total]', formatCurrency(c.futureValue));
      set('[data-int-simple]', formatCurrency(s.interest));
      set('[data-int-simple-total]', formatCurrency(s.total));
      set('[data-int-diff]', formatCurrency(c.totalInterest - s.interest));
    }
    form.addEventListener('input', recompute);
    recompute();
  });
</script>
