---
/**
 * GPA calculator island (R16B1 — Academic family pilot, 1 of 2; task-first migration).
 *
 * Task-first, direct-intent: starts with exactly ONE blank course row, the result is an instruction,
 * and the visitor presses "Calculate GPA" for the first result; live-after-first afterwards. Compute,
 * validation, state, announcement and focus are owned by the shared runtime + the GPA binding
 * (@lib/calculators/gpa-form), which wraps the UNCHANGED calculateGPA / GRADE_POINTS.
 *
 * The dynamic course rows are entirely ISLAND-OWNED: rows are built with the DOM API (never innerHTML),
 * each with a globally-unique id (so two instances on one page never collide), a grade <select>
 * (letter value + "Select grade" placeholder), a credit-hours input, per-row error slots
 * ([data-error-for]) the runtime targets, and a remove control. "Add course" / remove dispatch an
 * `input` event so the runtime recalculates live AFTER the first calculation (a no-op before it); a
 * MutationObserver keeps the remove buttons disabled when only one row remains (including after the
 * binding's Reset collapses to one row). The standard-form runtime is UNCHANGED and there is NO generic
 * rows/repeater abstraction — GPA owns its rows; Grade (follow-on) will own its own.
 *
 * The complete-result guard lives in the binding's resultValue (a NaN sentinel → the runtime's default
 * finite gate) — there is NO isUsableResult (a valid 0.0 GPA is a finite 0 the default gate accepts).
 */
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
---

<div class="gpa grid grid-cols-2 gap-4 mx-auto w-full" data-gpa>
  <form class="card p-4" data-form novalidate aria-label="GPA calculator">
    <div class="gpa-head" aria-hidden="true">
      <span>Grade</span>
      <span>Credit hours</span>
      <span></span>
    </div>
    <!-- Course rows are island-owned; the script seeds exactly one blank row. -->
    <div data-gpa-rows></div>

    <button type="button" class="btn btn-secondary mt-3" data-gpa-add>+ Add course</button>

    <div class="mt-6 flex items-center gap-3">
      <button type="submit" class="btn btn-primary" data-gpa-submit>Calculate GPA</button>
      <button type="button" class="btn btn-secondary" data-reset>Reset</button>
    </div>
    <p class="gpa-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <ResultShell id="gpa-result" state="empty" density="standard" label="GPA result" minHeight="4rem">
    <EmptyResult message="Add each course's grade and credit hours, then calculate to see your credit-weighted GPA." />

    <div data-result-when="valid">
      <div class="gpa-summary">
        <ResultSummary label="GPA">
          <ResultValue value="—" size="text-3xl" />
        </ResultSummary>
        <dl class="gpa-metrics">
          <div><dt>Total credit hours</dt><dd data-gpa-credits-total>—</dd></div>
        </dl>
      </div>
      <p class="gpa-interpretation" data-gpa-interpretation>—</p>
    </div>

    <InvalidResult
      title="Check your courses"
      message="Add at least one course with a grade and credit hours greater than zero."
    />

    <ResultAnnouncement id="gpa-live" />
  </ResultShell>
</div>

<style>
  .gpa-head {
    display: grid;
    grid-template-columns: 1fr 8rem 2.5rem;
    gap: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--muted);
  }

  .gpa :global(.gpa-row) {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
  }
  .gpa :global(.gpa-row__controls) {
    display: grid;
    grid-template-columns: 1fr 8rem 2.5rem;
    gap: 0.75rem;
    align-items: center;
  }
  .gpa :global(.gpa-remove) {
    display: grid;
    place-items: center;
    height: 2.25rem;
    width: 2.25rem;
    border-radius: 0.5rem;
    border: 1px solid var(--line);
    color: var(--color-danger);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }
  .gpa :global(.gpa-remove:disabled) {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .gpa :global(.gpa-remove:focus-visible) {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }
  .gpa :global(.gpa-row__errors:empty) {
    display: none;
  }
  .gpa :global(.gpa-field-error) {
    margin: 0.35rem 0 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .gpa :global(.gpa-field-error) {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .gpa :global(.gpa-field-error) {
    color: #fca5a5;
  }

  .gpa-live-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .gpa-summary {
    display: grid;
    gap: 1rem;
    align-items: center;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .gpa-summary {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .gpa-metrics {
    margin: 0;
    align-self: center;
  }
  .gpa-metrics > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .gpa-metrics dt {
    color: var(--fg);
    font-weight: 600;
  }
  .gpa-metrics dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--heading);
    font-weight: 700;
    white-space: nowrap;
  }
  .gpa-interpretation {
    margin: 1.25rem 0 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--fg);
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { gpaBinding } from '@lib/calculators/gpa-form';
  import { GRADE_POINTS } from '@lib/calculators/gpa';

  // Module-global so row ids are unique across every instance rendered on a page.
  let uid = 0;

  function buildRow(): HTMLElement {
    const id = `gpa-r${++uid}`;
    const row = document.createElement('div');
    row.className = 'gpa-row';
    row.dataset.gpaRow = '';
    row.dataset.rowId = id;

    const controls = document.createElement('div');
    controls.className = 'gpa-row__controls';

    const grade = document.createElement('select');
    grade.className = 'field';
    grade.dataset.gpaGrade = '';
    grade.name = `grade-${id}`;
    grade.id = `${id}-grade`;
    grade.setAttribute('aria-label', 'Course grade');
    grade.setAttribute('aria-describedby', `${id}-grade-error`);
    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = 'Select grade';
    grade.appendChild(placeholder);
    for (const g of GRADE_POINTS) {
      const opt = document.createElement('option');
      opt.value = g.label;
      opt.textContent = `${g.label} (${g.value.toFixed(1)})`;
      grade.appendChild(opt);
    }

    const credits = document.createElement('input');
    credits.className = 'field';
    credits.type = 'number';
    credits.min = '0';
    credits.step = '0.5';
    credits.inputMode = 'decimal';
    credits.autocomplete = 'off';
    credits.dataset.gpaCredits = '';
    credits.name = `credits-${id}`;
    credits.id = `${id}-credits`;
    credits.placeholder = 'e.g. 3';
    credits.setAttribute('aria-label', 'Credit hours');
    credits.setAttribute('aria-describedby', `${id}-credits-error`);

    const remove = document.createElement('button');
    remove.type = 'button';
    remove.className = 'gpa-remove';
    remove.dataset.gpaRemove = '';
    remove.setAttribute('aria-label', 'Remove course');
    remove.textContent = '×';

    controls.append(grade, credits, remove);

    const errors = document.createElement('div');
    errors.className = 'gpa-row__errors';
    const gradeErr = document.createElement('p');
    gradeErr.className = 'gpa-field-error';
    gradeErr.id = `${id}-grade-error`;
    gradeErr.dataset.errorFor = `grade-${id}`;
    gradeErr.hidden = true;
    const creditsErr = document.createElement('p');
    creditsErr.className = 'gpa-field-error';
    creditsErr.id = `${id}-credits-error`;
    creditsErr.dataset.errorFor = `credits-${id}`;
    creditsErr.hidden = true;
    errors.append(gradeErr, creditsErr);

    row.append(controls, errors);
    return row;
  }

  document.querySelectorAll<HTMLElement>('[data-gpa]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const rowsEl = root.querySelector<HTMLElement>('[data-gpa-rows]')!;
    const shell = root.querySelector<HTMLElement>('[data-result-shell]');
    const addBtn = root.querySelector<HTMLButtonElement>('[data-gpa-add]')!;

    // Seed exactly one blank course row (idempotent).
    if (!rowsEl.querySelector('[data-gpa-row]')) rowsEl.appendChild(buildRow());

    const updateRemoveState = () => {
      const rows = rowsEl.querySelectorAll<HTMLElement>('[data-gpa-row]');
      const onlyOne = rows.length <= 1;
      rows.forEach((r) => {
        const btn = r.querySelector<HTMLButtonElement>('[data-gpa-remove]');
        if (btn) btn.disabled = onlyOne;
      });
    };
    updateRemoveState();

    // Shared runtime, UNCHANGED, with the GPA binding.
    mountFormCalculator(root, gpaBinding, {
      recalculationMode: 'live-after-first',
      calculateButtonLabel: 'Calculate GPA',
    });

    // Drive the runtime's live-after-first path on structural row changes (ignored before the first calc).
    const notifyInput = () => form.dispatchEvent(new Event('input', { bubbles: true }));

    addBtn.addEventListener('click', () => {
      rowsEl.appendChild(buildRow());
      updateRemoveState();
      notifyInput();
    });

    rowsEl.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-gpa-remove]');
      if (!btn) return;
      if (rowsEl.querySelectorAll('[data-gpa-row]').length > 1) {
        btn.closest('[data-gpa-row]')!.remove();
        updateRemoveState();
        notifyInput();
      }
    });

    // Keep the remove-button state correct when Reset (binding) collapses to one row.
    new MutationObserver(updateRemoveState).observe(rowsEl, { childList: true });

    // Form-level error focus (Triangle precedent): on an explicit invalid submit with no field marked
    // invalid (the "add a course" form error), return focus to the first grade selector.
    form.addEventListener('submit', () => {
      if (shell?.dataset.resultState === 'invalid' && !root.querySelector('[aria-invalid="true"]')) {
        root.querySelector<HTMLElement>('[data-gpa-grade]')?.focus();
      }
    });
  });
</script>
