---
/**
 * Savings calculator island (R8D1 — standard-form wave, calculator #16; product family
 * MULTI-MODE, on the standard-form runtime UNCHANGED — no isUsableResult).
 *
 * Task-first, direct-intent: mode defaults to Project savings, all fields start EMPTY, the
 * result is empty (an instruction, not the legacy $1,000 / $300 / 4% / 10-year sample), and
 * the visitor presses "Project Savings" (or "Calculate Required Deposit") for the first
 * result. Live-after-first afterwards. Compute, validation, state, announcement and focus are
 * owned by the shared runtime + the savings binding (@lib/calculators/savings-form).
 *
 * "Savings calculation" is a native radio group — a STRUCTURAL selector the runtime recomputes
 * on. Its two modes swap ONE conditional field (monthly deposit ⇆ savings goal), sharing the
 * starting balance, annual return and years. The island OWNS the conditional field's visibility
 * + the action label: the inactive field is hidden AND disabled, its stale error cleared and its
 * value preserved for an in-session switch; on a switch the mode-owned result is briefly blanked.
 * The calculator is SUMMARY-ONLY — the formula's yearly series is not rendered.
 */
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import ResultBreakdown from '@components/result/ResultBreakdown.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';
---

<div class="savings mx-auto grid w-full max-w-4xl gap-6 md:grid-cols-2 md:items-start" data-savings>
  <!-- Inputs -->
  <form class="card p-4" data-form novalidate aria-label="Savings calculator">
    <fieldset class="sv-modes">
      <legend class="field-label">Savings calculation</legend>
      <div class="seg-group">
        <label class="seg"><input type="radio" name="mode" value="project" checked /><span>Project savings</span></label>
        <label class="seg"><input type="radio" name="mode" value="goal" /><span>Reach a savings goal</span></label>
      </div>
    </fieldset>

    <div class="mt-5 space-y-4">
      <div data-field="startingAmount">
        <label class="field-label" for="sv-start">Starting balance</label>
        <div class="flex">
          <span class="field-affix rounded-l-lg border-r-0">$</span>
          <input class="field rounded-l-none" id="sv-start" name="startingAmount" type="number" min="0" step="100" inputmode="decimal" autocomplete="off" placeholder="e.g. 1000" aria-describedby="sv-start-error" />
        </div>
        <p class="sv-field-error" id="sv-start-error" data-error-for="startingAmount" hidden></p>
      </div>

      <!-- Conditional: Project shows the monthly deposit. -->
      <div data-field="monthlyContribution" data-sv-project>
        <label class="field-label" for="sv-monthly">Monthly deposit</label>
        <div class="flex">
          <span class="field-affix rounded-l-lg border-r-0">$</span>
          <input class="field rounded-l-none" id="sv-monthly" name="monthlyContribution" type="number" min="0" step="50" inputmode="decimal" autocomplete="off" placeholder="e.g. 300" aria-describedby="sv-monthly-error" />
        </div>
        <p class="sv-field-error" id="sv-monthly-error" data-error-for="monthlyContribution" hidden></p>
      </div>

      <!-- Conditional: Reach a goal shows the savings goal. -->
      <div data-field="goal" data-sv-goal hidden>
        <label class="field-label" for="sv-goalamt">Savings goal</label>
        <div class="flex">
          <span class="field-affix rounded-l-lg border-r-0">$</span>
          <input class="field rounded-l-none" id="sv-goalamt" name="goal" type="number" min="0" step="1000" inputmode="decimal" autocomplete="off" placeholder="e.g. 50000" aria-describedby="sv-goal-error" disabled />
        </div>
        <p class="sv-field-error" id="sv-goal-error" data-error-for="goal" hidden></p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div data-field="annualRatePct">
          <label class="field-label" for="sv-rate">Annual return</label>
          <div class="flex">
            <input class="field rounded-r-none" id="sv-rate" name="annualRatePct" type="number" min="0" step="0.1" inputmode="decimal" autocomplete="off" placeholder="e.g. 4" aria-describedby="sv-rate-error" />
            <span class="field-affix rounded-r-lg border-l-0">%</span>
          </div>
          <p class="sv-field-error" id="sv-rate-error" data-error-for="annualRatePct" hidden></p>
        </div>
        <div data-field="years">
          <label class="field-label" for="sv-years">Years</label>
          <input class="field" id="sv-years" name="years" type="number" min="1" step="1" inputmode="numeric" autocomplete="off" placeholder="e.g. 10" aria-describedby="sv-years-error" />
          <p class="sv-field-error" id="sv-years-error" data-error-for="years" hidden></p>
        </div>
      </div>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <button type="submit" class="btn btn-primary" data-sv-submit>Project Savings</button>
      <button type="button" class="btn btn-secondary" data-reset>Reset</button>
    </div>
    <p class="sv-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result -->
  <ResultShell
    id="sv-result"
    state="empty"
    density="standard"
    label="Savings result"
    minHeight="20rem"
    placeholderAlignment="center"
  >
    <ExampleNotice />
    <EmptyResult message="Enter your savings details, then project your balance or calculate the monthly deposit needed for a goal." />

    <div data-result-when="valid">
      <ResultSummary label="Projected savings balance">
        <ResultValue value="—" size="text-4xl" />
      </ResultSummary>

      <p class="sv-interpretation" data-sv-interpretation hidden></p>

      <div data-sv-breakdown>
        <ResultBreakdown title="Breakdown">
          <dl class="sv-metrics">
            <div><dt>Total deposited</dt><dd data-sv-contrib>—</dd></div>
            <div><dt>Interest earned</dt><dd data-sv-interest>—</dd></div>
          </dl>
          <p class="sv-note">Assumes monthly deposits and monthly compounding. Amounts are in US dollars (USD).</p>
        </ResultBreakdown>
      </div>
    </div>

    <InvalidResult
      title="Check your entries"
      message="Enter your starting balance, annual return, years, and — depending on the mode — a monthly deposit or a savings goal."
    />

    <ResultAnnouncement id="sv-live" />
  </ResultShell>
</div>

<style>
  .sv-modes {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .seg-group {
    display: inline-flex;
    margin-top: 0.4rem;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    padding: 0.125rem;
  }
  .seg {
    position: relative;
    display: inline-flex;
  }
  .seg input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .seg span {
    padding: 0.35rem 0.9rem;
    border-radius: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }
  .seg:has(input:checked) span {
    background: var(--color-brand-600);
    color: #fff;
  }
  .seg:has(input:focus-visible) span {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }

  .sv-field-error {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .sv-field-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .sv-field-error {
    color: #fca5a5;
  }

  .sv-live-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .sv-interpretation {
    margin: 0.6rem 0 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--fg);
  }

  .sv-metrics {
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }
  .sv-metrics > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .sv-metrics dt {
    color: var(--fg);
    font-weight: 600;
  }
  .sv-metrics dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--heading);
    font-weight: 700;
    white-space: nowrap;
  }
  .sv-note {
    margin: 0.6rem 0 0;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--muted);
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { savingsBinding, SAVINGS_EXAMPLE_VALUES } from '@lib/calculators/savings-form';

  document.querySelectorAll<HTMLElement>('[data-savings]').forEach((root) => {
    mountFormCalculator(root, savingsBinding, {
      recalculationMode: 'live-after-first',
      example: { values: SAVINGS_EXAMPLE_VALUES },
      calculateButtonLabel: 'Project Savings',
    });

    // The island owns the visible mode presentation. The runtime recomputes on the mode
    // radio's structural `input` (unchanged); here we keep the conditional field + action
    // label in step and, on a switch, blank the mode-owned result so no stale value shows
    // under the new mode while the live recompute is pending.
    const submitBtn = root.querySelector<HTMLElement>('[data-sv-submit]');
    const shell = root.querySelector<HTMLElement>('[data-result-shell]');
    const projWrap = root.querySelector<HTMLElement>('[data-sv-project]');
    const goalWrap = root.querySelector<HTMLElement>('[data-sv-goal]');
    const projInput = projWrap?.querySelector<HTMLInputElement>('input');
    const goalInput = goalWrap?.querySelector<HTMLInputElement>('input');
    const isGoal = () => root.querySelector<HTMLInputElement>('[name="mode"]:checked')?.value === 'goal';

    const clearError = (name: string) => {
      root.querySelector<HTMLElement>(`[name="${name}"]`)?.removeAttribute('aria-invalid');
      const err = root.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (err) {
        err.textContent = '';
        err.hidden = true;
      }
    };

    const syncMode = () => {
      const g = isGoal();
      if (submitBtn) submitBtn.textContent = g ? 'Calculate Required Deposit' : 'Project Savings';
      if (projWrap) projWrap.hidden = g;
      if (projInput) projInput.disabled = g;
      if (goalWrap) goalWrap.hidden = !g;
      if (goalInput) goalInput.disabled = !g;
      clearError(g ? 'monthlyContribution' : 'goal');
    };

    const blankResult = () => {
      for (const sel of [
        '[data-result-when~="valid"] [data-result-value]',
        '[data-result-when~="valid"] [data-result-value-a11y]',
        '[data-sv-contrib]',
        '[data-sv-interest]',
        '[data-sv-interpretation]',
      ]) {
        const el = root.querySelector<HTMLElement>(sel);
        if (el) el.textContent = '—';
      }
    };

    root.querySelectorAll<HTMLInputElement>('[name="mode"]').forEach((r) =>
      r.addEventListener('change', () => {
        syncMode();
        if (shell?.dataset.resultState === 'valid') blankResult();
      }),
    );
    root.querySelector<HTMLElement>('[data-reset]')?.addEventListener('click', () => {
      const projectRadio = root.querySelector<HTMLInputElement>('[name="mode"][value="project"]');
      if (projectRadio) projectRadio.checked = true;
      syncMode();
    });
    syncMode();
  });
</script>
