---
/**
 * Mortgage calculator island (R11E1 — task-first migration, finance complex-form family; the fourth and
 * final finance complex-form).
 *
 * Task-first, summary-first: every field starts EMPTY. The result panel opens on a clearly-labelled
 * worked Example (engine-computed at build time), which the visitor dismisses by typing or via
 * "Start with my values" — after that it is the ordinary empty → valid flow. The visitor presses
 * "Calculate Mortgage Payment" for the first result; live-after-first afterwards. Compute, validation, state,
 * announcement and focus are owned by the shared runtime + the mortgage binding
 * (@lib/calculators/mortgage-form), which wraps the UNCHANGED dedicated calculateMortgage /
 * toYearlySchedule engine (its OWN PMI-aware schedule — NOT @lib/finance / the Amortization binding). The
 * complete-result guard lives in the binding's resultValue (a NaN sentinel → the runtime's default finite
 * gate) — there is NO isUsableResult.
 *
 * The dominant value is the estimated monthly payment (PITI + HOA). A supplemental breakdown bar
 * (aria-hidden) and a textual breakdown split it into principal & interest, tax, insurance, PMI and HOA;
 * three summary metrics show the loan amount, total interest and total of payments. The amortization
 * schedule is a native <details> DISCLOSURE, closed by default and hidden entirely for a zero mortgage;
 * inside, the yearly schedule renders every row (built with the DOM API, never innerHTML) into a semantic
 * <table> (caption + scoped headers). Optional taxes/insurance/HOA/PMI live in their own closed
 * disclosure so the core four inputs lead. The island also reacts to runtime state changes it does not
 * itself cause: leaving `valid` (an invalid live edit) drops the stale rows; returning to `empty` (Reset)
 * also closes the schedule disclosure.
 */
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import ExampleResult from '@components/result/ExampleResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import { mortgageExample } from '@lib/calculators/mortgage-form';
import { formatCurrency, formatCurrencyRounded } from '@lib/format';

// Every figure below is derived at build time by the same reviewed calculateMortgage the
// calculator runs, so the example can never drift from the engine.
const ex = mortgageExample();
---

<div class="mortgage mx-auto grid w-full max-w-5xl gap-4 lg:grid-cols-2 lg:items-start" data-mortgage>
  <!-- Inputs -->
  <form class="card p-4" data-form novalidate aria-label="Mortgage calculator">
    <div class="space-y-3">
      <div data-field="homePrice">
        <label class="field-label" for="mc-home-price">Home price</label>
        <div class="flex">
          <span class="field-affix rounded-l-lg border-r-0">$</span>
          <input class="field rounded-l-none" id="mc-home-price" name="homePrice" type="number" min="0" step="1000" inputmode="decimal" autocomplete="off" placeholder="e.g. 360000" aria-describedby="mc-home-price-error" />
        </div>
        <p class="mc-field-error" id="mc-home-price-error" data-error-for="homePrice" hidden></p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div data-field="downPayment">
          <div class="flex items-baseline justify-between">
            <label class="field-label" for="mc-down-payment">Down payment</label>
            <span class="mc-down-pct" data-mc-down-pct hidden></span>
          </div>
          <div class="mt-1 flex" data-unit-group="downPayment">
            <input class="field rounded-r-none" id="mc-down-payment" name="downPayment" type="number" min="0" step="1000" inputmode="decimal" autocomplete="off" placeholder="e.g. 80000" aria-describedby="mc-down-payment-error" />
            <div class="mc-unit" role="radiogroup" aria-label="Enter the down payment as dollars or a percent">
              <button type="button" class="mc-unit__btn is-active" data-unit="amount" role="radio" aria-checked="true" aria-label="Dollars">$</button>
              <button type="button" class="mc-unit__btn" data-unit="percent" role="radio" aria-checked="false" aria-label="Percent of home price">%</button>
            </div>
          </div>
          <p class="mc-field-error" id="mc-down-payment-error" data-error-for="downPayment" hidden></p>
        </div>
        <div data-field="startDate">
          <label class="field-label" for="mc-start-month">Start date</label>
          <div class="mt-1 flex gap-2">
            <select class="field mc-start-month" id="mc-start-month" name="startMonth" aria-label="Repayment start month">
              {['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'].map((m, i) => (
                <option value={i + 1}>{m}</option>
              ))}
            </select>
            <input class="field mc-start-year" id="mc-start-year" name="startYear" type="number" min="1900" max="2200" step="1" inputmode="numeric" autocomplete="off" aria-label="Repayment start year" />
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div data-field="loanTermYears">
          <label class="field-label" for="mc-term">Loan term</label>
          <select class="field" id="mc-term" name="loanTermYears" aria-describedby="mc-term-error">
            {[30, 20, 15, 10].map((y) => <option value={y}>{y} years</option>)}
          </select>
          <p class="mc-field-error" id="mc-term-error" data-error-for="loanTermYears" hidden></p>
        </div>
        <div data-field="annualInterestRate">
          <label class="field-label" for="mc-rate">Interest rate</label>
          <div class="flex">
            <input class="field rounded-r-none" id="mc-rate" name="annualInterestRate" type="number" min="0" step="0.05" inputmode="decimal" autocomplete="off" placeholder="e.g. 6.5" aria-describedby="mc-rate-error" />
            <span class="field-affix rounded-r-lg border-l-0">%</span>
          </div>
          <p class="mc-field-error" id="mc-rate-error" data-error-for="annualInterestRate" hidden></p>
        </div>
      </div>

      <details class="mc-costs" data-mc-costs>
        <summary class="mc-costs__summary">
          <span>Taxes, insurance &amp; fees</span>
          <span class="mc-costs__hint">optional</span>
        </summary>
        <div class="mt-2 grid grid-cols-2 gap-4">
          <div data-field="propertyTaxAnnual">
            <label class="field-label" for="mc-tax-in">Property tax /yr</label>
            <div class="mt-1 flex" data-unit-group="propertyTax">
              <input class="field rounded-r-none" id="mc-tax-in" name="propertyTaxAnnual" type="number" min="0" step="100" inputmode="decimal" autocomplete="off" placeholder="e.g. 3600" aria-describedby="mc-tax-error" />
              <div class="mc-unit" role="radiogroup" aria-label="Enter property tax as dollars per year or a percent of the home price">
                <button type="button" class="mc-unit__btn is-active" data-unit="amount" role="radio" aria-checked="true" aria-label="Dollars per year">$</button>
                <button type="button" class="mc-unit__btn" data-unit="percent" role="radio" aria-checked="false" aria-label="Percent of home price per year">%</button>
              </div>
            </div>
            <p class="mc-field-error" id="mc-tax-error" data-error-for="propertyTaxAnnual" hidden></p>
          </div>
          <div data-field="homeInsuranceAnnual">
            <label class="field-label" for="mc-insurance-in">Home insurance /yr</label>
            <div class="flex">
              <span class="field-affix rounded-l-lg border-r-0">$</span>
              <input class="field rounded-l-none" id="mc-insurance-in" name="homeInsuranceAnnual" type="number" min="0" step="100" inputmode="decimal" autocomplete="off" placeholder="e.g. 1200" aria-describedby="mc-insurance-error" />
            </div>
            <p class="mc-field-error" id="mc-insurance-error" data-error-for="homeInsuranceAnnual" hidden></p>
          </div>
          <div data-field="hoaMonthly">
            <label class="field-label" for="mc-hoa-in">HOA /mo</label>
            <div class="flex">
              <span class="field-affix rounded-l-lg border-r-0">$</span>
              <input class="field rounded-l-none" id="mc-hoa-in" name="hoaMonthly" type="number" min="0" step="10" inputmode="decimal" autocomplete="off" placeholder="e.g. 0" aria-describedby="mc-hoa-error" />
            </div>
            <p class="mc-field-error" id="mc-hoa-error" data-error-for="hoaMonthly" hidden></p>
          </div>
          <div data-field="otherCostsAnnual">
            <label class="field-label" for="mc-other-in">Other costs /yr</label>
            <div class="mt-1 flex" data-unit-group="otherCosts">
              <input class="field rounded-r-none" id="mc-other-in" name="otherCostsAnnual" type="number" min="0" step="100" inputmode="decimal" autocomplete="off" placeholder="e.g. 0" aria-describedby="mc-other-error" />
              <div class="mc-unit" role="radiogroup" aria-label="Enter other costs as dollars per year or a percent of the home price">
                <button type="button" class="mc-unit__btn is-active" data-unit="amount" role="radio" aria-checked="true" aria-label="Dollars per year">$</button>
                <button type="button" class="mc-unit__btn" data-unit="percent" role="radio" aria-checked="false" aria-label="Percent of home price per year">%</button>
              </div>
            </div>
            <p class="mc-field-error" id="mc-other-error" data-error-for="otherCostsAnnual" hidden></p>
          </div>
          <div data-field="pmiAnnualRate">
            <label class="field-label" for="mc-pmi-in">PMI /yr</label>
            <div class="mt-1 flex" data-unit-group="pmi">
              <input class="field rounded-r-none" id="mc-pmi-in" name="pmiAnnualRate" type="number" min="0" step="0.05" inputmode="decimal" autocomplete="off" placeholder="e.g. 0.5" aria-describedby="mc-pmi-error" />
              <div class="mc-unit" role="radiogroup" aria-label="Enter PMI as a percent of the loan or dollars per year">
                <button type="button" class="mc-unit__btn is-active" data-unit="percent" role="radio" aria-checked="true" aria-label="Percent of the loan per year">%</button>
                <button type="button" class="mc-unit__btn" data-unit="amount" role="radio" aria-checked="false" aria-label="Dollars per year">$</button>
              </div>
            </div>
            <p class="mc-field-error" id="mc-pmi-error" data-error-for="pmiAnnualRate" hidden></p>
          </div>
        </div>
      </details>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <button type="submit" class="btn btn-primary" data-mc-submit>Calculate Mortgage Payment</button>
      <button type="button" class="btn btn-secondary" data-reset>Reset</button>
    </div>
    <p class="mc-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result -->
  <ResultShell id="mc-result" state="example" density="complex" label="Mortgage result" minHeight="22rem">
    <EmptyResult message="Enter a home price, down payment, loan term and interest rate, then calculate to see your estimated monthly payment and amortization schedule." />

    <ExampleResult
      label="Example"
      caption={`Sample figures for a ${formatCurrencyRounded(ex.homePrice)} home with ${ex.downPaymentPct}% down at ${ex.annualInterestRate}% over ${ex.loanTermYears} years — not your result.`}
      dismissLabel="Start with my values"
    >
      <ResultSummary label="Example principal &amp; interest">
        <ResultValue value={`${formatCurrency(ex.monthlyPrincipalInterest)}/mo`} size="text-3xl" />
      </ResultSummary>
      <div class="mc-totals">
        <div><span class="mc-totals__label">Loan amount</span><span class="mc-totals__value">{formatCurrencyRounded(ex.loanAmount)}</span></div>
        <div><span class="mc-totals__label">Total interest</span><span class="mc-totals__value">{formatCurrencyRounded(ex.totalInterest)}</span></div>
        <div><span class="mc-totals__label">Total of payments</span><span class="mc-totals__value">{formatCurrencyRounded(ex.totalOfPayments)}</span></div>
      </div>
      <p class="mc-example-note">Principal and interest only — this example adds no property tax, insurance, PMI, HOA or other costs.</p>
    </ExampleResult>

    <div data-result-when="valid">
      <ResultSummary label="Estimated monthly payment">
        <ResultValue value="—" size="text-3xl" />
      </ResultSummary>

      <p class="mc-interpretation" data-mc-interpretation></p>

      <div class="mc-bar" data-mc-bar aria-hidden="true">
        <span class="mc-seg" style="width:0%; background: var(--color-brand-600)" data-mc-seg="pi"></span>
        <span class="mc-seg" style="width:0%; background: var(--color-accent-500)" data-mc-seg="tax"></span>
        <span class="mc-seg" style="width:0%; background: #f59e0b" data-mc-seg="ins"></span>
        <span class="mc-seg" style="width:0%; background: #a855f7" data-mc-seg="pmi"></span>
        <span class="mc-seg" style="width:0%; background: #64748b" data-mc-seg="hoa"></span>
        <span class="mc-seg" style="width:0%; background: #0ea5e9" data-mc-seg="other"></span>
      </div>

      <dl class="mc-metrics">
        <div><dt><span class="mc-dot" style="background: var(--color-brand-600)"></span>Principal &amp; interest</dt><dd data-mc-pi>—</dd></div>
        <div><dt><span class="mc-dot" style="background: var(--color-accent-500)"></span>Property tax</dt><dd data-mc-tax>—</dd></div>
        <div><dt><span class="mc-dot" style="background: #f59e0b"></span>Home insurance</dt><dd data-mc-ins>—</dd></div>
        <div><dt><span class="mc-dot" style="background: #a855f7"></span>PMI</dt><dd data-mc-pmi>—</dd></div>
        <div><dt><span class="mc-dot" style="background: #64748b"></span>HOA</dt><dd data-mc-hoa>—</dd></div>
        <div><dt><span class="mc-dot" style="background: #0ea5e9"></span>Other costs</dt><dd data-mc-other>—</dd></div>
      </dl>

      <div class="mc-totals">
        <div><span class="mc-totals__label">Loan amount</span><span class="mc-totals__value" data-mc-loan>—</span></div>
        <div><span class="mc-totals__label">Total interest</span><span class="mc-totals__value" data-mc-total-interest>—</span></div>
        <div><span class="mc-totals__label">Total of payments</span><span class="mc-totals__value" data-mc-total-paid>—</span></div>
      </div>

      <div data-mc-schedule-block>
        <details class="mc-disclosure" data-mc-disclosure>
          <summary class="mc-disclosure__summary">
            <span>View year-by-year amortization schedule</span>
            <svg class="mc-disclosure__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </summary>

          <div class="mc-table-wrap">
            <table class="mc-table">
              <caption class="sr-only">Yearly amortization schedule showing principal paid, interest paid and remaining balance at the end of each year.</caption>
              <thead>
                <tr>
                  <th scope="col" class="mc-th-period">Year</th>
                  <th scope="col" class="mc-num">Principal</th>
                  <th scope="col" class="mc-num">Interest</th>
                  <th scope="col" class="mc-num">Balance</th>
                </tr>
              </thead>
              <tbody data-mc-rows></tbody>
            </table>
          </div>
          <p class="mc-schedule__note">Amounts are shown to the nearest dollar, in US dollars (USD).</p>
        </details>
      </div>

      <p class="mc-assumptions">This is an estimate of your monthly housing cost (often called PITI). Principal and interest use the fixed-rate amortization formula; PMI applies while your balance stays above 80% of the home price. Your actual rate, taxes and insurance depend on your lender, location and credit profile.</p>
    </div>

    <InvalidResult
      title="Check your entries"
      message="Enter a home price, an interest rate, and a down payment no greater than the price."
    />

    <ResultAnnouncement id="mc-live" />
  </ResultShell>
</div>

<style>
  .mc-field-error {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .mc-field-error { color: #fca5a5; }
  }
  :root[data-theme='dark'] .mc-field-error { color: #fca5a5; }

  .mc-down-pct { font-size: 0.75rem; font-weight: 600; color: var(--muted); }
  .mc-live-note { margin-top: 0.75rem; font-size: 0.8rem; color: var(--muted); }

  /* Optional-cost disclosure */
  .mc-costs { padding-top: 0.25rem; }
  .mc-costs__summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    list-style: none;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-brand-600);
  }
  .mc-costs__summary::-webkit-details-marker { display: none; }
  .mc-costs__summary:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 3px;
    border-radius: 0.35rem;
  }
  .mc-costs__hint {
    font-weight: 600;
    color: var(--muted);
    font-size: 0.75rem;
  }

  .mc-interpretation { margin: 0.6rem 0 0; font-size: 0.95rem; line-height: 1.5; color: var(--fg); }

  /* Breakdown bar */
  .mc-bar {
    margin-top: 1.1rem;
    display: flex;
    height: 0.75rem;
    width: 100%;
    overflow: hidden;
    border-radius: 9999px;
    background: var(--subtle);
  }
  .mc-seg { display: block; height: 100%; }

  .mc-metrics { margin: 1.1rem 0 0; display: grid; gap: 0.25rem; }
  .mc-metrics > div {
    display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
    padding: 0.4rem 0; border-bottom: 1px solid var(--line); font-size: 0.95rem;
  }
  .mc-metrics dt { display: flex; align-items: center; gap: 0.5rem; color: var(--fg); font-weight: 600; }
  .mc-metrics dd { margin: 0; font-variant-numeric: tabular-nums; color: var(--heading); font-weight: 700; white-space: nowrap; }
  .mc-dot { display: inline-block; height: 0.6rem; width: 0.6rem; border-radius: 9999px; flex: none; }

  /* Loan-summary totals */
  .mc-totals {
    margin-top: 1.25rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
    text-align: center;
  }
  .mc-totals__label { display: block; font-size: 0.75rem; color: var(--muted); }
  .mc-totals__value { display: block; margin-top: 0.25rem; font-weight: 700; color: var(--heading); font-variant-numeric: tabular-nums; }

  /* Schedule disclosure */
  .mc-disclosure {
    margin-top: 1.5rem;
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }
  .mc-disclosure__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    cursor: pointer;
    list-style: none;
    font-weight: 700;
    color: var(--heading);
    padding: 0.35rem 0;
  }
  .mc-disclosure__summary::-webkit-details-marker { display: none; }
  .mc-disclosure__summary:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 3px;
    border-radius: 0.35rem;
  }
  .mc-disclosure__chevron { flex: none; transition: transform 0.15s ease; color: var(--muted); }
  .mc-disclosure[open] .mc-disclosure__chevron { transform: rotate(180deg); }

  .mc-table-wrap {
    margin-top: 1rem;
    max-height: 22rem;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
  }
  .mc-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
  .mc-table thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--subtle);
    padding: 0.55rem 0.75rem;
    font-weight: 600;
    text-align: left;
    color: var(--fg);
    white-space: nowrap;
  }
  .mc-table th.mc-num, .mc-table td.mc-num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .mc-table :global(.mc-row) { border-top: 1px solid var(--line); }
  .mc-table :global(.mc-cell) { padding: 0.5rem 0.75rem; }
  .mc-table :global(.mc-cell--period) { text-align: left; font-weight: 600; color: var(--fg); white-space: nowrap; }

  /* The dated window sits inside the period cell, smaller and muted, so no column is added. */
  .mc-table :global(.mc-cell__range) {
    margin-left: 0.4rem;
    font-weight: 500;
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .mc-start-month { flex: 1 1 0; min-width: 0; }
  .mc-start-year { flex: 1 1 0; min-width: 0; }

  /* Inline unit selector — sits flush on the input's right edge so a $/% field stays ONE row.
     The active button is the unit indicator, so no separate affix is needed beside the number. */
  .mc-unit {
    display: inline-flex;
    flex: none;
    align-items: stretch;
    background: var(--subtle);
    border: 1px solid var(--line);
    border-left: 0;
    border-radius: 0 0.625rem 0.625rem 0;
    overflow: hidden;
  }

  .mc-unit__btn {
    border: 0;
    background: transparent;
    color: var(--muted);
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1;
    min-width: 2.5rem;
    padding-inline: 0.5rem;
    cursor: pointer;
    transition: background-color 0.12s ease, color 0.12s ease;
  }

  .mc-unit__btn:hover:not(.is-active) { color: var(--fg); }

  .mc-unit__btn.is-active {
    background: var(--color-brand-600);
    color: #fff;
  }

  .mc-unit__btn:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: -2px;
  }

  .mc-schedule__note { margin: 0.75rem 0 0; font-size: 0.8rem; line-height: 1.45; color: var(--muted); }
  .mc-assumptions { margin: 1.25rem 0 0; font-size: 0.78rem; line-height: 1.5; color: var(--muted); }
  .mc-example-note { margin: 0.85rem 0 0; font-size: 0.78rem; line-height: 1.5; color: var(--muted); }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { mortgageBinding } from '@lib/calculators/mortgage-form';

  document.querySelectorAll<HTMLElement>('[data-mortgage]').forEach((root) => {
    mountFormCalculator(root, mortgageBinding, {
      recalculationMode: 'live-after-first',
      calculateButtonLabel: 'Calculate Mortgage Payment',
    });

    // A live readout beside the down-payment field showing the OTHER unit — purely presentational and
    // independent of the result state. In dollar mode it shows the share ("20% down"); in percent mode
    // it shows the cash ("$80,000 down"), so the visitor always sees both halves of the same figure.
    // Shown only when the price is positive and the entry is valid for its unit (an out-of-range entry
    // surfaces its own field error instead).
    const priceEl = root.querySelector<HTMLInputElement>('[name="homePrice"]');
    const downEl = root.querySelector<HTMLInputElement>('[name="downPayment"]');
    const pctEl = root.querySelector<HTMLElement>('[data-mc-down-pct]');
    const unitBtns = root.querySelectorAll<HTMLElement>('[data-unit]');
    /** The unit active in ONE group — each group is read independently, never form-wide. */
    const unitOf = (group: string, fallback: 'amount' | 'percent') => {
      const u = root.querySelector<HTMLElement>(`[data-unit-group="${group}"] [data-unit].is-active`)
        ?.dataset.unit;
      return u === 'percent' || u === 'amount' ? u : fallback;
    };
    const currentUnit = () => unitOf('downPayment', 'amount');
    const dollars = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

    // Per-unit input affordances, one entry per unit group. Each keeps its original single-unit step
    // for its default unit; the alternate unit gets the granularity that suits it (percentages move in
    // 0.1 / 0.05, the fleet's percentage-field convention). The markup ships each field's default, so
    // this is purely a progressive enhancement — with JS off every field keeps a correct step.
    const AFFORDANCES = {
      downPayment: {
        name: 'downPayment',
        step: { amount: '1000', percent: '0.1' },
        placeholder: { amount: 'e.g. 80000', percent: 'e.g. 20' },
        fallback: 'amount',
      },
      propertyTax: {
        name: 'propertyTaxAnnual',
        step: { amount: '100', percent: '0.1' },
        placeholder: { amount: 'e.g. 3600', percent: 'e.g. 1.2' },
        fallback: 'amount',
      },
      otherCosts: {
        name: 'otherCostsAnnual',
        step: { amount: '100', percent: '0.1' },
        placeholder: { amount: 'e.g. 0', percent: 'e.g. 0.5' },
        fallback: 'amount',
      },
      pmi: {
        name: 'pmiAnnualRate',
        step: { amount: '100', percent: '0.05' },
        placeholder: { amount: 'e.g. 1600', percent: 'e.g. 0.5' },
        fallback: 'percent',
      },
    } as const;

    const syncUnitAffordances = () => {
      for (const [group, cfg] of Object.entries(AFFORDANCES)) {
        const el = root.querySelector<HTMLInputElement>(`[name="${cfg.name}"]`);
        if (!el) continue;
        const unit = unitOf(group, cfg.fallback);
        el.step = cfg.step[unit];
        el.placeholder = cfg.placeholder[unit];
      }
    };

    const syncDownPct = () => {
      if (!pctEl) return;
      const percent = currentUnit() === 'percent';
      const price = Number(priceEl?.value);
      const down = Number(downEl?.value);
      const inRange = percent ? down <= 100 : down <= price;
      const show =
        Number.isFinite(price) && price > 0 && Number.isFinite(down) && down >= 0 && inRange && (downEl?.value ?? '') !== '';
      if (show) {
        pctEl.textContent = percent
          ? `${dollars((price * down) / 100)} down`
          : `${Math.round((down / price) * 100)}% down`;
        pctEl.hidden = false;
      } else {
        pctEl.hidden = true;
      }
    };
    priceEl?.addEventListener('input', syncDownPct);
    downEl?.addEventListener('input', syncDownPct);
    // The runtime owns the unit switch itself (it flips is-active, swaps the $/% affix and calls the
    // binding's convertValues); this only refreshes the readout afterwards.
    unitBtns.forEach((b) =>
      b.addEventListener('click', () =>
        queueMicrotask(() => {
          syncUnitAffordances();
          syncDownPct();
        }),
      ),
    );

    // Repayment start defaults to the visitor's current month/year (the age calculator's
    // client-today precedent). Server-rendered blank, filled on hydration, so the build date can
    // never go stale in the markup. Only ever fills a blank field.
    const monthEl = root.querySelector<HTMLSelectElement>('[name="startMonth"]');
    const yearEl = root.querySelector<HTMLInputElement>('[name="startYear"]');
    const today = new Date();
    if (monthEl && !monthEl.dataset.touched) monthEl.value = String(today.getMonth() + 1);
    if (yearEl && yearEl.value === '') yearEl.value = String(today.getFullYear());
    monthEl?.addEventListener('change', () => { monthEl.dataset.touched = '1'; });

    const shell = root.querySelector<HTMLElement>('[data-result-shell]');
    const disclosure = root.querySelector<HTMLDetailsElement>('[data-mc-disclosure]');
    const costs = root.querySelector<HTMLDetailsElement>('[data-mc-costs]');
    const clearRows = () =>
      root.querySelectorAll<HTMLElement>('[data-mc-rows]').forEach((tb) => tb.replaceChildren());

    // React to runtime state transitions the island does not itself cause. Leaving `valid` (an invalid
    // live edit) drops the stale/possibly-malformed rows so a malformed schedule can never remain in the
    // DOM; returning to `empty` (Reset) also closes BOTH disclosures (the optional-cost inputs and the
    // yearly schedule) and clears the live down-payment readout. A `valid` update is owned by the
    // binding's renderResult, so the observer never touches it. Dismissing the worked example
    // (`example` → `empty`) is explicitly NOT a Reset and collapses nothing.
    if (shell) {
      // The shell re-commits its state attribute on every run — including a structural unit switch
      // that leaves the state unchanged — and a MutationObserver fires even when the value is
      // identical. Only a real TRANSITION into `empty` (i.e. Reset) should collapse the disclosures;
      // otherwise switching the tax or PMI unit would close the very disclosure holding that control.
      let previousState = shell.dataset.resultState;
      const observer = new MutationObserver(() => {
        const state = shell.dataset.resultState;
        const entered = state !== previousState;
        const fromExample = previousState === 'example';
        previousState = state;
        if (state === 'valid') return;
        clearRows();
        // `example` → `empty` is the visitor DISMISSING the worked example, not a Reset: they may
        // have just opened the optional-cost disclosure or typed into it, so collapsing here would
        // shut the panel under their hands. Only a real return to empty (Reset) collapses.
        if (state === 'empty' && entered && !fromExample) {
          if (disclosure) disclosure.open = false;
          if (costs) costs.open = false;
          if (pctEl) pctEl.hidden = true;
          // Reset restores the default unit via the runtime (no click event), so the step and
          // placeholder must be re-derived from whichever unit is now active.
          syncUnitAffordances();
        }
      });
      observer.observe(shell, { attributes: true, attributeFilter: ['data-result-state'] });
    }
  });
</script>
