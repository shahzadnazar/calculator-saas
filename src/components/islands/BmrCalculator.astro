---
/**
 * BMR island — the reference's fields, its "+ Settings" disclosure and its result table, on
 * the UNCHANGED standard-form runtime.
 *
 * Three tabs, two of which are unit systems. "US Units" and "Metric Units" are the runtime's
 * own unit axis: switching one converts the height and weight already typed rather than
 * throwing them away. "Other Units" is not a third system — it opens the shared
 * `FieldConverterPanel` ABOVE the calculator, one small converter per quantity the form asks
 * for, and leaves the selected system alone.
 *
 * Everything the visitor must answer is visible; the three things most people never change
 * live under "+ Settings" — which of three published equations to use, a body-fat percentage
 * for the one that needs it, and whether to answer in Calories or kilojoules. The body-fat
 * box appears only when Katch-McArdle is chosen, because only that equation reads it.
 *
 * The DOMINANT result is the BMR itself; the six-row activity table is the breakdown, and
 * every row is the displayed BMR times its multiplier, so the table always adds up to what
 * is printed above it.
 */
import {
  ACTIVITY_BANDS,
  ACTIVITY_BAND_NOTES,
  BMR_FORMULAS,
  RESULT_UNITS,
  BMR_AGE_MIN,
  BMR_AGE_MAX,
} from '@lib/calculators/bmr-form';
import FieldConverterPanel from '@components/calc/FieldConverterPanel.astro';
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultBreakdown from '@components/result/ResultBreakdown.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';

const UNIT_TABS = [
  { value: 'imperial', label: 'US Units' },
  { value: 'metric', label: 'Metric Units' },
];

const CONVERTER_ROWS = [
  { key: 'height', label: 'Height Converter', category: 'length', from: 'm', to: 'in' },
  { key: 'weight', label: 'Weight Converter', category: 'mass', from: 'kg', to: 'lb' },
];
---

<div class="bmrwrap mx-auto w-full max-w-4xl" data-bmr>
  <FieldConverterPanel id="bmr-converter" rows={CONVERTER_ROWS} />

  <div class="bmrcalc grid gap-6 md:grid-cols-2 md:items-start">
    <!-- Inputs -->
    <form class="card p-4" data-form novalidate aria-label="BMR calculator">
      <div class="bmr-tabs">
        <div class="bmr-tabs__systems" role="radiogroup" aria-label="Unit system">
          {UNIT_TABS.map((t, i) => (
            <button type="button" class:list={['bmr-tab', i === 0 && 'is-active']} data-unit={t.value} role="radio" aria-checked={i === 0 ? 'true' : 'false'}>
              {t.label}
            </button>
          ))}
        </div>
        <button type="button" class="bmr-tab bmr-tab--toggle" data-converter-toggle aria-expanded="false" aria-controls="bmr-converter">
          Other Units
        </button>
      </div>

      <div class="bmr-row" data-field="age">
        <label class="field-label bmr-row__label" for="bmr-age">Age</label>
        <div class="bmr-inputs">
          <input class="field bmr-input" id="bmr-age" name="age" type="number" min={BMR_AGE_MIN} max={BMR_AGE_MAX} step="1" inputmode="numeric" autocomplete="off" placeholder="25" aria-describedby="bmr-age-error" />
          <span class="bmr-hint">ages {BMR_AGE_MIN} - {BMR_AGE_MAX}</span>
        </div>
      </div>
      <p class="bmr-error" id="bmr-age-error" data-error-for="age" hidden></p>

      <fieldset class="bmr-row bmr-row--radios" data-field="sex">
        <legend class="field-label bmr-row__label">Gender</legend>
        <div class="bmr-radios">
          <label class="bmr-radio"><input type="radio" name="sex" value="male" checked /><span>male</span></label>
          <label class="bmr-radio"><input type="radio" name="sex" value="female" /><span>female</span></label>
        </div>
      </fieldset>

      <!-- US height + weight -->
      <div data-group="imperial">
        <div class="bmr-row" data-field="height">
          <label class="field-label bmr-row__label" for="bmr-ft">Height</label>
          <div class="bmr-inputs">
            <div class="bmr-pair">
              <input class="field bmr-input" id="bmr-ft" name="heightFt" type="number" min="0" step="1" inputmode="numeric" autocomplete="off" placeholder="5" aria-label="Height, feet" aria-describedby="bmr-height-error" />
              <span class="bmr-unit">feet</span>
            </div>
            <div class="bmr-pair">
              <input class="field bmr-input" id="bmr-in" name="heightIn" type="number" min="0" max="11" step="1" inputmode="numeric" autocomplete="off" placeholder="10" aria-label="Height, inches" aria-describedby="bmr-height-error" />
              <span class="bmr-unit">inches</span>
            </div>
          </div>
        </div>
        <p class="bmr-error" id="bmr-height-error" data-error-for="height" hidden></p>

        <div class="bmr-row" data-field="weightLb">
          <label class="field-label bmr-row__label" for="bmr-lb">Weight</label>
          <div class="bmr-inputs">
            <div class="bmr-pair">
              <input class="field bmr-input bmr-input--wide" id="bmr-lb" name="weightLb" type="number" min="0" step="0.1" inputmode="decimal" autocomplete="off" placeholder="160" aria-describedby="bmr-weightLb-error" />
              <span class="bmr-unit">pounds</span>
            </div>
          </div>
        </div>
        <p class="bmr-error" id="bmr-weightLb-error" data-error-for="weightLb" hidden></p>
      </div>

      <!-- Metric height + weight -->
      <div data-group="metric" hidden>
        <div class="bmr-row" data-field="heightCm">
          <label class="field-label bmr-row__label" for="bmr-cm">Height</label>
          <div class="bmr-inputs">
            <div class="bmr-pair">
              <input class="field bmr-input bmr-input--wide" id="bmr-cm" name="heightCm" type="number" min="0" step="0.1" inputmode="decimal" autocomplete="off" placeholder="180" aria-describedby="bmr-heightCm-error" />
              <span class="bmr-unit">cm</span>
            </div>
          </div>
        </div>
        <p class="bmr-error" id="bmr-heightCm-error" data-error-for="heightCm" hidden></p>

        <div class="bmr-row" data-field="weightKg">
          <label class="field-label bmr-row__label" for="bmr-kg">Weight</label>
          <div class="bmr-inputs">
            <div class="bmr-pair">
              <input class="field bmr-input bmr-input--wide" id="bmr-kg" name="weightKg" type="number" min="0" step="0.1" inputmode="decimal" autocomplete="off" placeholder="60" aria-describedby="bmr-weightKg-error" />
              <span class="bmr-unit">kg</span>
            </div>
          </div>
        </div>
        <p class="bmr-error" id="bmr-weightKg-error" data-error-for="weightKg" hidden></p>
      </div>

      <!-- Settings: the three things most people never change. -->
      <button type="button" class="bmr-settings-toggle" data-settings-toggle aria-expanded="false" aria-controls="bmr-settings">
        <span class="bmr-settings-toggle__sign" aria-hidden="true">+</span> Settings
      </button>

      <div class="bmr-settings" id="bmr-settings" data-settings hidden>
        <fieldset class="bmr-set" data-field="formula">
          <legend class="bmr-set__legend">BMR estimation formula</legend>
          <div class="bmr-set__options">
            {BMR_FORMULAS.map((f, i) => (
              <label class="bmr-radio"><input type="radio" name="formula" value={f.value} checked={i === 0} /><span>{f.label}</span></label>
            ))}
          </div>
        </fieldset>

        <div class="bmr-set" data-field="bodyFatPct" data-bodyfat hidden>
          <label class="bmr-set__legend" for="bmr-bf">Body fat percentage</label>
          <div class="bmr-inputs">
            <div class="bmr-pair">
              <input class="field bmr-input" id="bmr-bf" name="bodyFatPct" type="number" min="0" max="99.9" step="0.1" inputmode="decimal" autocomplete="off" placeholder="20" aria-describedby="bmr-bodyFatPct-error" />
              <span class="bmr-unit">%</span>
            </div>
            <span class="bmr-hint">Katch-McArdle works from lean mass</span>
          </div>
          <p class="bmr-error" id="bmr-bodyFatPct-error" data-error-for="bodyFatPct" hidden></p>
        </div>

        <fieldset class="bmr-set" data-field="resultUnit">
          <legend class="bmr-set__legend">Result unit</legend>
          <div class="bmr-set__options">
            {RESULT_UNITS.map((u, i) => (
              <label class="bmr-radio"><input type="radio" name="resultUnit" value={u.value} checked={i === 0} /><span>{u.label}</span></label>
            ))}
          </div>
        </fieldset>
      </div>

      <div class="mt-5 flex items-center gap-3">
        <button type="submit" class="btn btn-primary">Calculate BMR</button>
        <button type="button" class="btn btn-secondary" data-reset>Clear</button>
      </div>
      <p class="bmr-live-note" data-live-note hidden>Changes update automatically.</p>
    </form>

    <!-- Result -->
    <ResultShell
      id="bmr-result"
      state="empty"
      density="standard"
      label="Your BMR result"
      minHeight="20rem"
      placeholderAlignment="center"
    >
      <ExampleNotice />
      <EmptyResult message="Enter your age, gender, height and weight, then calculate your BMR." />

      <div data-result-when="valid">
        <ResultSummary label="Basal metabolic rate">
          <span aria-hidden="true">
            <span class="bmr-eq">BMR =</span> <span class="result-value text-4xl" data-bmr-value>—</span>&nbsp;<span class="result-unit" data-bmr-suffix>Calories/day</span>
          </span>
          <span class="sr-only" data-bmr-a11y></span>
        </ResultSummary>

        <ResultBreakdown>
          <p class="bmr-table-title" data-bmr-table-title>Daily calorie needs based on activity level</p>
          <table class="bmr-activity">
            <thead>
              <tr><th scope="col">Activity Level</th><th scope="col" class="bmr-num" data-bmr-col-head>Calorie</th></tr>
            </thead>
            <tbody>
              {ACTIVITY_BANDS.map((b) => (
                <tr><th scope="row">{b.label}</th><td class="bmr-num" data-bmr-activity>—</td></tr>
              ))}
            </tbody>
          </table>
          <ul class="bmr-notes">
            {ACTIVITY_BAND_NOTES.map((n) => <li>{n}</li>)}
          </ul>
        </ResultBreakdown>
      </div>

      <InvalidResult title="Check your entries" message="Enter your age, height and weight to estimate your BMR." />

      <ResultAnnouncement id="bmr-live" />
    </ResultShell>
  </div>
</div>

<style>
  .bmr-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-bottom: 0.9rem;
  }
  .bmr-tabs__systems {
    display: flex;
    gap: 0.3rem;
  }
  .bmr-tab {
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: var(--card);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--fg);
    cursor: pointer;
  }
  .bmr-tab.is-active {
    border-color: var(--color-brand-600);
    background: var(--color-brand-600);
    color: #fff;
  }
  .bmr-tab:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }
  .bmr-tab--toggle[aria-expanded='true'] {
    border-color: var(--color-brand-600);
    color: var(--color-brand-700);
  }

  .bmr-row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.6rem;
    padding: 0.3rem 0;
    border: 0;
    margin: 0;
  }
  .bmr-row__label {
    margin: 0;
    font-size: 0.86rem;
  }
  .bmr-inputs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .bmr-pair {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .bmr-input {
    width: 5rem;
    min-height: 2.75rem;
    font-variant-numeric: tabular-nums;
  }
  .bmr-input--wide {
    width: 7rem;
  }
  .bmr-unit,
  .bmr-hint {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .bmr-radios {
    display: flex;
    gap: 0.9rem;
  }
  .bmr-radio {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    font-size: 0.88rem;
    color: var(--fg);
    cursor: pointer;
  }
  .bmr-radio input {
    width: 1.05rem;
    height: 1.05rem;
    accent-color: var(--color-brand-600);
  }
  .bmr-error {
    margin: 0.1rem 0 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .bmr-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .bmr-error {
    color: #fca5a5;
  }
  .bmr-live-note {
    margin-top: 0.7rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .bmr-settings-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 2.75rem;
    margin-top: 0.2rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-brand-700);
    cursor: pointer;
  }
  .bmr-settings-toggle__sign {
    font-size: 1rem;
    line-height: 1;
  }
  :root[data-theme='dark'] .bmr-settings-toggle {
    color: var(--color-brand-300);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .bmr-settings-toggle {
      color: var(--color-brand-300);
    }
  }
  .bmr-settings {
    margin-top: 0.4rem;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--subtle);
  }
  .bmr-set {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .bmr-set + .bmr-set {
    margin-top: 0.6rem;
  }
  .bmr-set__legend {
    display: block;
    padding: 0;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--heading);
  }
  .bmr-set__options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .bmr-eq {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--heading);
    margin-right: 0.15rem;
  }
  .bmr-table-title {
    margin: 0 0 0.5rem;
    font-size: 0.86rem;
    color: var(--fg);
  }
  .bmr-activity {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
  }
  .bmr-activity th,
  .bmr-activity td {
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }
  .bmr-activity thead th {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    font-weight: 700;
  }
  .bmr-activity tbody th {
    font-weight: 500;
    color: var(--fg);
    padding-right: 0.6rem;
  }
  .bmr-num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .bmr-activity tbody td {
    font-weight: 700;
    color: var(--heading);
  }
  .bmr-notes {
    margin: 0.7rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 26rem) {
    .bmr-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { mountFieldConverters } from '@lib/calculators/unit-converter-panel';
  import { bmrBinding, BMR_EXAMPLE_VALUES, needsBodyFat, type BmrFormula } from '@lib/calculators/bmr-form';

  document.querySelectorAll<HTMLElement>('[data-bmr]').forEach((root) => {
    mountFormCalculator(root, bmrBinding, {
      recalculationMode: 'live-after-first',
      example: { values: BMR_EXAMPLE_VALUES },
      calculateButtonLabel: 'Calculate BMR',
    });

    // The "Other Units" converters, above the calculator and never changing its system.
    mountFieldConverters(root);

    // "+ Settings" — a plain disclosure, closed on load.
    const settings = root.querySelector<HTMLElement>('[data-settings]');
    const settingsToggle = root.querySelector<HTMLButtonElement>('[data-settings-toggle]');
    const sign = settingsToggle?.querySelector<HTMLElement>('.bmr-settings-toggle__sign');
    if (settings && settingsToggle) {
      settingsToggle.addEventListener('click', () => {
        const open = settings.hidden;
        settings.hidden = !open;
        settingsToggle.setAttribute('aria-expanded', String(open));
        if (sign) sign.textContent = open ? '−' : '+';
      });
    }

    /**
     * Only Katch-McArdle reads a body-fat percentage, so only it asks for one. The box is
     * emptied on the way out, so a figure the visitor typed and then walked away from can
     * never reach a result they cannot see the input for.
     */
    const bodyFatRow = root.querySelector<HTMLElement>('[data-bodyfat]');
    const bodyFat = root.querySelector<HTMLInputElement>('[name="bodyFatPct"]');
    const syncBodyFat = () => {
      const formula = (root.querySelector<HTMLInputElement>('[name="formula"]:checked')?.value ??
        'mifflin') as BmrFormula;
      const wanted = needsBodyFat(formula);
      if (bodyFatRow) bodyFatRow.hidden = !wanted;
      if (!wanted) {
        if (bodyFat) bodyFat.value = '';
        const err = root.querySelector<HTMLElement>('[data-error-for="bodyFatPct"]');
        if (err) err.hidden = true;
      }
    };
    root.querySelectorAll<HTMLInputElement>('[name="formula"]').forEach((r) =>
      r.addEventListener('change', syncBodyFat),
    );
    syncBodyFat();

    /**
     * A required field the visitor cannot see is a dead end: if they pick Katch-McArdle,
     * close Settings and then submit, the runtime would try to focus a hidden box. Open the
     * panel first — in capture, so it happens before the runtime handles the submit.
     */
    root.querySelector<HTMLFormElement>('[data-form]')?.addEventListener(
      'submit',
      () => {
        if (!settings || !settingsToggle || !settings.hidden) return;
        if (!bodyFatRow || bodyFatRow.hidden) return;
        settings.hidden = false;
        settingsToggle.setAttribute('aria-expanded', 'true');
        if (sign) sign.textContent = '−';
      },
      true,
    );
  });
</script>
