---
/**
 * BMR calculator island (R7B — standard-form runtime generalization pilot).
 *
 * The first calculator to prove the shipped standard-form runtime
 * (@lib/result/form-runtime) generalizes beyond BMI. Task-first, direct-intent:
 * personal fields start EMPTY, the result panel is empty (an instruction, no
 * sample BMR), and the visitor presses "Calculate BMR" for the first result.
 * After that first success, edits update automatically (live-after-first). All
 * interaction, validation, state, announcements and focus are owned by the shared
 * runtime; this island is only markup + the BMR binding (@lib/calculators/bmr-form).
 *
 * Sex is a real radio group (fires the form `input` event, so the runtime treats
 * it like any field); Metric/Imperial is the runtime's `[data-unit]` structural
 * selector. Neither triggers a result before the first Calculate.
 */
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import ResultInterpretation from '@components/result/ResultInterpretation.astro';
import ResultBreakdown from '@components/result/ResultBreakdown.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';
---

<div class="bmr mx-auto grid w-full max-w-4xl gap-6 md:grid-cols-2 md:items-start" data-bmr>
  <!-- Inputs -->
  <form class="card p-4" data-form novalidate aria-label="BMR calculator">
    <div class="flex flex-wrap gap-3">
      <fieldset class="seg-group">
        <legend class="sr-only">Sex</legend>
        <label class="seg"><input type="radio" name="sex" value="male" checked /><span>Male</span></label>
        <label class="seg"><input type="radio" name="sex" value="female" /><span>Female</span></label>
      </fieldset>
      <div class="inline-flex rounded-lg border p-0.5" role="radiogroup" aria-label="Unit system" style="border-color: var(--line)">
        <button type="button" class="unit-btn is-active" data-unit="metric" role="radio" aria-checked="true">Metric</button>
        <button type="button" class="unit-btn" data-unit="imperial" role="radio" aria-checked="false">Imperial (US)</button>
      </div>
    </div>

    <div class="mt-5 space-y-4">
      <div data-field="age">
        <label class="field-label" for="bmr-age">Age</label>
        <div class="flex">
          <input
            class="field rounded-r-none"
            id="bmr-age"
            name="age"
            type="number"
            min="0"
            step="1"
            inputmode="numeric"
            autocomplete="off"
            placeholder="e.g. 30"
            aria-describedby="bmr-age-error"
          />
          <span class="field-affix rounded-r-lg border-l-0">years</span>
        </div>
        <p class="bmr-field-error" id="bmr-age-error" data-error-for="age" hidden></p>
      </div>

      <!-- Metric -->
      <div class="grid grid-cols-2 gap-4" data-group="metric">
        <div data-field="heightCm">
          <label class="field-label" for="bmr-height-cm">Height</label>
          <div class="flex">
            <input class="field rounded-r-none" id="bmr-height-cm" name="heightCm" type="number" min="0" step="0.1" inputmode="decimal" autocomplete="off" placeholder="e.g. 180" aria-describedby="bmr-heightCm-error" />
            <span class="field-affix rounded-r-lg border-l-0">cm</span>
          </div>
          <p class="bmr-field-error" id="bmr-heightCm-error" data-error-for="heightCm" hidden></p>
        </div>
        <div data-field="weightKg">
          <label class="field-label" for="bmr-weight-kg">Weight</label>
          <div class="flex">
            <input class="field rounded-r-none" id="bmr-weight-kg" name="weightKg" type="number" min="0" step="0.1" inputmode="decimal" autocomplete="off" placeholder="e.g. 80" aria-describedby="bmr-weightKg-error" />
            <span class="field-affix rounded-r-lg border-l-0">kg</span>
          </div>
          <p class="bmr-field-error" id="bmr-weightKg-error" data-error-for="weightKg" hidden></p>
        </div>
      </div>

      <!-- Imperial -->
      <div class="grid grid-cols-2 gap-4" data-group="imperial" hidden>
        <div data-field="height">
          <label class="field-label" for="bmr-height-ft">Height</label>
          <div class="grid grid-cols-2 gap-3">
            <div class="flex">
              <input class="field rounded-r-none" id="bmr-height-ft" name="heightFt" type="number" min="0" step="1" inputmode="numeric" autocomplete="off" placeholder="5" aria-label="Height, feet" aria-describedby="bmr-height-error" />
              <span class="field-affix rounded-r-lg border-l-0">ft</span>
            </div>
            <div class="flex">
              <input class="field rounded-r-none" id="bmr-height-in" name="heightIn" type="number" min="0" max="11" step="1" inputmode="numeric" autocomplete="off" placeholder="11" aria-label="Height, inches" aria-describedby="bmr-height-error" />
              <span class="field-affix rounded-r-lg border-l-0">in</span>
            </div>
          </div>
          <p class="bmr-field-error" id="bmr-height-error" data-error-for="height" hidden></p>
        </div>
        <div data-field="weightLb">
          <label class="field-label" for="bmr-weight-lb">Weight</label>
          <div class="flex">
            <input class="field rounded-r-none" id="bmr-weight-lb" name="weightLb" type="number" min="0" step="0.1" inputmode="decimal" autocomplete="off" placeholder="e.g. 176" aria-describedby="bmr-weightLb-error" />
            <span class="field-affix rounded-r-lg border-l-0">lb</span>
          </div>
          <p class="bmr-field-error" id="bmr-weightLb-error" data-error-for="weightLb" hidden></p>
        </div>
      </div>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <button type="submit" class="btn btn-primary">Calculate BMR</button>
      <button type="button" class="btn btn-secondary" data-reset>Reset</button>
    </div>
    <p class="bmr-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result. Reserve the valid-state height so live editing never jumps; the
       shared `placeholderAlignment="center"` centres the short empty/invalid
       placeholders so the reserved card reads as intentional. -->
  <ResultShell
    id="bmr-result"
    state="empty"
    density="standard"
    label="Your BMR result"
    minHeight="24rem"
    placeholderAlignment="center"
  >
    <ExampleNotice />
    <EmptyResult message="Enter your details, then calculate your estimated BMR." />

    <div data-result-when="valid">
      <ResultSummary label="Estimated BMR">
        <ResultValue value="—" unit="kcal/day" />
      </ResultSummary>
      <ResultInterpretation>
        The calories your body burns at complete rest each day — the baseline for planning nutrition.
      </ResultInterpretation>

      <ResultBreakdown title="Estimated daily calorie needs">
        <p class="bmr-activity-lead">
          Your BMR multiplied by an activity factor — an estimate of the total calories you burn per day (TDEE). These are daily calorie needs, not additional BMR values.
        </p>
        <dl class="bmr-activity">
          <div class="bmr-act-row"><dt>Sedentary <span>little or no exercise</span></dt><dd data-bmr-activity>—</dd></div>
          <div class="bmr-act-row"><dt>Light <span>exercise 1–3 days/week</span></dt><dd data-bmr-activity>—</dd></div>
          <div class="bmr-act-row"><dt>Moderate <span>exercise 3–5 days/week</span></dt><dd data-bmr-activity>—</dd></div>
          <div class="bmr-act-row"><dt>Active <span>exercise 6–7 days/week</span></dt><dd data-bmr-activity>—</dd></div>
          <div class="bmr-act-row"><dt>Very active <span>hard exercise / physical job</span></dt><dd data-bmr-activity>—</dd></div>
        </dl>
        <p class="bmr-activity-note">
          For weight-loss and weight-gain targets, use the
          <a href="/health/calorie-calculator">calorie calculator</a>.
        </p>
      </ResultBreakdown>

      <p class="bmr-footnote">
        Mifflin-St Jeor equation. A population estimate for healthy adults, not a diagnosis or medical advice.
      </p>
    </div>

    <InvalidResult title="Check your entries" message="Enter your age, height and weight to estimate your BMR." />

    <ResultAnnouncement id="bmr-live" />
  </ResultShell>
</div>

<style>
  /* Sex segmented control: real radios, styled labels, no colour-only meaning. */
  .seg-group {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    padding: 0.125rem;
  }
  .seg {
    position: relative;
    display: inline-flex;
  }
  .seg input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .seg span {
    padding: 0.35rem 0.9rem;
    border-radius: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }
  .seg:has(input:checked) span {
    background: var(--color-brand-600);
    color: #fff;
  }
  .seg:has(input:focus-visible) span {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }

  .unit-btn {
    padding: 0.35rem 0.9rem;
    border-radius: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    cursor: pointer;
  }
  .unit-btn.is-active {
    background: var(--color-brand-600);
    color: #fff;
  }

  .bmr-field-error {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .bmr-field-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .bmr-field-error {
    color: #fca5a5;
  }

  .bmr-live-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* Activity estimates: clearly secondary to the dominant BMR figure above. */
  .bmr-activity-lead {
    margin: 0 0 0.6rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .bmr-activity {
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }
  .bmr-act-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.9rem;
  }
  .bmr-act-row:last-child {
    border-bottom: 0;
  }
  .bmr-act-row dt {
    color: var(--fg);
    font-weight: 600;
  }
  .bmr-act-row dt span {
    display: block;
    font-weight: 400;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .bmr-act-row dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    color: var(--heading);
    white-space: nowrap;
  }
  .bmr-act-row dd::after {
    content: ' kcal';
    font-weight: 400;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .bmr-activity-note {
    margin: 0.7rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .bmr-footnote {
    margin-top: 1rem;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--muted);
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { bmrBinding, BMR_EXAMPLE_VALUES } from '@lib/calculators/bmr-form';

  document.querySelectorAll<HTMLElement>('[data-bmr]').forEach((root) =>
    mountFormCalculator(root, bmrBinding, {
      recalculationMode: 'live-after-first',
      example: { values: BMR_EXAMPLE_VALUES },
      calculateButtonLabel: 'Calculate BMR',
    }),
  );
</script>
