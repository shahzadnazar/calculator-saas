---
/**
 * Sales-tax calculator island (R8A1 — standard-form wave, calculator #13; product
 * family MULTI-MODE, on the standard-form runtime UNCHANGED).
 *
 * Task-first, direct-intent: mode defaults to Add tax, the amount + rate start EMPTY,
 * the result is empty (an instruction, not the legacy $100 / 7.25% sample), and the
 * visitor presses "Add Sales Tax" (or "Remove Sales Tax") for the first result.
 * Live-after-first afterwards. Compute, validation, state, announcement and focus are
 * owned by the shared runtime (UNCHANGED) + the sales-tax binding
 * (@lib/calculators/sales-tax-form).
 *
 * Mode is a native radio group — a STRUCTURAL selector the runtime recomputes on
 * (like calorie's goal). The island OWNS the visible mode presentation: the amount +
 * action labels change with the mode, and on a mode switch the mode-owned result is
 * briefly blanked so no stale values show under the new mode while the runtime's
 * live recompute is pending. The binding owns formula selection, the mode-specific
 * dominant result, the USD announcement and clearing the values on reset.
 */
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import ResultInterpretation from '@components/result/ResultInterpretation.astro';
import ResultBreakdown from '@components/result/ResultBreakdown.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
---

<div class="salestax mx-auto grid w-full max-w-4xl gap-6 md:grid-cols-2 md:items-start" data-tax>
  <!-- Inputs -->
  <form class="card p-4" data-form novalidate aria-label="Sales tax calculator">
    <fieldset class="tax-modes">
      <legend class="field-label">Calculation</legend>
      <div class="seg-group">
        <label class="seg"><input type="radio" name="mode" value="add" checked /><span>Add tax</span></label>
        <label class="seg"><input type="radio" name="mode" value="remove" /><span>Remove tax</span></label>
      </div>
    </fieldset>

    <div class="mt-5 space-y-4">
      <div data-field="amount">
        <label class="field-label" for="tax-amount" data-tax-amount-label>Amount before tax</label>
        <div class="flex">
          <span class="field-affix rounded-l-lg border-r-0">$</span>
          <input
            class="field rounded-l-none"
            id="tax-amount"
            name="amount"
            type="number"
            min="0"
            step="0.01"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 100"
            aria-describedby="tax-amount-error"
          />
        </div>
        <p class="tax-field-error" id="tax-amount-error" data-error-for="amount" hidden></p>
      </div>

      <div data-field="rate">
        <label class="field-label" for="tax-rate">Sales tax rate</label>
        <div class="flex">
          <input
            class="field rounded-r-none"
            id="tax-rate"
            name="rate"
            type="number"
            min="0"
            step="0.01"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 7.25"
            aria-describedby="tax-rate-error"
          />
          <span class="field-affix rounded-r-lg border-l-0">%</span>
        </div>
        <p class="tax-field-error" id="tax-rate-error" data-error-for="rate" hidden></p>
      </div>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <button type="submit" class="btn btn-primary" data-tax-submit>Add Sales Tax</button>
      <button type="button" class="btn btn-secondary" data-reset>Reset</button>
    </div>
    <p class="tax-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result -->
  <ResultShell
    id="tax-result"
    state="empty"
    density="standard"
    label="Sales tax result"
    minHeight="20rem"
    placeholderAlignment="center"
  >
    <EmptyResult message="Enter an amount and tax rate, then add or remove sales tax." />

    <div data-result-when="valid">
      <ResultSummary label="Total including sales tax">
        <ResultValue value="—" />
      </ResultSummary>
      <ResultInterpretation>
        <span data-tax-interpretation></span>
      </ResultInterpretation>

      <ResultBreakdown title="Breakdown">
        <dl class="tax-metrics">
          <div><dt data-tax-sec1-label>—</dt><dd data-tax-sec1>—</dd></div>
          <div><dt data-tax-sec2-label>—</dt><dd data-tax-sec2>—</dd></div>
        </dl>
        <p class="tax-note">Amounts are in US dollars (USD).</p>
      </ResultBreakdown>
    </div>

    <InvalidResult title="Check your entries" message="Enter an amount and a sales-tax rate to calculate." />

    <ResultAnnouncement id="tax-live" />
  </ResultShell>
</div>

<style>
  .tax-modes {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .seg-group {
    display: inline-flex;
    margin-top: 0.4rem;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    padding: 0.125rem;
  }
  .seg {
    position: relative;
    display: inline-flex;
  }
  .seg input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .seg span {
    padding: 0.35rem 0.9rem;
    border-radius: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }
  .seg:has(input:checked) span {
    background: var(--color-brand-600);
    color: #fff;
  }
  .seg:has(input:focus-visible) span {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }

  .tax-field-error {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .tax-field-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .tax-field-error {
    color: #fca5a5;
  }

  .tax-live-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .tax-metrics {
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }
  .tax-metrics > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .tax-metrics dt {
    color: var(--fg);
    font-weight: 600;
  }
  .tax-metrics dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--heading);
    font-weight: 700;
    white-space: nowrap;
  }
  .tax-note {
    margin: 0.7rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { salesTaxBinding } from '@lib/calculators/sales-tax-form';

  document.querySelectorAll<HTMLElement>('[data-tax]').forEach((root) => {
    mountFormCalculator(root, salesTaxBinding, {
      recalculationMode: 'live-after-first',
      calculateButtonLabel: 'Add Sales Tax',
    });

    // The island owns the visible mode presentation. The runtime recomputes on the
    // mode radio's structural `input` (unchanged); here we keep the amount + action
    // labels in step and, on a switch, blank the mode-owned result so no stale value
    // shows under the new mode while the live recompute is pending.
    const amountLabel = root.querySelector<HTMLElement>('[data-tax-amount-label]');
    const submitBtn = root.querySelector<HTMLElement>('[data-tax-submit]');
    const shell = root.querySelector<HTMLElement>('[data-result-shell]');
    const isRemove = () => root.querySelector<HTMLInputElement>('[name="mode"]:checked')?.value === 'remove';
    const syncMode = () => {
      if (amountLabel) amountLabel.textContent = isRemove() ? 'Total amount including tax' : 'Amount before tax';
      if (submitBtn) submitBtn.textContent = isRemove() ? 'Remove Sales Tax' : 'Add Sales Tax';
    };
    const blankResult = () => {
      for (const sel of [
        '[data-result-when~="valid"] [data-result-value]',
        '[data-tax-interpretation]',
        '[data-tax-sec1]',
        '[data-tax-sec2]',
      ]) {
        const el = root.querySelector<HTMLElement>(sel);
        if (el) el.textContent = '—';
      }
    };
    root.querySelectorAll<HTMLInputElement>('[name="mode"]').forEach((r) =>
      r.addEventListener('change', () => {
        syncMode();
        if (shell?.dataset.resultState === 'valid') blankResult();
      }),
    );
    root.querySelector<HTMLElement>('[data-reset]')?.addEventListener('click', () => {
      const add = root.querySelector<HTMLInputElement>('[name="mode"][value="add"]');
      if (add) add.checked = true;
      syncMode();
    });
    syncMode();
  });
</script>
