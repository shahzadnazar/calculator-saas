---
/**
 * Sales tax island — the reference's three-field solver on the UNCHANGED standard-form
 * runtime.
 *
 * Before-tax price, sales tax rate, after-tax price: fill any two, leave one blank, and the
 * blank one is what gets worked out. There is deliberately NO mode selector — the blank
 * field is the mode, which is one fewer control to get out of step with the values.
 *
 * All three start empty, because none of them is more "the input" than the others.
 */
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import ResultInterpretation from '@components/result/ResultInterpretation.astro';
import ResultBreakdown from '@components/result/ResultBreakdown.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';
---

<div class="stcalc mx-auto grid w-full max-w-4xl gap-6 md:grid-cols-2 md:items-start" data-sales-tax>
  <!-- Inputs -->
  <form class="card p-4" data-form novalidate aria-label="Sales tax calculator">
    <p class="st-lede">Fill in any two and leave the third blank — that is the one worked out.</p>

    <div class="st-fields">
      <div class="st-row" data-field="beforeTax">
        <label class="field-label st-row__label" for="st-before">Before Tax Price</label>
        <div class="st-money">
          <span class="st-affix">$</span>
          <input class="field st-input" id="st-before" name="beforeTax" type="number" min="0" step="any" inputmode="decimal" autocomplete="off" placeholder="100" aria-describedby="st-before-error" />
        </div>
      </div>
      <p class="st-error" id="st-before-error" data-error-for="beforeTax" hidden></p>

      <div class="st-row" data-field="rate">
        <label class="field-label st-row__label" for="st-rate">Sales Tax Rate</label>
        <div class="st-money">
          <input class="field st-input st-input--pct" id="st-rate" name="rate" type="number" step="any" inputmode="decimal" autocomplete="off" placeholder="6.5" aria-describedby="st-rate-error" />
          <span class="st-affix st-affix--suffix">%</span>
        </div>
      </div>
      <p class="st-error" id="st-rate-error" data-error-for="rate" hidden></p>

      <div class="st-row" data-field="afterTax">
        <label class="field-label st-row__label" for="st-after">After Tax Price</label>
        <div class="st-money">
          <span class="st-affix">$</span>
          <input class="field st-input" id="st-after" name="afterTax" type="number" min="0" step="any" inputmode="decimal" autocomplete="off" placeholder="106.50" aria-describedby="st-after-error" />
        </div>
      </div>
      <p class="st-error" id="st-after-error" data-error-for="afterTax" hidden></p>
    </div>

    <div class="st-actions">
      <button type="submit" class="btn btn-primary st-btn">Calculate</button>
      <button type="button" class="btn btn-secondary st-btn" data-reset>Clear</button>
    </div>
    <p class="st-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result -->
  <ResultShell id="st-result" state="example" density="standard" label="Sales tax result" minHeight="16rem" placeholderAlignment="center">
    <ExampleNotice caption="Sample: $100 before tax at a 6.5% rate." />
    <EmptyResult message="Enter any two of the three, then calculate." />

    <div data-result-when="valid">
      <ResultSummary label="After Tax Price">
        <ResultValue value="—" size="text-4xl" />
      </ResultSummary>
      <ResultInterpretation>
        <span data-st-interpretation></span>
      </ResultInterpretation>

      <ResultBreakdown title="All three">
        <dl class="st-metrics">
          <div><dt>Before Tax Price</dt><dd data-st-before>—</dd></div>
          <div><dt>Sales Tax</dt><dd data-st-tax>—</dd></div>
          <div><dt>After Tax Price</dt><dd data-st-after>—</dd></div>
        </dl>
      </ResultBreakdown>
    </div>

    <InvalidResult
      title="Check your entries"
      message="Fill in exactly two of the three, using prices of zero or more and a rate above -100%."
    />

    <ResultAnnouncement id="st-live" />
  </ResultShell>
</div>

<style>
  .st-lede {
    margin: 0 0 0.75rem;
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .st-fields {
    display: grid;
    gap: 0.15rem;
  }

  .st-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.3rem 0;
  }
  .st-row__label {
    margin: 0;
    font-size: 0.9rem;
  }

  .st-money {
    display: inline-flex;
    align-items: stretch;
    flex: 0 0 auto;
  }
  .st-affix {
    display: inline-flex;
    align-items: center;
    padding: 0 0.55rem;
    border: 1px solid var(--line);
    border-right: 0;
    border-radius: 0.5rem 0 0 0.5rem;
    background: var(--surface-2, transparent);
    font-size: 0.9rem;
    color: var(--muted);
  }
  .st-affix--suffix {
    border-right: 1px solid var(--line);
    border-left: 0;
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .st-input {
    width: 9rem;
    min-height: 2.75rem;
    border-radius: 0 0.5rem 0.5rem 0;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .st-input--pct {
    border-radius: 0.5rem 0 0 0.5rem;
  }

  .st-error {
    margin: 0 0 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .st-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .st-error {
    color: #fca5a5;
  }

  .st-actions {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .st-btn {
    min-height: 2.75rem;
  }
  .st-live-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .st-metrics {
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }
  .st-metrics > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .st-metrics > div:last-child {
    border-bottom: 0;
  }
  .st-metrics dt {
    color: var(--fg);
    font-weight: 600;
  }
  .st-metrics dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--heading);
    font-weight: 700;
    white-space: nowrap;
  }

  @media (max-width: 26rem) {
    .st-row {
      flex-wrap: wrap;
    }
    .st-input {
      width: 7rem;
    }
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { salesTaxBinding, SALES_TAX_EXAMPLE_VALUES } from '@lib/calculators/sales-tax-form';

  document.querySelectorAll<HTMLElement>('[data-sales-tax]').forEach((root) => {
    mountFormCalculator(root, salesTaxBinding, {
      recalculationMode: 'live-after-first',
      example: { values: SALES_TAX_EXAMPLE_VALUES },
      calculateButtonLabel: 'Calculate',
    });

    // Blank the three figures whenever the shell leaves the valid state, so nothing stale
    // lingers behind the hidden valid region. Presentation only.
    const shell = root.querySelector<HTMLElement>('[data-result-shell]');
    if (shell) {
      new MutationObserver(() => {
        if (shell.dataset.resultState === 'valid') return;
        root.querySelectorAll<HTMLElement>('[data-st-before], [data-st-tax], [data-st-after]').forEach((el) => {
          el.textContent = '—';
        });
      }).observe(shell, { attributes: true, attributeFilter: ['data-result-state'] });
    }
  });
</script>
