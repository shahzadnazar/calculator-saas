---
/**
 * Square footage island — the reference's NINE independent calculators, stacked.
 *
 * Rectangle, Rectangle Border, Circle, Ring, Triangle with Edge Lengths, Triangle with Base &
 * Height, Trapezoid, Sector and Parallelogram. Each is its own calculator: its own fields, its own
 * Calculate button and its own result, none of them touching another. A visitor sizing a patio and
 * its surround can leave the first answer on screen while working out the second.
 *
 * The nine sections are RENDERED FROM `SHAPES`, not written out nine times. A shape is a list of
 * fields plus one area formula, so the markup is a loop over the same specs the binding is built
 * from, and the two can never drift: add a spec and the section, the mount and the tests follow.
 *
 * Each dimension is a number and its own unit on ONE row, as the reference has it — a length in
 * inches beside a width in feet is a normal way to have measured a room. Quantity defaults to 1 (a
 * neutral structural default, the only pre-filled field); every measurement starts EMPTY and every
 * result starts as a labelled example, never as a sample result in the visitor's own panel.
 *
 * All nine run on the UNCHANGED standard-form runtime, one mount per section, sharing one binding
 * built by `makeShapeBinding`. The complete-result guard lives in each binding's `resultValue`;
 * none of them uses `isUsableResult`.
 *
 * Static ids are namespaced per-instance WHEN more than one square-footage page shares a document
 * (the R16B2.1 discipline), so an embed gallery has no duplicate ids.
 */
import ResultShell from '@components/result/ResultShell.astro';
import ResultValue from '@components/result/ResultValue.astro';
import ResultBreakdown from '@components/result/ResultBreakdown.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';
import { SHAPES } from '@lib/calculators/square-footage-form';
import { LENGTH_UNITS, ANGLE_UNITS, AREA_UNITS } from '@lib/calculators/square-footage';

/** One small line drawing per shape, so a section is recognisable before it is read. */
const DIAGRAMS: Record<string, string> = {
  rectangle: '<rect x="8" y="14" width="104" height="52" />',
  'rectangle-border':
    '<rect x="8" y="14" width="104" height="52" /><rect x="20" y="24" width="80" height="32" stroke-dasharray="4 3" />',
  circle: '<circle cx="60" cy="40" r="26" />',
  ring: '<circle cx="60" cy="40" r="26" /><circle cx="60" cy="40" r="18" stroke-dasharray="4 3" />',
  'triangle-edges': '<polygon points="10,66 110,66 78,14" />',
  'triangle-base':
    '<polygon points="10,66 110,66 78,14" /><line x1="78" y1="14" x2="78" y2="66" stroke-dasharray="4 3" />',
  trapezoid: '<polygon points="10,66 110,66 88,14 32,14" />',
  sector: '<path d="M60 66 L60 14 A52 52 0 0 1 112 66 Z" />',
  parallelogram: '<polygon points="10,66 86,66 110,14 34,14" />',
};
---

<div class="sfpage mx-auto w-full max-w-4xl" data-sfpage>
  {
    SHAPES.map((spec) => (
      <section class="sf-calc" data-sf-shape={spec.key} aria-labelledby={`sf-${spec.key}-heading`}>
        <div class="sf-head">
          <svg class="sf-diagram" viewBox="0 0 120 80" aria-hidden="true" focusable="false" set:html={DIAGRAMS[spec.key]} />
          <div>
            <h2 class="sf-title" id={`sf-${spec.key}-heading`}>{spec.title}</h2>
            <p class="sf-lede">{spec.lede}</p>
          </div>
        </div>

        <div class="grid gap-6 md:grid-cols-2 md:items-start">
          <form class="card p-4" data-form novalidate aria-label={`${spec.title} square footage calculator`}>
            {spec.fields.map((f) => (
              <div class="sf-field" data-field={f.name}>
                <div class="sf-row">
                  <label class="field-label sf-row__label" for={`sf-${spec.key}-${f.name}`}>
                    {f.label}:
                  </label>
                  <div class="sf-row__control">
                    <input
                      class="field sf-num"
                      id={`sf-${spec.key}-${f.name}`}
                      name={f.name}
                      type="number"
                      min="0"
                      step="any"
                      inputmode="decimal"
                      autocomplete="off"
                      aria-describedby={`sf-${spec.key}-${f.name}-error`}
                    />
                    <select
                      class="field sf-unit"
                      name={`${f.name}Unit`}
                      aria-label={`${f.label} unit`}
                    >
                      {(f.kind === 'angle' ? ANGLE_UNITS : LENGTH_UNITS).map((u) => (
                        <option value={u.value}>{u.label}</option>
                      ))}
                    </select>
                  </div>
                </div>
                <p class="sf-field-error" id={`sf-${spec.key}-${f.name}-error`} data-error-for={f.name} hidden />
              </div>
            ))}

            <div class="sf-field" data-field="quantity">
              <div class="sf-row">
                <label class="field-label sf-row__label" for={`sf-${spec.key}-quantity`}>Quantity:</label>
                <div class="sf-row__control">
                  <input
                    class="field sf-num"
                    id={`sf-${spec.key}-quantity`}
                    name="quantity"
                    type="number"
                    min="1"
                    step="1"
                    value="1"
                    inputmode="numeric"
                    autocomplete="off"
                    aria-describedby={`sf-${spec.key}-quantity-error`}
                  />
                  <span class="sf-unit-note">identical areas</span>
                </div>
              </div>
              <p class="sf-field-error" id={`sf-${spec.key}-quantity-error`} data-error-for="quantity" hidden />
            </div>

            <div class="sf-field" data-field="price">
              <div class="sf-row">
                <label class="field-label sf-row__label" for={`sf-${spec.key}-price`}>
                  Price <span class="sf-optional">(optional)</span>:
                </label>
                <div class="sf-row__control">
                  <span class="sf-currency" aria-hidden="true">$</span>
                  <input
                    class="field sf-num sf-num--price"
                    id={`sf-${spec.key}-price`}
                    name="price"
                    type="number"
                    min="0"
                    step="any"
                    inputmode="decimal"
                    autocomplete="off"
                    aria-describedby={`sf-${spec.key}-price-error`}
                  />
                  <span class="sf-per">per</span>
                  <select class="field sf-unit" name="priceUnit" aria-label="Price unit">
                    {AREA_UNITS.map((u) => (
                      <option value={u.value}>{u.label}</option>
                    ))}
                  </select>
                </div>
              </div>
              <p class="sf-field-error" id={`sf-${spec.key}-price-error`} data-error-for="price" hidden />
            </div>

            <div class="mt-4 flex items-center gap-3">
              <button type="submit" class="btn btn-primary">Calculate {spec.title}</button>
              <button type="button" class="btn btn-secondary" data-reset>Clear</button>
            </div>
            <p class="sf-live-note" data-live-note hidden>Changes update automatically.</p>
          </form>

          <ResultShell
            id={`sf-${spec.key}-result`}
            state="empty"
            density="standard"
            label={`${spec.title} area result`}
            minHeight="16rem"
            placeholderAlignment="center"
          >
            <ExampleNotice />
            <EmptyResult message={`Enter the ${spec.fields.map((f) => f.label.toLowerCase()).join(' and ')}, then calculate the area.`} />

            <div data-result-when="valid">
              <p class="sf-result-label">Area =</p>
              <ResultValue value="—" size="text-3xl" unit="" />
              <p class="sf-area-unit" data-sf-area-unit>Square Feet</p>
              <p class="sf-quantity-note" data-sf-quantity-note hidden />

              <div class="sf-cost" data-sf-cost-row hidden>
                <span data-sf-cost-label></span>
                <strong data-sf-cost>—</strong>
              </div>

              <ResultBreakdown title="The same area in other units">
                <dl class="sf-others">
                  {AREA_UNITS.filter((u) => u.value !== 'sqft').map((u) => (
                    <div data-sf-other={u.value}>
                      <dt>{u.plural}</dt>
                      <dd data-sf-other-value>—</dd>
                    </div>
                  ))}
                </dl>
              </ResultBreakdown>
            </div>

            <InvalidResult
              title="Check your entries"
              message="Every measurement must be a number greater than zero."
            />

            <ResultAnnouncement id={`sf-${spec.key}-live`} />
          </ResultShell>
        </div>
      </section>
    ))
  }
</div>

<style>
  .sf-calc + .sf-calc {
    margin-top: 2rem;
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }

  .sf-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .sf-diagram {
    flex: none;
    width: 3.25rem;
    height: 2.2rem;
    fill: none;
    stroke: var(--muted);
    stroke-width: 5;
    stroke-linejoin: round;
    opacity: 0.7;
  }
  .sf-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--heading);
  }
  .sf-lede {
    margin: 0.1rem 0 0;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .sf-field + .sf-field {
    margin-top: 0.4rem;
  }
  /* Label, then the number and its unit together on one row — the reference's anatomy. */
  .sf-row {
    display: grid;
    grid-template-columns: minmax(0, 8rem) minmax(0, 1fr);
    align-items: center;
    gap: 0.5rem;
  }
  .sf-row__label {
    margin: 0;
  }
  .sf-row__control {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
  }
  .sf-num {
    flex: 1 1 0;
    min-width: 0;
    min-height: 2.75rem;
    font-variant-numeric: tabular-nums;
  }
  .sf-num--price {
    flex: 1 1 4rem;
  }
  .sf-unit {
    flex: 0 1 auto;
    width: auto;
    min-width: 0;
    min-height: 2.75rem;
    font-size: 0.86rem;
  }
  .sf-unit-note,
  .sf-per,
  .sf-currency {
    flex: none;
    font-size: 0.84rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .sf-optional {
    font-weight: 400;
    color: var(--muted);
  }

  @media (max-width: 30rem) {
    .sf-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.2rem;
    }
  }

  .sf-field-error {
    margin: 0.3rem 0 0;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.3;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .sf-field-error { color: #fca5a5; }
  }
  :root[data-theme='dark'] .sf-field-error { color: #fca5a5; }

  .sf-live-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .sf-result-label {
    margin: 0 0 0.1rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--fg);
  }
  /* The figure is printed unrounded, so it has to be allowed to wrap. */
  .sf-calc :global([data-result-value]) {
    overflow-wrap: anywhere;
    line-height: 1.15;
  }
  .sf-area-unit {
    margin: 0.15rem 0 0;
    font-size: 1rem;
    font-weight: 700;
    color: var(--muted);
  }
  .sf-quantity-note {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .sf-cost {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.75rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
    color: var(--fg);
  }
  .sf-cost strong {
    color: var(--heading);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .sf-others {
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }
  .sf-others > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.92rem;
  }
  .sf-others dt {
    color: var(--fg);
    font-weight: 600;
  }
  .sf-others dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--heading);
    font-weight: 700;
    text-align: right;
    overflow-wrap: anywhere;
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { SHAPES, makeShapeBinding, shapeExampleValues } from '@lib/calculators/square-footage-form';

  function uniquifyStaticIds(root: HTMLElement, suffix: string): void {
    const remap = new Map<string, string>();
    root.querySelectorAll<HTMLElement>('[id]').forEach((el) => {
      const next = `${el.id}-${suffix}`;
      remap.set(el.id, next);
      el.id = next;
    });
    const repoint = (attr: string) =>
      root.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((el) => {
        const next = el
          .getAttribute(attr)!
          .split(/\s+/)
          .map((token) => remap.get(token) ?? token)
          .join(' ');
        el.setAttribute(attr, next);
      });
    repoint('for');
    repoint('aria-describedby');
    repoint('aria-labelledby');
    repoint('aria-controls');
  }

  const pages = document.querySelectorAll<HTMLElement>('[data-sfpage]');
  pages.forEach((page, i) => {
    if (pages.length > 1) uniquifyStaticIds(page, `s${i + 1}`);

    for (const spec of SHAPES) {
      const section = page.querySelector<HTMLElement>(`[data-sf-shape="${spec.key}"]`);
      if (!section) continue;
      mountFormCalculator(section, makeShapeBinding(spec), {
        recalculationMode: 'live-after-first',
        example: { values: shapeExampleValues(spec) },
        calculateButtonLabel: `Calculate ${spec.title}`,
      });
    }
  });
</script>
