---
/**
 * Ideal-weight island — the reference's fields and its result table, on the UNCHANGED
 * standard-form runtime.
 *
 * Three tabs, two of which are unit systems. "US Units" and "Metric Units" are the runtime's
 * own unit axis: switching one relabels the height boxes and CONVERTS what is already typed,
 * because the visitor measured a body, not a number. "Other Units" is not a third system —
 * it opens the shared `UnitConverterPanel` ABOVE the calculator, exactly where the reference
 * puts it, and leaves the selected system alone.
 *
 * The DOMINANT result is the band the four formulas agree on; beneath it sits the
 * reference's table row for row — Robinson, Miller, Devine, Hamwi and the healthy BMI range.
 *
 * Age changes no number. Below 18 the adult formulas do not apply at all, so the panel says
 * so and points at BMI-for-age instead — a valid informational result, not an error.
 */
import { UNIT_TABS, FORMULA_ROWS, ADULT_MIN_AGE, AGE_MIN, AGE_MAX } from '@lib/calculators/ideal-weight-form';
import UnitConverterPanel from '@components/calc/UnitConverterPanel.astro';
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultInterpretation from '@components/result/ResultInterpretation.astro';
import ResultBreakdown from '@components/result/ResultBreakdown.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';
---

<div class="iwwrap mx-auto w-full max-w-4xl" data-idealweight>
  <UnitConverterPanel id="iw-converter" />

  <div class="iwcalc grid gap-6 md:grid-cols-2 md:items-start">
    <!-- Inputs -->
    <form class="card p-4" data-form novalidate aria-label="Ideal weight calculator">
      <div class="iw-tabs">
        <div class="iw-tabs__systems" role="radiogroup" aria-label="Unit system">
          {UNIT_TABS.map((t, i) => (
            <button type="button" class:list={['iw-tab', i === 0 && 'is-active']} data-unit={t.value} role="radio" aria-checked={i === 0 ? 'true' : 'false'}>
              {t.label}
            </button>
          ))}
        </div>
        <button type="button" class="iw-tab iw-tab--toggle" data-converter-toggle aria-expanded="false" aria-controls="iw-converter">
          Other Units
        </button>
      </div>

      <div class="iw-row" data-field="age">
        <label class="field-label iw-row__label" for="iw-age">Age</label>
        <div class="iw-inputs">
          <input class="field iw-input" id="iw-age" name="age" type="number" min={AGE_MIN} max={AGE_MAX} step="1" inputmode="numeric" autocomplete="off" placeholder="25" aria-describedby="iw-age-error" />
          <span class="iw-hint">ages {AGE_MIN} - {AGE_MAX}</span>
        </div>
      </div>
      <p class="iw-error" id="iw-age-error" data-error-for="age" hidden></p>

      <fieldset class="iw-row iw-row--radios" data-field="sex">
        <legend class="field-label iw-row__label">Gender</legend>
        <div class="iw-radios">
          <label class="iw-radio"><input type="radio" name="sex" value="male" checked /><span>male</span></label>
          <label class="iw-radio"><input type="radio" name="sex" value="female" /><span>female</span></label>
        </div>
      </fieldset>

      <div class="iw-row" data-group="imperial" data-field="height">
        <label class="field-label iw-row__label" for="iw-ft">Height</label>
        <div class="iw-inputs">
          <div class="iw-pair">
            <input class="field iw-input" id="iw-ft" name="heightFt" type="number" min="0" step="1" inputmode="numeric" autocomplete="off" placeholder="5" aria-label="Height, feet" aria-describedby="iw-height-error" />
            <span class="iw-unit">feet</span>
          </div>
          <div class="iw-pair">
            <input class="field iw-input" id="iw-in" name="heightIn" type="number" min="0" max="11" step="1" inputmode="numeric" autocomplete="off" placeholder="10" aria-label="Height, inches" aria-describedby="iw-height-error" />
            <span class="iw-unit">inches</span>
          </div>
        </div>
      </div>
      <p class="iw-error" id="iw-height-error" data-error-for="height" hidden></p>

      <div class="iw-row" data-group="metric" data-field="heightCm" hidden>
        <label class="field-label iw-row__label" for="iw-cm">Height</label>
        <div class="iw-inputs">
          <div class="iw-pair">
            <input class="field iw-input iw-input--wide" id="iw-cm" name="heightCm" type="number" min="0" step="0.1" inputmode="decimal" autocomplete="off" placeholder="180" aria-describedby="iw-heightCm-error" />
            <span class="iw-unit">cm</span>
          </div>
        </div>
      </div>
      <p class="iw-error" id="iw-heightCm-error" data-error-for="heightCm" hidden></p>

      <div class="mt-5 flex items-center gap-3">
        <button type="submit" class="btn btn-primary">Calculate</button>
        <button type="button" class="btn btn-secondary" data-reset>Clear</button>
      </div>
      <p class="iw-live-note" data-live-note hidden>Changes update automatically.</p>
    </form>

    <!-- Result -->
    <ResultShell
      id="iw-result"
      state="empty"
      density="standard"
      label="Your ideal weight result"
      minHeight="20rem"
      placeholderAlignment="center"
    >
      <ExampleNotice />
      <EmptyResult message="Enter your age, gender and height, then calculate your ideal weight." />

      <div data-result-when="valid">
        <div data-iw-adult>
          <ResultSummary label="Ideal weight for your height">
            <span aria-hidden="true">
              <span class="result-value text-4xl" data-iw-low>—</span><span class="iw-sep">–</span><span class="result-value text-4xl" data-iw-high>—</span>&nbsp;<span class="result-unit" data-iw-unit>kg</span>
            </span>
            <span class="sr-only" data-iw-spread-a11y></span>
          </ResultSummary>
          <ResultInterpretation>
            The band the four popular formulas agree on. The healthy-BMI range below is wider — a
            reminder that healthy weight is a range, not a single number.
          </ResultInterpretation>

          <ResultBreakdown title="The ideal weight based on popular formulas">
            <table class="iw-formulas">
              <thead>
                <tr><th scope="col">Formula</th><th scope="col" class="iw-num">Ideal Weight</th></tr>
              </thead>
              <tbody>
                {FORMULA_ROWS.map((row) => (
                  <tr><th scope="row">{row.label}</th><td class="iw-num" data-iw-row={row.key}>—</td></tr>
                ))}
                <tr class="iw-formulas__range"><th scope="row">Healthy BMI Range</th><td class="iw-num" data-iw-bmirange>—</td></tr>
              </tbody>
            </table>
            <p class="iw-note">
              Classic formulas using height and sex only — reference estimates from different
              equations, not a diagnosis. They ignore frame size and muscle mass, so read the
              spread as a guide rather than a target.
            </p>
          </ResultBreakdown>
        </div>

        <div data-iw-child hidden>
          <ResultSummary label="Ideal weight for your height">
            <span class="iw-child-headline">Not from these formulas</span>
          </ResultSummary>
          <ResultInterpretation>
            Robinson, Miller, Devine and Hamwi were all derived on adults, so they do not apply at
            age <span data-iw-age-echo>—</span>. From {AGE_MIN} to {ADULT_MIN_AGE - 1}, healthy weight is judged from
            BMI-for-age percentiles, which account for the way body fat changes as a child grows —
            the <a href="/health/bmi-calculator">BMI calculator</a> is the right tool for that.
          </ResultInterpretation>
        </div>
      </div>

      <InvalidResult title="Check your entries" message="Enter an age and a height to estimate your ideal weight." />

      <ResultAnnouncement id="iw-live" />
    </ResultShell>
  </div>
</div>

<style>
  .iw-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-bottom: 0.9rem;
  }
  .iw-tabs__systems {
    display: flex;
    gap: 0.3rem;
    border: 0;
    padding: 0;
    margin: 0;
  }
  .iw-tab {
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: var(--card);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--fg);
    cursor: pointer;
  }
  .iw-tab.is-active {
    border-color: var(--color-brand-600);
    background: var(--color-brand-600);
    color: #fff;
  }
  .iw-tab:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }
  .iw-tab--toggle[aria-expanded='true'] {
    border-color: var(--color-brand-600);
    color: var(--color-brand-700);
  }

  .iw-row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.6rem;
    padding: 0.3rem 0;
    border: 0;
    margin: 0;
  }
  .iw-row__label {
    margin: 0;
    font-size: 0.86rem;
  }
  .iw-inputs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .iw-pair {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .iw-input {
    width: 5rem;
    min-height: 2.75rem;
    font-variant-numeric: tabular-nums;
  }
  .iw-input--wide {
    width: 7rem;
  }
  .iw-unit,
  .iw-hint {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .iw-radios {
    display: flex;
    gap: 0.9rem;
  }
  .iw-radio {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    font-size: 0.88rem;
    color: var(--fg);
    cursor: pointer;
  }
  .iw-radio input {
    width: 1.05rem;
    height: 1.05rem;
    accent-color: var(--color-brand-600);
  }
  .iw-error {
    margin: 0.1rem 0 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .iw-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .iw-error {
    color: #fca5a5;
  }
  .iw-live-note {
    margin-top: 0.7rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* The dash belongs to the headline, so it takes the headline's size — at the default
     body size it reads as a subscript wedged between two big numbers. */
  .iw-sep {
    margin: 0 0.3rem;
    font-size: 1.6rem;
    line-height: 1;
    vertical-align: 0.12em;
    color: var(--muted);
    font-weight: 600;
  }
  .iw-child-headline {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--heading);
  }

  .iw-formulas {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .iw-formulas th,
  .iw-formulas td {
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }
  .iw-formulas thead th {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    font-weight: 700;
  }
  .iw-formulas tbody th {
    font-weight: 600;
    color: var(--fg);
  }
  .iw-num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .iw-formulas tbody td {
    font-weight: 700;
    color: var(--heading);
  }
  .iw-formulas__range th,
  .iw-formulas__range td {
    border-bottom: 0;
  }
  .iw-note {
    margin: 0.7rem 0 0;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--muted);
  }

  @media (max-width: 26rem) {
    .iw-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { mountUnitConverterPanel } from '@lib/calculators/unit-converter-panel';
  import { idealWeightBinding, IDEAL_WEIGHT_EXAMPLE_VALUES } from '@lib/calculators/ideal-weight-form';

  document.querySelectorAll<HTMLElement>('[data-idealweight]').forEach((root) => {
    mountFormCalculator(root, idealWeightBinding, {
      recalculationMode: 'live-after-first',
      example: { values: IDEAL_WEIGHT_EXAMPLE_VALUES },
      calculateButtonLabel: 'Calculate',
    });

    // The "Other Units" converter, shared with the body-fat calculator.
    mountUnitConverterPanel(root);
  });
</script>
