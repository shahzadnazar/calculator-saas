---
/**
 * Ideal-weight calculator island (R7C-1 — standard-form wave).
 *
 * Task-first, direct-intent: height starts EMPTY, the result is empty (an
 * instruction, no sample weight), and the visitor presses "Calculate Ideal
 * Weight" for the first result. Live-after-first afterwards. All interaction,
 * validation, state, announcement and focus are owned by the shared standard-form
 * runtime; this island is markup + the ideal-weight binding
 * (@lib/calculators/ideal-weight-form).
 *
 * The DOMINANT result is the healthy-BMI weight range (the defensible primary the
 * copy frames as the target); the four classic formulas (Robinson/Miller/Devine/
 * Hamwi) are a SECONDARY, accessible comparison — no average is invented and no
 * single formula is presented as authoritative.
 */
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultInterpretation from '@components/result/ResultInterpretation.astro';
import ResultBreakdown from '@components/result/ResultBreakdown.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
---

<div class="iw mx-auto grid w-full max-w-4xl gap-6 md:grid-cols-2 md:items-start" data-idealweight>
  <!-- Inputs -->
  <form class="card p-5 sm:p-6" data-form novalidate aria-label="Ideal weight calculator">
    <div class="flex flex-wrap gap-3">
      <fieldset class="seg-group">
        <legend class="sr-only">Sex</legend>
        <label class="seg"><input type="radio" name="sex" value="male" checked /><span>Male</span></label>
        <label class="seg"><input type="radio" name="sex" value="female" /><span>Female</span></label>
      </fieldset>
      <div class="inline-flex rounded-lg border p-0.5" role="radiogroup" aria-label="Unit system" style="border-color: var(--line)">
        <button type="button" class="unit-btn is-active" data-unit="metric" role="radio" aria-checked="true">Metric</button>
        <button type="button" class="unit-btn" data-unit="imperial" role="radio" aria-checked="false">Imperial (US)</button>
      </div>
    </div>

    <div class="mt-5">
      <div data-group="metric" data-field="heightCm">
        <label class="field-label" for="iw-cm">Height</label>
        <div class="flex">
          <input class="field rounded-r-none" id="iw-cm" name="heightCm" type="number" min="0" step="0.1" inputmode="decimal" autocomplete="off" placeholder="e.g. 175" aria-describedby="iw-heightCm-error" />
          <span class="field-affix rounded-r-lg border-l-0">cm</span>
        </div>
        <p class="iw-field-error" id="iw-heightCm-error" data-error-for="heightCm" hidden></p>
      </div>
      <div data-group="imperial" data-field="height" hidden>
        <label class="field-label" for="iw-ft">Height</label>
        <div class="grid grid-cols-2 gap-3">
          <div class="flex">
            <input class="field rounded-r-none" id="iw-ft" name="heightFt" type="number" min="0" step="1" inputmode="numeric" autocomplete="off" placeholder="5" aria-label="Height, feet" aria-describedby="iw-height-error" />
            <span class="field-affix rounded-r-lg border-l-0">ft</span>
          </div>
          <div class="flex">
            <input class="field rounded-r-none" id="iw-in" name="heightIn" type="number" min="0" max="11" step="1" inputmode="numeric" autocomplete="off" placeholder="9" aria-label="Height, inches" aria-describedby="iw-height-error" />
            <span class="field-affix rounded-r-lg border-l-0">in</span>
          </div>
        </div>
        <p class="iw-field-error" id="iw-height-error" data-error-for="height" hidden></p>
      </div>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <button type="submit" class="btn btn-primary">Calculate Ideal Weight</button>
      <button type="button" class="btn btn-secondary" data-reset>Reset</button>
    </div>
    <p class="iw-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result -->
  <ResultShell
    id="iw-result"
    state="empty"
    density="standard"
    label="Your ideal weight result"
    minHeight="20rem"
    placeholderAlignment="center"
  >
    <EmptyResult message="Enter your height, then calculate your ideal weight range." />

    <div data-result-when="valid">
      <ResultSummary label="Healthy weight range for your height">
        <span class="iw-range">
          <span aria-hidden="true">
            <span class="result-value text-4xl" data-iw-bmimin>—</span><span class="iw-range-sep">–</span><span class="result-value text-4xl" data-iw-bmimax>—</span>&nbsp;<span class="result-unit" data-iw-unit>kg</span>
          </span>
          <span class="sr-only" data-iw-range-a11y></span>
        </span>
      </ResultSummary>
      <ResultInterpretation>
        The weight range for a healthy BMI (18.5–24.9) at your height.
      </ResultInterpretation>

      <ResultBreakdown title="Ideal-weight formula estimates">
        <table class="iw-formulas">
          <thead>
            <tr><th scope="col">Formula</th><th scope="col" class="iw-num">Estimate</th></tr>
          </thead>
          <tbody>
            <tr><th scope="row">Robinson <span>1983</span></th><td class="iw-num" data-iw-robinson>—</td></tr>
            <tr><th scope="row">Miller <span>1983</span></th><td class="iw-num" data-iw-miller>—</td></tr>
            <tr><th scope="row">Devine <span>1974</span></th><td class="iw-num" data-iw-devine>—</td></tr>
            <tr><th scope="row">Hamwi <span>1964</span></th><td class="iw-num" data-iw-hamwi>—</td></tr>
          </tbody>
        </table>
        <p class="iw-note">
          Classic formulas using height and sex only — reference estimates from different equations, not a diagnosis. Treat the spread as a range.
        </p>
      </ResultBreakdown>
    </div>

    <InvalidResult title="Check your height" message="Enter your height to estimate your ideal weight range." />

    <ResultAnnouncement id="iw-live" />
  </ResultShell>
</div>

<style>
  .seg-group {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    padding: 0.125rem;
  }
  .seg {
    position: relative;
    display: inline-flex;
  }
  .seg input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .seg span {
    padding: 0.35rem 0.9rem;
    border-radius: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }
  .seg:has(input:checked) span {
    background: var(--color-brand-600);
    color: #fff;
  }
  .seg:has(input:focus-visible) span {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }
  .unit-btn {
    padding: 0.35rem 0.9rem;
    border-radius: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    cursor: pointer;
  }
  .unit-btn.is-active {
    background: var(--color-brand-600);
    color: #fff;
  }
  .iw-field-error {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .iw-field-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .iw-field-error {
    color: #fca5a5;
  }
  .iw-live-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* Primary range — dominant */
  .iw-range-sep {
    margin: 0 0.15rem;
    color: var(--muted);
    font-weight: 600;
  }

  /* Secondary formula comparison table */
  .iw-formulas {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .iw-formulas th,
  .iw-formulas td {
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }
  .iw-formulas thead th {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    font-weight: 700;
  }
  .iw-formulas tbody th {
    font-weight: 600;
    color: var(--fg);
  }
  .iw-formulas tbody th span {
    font-weight: 400;
    color: var(--muted);
    font-size: 0.78rem;
    margin-left: 0.25rem;
  }
  .iw-num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .iw-formulas tbody td {
    font-weight: 700;
    color: var(--heading);
  }
  .iw-note {
    margin: 0.7rem 0 0;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--muted);
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { idealWeightBinding } from '@lib/calculators/ideal-weight-form';

  document.querySelectorAll<HTMLElement>('[data-idealweight]').forEach((root) =>
    mountFormCalculator(root, idealWeightBinding, {
      recalculationMode: 'live-after-first',
      calculateButtonLabel: 'Calculate Ideal Weight',
    }),
  );
</script>
