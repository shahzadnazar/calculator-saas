---
/**
 * Compound interest island — converting a rate between compounding periods.
 *
 * The form is the reference's own single line: a rate, the period it compounds on,
 * an equals sign, and the period to convert it to. 6% compounded monthly and
 * 6.16778% compounded annually grow money at exactly the same speed, and this says
 * so — which is the only way to compare a card's APR with a savings account's APY.
 *
 * It is deliberately NOT a growth projection; that is the Interest calculator's job,
 * and the reference draws the same line.
 *
 * Beneath the answer, the whole ladder: what the entered rate earns in a year at
 * every period. The bars encode what each period earns ABOVE annual compounding —
 * a true zero — because plotted from zero the nine rates are indistinguishable, and
 * cutting the axis to fake a difference would be a lie. Every exact rate is printed
 * beside its bar.
 *
 * Compute, validation, state, focus and the announcement belong to the shared form
 * runtime and the compound binding.
 */
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import ResultBreakdown from '@components/result/ResultBreakdown.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';
import { COMPOUND_FREQUENCIES } from '@lib/calculators/compounding';
import { FREQUENCY_LABELS } from '@lib/calculators/compound-interest-form';
---

<div class="ci mx-auto flex w-full max-w-5xl flex-col gap-4" data-ci>
  <!-- Inputs: the reference's one-line converter. -->
  <form class="card p-4" data-form novalidate aria-label="Compound interest rate converter">
    <div class="ci-convert">
      <div class="ci-convert__cell" data-field="inputRate">
        <label class="field-label" for="ci-rate">Input Interest</label>
        <div class="flex">
          <input class="field rounded-r-none" id="ci-rate" name="inputRate" type="number" min="0" max="200" step="0.01" inputmode="decimal" autocomplete="off" placeholder="e.g. 6" aria-describedby="ci-rate-error" />
          <span class="field-affix rounded-r-lg border-l-0">%</span>
        </div>
      </div>

      <div class="ci-convert__cell">
        <label class="field-label" for="ci-input-compound">Compound</label>
        <select class="field" id="ci-input-compound" name="inputCompound">
          {COMPOUND_FREQUENCIES.map((f) => (
            <option value={f} selected={f === 'monthly'}>{FREQUENCY_LABELS[f]}</option>
          ))}
        </select>
      </div>

      <p class="ci-equals" aria-hidden="true">=</p>

      <div class="ci-convert__cell">
        <span class="field-label">Output Interest</span>
        <output class="ci-output" for="ci-rate ci-input-compound ci-output-compound" data-ci-output>—</output>
      </div>

      <div class="ci-convert__cell">
        <label class="field-label" for="ci-output-compound">Compound</label>
        <select class="field" id="ci-output-compound" name="outputCompound">
          {COMPOUND_FREQUENCIES.map((f) => (
            <option value={f} selected={f === 'annually'}>{FREQUENCY_LABELS[f]}</option>
          ))}
        </select>
      </div>
    </div>
    <p class="ci-error" id="ci-rate-error" data-error-for="inputRate" hidden></p>

    <div class="mt-3 flex items-center gap-3">
      <button type="submit" class="btn btn-primary" data-ci-submit>Calculate</button>
      <button type="button" class="btn btn-secondary" data-reset>Clear</button>
    </div>
    <p class="ci-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result -->
  <ResultShell id="ci-result" state="empty" density="complex" label="Equivalent interest rate" minHeight="18rem">
    <ExampleNotice />
    <EmptyResult message="Enter an interest rate and choose the two compounding periods, then press Calculate to see the equivalent rate." />

    <div data-result-when="valid">
      <ResultSummary label="Equivalent rate">
        <ResultValue value="—" size="text-4xl" />
      </ResultSummary>

      <p class="ci-summary" data-ci-summary>—</p>

      <ResultBreakdown title="What it earns">
        <dl class="ci-metrics">
          <div><dt>Effective annual rate</dt><dd data-ci-effective>—</dd></div>
        </dl>

        <figure class="ci-chart" data-ci-chart-figure hidden>
          <figcaption class="ci-figure__title">What this rate earns at each compounding period</figcaption>
          <div data-ci-chart></div>
          <p class="ci-chart__note">
            Bars show what each period earns above annual compounding — the exact rate is
            beside each one. More frequent compounding always earns more, but the gain
            shrinks fast: most of it is already won by the time you reach monthly.
          </p>
        </figure>
      </ResultBreakdown>
    </div>

    <InvalidResult
      title="Check your entry"
      message="Enter an interest rate of zero or more, then choose the compounding period it is quoted on and the one to convert it to."
    />

    <ResultAnnouncement id="ci-live" />
  </ResultShell>
</div>

<style>
  /* Emphasis, not categorical: the two periods being converted wear the accent and
     the other seven recede. Each step is chosen for its own scheme rather than
     flipped — the light gray is too pale on a dark surface and the dark accent is
     too close to the gray once both are lightened. Validated in both modes. */
  .ci {
    --ci-accent: #7c3aed;
    --ci-context: #64748b;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .ci {
      --ci-accent: #8b5cf6;
      --ci-context: #78716c;
    }
  }
  :root[data-theme='dark'] .ci {
    --ci-accent: #8b5cf6;
    --ci-context: #78716c;
  }

  .ci > :global(*) { min-width: 0; }
  .ci .field-label { margin-bottom: 0.15rem; line-height: 1.25; }

  /* The converter reads as one sentence across the row, and stacks when there is
     not room for five cells. */
  .ci-convert {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.5rem 0.6rem;
    align-items: end;
  }
  .ci-convert__cell { min-width: 0; }
  .ci-equals {
    display: none;
    margin: 0;
    padding-bottom: 0.5rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--muted);
    text-align: center;
  }
  @media (min-width: 40rem) {
    .ci-convert {
      grid-template-columns: minmax(7rem, 0.8fr) minmax(0, 1.1fr) auto minmax(7rem, 0.8fr) minmax(0, 1.1fr);
      align-items: end;
    }
    .ci-equals { display: block; }
  }

  /* The output mirrors the answer beside the inputs, the way the reference does —
     it is a readout, never an editable field. */
  .ci-output {
    display: block;
    padding: 0.5rem 0.2rem;
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-brand-600);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .ci-error {
    margin-top: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .ci-error { color: #fca5a5; }
  }
  :root[data-theme='dark'] .ci-error { color: #fca5a5; }

  .ci-live-note { margin-top: 0.75rem; font-size: 0.8rem; color: var(--muted); }

  .ci-summary { margin: 0.4rem 0 0; font-size: 0.95rem; line-height: 1.5; color: var(--fg); }

  .ci-metrics { margin: 0; display: grid; gap: 0.2rem; }
  .ci-metrics > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.92rem;
  }
  .ci-metrics dt { color: var(--fg); font-weight: 600; }
  .ci-metrics dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--heading);
    font-weight: 700;
    white-space: nowrap;
  }

  .ci-figure__title {
    margin: 0 0 0.4rem;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .ci-chart { margin: 0.9rem 0 0; }
  .ci-chart__note { margin: 0.6rem 0 0; font-size: 0.8rem; line-height: 1.5; color: var(--muted); }

  /* The ladder. Rows are built with the DOM API, so these must be global — a scoped
     selector compiles to an attribute the generated cells never carry. */
  /* Fixed layout so the table can never be wider than the panel holding it — the
     column headers are long enough to push it past a phone otherwise. */
  .ci-chart :global(.ci-rate) {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: 0.82rem;
  }
  .ci-chart :global(.ci-rate__th) {
    padding: 0 0.5rem 0.3rem 0;
    text-align: left;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  /* Label and value are sized; the track takes whatever is left. */
  .ci-chart :global(.ci-rate__th):first-child { width: 38%; }
  .ci-chart :global(.ci-rate__th--value) { width: 5.5rem; }
  .ci-chart :global(.ci-rate__th--value) { text-align: right; padding-right: 0; }
  .ci-chart :global(.ci-rate__row) > :global(*) { padding: 0.22rem 0.5rem 0.22rem 0; }
  .ci-chart :global(.ci-rate__label) {
    text-align: left;
    font-weight: 600;
    color: var(--fg);
    overflow-wrap: anywhere;
  }
  /* A hairline track one step off the surface, never a boxed-in bar. */
  .ci-chart :global(.ci-rate__track) { width: 100%; }
  .ci-chart :global(.ci-rate__track)::after { content: ''; }
  .ci-chart :global(.ci-rate__bar) {
    display: block;
    height: 0.5rem;
    min-width: 0;
    border-radius: 0 4px 4px 0;
    background: var(--ci-context);
  }
  .ci-chart :global(.ci-rate__row[data-highlight]) :global(.ci-rate__bar) { background: var(--ci-accent); }
  .ci-chart :global(.ci-rate__row[data-highlight]) :global(.ci-rate__label),
  .ci-chart :global(.ci-rate__row[data-highlight]) :global(.ci-rate__value) {
    color: var(--heading);
    font-weight: 800;
  }
  .ci-chart :global(.ci-rate__value) {
    padding-right: 0;
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: var(--fg);
    white-space: nowrap;
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { compoundInterestBinding, COMPOUND_EXAMPLE_VALUES } from '@lib/calculators/compound-interest-form';

  document.querySelectorAll<HTMLElement>('[data-ci]').forEach((root) => {
    const shell = root.querySelector<HTMLElement>('[data-result-shell]');
    const output = root.querySelector<HTMLElement>('[data-ci-output]');

    mountFormCalculator(root, compoundInterestBinding, {
      recalculationMode: 'live-after-first',
      example: { values: COMPOUND_EXAMPLE_VALUES },
      calculateButtonLabel: 'Calculate',
    });

    // The inline readout mirrors whatever the result panel is currently showing —
    // including the labelled example — and empties whenever there is no valid
    // answer, so it can never display a rate the result has already dropped.
    const mirror = () => {
      if (!output || !shell) return;
      const valid = shell.dataset.resultState === 'valid' || shell.dataset.resultState === 'example';
      const shown = shell.querySelector<HTMLElement>('[data-result-when~="valid"] [data-result-value]');
      output.textContent = valid && shown?.textContent ? shown.textContent : '—';
    };
    mirror();
    if (shell) {
      new MutationObserver(mirror).observe(shell, {
        subtree: true,
        childList: true,
        characterData: true,
        attributes: true,
        attributeFilter: ['data-result-state'],
      });
    }
  });
</script>
