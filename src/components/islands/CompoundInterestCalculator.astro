---
/**
 * Compound Interest calculator island (R21A1 — task-first; finance; the FINAL legacy migration; the
 * standard-form runtime UNCHANGED).
 *
 * A single form on the UNCHANGED standard-form runtime + the Compound Interest binding
 * (@lib/calculators/compound-interest-form), which wraps the UNCHANGED calculateCompoundInterest
 * (frozen by compound-interest.test.ts) — the shared compound-growth engine also consumed by
 * Investment / Savings / Retirement / Interest and the reference tables. Task-first: principal / rate /
 * years start EMPTY, the compounding frequency defaults to Monthly, the contribution is optional, the
 * result is empty on the server AND after hydration (the legacy island SSR-seeded a $10,000 / 7% / 20y
 * / $200 result and recomputed live on every keystroke), and the visitor presses "Calculate" for the
 * first result (live-after-first).
 *
 * The DOMINANT result is the FUTURE VALUE; the three-way split (initial principal / total contributions
 * / interest earned) is the supporting breakdown + proportion bar; the "Balance by year" series is an
 * island-owned <details> disclosure rendered via the DOM API (never innerHTML). ALL from the single
 * frozen CompoundResult (no duplicated calculation). NO isUsableResult — the complete-result guard
 * lives in the binding's resultValue (a finite future-value sentinel; a valid $0 is the finite 0 the
 * default gate accepts). No runtime change; the engine is untouched, so every sibling consumer +
 * reference table stays byte-identical.
 *
 * Static ids are namespaced per-instance WHEN more than one Compound Interest calculator shares a
 * document — mandatory here, because the understanding-compound-interest guide ALSO embeds this island.
 */
import { COMPOUND_FREQUENCIES, DEFAULT_FREQUENCY } from '@lib/calculators/compound-interest-form';
import ResultShell from '@components/result/ResultShell.astro';
import ResultSummary from '@components/result/ResultSummary.astro';
import ResultValue from '@components/result/ResultValue.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
---

<div class="cicalc mx-auto grid w-full max-w-4xl gap-6 md:grid-cols-2 md:items-start" data-compound>
  <!-- Inputs -->
  <form class="card p-5 sm:p-6" data-form novalidate aria-label="Compound interest calculator">
    <div class="space-y-4">
      <div data-field="principal">
        <label class="field-label" for="ci-principal">Initial amount</label>
        <div class="mt-1 flex">
          <span class="field-affix rounded-l-lg border-r-0">$</span>
          <input class="field rounded-l-none" id="ci-principal" name="principal" type="number" min="0" step="500" inputmode="decimal" autocomplete="off" placeholder="e.g. 10000" aria-describedby="ci-principal-error" />
        </div>
        <p class="ci-error" id="ci-principal-error" data-error-for="principal" hidden></p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div data-field="annualRatePct">
          <label class="field-label" for="ci-rate">Annual rate</label>
          <div class="mt-1 flex">
            <input class="field rounded-r-none" id="ci-rate" name="annualRatePct" type="number" min="0" step="0.1" inputmode="decimal" autocomplete="off" placeholder="e.g. 7" aria-describedby="ci-rate-error" />
            <span class="field-affix rounded-r-lg border-l-0">%</span>
          </div>
          <p class="ci-error" id="ci-rate-error" data-error-for="annualRatePct" hidden></p>
        </div>
        <div data-field="years">
          <label class="field-label" for="ci-years">Years</label>
          <input class="field mt-1" id="ci-years" name="years" type="number" min="1" step="1" inputmode="numeric" autocomplete="off" placeholder="e.g. 20" aria-describedby="ci-years-error" />
          <p class="ci-error" id="ci-years-error" data-error-for="years" hidden></p>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div data-field="compoundsPerYear">
          <label class="field-label" for="ci-freq">Compounding</label>
          <select class="field mt-1" id="ci-freq" name="compoundsPerYear" aria-label="Compounding frequency">
            {COMPOUND_FREQUENCIES.map((f) => <option value={f.value} selected={f.value === DEFAULT_FREQUENCY}>{f.label}</option>)}
          </select>
        </div>
        <div data-field="contribution">
          <label class="field-label" for="ci-contribution">Added / period</label>
          <div class="mt-1 flex">
            <span class="field-affix rounded-l-lg border-r-0">$</span>
            <input class="field rounded-l-none" id="ci-contribution" name="contribution" type="number" min="0" step="50" inputmode="decimal" autocomplete="off" placeholder="optional" aria-describedby="ci-contribution-error" />
          </div>
          <p class="ci-error" id="ci-contribution-error" data-error-for="contribution" hidden></p>
        </div>
      </div>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <button type="submit" class="btn btn-primary">Calculate</button>
      <button type="button" class="btn btn-secondary" data-reset>Reset</button>
    </div>
    <p class="ci-live-note" data-live-note hidden>Changes update automatically.</p>
  </form>

  <!-- Result -->
  <ResultShell id="compound-result" state="empty" density="standard" label="Compound interest result" minHeight="20rem" placeholderAlignment="center">
    <EmptyResult message="Enter an initial amount, rate and time, then calculate to project the growth." />

    <div data-result-when="valid">
      <ResultSummary label="Future value">
        <ResultValue value="—" size="text-4xl" />
      </ResultSummary>

      <div class="ci-bar" aria-hidden="true">
        <span class="ci-seg ci-seg--principal" data-ci-seg="principal" style="width:0%"></span>
        <span class="ci-seg ci-seg--contrib" data-ci-seg="contrib" style="width:0%"></span>
        <span class="ci-seg ci-seg--interest" data-ci-seg="interest" style="width:0%"></span>
      </div>

      <dl class="ci-metrics">
        <div><dt><span class="ci-dot ci-dot--principal"></span>Initial principal</dt><dd data-ci-principal>—</dd></div>
        <div><dt><span class="ci-dot ci-dot--contrib"></span>Total contributions</dt><dd data-ci-contrib>—</dd></div>
        <div><dt><span class="ci-dot ci-dot--interest"></span>Interest earned</dt><dd data-ci-interest>—</dd></div>
      </dl>

      <details class="ci-series">
        <summary>Balance by year</summary>
        <div class="ci-series-scroll">
          <table class="ci-table">
            <caption class="sr-only">Projected balance by year: contributions, interest and balance</caption>
            <thead>
              <tr>
                <th scope="col">Year</th>
                <th scope="col" class="ci-num">Contributions</th>
                <th scope="col" class="ci-num">Interest</th>
                <th scope="col" class="ci-num">Balance</th>
              </tr>
            </thead>
            <tbody data-ci-rows></tbody>
          </table>
        </div>
      </details>

      <p class="ci-note">Estimates assume a constant rate of return; real returns vary. Gross figures, before tax.</p>
    </div>

    <InvalidResult
      title="Check your entries"
      message="Enter an initial amount and rate of zero or more, a whole number of years from 1 to 100, and an optional contribution of zero or more."
    />

    <ResultAnnouncement id="compound-live" />
  </ResultShell>
</div>

<style>
  .ci-error {
    margin: 0.3rem 0 0;
    font-size: 0.78rem;
    font-weight: 600;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .ci-error {
      color: #fca5a5;
    }
  }
  :root[data-theme='dark'] .ci-error {
    color: #fca5a5;
  }
  .ci-live-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .ci-bar {
    margin-top: 1.25rem;
    display: flex;
    height: 0.75rem;
    width: 100%;
    overflow: hidden;
    border-radius: 9999px;
    background: var(--subtle);
  }
  .ci-seg {
    display: block;
    height: 100%;
  }
  .ci-seg--principal {
    background: var(--color-brand-600);
  }
  .ci-seg--contrib {
    background: #64748b;
  }
  .ci-seg--interest {
    background: var(--color-accent-500);
  }

  .ci-metrics {
    margin: 1.25rem 0 0;
    display: grid;
    gap: 0.25rem;
  }
  .ci-metrics > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.35rem 0;
    font-size: 0.95rem;
  }
  .ci-metrics dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg);
    font-weight: 600;
  }
  .ci-metrics dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--heading);
    font-weight: 700;
    white-space: nowrap;
  }
  .ci-dot {
    display: inline-block;
    height: 0.625rem;
    width: 0.625rem;
    border-radius: 9999px;
  }
  .ci-dot--principal {
    background: var(--color-brand-600);
  }
  .ci-dot--contrib {
    background: #64748b;
  }
  .ci-dot--interest {
    background: var(--color-accent-500);
  }

  .ci-series {
    margin-top: 1.1rem;
    border-top: 1px solid var(--line);
    padding-top: 0.75rem;
  }
  .ci-series > summary {
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--heading);
  }
  .ci-series-scroll {
    margin-top: 0.75rem;
    max-height: 18rem;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
  }
  .ci-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .ci-table thead th {
    position: sticky;
    top: 0;
    background: var(--subtle);
    padding: 0.4rem 0.65rem;
    text-align: left;
    font-weight: 600;
  }
  .ci-table th.ci-num,
  .ci-table td.ci-num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .ci-table :global(.ci-cell) {
    padding: 0.4rem 0.65rem;
    border-top: 1px solid var(--line);
  }
  .ci-table :global(.ci-cell--year) {
    font-weight: 600;
    text-align: left;
  }
  .ci-note {
    margin: 0.9rem 0 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--muted);
  }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import { compoundInterestBinding } from '@lib/calculators/compound-interest-form';

  let ns = 0; // module-global → static-id namespace suffix, one per multi-instance root

  // When more than one Compound Interest calculator shares a document — which it DOES on the
  // understanding-compound-interest guide page (island) alongside any future gallery — the server-static
  // ids collide. Namespace THIS root's ids and repoint its in-root references so associations stay
  // instance-local; a lone instance is left untouched. The runtime targets fields by [name] / [data-*].
  function uniquifyStaticIds(root: HTMLElement, suffix: string): void {
    const remap = new Map<string, string>();
    root.querySelectorAll<HTMLElement>('[id]').forEach((el) => {
      const next = `${el.id}-${suffix}`;
      remap.set(el.id, next);
      el.id = next;
    });
    const repoint = (attr: string) =>
      root.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((el) => {
        const next = el
          .getAttribute(attr)!
          .split(/\s+/)
          .map((token) => remap.get(token) ?? token)
          .join(' ');
        el.setAttribute(attr, next);
      });
    repoint('for');
    repoint('aria-describedby');
    repoint('aria-labelledby');
    repoint('aria-controls');
  }

  document.querySelectorAll<HTMLElement>('[data-compound]').forEach((root) => {
    if (document.querySelectorAll('[data-compound]').length > 1) uniquifyStaticIds(root, `c${++ns}`);

    mountFormCalculator(root, compoundInterestBinding, {
      recalculationMode: 'live-after-first',
      calculateButtonLabel: 'Calculate',
    });

    // Clear the stale figures whenever the shell leaves the valid state (an invalid live edit, or
    // Reset), so no stale figure lingers behind the hidden valid region. Presentation only.
    const shell = root.querySelector<HTMLElement>('[data-result-shell]');
    if (shell) {
      const clear = () => {
        ['[data-ci-principal]', '[data-ci-contrib]', '[data-ci-interest]'].forEach((sel) => {
          const el = root.querySelector<HTMLElement>(sel);
          if (el) el.textContent = '—';
        });
        root.querySelectorAll<HTMLElement>('[data-ci-seg]').forEach((el) => (el.style.width = '0%'));
        const rows = root.querySelector<HTMLElement>('[data-ci-rows]');
        if (rows) rows.replaceChildren();
        root.querySelectorAll<HTMLElement>('[data-result-when~="valid"] [data-result-value], [data-result-when~="valid"] [data-result-value-a11y]').forEach((el) => {
          el.textContent = '—';
        });
      };
      new MutationObserver(() => {
        if (shell.dataset.resultState !== 'valid') clear();
      }).observe(shell, { attributes: true, attributeFilter: ['data-result-state'] });
    }
  });
</script>
