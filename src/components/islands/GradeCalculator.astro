---
/**
 * Grade island — the reference's TWO calculators.
 *
 * The Grade Calculator weight-averages a table of assignments, with an optional Final Grade
 * Planning block; the Final Grade Calculator answers a different question from three plain fields.
 * They keep their own fields, button and result — neither is a mode of the other — and each puts
 * its result in the same row as its inputs.
 *
 * The assignment rows are ISLAND-OWNED and built with the DOM API, never innerHTML: each carries a
 * globally unique id (so two instances on a page never collide), its three fields, and its own
 * error slots that the runtime targets. Adding or removing a row dispatches an `input` event so the
 * runtime recalculates live AFTER the first calculation, and a no-op before it.
 *
 * Both run on the UNCHANGED standard-form runtime; the complete-result guard lives in `resultValue`
 * and there is no `isUsableResult` (an all-F average is a finite 0 the default gate accepts).
 */
import ResultShell from '@components/result/ResultShell.astro';
import EmptyResult from '@components/result/EmptyResult.astro';
import InvalidResult from '@components/result/InvalidResult.astro';
import ResultAnnouncement from '@components/result/ResultAnnouncement.astro';
import ExampleNotice from '@components/result/ExampleNotice.astro';

const FINAL_FIELDS = [
  { name: 'current', label: 'Your current grade', placeholder: '88', suffix: null, hint: 'Your average on everything except the final.' },
  { name: 'want', label: 'The grade you want', placeholder: '85', suffix: null, hint: 'The overall grade you are aiming for.' },
  { name: 'weight', label: 'Your final is worth', placeholder: '40', suffix: '%', hint: 'The final’s share of the course grade.' },
];
---

<div class="gradepage mx-auto w-full max-w-5xl" data-grade-page>
  <!-- 1 — the weighted average -->
  <section class="grade-calc" data-grade aria-labelledby="grade-heading">
    <h2 class="grade-title" id="grade-heading">Grade Calculator</h2>
    <p class="grade-lede">Grades can be percentages (<strong>88</strong>) or letters (<strong>B+</strong>), mixed freely.</p>

    <div class="grade-split">
      <form class="card grade-card" data-form novalidate aria-label="Grade calculator">
        <div class="grade-scroll">
          <table class="grade-input-table">
            <thead>
              <tr>
                <th scope="col">Assignment/Exam <span class="grade-optional">(optional)</span></th>
                <th scope="col">Grade</th>
                <th scope="col">Weight</th>
                <th scope="col"><span class="sr-only">Remove</span></th>
              </tr>
            </thead>
            <!-- Rows are island-owned; the script seeds the opening set. -->
            <tbody data-grade-rows></tbody>
          </table>
        </div>

        <button type="button" class="grade-add" data-grade-add>+ add more rows</button>

        <fieldset class="grade-plan">
          <legend class="grade-plan__legend">Final Grade Planning (Optional)</legend>
          <div class="grade-plan__fields">
          <div class="grade-field">
            <label class="field-label grade-field__label" for="grade-goal">Final Grade Goal</label>
            <div class="grade-field__control">
              <input class="field grade-num" id="grade-goal" name="goal" type="text" inputmode="decimal" autocomplete="off" placeholder="A-" aria-describedby="grade-goal-error" />
              <p class="grade-field-error" id="grade-goal-error" data-error-for="goal" hidden />
            </div>
          </div>
          <div class="grade-field">
            <label class="field-label grade-field__label" for="grade-remaining">Weight of Remaining Tasks</label>
            <div class="grade-field__control">
              <div class="grade-suffixed">
                <input class="field grade-num" id="grade-remaining" name="remainingWeight" type="text" inputmode="decimal" autocomplete="off" placeholder="55" aria-describedby="grade-remaining-error" />
                <span class="grade-suffix" aria-hidden="true">%</span>
              </div>
              <p class="grade-field-error" id="grade-remaining-error" data-error-for="remainingWeight" hidden />
            </div>
          </div>
          </div>
        </fieldset>

        <div class="mt-3 flex items-center gap-3">
          <button type="submit" class="btn btn-primary" data-grade-submit>Calculate</button>
          <button type="button" class="btn btn-secondary" data-reset>Clear</button>
        </div>
        <p class="grade-live-note" data-live-note hidden>Changes update automatically.</p>
      </form>

      <ResultShell id="grade-result" state="empty" density="standard" label="Grade result" minHeight="0" class="grade-result">
        <ExampleNotice />
        <EmptyResult message="Enter a grade and a weight for at least one assignment, then calculate." />

        <div data-result-when="valid">
          <p class="grade-headline">
            <span class="grade-headline__label">Average grade:</span>
            <span class="grade-headline__value" data-result-value>—</span>
          </p>
          <span class="sr-only" data-result-value-a11y></span>

          <div class="grade-scroll">
            <table class="grade-report">
              <caption class="sr-only">Grades by assignment</caption>
              <thead>
                <tr>
                  <th scope="col">Assignment/Exam</th>
                  <th scope="col">Grade</th>
                  <th scope="col">Weight</th>
                </tr>
              </thead>
              <tbody data-grade-breakdown></tbody>
              <tfoot>
                <tr><th scope="row">Total:</th><td colspan="2" data-grade-total-weight>—</td></tr>
                <tr class="grade-report__total"><th scope="row">Average Grade:</th><td colspan="2" data-grade-average>—</td></tr>
              </tfoot>
            </table>
          </div>

          <p class="grade-plan-sentence" data-grade-plan-row hidden><span data-grade-plan></span></p>
        </div>

        <InvalidResult
          title="Check your rows"
          message="Every row you fill in needs a grade — a percentage or a letter — and a weight of zero or more."
        />

        <ResultAnnouncement id="grade-live" />
      </ResultShell>
    </div>
  </section>

  <!-- 2 — what the final has to be -->
  <section class="grade-calc" data-final aria-labelledby="final-heading">
    <h2 class="grade-title" id="final-heading">Final Grade Calculator</h2>
    <p class="grade-lede">What you need on the final to finish the course where you want.</p>

    <div class="grade-split">
      <form class="card grade-card" data-form novalidate aria-label="Final grade calculator">
        {
          FINAL_FIELDS.map((f) => (
            <div class="grade-field">
              <label class="field-label grade-field__label" for={`final-${f.name}`}>{f.label}</label>
              <div class="grade-field__control">
                <div class="grade-suffixed">
                  <input
                    class="field grade-num"
                    id={`final-${f.name}`}
                    name={f.name}
                    type="text"
                    inputmode="decimal"
                    autocomplete="off"
                    placeholder={f.placeholder}
                    aria-describedby={`final-${f.name}-hint final-${f.name}-error`}
                  />
                  {f.suffix && <span class="grade-suffix" aria-hidden="true">{f.suffix}</span>}
                </div>
                <p class="grade-hint" id={`final-${f.name}-hint`}>{f.hint}</p>
                <p class="grade-field-error" id={`final-${f.name}-error`} data-error-for={f.name} hidden />
              </div>
            </div>
          ))
        }

        <div class="mt-3 flex items-center gap-3">
          <button type="submit" class="btn btn-primary" data-final-submit>Calculate</button>
          <button type="button" class="btn btn-secondary" data-reset>Clear</button>
        </div>
        <p class="grade-live-note" data-live-note hidden>Changes update automatically.</p>
      </form>

      <ResultShell id="final-result" state="empty" density="standard" label="Final grade result" minHeight="0" class="grade-result">
        <ExampleNotice />
        <EmptyResult message="Enter your current grade, the grade you want and what the final is worth." />

        <div data-result-when="valid">
          <p class="grade-plan-sentence" data-final-sentence>—</p>
          <span class="sr-only" data-result-value>—</span>
          <span class="sr-only" data-result-value-a11y></span>
        </div>

        <InvalidResult
          title="Check your entries"
          message="Enter grades as percentages or letters, and a final weight above 0 and up to 100."
        />

        <ResultAnnouncement id="final-live" />
      </ResultShell>
    </div>
  </section>
</div>

<style>
  .gradepage { display: grid; gap: 1.75rem; min-width: 0; }
  .grade-calc { min-width: 0; }
  .grade-title {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--heading);
  }
  .grade-lede {
    margin: 0.1rem 0 0.45rem;
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--muted);
    max-width: 68ch;
  }

  /* Inputs and result side by side once there is room, so the answer appears beside the table that
     produced it rather than under a screenful of rows. */
  .grade-split {
    display: grid;
    gap: 1rem;
    align-items: start;
    min-width: 0;
  }
  @media (min-width: 62rem) {
    .grade-split { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }
  .grade-card { padding: 0.85rem; min-width: 0; }
  /* `position: relative` matters: an absolutely positioned .sr-only label inside the table would
     otherwise take the page as its containing block and stretch the document past the viewport. */
  .grade-scroll { overflow-x: auto; min-width: 0; position: relative; }

  /* ---- The assignment table -------------------------------------- */
  .grade-input-table { width: auto; border-collapse: collapse; }
  .grade-input-table thead th {
    padding: 0 0.3rem 0.35rem;
    text-align: left;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--muted);
    white-space: nowrap;
  }
  .grade-optional { font-weight: 500; text-transform: none; letter-spacing: 0; }

  /* Rows are built in JS, so their rules must be :global() beneath an element the template owns. */
  .grade-calc :global(.grade-row td) { padding: 0.08rem 0.3rem; vertical-align: top; }
  .grade-calc :global(.grade-row .field) { min-height: 2.75rem; max-width: 100%; }
  /* The optional name is the column that gives way: with the "%" now inline the
     four cells have to fit the card at a 900px tool width, and the remove
     button is the one thing that must never be clipped. */
  .grade-calc :global(.grade-row__name) { width: 8rem; }
  .grade-calc :global(.grade-row__score) { width: 4.5rem; font-variant-numeric: tabular-nums; }
  .grade-calc :global(.grade-row__weight) { width: 4.5rem; font-variant-numeric: tabular-nums; }
  .grade-calc :global(.grade-row__remove) {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 0.45rem;
    background: transparent;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1;
    cursor: pointer;
  }
  .grade-calc :global(.grade-row__remove:hover:not(:disabled)) { background: var(--subtle); color: var(--color-danger); }
  .grade-calc :global(.grade-row__remove:disabled) { opacity: 0.35; cursor: not-allowed; }
  .grade-calc :global(.grade-row-error),
  .grade-field-error {
    margin: 0.15rem 0 0;
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.3;
    color: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .grade-calc :global(.grade-row-error),
    :root:not([data-theme='light']) .grade-field-error { color: #fca5a5; }
  }
  :root[data-theme='dark'] .grade-calc :global(.grade-row-error),
  :root[data-theme='dark'] .grade-field-error { color: #fca5a5; }

  /* A per-cent sign that sits with the field rather than becoming a fourth column. */
  /* :global because the table rows are built in JS, and Astro's scoped styles
     never reach elements the browser created. Without it the rule applied only
     to the template-rendered fields, and each row's "%" fell to a line of its
     own as soon as the column got narrower — five rows of that pushed
     Calculate below the fold at 1366x768. */
  .grade-calc :global(.grade-suffixed) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: nowrap;
  }
  .grade-calc :global(.grade-suffix) {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--muted);
    flex: none;
  }

  .grade-add {
    margin-top: 0.25rem;
    padding: 0.35rem 0;
    min-height: 2.75rem;
    background: none;
    border: 0;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-brand-700);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  :root[data-theme='dark'] .grade-add { color: var(--color-brand-400); }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .grade-add { color: var(--color-brand-400); }
  }

  /* ---- Final Grade Planning + the final calculator's fields ------- */
  .grade-plan {
    margin: 0.45rem 0 0;
    padding: 0.5rem 0.7rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 0.7rem;
  }
  .grade-plan__legend {
    padding: 0 0.35rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--muted);
  }
  /* Side by side rather than stacked: two stacked optional fields cost sixty pixels of the first
     screen and push the primary action past it. */
  .grade-plan__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem 0.9rem;
  }
  .grade-plan__fields .grade-field {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.1rem;
    margin-top: 0;
  }
  .grade-plan__fields .grade-field__label { padding-top: 0; font-size: 0.78rem; }
  @media (max-width: 34rem) {
    .grade-plan__fields { grid-template-columns: minmax(0, 1fr); }
  }
  .grade-field + .grade-field { margin-top: 0.45rem; }
  .grade-field {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
    gap: 0.5rem;
    align-items: start;
  }
  .grade-field__label { margin: 0; padding-top: 0.7rem; }
  .grade-field__control { min-width: 0; }
  .grade-num { min-height: 2.75rem; width: 7rem; max-width: 100%; font-variant-numeric: tabular-nums; }
  .grade-hint { margin: 0.2rem 0 0; font-size: 0.76rem; line-height: 1.35; color: var(--muted); }
  @media (max-width: 30rem) {
    .grade-field { grid-template-columns: minmax(0, 1fr); gap: 0.15rem; }
    .grade-field__label { padding-top: 0; }
  }

  .grade-live-note { margin-top: 0.6rem; font-size: 0.8rem; color: var(--muted); }
  .grade-calc :global(.grade-result) { min-width: 0; }

  /* ---- Results ---------------------------------------------------- */
  .grade-headline {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 0.7rem;
  }
  .grade-headline__label { font-size: 1rem; font-weight: 700; color: var(--muted); }
  .grade-headline__value {
    font-size: clamp(1.35rem, 5vw, 1.85rem);
    font-weight: 800;
    color: var(--heading);
    font-variant-numeric: tabular-nums;
  }

  .grade-report { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  .grade-report thead th {
    padding: 0.35rem 0.55rem;
    text-align: left;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }
  .grade-report tfoot th,
  .grade-report tfoot td,
  .grade-calc :global(.grade-report tbody th),
  .grade-calc :global(.grade-report tbody td) {
    padding: 0.35rem 0.55rem;
    text-align: left;
    border-bottom: 1px solid var(--line);
    vertical-align: baseline;
  }
  .grade-calc :global(.grade-report tbody th) { font-weight: 600; color: var(--fg); }
  .grade-calc :global(.grade-report tbody td) {
    color: var(--heading);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .grade-report tfoot th { font-weight: 700; color: var(--fg); }
  .grade-report tfoot td { font-weight: 700; color: var(--heading); font-variant-numeric: tabular-nums; }
  .grade-report__total th,
  .grade-report__total td {
    background: color-mix(in srgb, var(--color-brand-500) 10%, transparent);
    font-size: 0.95rem;
  }

  .grade-plan-sentence {
    margin: 0.8rem 0 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--heading);
    font-weight: 600;
    max-width: 68ch;
  }
  .grade-plan-sentence[hidden] { display: none; }
  [data-final-sentence] { margin-top: 0; font-size: 1rem; }
</style>

<script>
  import { mountFormCalculator } from '@lib/result/form-runtime';
  import {
    gradeBinding,
    finalGradeBinding,
    GRADE_EXAMPLE_VALUES,
    FINAL_EXAMPLE_VALUES,
    INITIAL_ROWS,
  } from '@lib/calculators/grade-form';

  let uid = 0;

  /**
   * Namespace this instance's server-STATIC ids and repoint their in-root references, but ONLY when
   * more than one shares the document (an embed gallery, a guide with two copies). A lone instance
   * keeps the ids the server wrote. Without this, two instances would collide on every id and a
   * label would point at the other one's field.
   */
  function uniquifyStaticIds(root: HTMLElement, suffix: string): void {
    const remap = new Map<string, string>();
    root.querySelectorAll<HTMLElement>('[id]').forEach((el) => {
      const next = `${el.id}-${suffix}`;
      remap.set(el.id, next);
      el.id = next;
    });
    const repoint = (attr: string) =>
      root.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((el) => {
        const next = el
          .getAttribute(attr)!
          .split(/\s+/)
          .map((token) => remap.get(token) ?? token)
          .join(' ');
        el.setAttribute(attr, next);
      });
    repoint('for');
    repoint('aria-describedby');
    repoint('aria-labelledby');
    repoint('aria-controls');
  }

  /**
   * One assignment row, built with the DOM API — never markup from a string.
   *
   * Only the first row carries example placeholders: eight rows all reading "Homework 1 / 90 / 5"
   * look like an instruction to type it eight times.
   */
  function buildRow(withExample = false): HTMLTableRowElement {
    const id = `g${++uid}`;
    const tr = document.createElement('tr');
    tr.className = 'grade-row';
    tr.setAttribute('data-grade-row', id);

    const nameCell = document.createElement('td');
    const name = document.createElement('input');
    name.type = 'text';
    name.className = 'field grade-row__name';
    name.setAttribute('data-grade-name', '');
    name.autocomplete = 'off';
    if (withExample) name.placeholder = 'Homework 1';
    name.setAttribute('aria-label', 'Assignment or exam name (optional)');
    nameCell.appendChild(name);

    const makeField = (
      kind: 'score' | 'weight',
      label: string,
      placeholder: string,
      suffix?: string,
    ): HTMLTableCellElement => {
      const td = document.createElement('td');
      const wrap = document.createElement('div');
      wrap.className = 'grade-suffixed';
      const input = document.createElement('input');
      input.type = 'text';
      input.className = `field grade-row__${kind}`;
      input.setAttribute(`data-grade-${kind}`, '');
      input.inputMode = 'decimal';
      input.autocomplete = 'off';
      if (withExample) input.placeholder = placeholder;
      input.setAttribute('aria-label', label);
      input.setAttribute('aria-describedby', `grade-${kind}-${id}-error`);
      wrap.appendChild(input);
      if (suffix) {
        const mark = document.createElement('span');
        mark.className = 'grade-suffix';
        mark.setAttribute('aria-hidden', 'true');
        mark.textContent = suffix;
        wrap.appendChild(mark);
      }
      const error = document.createElement('p');
      error.className = 'grade-row-error';
      error.id = `grade-${kind}-${id}-error`;
      error.setAttribute('data-error-for', `${kind === 'score' ? 'grade' : 'weight'}-${id}`);
      error.hidden = true;
      td.append(wrap, error);
      return td;
    };

    const removeCell = document.createElement('td');
    const remove = document.createElement('button');
    remove.type = 'button';
    remove.className = 'grade-row__remove';
    remove.textContent = '×';
    remove.setAttribute('data-grade-remove', '');
    remove.setAttribute('aria-label', 'Remove this row');
    removeCell.appendChild(remove);

    tr.append(nameCell, makeField('score', 'Grade', '90'), makeField('weight', 'Weight', '5', '%'), removeCell);
    return tr;
  }

  function mountRows(root: HTMLElement): void {
    const body = root.querySelector<HTMLElement>('[data-grade-rows]');
    const form = root.querySelector<HTMLFormElement>('form[data-form]');
    if (!body || !form) return;

    const notify = () => form.dispatchEvent(new Event('input', { bubbles: true }));

    const syncRemoveButtons = () => {
      const rows = body.querySelectorAll('[data-grade-row]');
      rows.forEach((row) => {
        const button = row.querySelector<HTMLButtonElement>('[data-grade-remove]');
        if (button) button.disabled = rows.length <= 1;
      });
    };

    const seed = (count: number) => {
      body.textContent = '';
      for (let i = 0; i < count; i += 1) body.appendChild(buildRow(i === 0));
      syncRemoveButtons();
    };

    root.querySelector('[data-grade-add]')?.addEventListener('click', () => {
      body.appendChild(buildRow());
      syncRemoveButtons();
      notify();
    });

    body.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-grade-remove]');
      if (!button || button.disabled) return;
      button.closest('[data-grade-row]')?.remove();
      syncRemoveButtons();
      notify();
    });

    // The binding cannot rebuild island-owned rows, so it asks for it.
    root.addEventListener('grade:reset', () => seed(INITIAL_ROWS));

    seed(INITIAL_ROWS);
  }

  const gRoots = document.querySelectorAll<HTMLElement>('[data-grade]');
  gRoots.forEach((root, i) => {
    if (gRoots.length > 1) uniquifyStaticIds(root, `g${i + 1}`);
    mountRows(root);
    mountFormCalculator(root, gradeBinding, {
      recalculationMode: 'live-after-first',
      example: { values: GRADE_EXAMPLE_VALUES },
      calculateButtonLabel: 'Calculate',
    });
  });

  const fRoots = document.querySelectorAll<HTMLElement>('[data-final]');
  fRoots.forEach((root, i) => {
    if (fRoots.length > 1) uniquifyStaticIds(root, `f${i + 1}`);
    mountFormCalculator(root, finalGradeBinding, {
      recalculationMode: 'live-after-first',
      example: { values: FINAL_EXAMPLE_VALUES },
      calculateButtonLabel: 'Calculate',
    });
  });
</script>
