---
/**
 * "Embed this on your site" box — gives site owners a copy-paste snippet to put
 * a calculator or reference table on their own page. This is the authority/link
 * engine: the snippet includes an attribution link *in the host page's DOM*
 * (outside the iframe), which is a real backlink — a link inside the iframe
 * would not count. Renders only when the embeddable stream is enabled.
 *
 * Generic over what is embedded: pass the display title, a unique slug, the
 * embed page path and the canonical page path.
 */
import { EMBEDDABLE } from '@config/monetization';
import { buildEmbedSnippet } from '@lib/embed';

interface Props {
  title: string;
  slug: string;
  embedPath: string;
  canonicalPath: string;
  /** Word used in the heading, e.g. "calculator" (default) or "table". */
  noun?: string;
}
const { title, slug, embedPath, canonicalPath, noun = 'calculator' } = Astro.props;

const snippet = buildEmbedSnippet({ title, slug, embedPath, canonicalPath });
---

{
  EMBEDDABLE.enabled && (
    <section class="mt-16 max-w-3xl" aria-labelledby={`embed-heading-${slug}`}>
      <details class="card group px-5 py-4">
        <summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold" style="color: var(--heading)">
          <span id={`embed-heading-${slug}`}>Embed this {noun} on your site — free</span>
          <span class="shrink-0 transition-transform group-open:rotate-45" style="color: var(--color-brand-600)" aria-hidden="true">+</span>
        </summary>
        <div class="mt-4">
          <p class="text-sm" style="color: var(--fg)">
            Add this free, mobile-friendly {title} to your own website. Paste the code where you want it to
            appear — it stays up to date automatically, and the frame resizes to fit.
          </p>
          <label class="sr-only" for={`embed-code-${slug}`}>Embed code</label>
          <textarea
            id={`embed-code-${slug}`}
            class="field mt-3 min-h-32 font-mono text-xs"
            rows="6"
            readonly
            spellcheck="false"
            data-embed-code
          >{snippet}</textarea>
          <button type="button" class="btn btn-primary mt-2" data-embed-copy>Copy embed code</button>
          <p class="mt-2 text-xs" style="color: var(--muted)">
            Please keep the attribution link — it's what keeps these tools free to use and embed.
          </p>
        </div>
      </details>
    </section>
  )
}

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-embed-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const box = btn.closest('details');
      const ta = box?.querySelector<HTMLTextAreaElement>('[data-embed-code]');
      if (!ta) return;
      const done = () => {
        const original = 'Copy embed code';
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = original), 1500);
      };
      try {
        await navigator.clipboard.writeText(ta.value);
        done();
      } catch {
        // Clipboard API unavailable — select the code so it can be copied manually.
        ta.select();
      }
    });
  });
</script>
